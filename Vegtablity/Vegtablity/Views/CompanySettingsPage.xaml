<UserControl x:Class="Views.CompanySettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:CompanySettingsViewModel/>
    </UserControl.DataContext>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Background="White" CornerRadius="20" Padding="40" MaxWidth="800" MinWidth="600">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="5" Opacity="0.1"/>
                    </Border.Effect>

                    <StackPanel>
                        <TextBlock Text="🏢 إعدادات بيانات الشركة" FontSize="32" FontWeight="Bold" Margin="0,0,0,40" Foreground="#2c3e50" HorizontalAlignment="Center"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Inputs Section -->
                            <StackPanel Grid.Column="0" Margin="0,0,40,0">
                                <!-- Company Name -->
                                <TextBlock Text="اسم الشركة" FontSize="16" FontWeight="SemiBold" Foreground="#34495e" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}" Height="45" Padding="12,10" FontSize="16" Margin="0,0,0,25" VerticalContentAlignment="Center">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Background" Value="#fdfdfd"/>
                                            <Setter Property="BorderBrush" Value="#bdc3c7"/>
                                            <Style.Resources>
                                                <Style TargetType="Border">
                                                    <Setter Property="CornerRadius" Value="8"/>
                                                </Style>
                                            </Style.Resources>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>

                                <!-- Address -->
                                <TextBlock Text="العنوان الرسمي" FontSize="16" FontWeight="SemiBold" Foreground="#34495e" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Height="45" Padding="12,10" FontSize="16" Margin="0,0,0,25" VerticalContentAlignment="Center"/>

                                <!-- Phone -->
                                <TextBlock Text="رقم التواصل" FontSize="16" FontWeight="SemiBold" Foreground="#34495e" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Height="45" Padding="12,10" FontSize="16" Margin="0,0,0,25" VerticalContentAlignment="Center"/>

                                <!-- Email -->
                                <TextBlock Text="البريد الإلكتروني" FontSize="16" FontWeight="SemiBold" Foreground="#34495e" Margin="0,0,0,10"/>
                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="45" Padding="12,10" FontSize="16" Margin="0,0,0,25" VerticalContentAlignment="Center"/>

                                <!-- System Preferences: Partner Mode -->
                                <TextBlock Text="تفضيلات النظام" FontSize="16" FontWeight="SemiBold" Foreground="#34495e" Margin="0,15,0,10"/>
                                <Border Background="#fdfdfd" BorderBrush="#bdc3c7" BorderThickness="1" CornerRadius="8" Padding="15">
                                    <CheckBox IsChecked="{Binding UnifiedPartnerSearch}" Content="تفعيل البحث الموحد (دمج العملاء والموردين معاً في شاشات الفواتير)" FontSize="15" FontWeight="SemiBold" Foreground="#2c3e50" VerticalContentAlignment="Center"/>
                                </Border>
                            </StackPanel>

                            <!-- Logo Section -->
                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="شعار المؤسسة" FontSize="16" FontWeight="SemiBold" Foreground="#34495e" Margin="0,0,0,15" HorizontalAlignment="Center"/>
                                <Border Width="200" Height="200" BorderBrush="#ecf0f1" BorderThickness="2" CornerRadius="15" Background="#fbfcfc" Margin="0,0,0,20">
                                    <Grid>
                                        <Image Source="{Binding Logo}" Margin="10" Stretch="Uniform"/>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Logo, Converter={helpers:NullToVisibilityConverter}}">
                                            <TextBlock Text="🖼️" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                            <TextBlock Text="انقر لاختيار صورة" Foreground="#95a5a6" FontSize="14"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Button Content="تغيير الشعار" Command="{Binding SelectLogoCommand}" Height="40" Width="140" Background="#34495e" Foreground="White" BorderThickness="0" FontSize="14" FontWeight="SemiBold">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="8"/>
                                        </Style>
                                    </Button.Resources>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Separator Height="1" Background="#eee" Margin="0,30"/>

                        <!-- Save Action -->
                        <Button Content="✅ حفظ ومزامنة البيانات" Command="{Binding SaveCommand}" Height="55" Width="300" HorizontalAlignment="Center" Background="#2ecc71" Foreground="White" FontSize="18" FontWeight="Bold" BorderThickness="0">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="10"/>
                                </Style>
                            </Button.Resources>
                            <Button.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                            </Button.Effect>
                        </Button>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
