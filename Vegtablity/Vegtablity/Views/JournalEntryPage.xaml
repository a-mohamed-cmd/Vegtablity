<UserControl x:Class="Views.JournalEntryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:controls="clr-namespace:Vegtablity.Controls"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo"
             Focusable="True"
             PreviewKeyDown="UserControl_PreviewKeyDown">

    <UserControl.DataContext>
        <vm:JournalEntryViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        <helpers:BooleanInverterConverter x:Key="BoolToInvertedConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <helpers:BooleanToTextConverter x:Key="PostedTextConverter" TrueText="تم الترحيل" FalseText="قيد الانتظار"/>
        <helpers:BooleanToBrushConverter x:Key="PostedCardBrushConverter">
            <helpers:BooleanToBrushConverter.TrueBrush>
                <SolidColorBrush Color="#f1f9f5"/>
            </helpers:BooleanToBrushConverter.TrueBrush>
            <helpers:BooleanToBrushConverter.FalseBrush>
                <SolidColorBrush Color="White"/>
            </helpers:BooleanToBrushConverter.FalseBrush>
        </helpers:BooleanToBrushConverter>
        <helpers:BooleanToBrushConverter x:Key="PostedLabelBrushConverter">
            <helpers:BooleanToBrushConverter.TrueBrush>
                <SolidColorBrush Color="#27ae60"/>
            </helpers:BooleanToBrushConverter.TrueBrush>
            <helpers:BooleanToBrushConverter.FalseBrush>
                <SolidColorBrush Color="#f39c12"/>
            </helpers:BooleanToBrushConverter.FalseBrush>
        </helpers:BooleanToBrushConverter>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Padding="12" Background="#f8f9fa" CornerRadius="10,10,0,0" Margin="0,0,0,5" BorderBrush="#dcdde1" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="{Binding ToggleIconText}" Command="{Binding ToggleListCommand}" Click="ToggleButton_Click"
                            Style="{StaticResource ModernButtonStyle}" Width="36" Height="32" FontSize="14" FontWeight="Bold"
                            Background="#f3e5f5" Foreground="#8e44ad" BorderBrush="#e1bee7" BorderThickness="1" Margin="0,0,10,0"
                            ToolTip="طي / إظهار قائمة القيود"/>
                    <TextBlock Text="📝 القيود المحاسبية اليدوية" FontSize="18" FontWeight="Bold" Foreground="#8e44ad" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="🔄 تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Height="32" Background="#607d8b" Margin="4,0" ToolTip="تحديث قائمة القيود (F5)"/>
                    <Button Content="⚖️ موازنة" Command="{Binding AutoBalanceCommand}" Style="{StaticResource ModernButtonStyle}" Width="90" Height="32" Background="#16a085" Margin="4,0" 
                            Visibility="{Binding IsEditAllowed, Converter={StaticResource BoolToVisConverter}}"
                            ToolTip="موازنة القيد تلقائياً بإضافة المبلغ المتبقي على أحدث سطر"/>
                    <Button Content="🆕 قيد جديد" Command="{Binding NewCommand}" Style="{StaticResource ModernButtonStyle}" Width="95" Height="32" Background="#3498db" Margin="4,0" IsEnabled="{Binding CurrentPermissions.CanAdd}" ToolTip="إنشاء قيد جديد فارغ (F2)"/>
                    <Button Content="💾 حفظ" Command="{Binding SaveCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Height="32" Background="#27ae60" Margin="4,0" 
                            Visibility="{Binding IsSaveVisible, Converter={StaticResource BoolToVisConverter}}"
                            ToolTip="حفظ القيد المحاسبي (Ctrl + S)"/>
                    <Button Content="📌 ترحيل" Command="{Binding PostCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Height="32" Background="#8e44ad" Margin="4,0" 
                            Visibility="{Binding IsPostVisible, Converter={StaticResource BoolToVisConverter}}"
                            ToolTip="ترحيل القيد إلى الدفتر العام (Ctrl + D)"/>
                    <Button Content="↩️ إلغاء ترحيل" Command="{Binding UnpostCommand}" Style="{StaticResource ModernButtonStyle}" Width="105" Height="32" Background="#e67e22" Margin="4,0" 
                            Visibility="{Binding IsUnpostVisible, Converter={StaticResource BoolToVisConverter}}"
                            IsEnabled="{Binding CurrentPermissions.CanDelete}" ToolTip="إلغاء ترحيل القيد الحالي"/>
                    <Button Content="🖨️ طباعة" Command="{Binding PrintCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Height="32" Background="#2c3e50" Margin="4,0" ToolTip="طباعة القيد مباشرة مع خيارات واختيار الطابعة (Ctrl + P)"/>
                    <Button Content="📤" Command="{Binding ExportPdfCommand}" Style="{StaticResource ModernButtonStyle}" Width="38" Height="32" FontSize="14" Background="#7f8c8d" Margin="4,0" ToolTip="تصدير PDF"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Content Grid -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="330"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Collapsible Journals List Panel -->
            <Border x:Name="JournalListBorder" Grid.Column="0" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#eee" BorderThickness="1" Background="White" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="Auto"/> <!-- Search & Filter Card -->
                        <RowDefinition Height="Auto"/> <!-- Active Filter Banner -->
                        <RowDefinition Height="*"/>    <!-- ListBox -->
                        <RowDefinition Height="Auto"/> <!-- Pagination -->
                    </Grid.RowDefinitions>

                    <!-- Header Bar with Filter Toggle Button -->
                    <Border Grid.Row="0" Background="#ecf0f1" Padding="8,6" CornerRadius="8,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="📋 قائمة القيود المسجلة" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="#2c3e50"/>
                            
                            <Button Grid.Column="1" x:Name="BtnToggleFilter" Click="ToggleFilterCard_Click" Style="{StaticResource ModernButtonStyle}"
                                    Height="28" Padding="8,2" FontSize="11" FontWeight="Bold"
                                    Background="#EDE9FE" Foreground="#6D28D9" BorderBrush="#DDD6FE" BorderThickness="1"
                                    ToolTip="إظهار / إخفاء كارت البحث والتصفية">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔍 تصفية" VerticalAlignment="Center"/>
                                    <Border Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisConverter}}"
                                            Background="#E11D48" CornerRadius="4" Padding="4,1" Margin="4,0,0,0">
                                        <TextBlock Text="نشط" Foreground="White" FontSize="9" FontWeight="Bold"/>
                                    </Border>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Collapsible Animated Search & Filter Card -->
                    <Border Grid.Row="1" x:Name="SearchFilterCard" Height="0" Opacity="0" ClipToBounds="True" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10,8">
                        <StackPanel>
                            <!-- Search by Journal No & Description -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="95"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding SearchJournalNo, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" Height="30" FontSize="11"
                                         VerticalContentAlignment="Center" Padding="8,0,8,2"
                                         helpers:WatermarkHelper.Watermark="رقم القيد..." PreviewKeyDown="SearchBox_PreviewKeyDown" Margin="0,0,5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding SearchDescription, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource ModernTextBoxStyle}" Height="30" FontSize="11"
                                         VerticalContentAlignment="Center" Padding="8,0,8,2"
                                         helpers:WatermarkHelper.Watermark="بحث بالبيان / الوصف..." PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                            </Grid>

                            <!-- Status Filter (Posted / Unposted / All) -->
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="الحالة:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding SearchStatusIndex, Mode=TwoWay}" Height="30" FontSize="11" VerticalContentAlignment="Center">
                                    <ComboBoxItem Content="📑 كافة القيود (الكل)"/>
                                    <ComboBoxItem Content="🟢 قيود مرحلة فقط"/>
                                    <ComboBoxItem Content="🟡 قيود قيد الانتظار فقط"/>
                                </ComboBox>
                            </Grid>

                            <!-- Date Range Filter -->
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Text="تصفية بنطاق التاريخ:" FontSize="11" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" x:Name="TxtSearchDateFrom"
                                             Text="{Binding SearchDateFromText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}" Height="30" FontSize="11"
                                             VerticalContentAlignment="Center" Padding="8,0,8,2"
                                             helpers:WatermarkHelper.Watermark="من: dd/MM/yyyy"
                                             LostFocus="Date_LostFocus" GotFocus="Date_GotFocus" PreviewKeyDown="SearchDateFrom_PreviewKeyDown"
                                             ToolTip="أدخل التاريخ: dd/MM/yyyy أو ddMMyyyy"/>
                                    <TextBlock Grid.Column="1" Text="إلى" FontSize="11" Foreground="#64748B" VerticalAlignment="Center" Margin="4,0"/>
                                    <TextBox Grid.Column="2" x:Name="TxtSearchDateTo"
                                             Text="{Binding SearchDateToText, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource ModernTextBoxStyle}" Height="30" FontSize="11"
                                             VerticalContentAlignment="Center" Padding="8,0,8,2"
                                             helpers:WatermarkHelper.Watermark="إلى: dd/MM/yyyy"
                                             LostFocus="Date_LostFocus" GotFocus="Date_GotFocus" PreviewKeyDown="SearchDateTo_PreviewKeyDown"
                                             ToolTip="أدخل التاريخ: dd/MM/yyyy أو ddMMyyyy"/>
                                </Grid>
                            </StackPanel>

                            <!-- Filter Action Buttons -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="🔍 تطبيق البحث" Command="{Binding ApplyFilterCommand}"
                                        Style="{StaticResource ModernButtonStyle}" Height="30" FontSize="11" Background="#8E44AD" Margin="0,0,4,0"/>
                                <Button Grid.Column="1" Content="🔄 مسح التصفية" Command="{Binding ClearFilterCommand}"
                                        Style="{StaticResource ModernButtonStyle}" Height="30" FontSize="11" Background="#64748B" Margin="4,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Active Filter Banner Indicator -->
                    <Border Grid.Row="2" Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVisConverter}}"
                            Background="#EDE9FE" BorderBrush="#DDD6FE" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="8,6,8,2">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding ActiveFilterSummaryText}" FontSize="11" FontWeight="Bold" Foreground="#6D28D9" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="✖ إلغاء" Command="{Binding ClearFilterCommand}"
                                    Background="Transparent" BorderThickness="0" Foreground="#DC2626" FontSize="11" FontWeight="Bold" Cursor="Hand" ToolTip="إلغاء التصفية الحالية"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="3" ItemsSource="{Binding JournalList}" SelectedItem="{Binding SelectedJournal}" BorderThickness="0" HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" BorderBrush="#f1f2f6" BorderThickness="0,0,0,1" 
                                        Background="{Binding IsPosted, Converter={StaticResource PostedCardBrushConverter}}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock FontWeight="Bold" FontSize="13" Foreground="#2c3e50">
                                                <Run Text="قيد رقم: "/>
                                                <Run Text="{Binding JournalNo}"/>
                                            </TextBlock>
                                            <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding JDate, StringFormat=\{0:yyyy/MM/dd\}}" FontSize="11" Foreground="Silver" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Padding="6,3" CornerRadius="12" 
                                                Background="{Binding IsPosted, Converter={StaticResource PostedLabelBrushConverter}}" 
                                                VerticalAlignment="Center">
                                             <TextBlock Text="{Binding IsPosted, Converter={StaticResource PostedTextConverter}}" 
                                                        Foreground="White" FontSize="10" FontWeight="Bold"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Pagination Control Bar -->
                    <Border Grid.Row="4" Background="#f8f9fa" Padding="6" CornerRadius="0,0,8,8" BorderBrush="#dcdde1" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="◀ السابق" Command="{Binding PreviousPageCommand}" Style="{StaticResource ModernButtonStyle}" Width="65" Height="26" FontSize="11" Background="#7f8c8d"/>
                            <TextBlock Grid.Column="1" Text="{Binding PageInfoText}" FontSize="11" FontWeight="Bold" Foreground="#34495e" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            <Button Grid.Column="2" Content="التالي ▶" Command="{Binding NextPageCommand}" Style="{StaticResource ModernButtonStyle}" Width="65" Height="26" FontSize="11" Background="#7f8c8d"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Entry Editor Panel -->
            <Border Grid.Column="1" CornerRadius="10" Background="White" Padding="15" BorderBrush="#eee" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header Info (Date & Description) -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="التاريخ:" VerticalAlignment="Center" FontWeight="Bold" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" x:Name="TxtJDate"
                                 Text="{Binding JDateText, UpdateSourceTrigger=PropertyChanged}"
                                 LostFocus="Date_LostFocus" PreviewKeyDown="Date_PreviewKeyDown"
                                 GotFocus="Date_GotFocus"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Width="130" Height="40" HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center" Padding="10,1,10,4"
                                 IsEnabled="{Binding IsEditAllowed}"
                                 ToolTip="أدخل التاريخ: dd/MM/yyyy أو ddMMyyyy"/>
                        
                        <TextBlock Grid.Column="2" Text="البيان العام للقيد:" VerticalAlignment="Center" FontWeight="Bold" Margin="20,0,8,0"/>
                        <TextBox Grid.Column="3" Text="{Binding CurrentJournal.Description, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Height="40" VerticalContentAlignment="Center" Padding="10,1,10,5"
                                 IsReadOnly="{Binding IsJournalPosted}"/>
                    </Grid>

                    <!-- Details Header & Custom ItemsControl Container -->
                    <Border Grid.Row="1" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Background="#FAFAFA">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Table Column Header -->
                            <Border Grid.Row="0" Background="#F1F5F9" CornerRadius="8,8,0,0" Padding="8,10" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="الحساب" FontWeight="Bold" Foreground="#334155" Margin="5,0"/>
                                    <TextBlock Grid.Column="1" Text="مدين" FontWeight="Bold" Foreground="#c0392b" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="دائن" FontWeight="Bold" Foreground="#27ae60" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="البيان / ملاحظات السطر" FontWeight="Bold" Foreground="#334155" Margin="5,0"/>
                                    <TextBlock Grid.Column="4" Text="حذف" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Multi-Row ItemsControl with JournalRowControl -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                                <ItemsControl x:Name="DetailsItemsControl" ItemsSource="{Binding CurrentJournal.Details}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:JournalRowControl
                                                AccountsList="{Binding DataContext.Accounts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                IsLocked="{Binding DataContext.IsJournalPosted, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                RequestAddNewRow="JournalRow_RequestAddNewRow"
                                                RequestDeleteRow="JournalRow_RequestDeleteRow"
                                                AmountChanged="JournalRow_AmountChanged"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Footer Totals & Imbalance Display -->
                    <Grid Grid.Row="2" Margin="0,12,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        
                        <Button Grid.Column="0" Content="➕ إضافة سطر جديد" Command="{Binding AddLineCommand}" Width="140" Height="36" HorizontalAlignment="Left" Style="{StaticResource ModernButtonStyle}" Background="#95a5a6"
                                Visibility="{Binding IsEditAllowed, Converter={StaticResource BoolToVisConverter}}"/>
                        
                        <!-- نص حالة الاتزان / الفرق بجوار الإجماليات مباشرة -->
                        <Border Grid.Column="2" Margin="0,0,15,0" Padding="12,6" CornerRadius="8" Background="#f8f9fa" BorderBrush="#e9ecef" BorderThickness="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding DifferenceFormatted}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" Foreground="{Binding DifferenceColor}"/>
                        </Border>

                        <TextBlock Grid.Column="3" Text="الإجماليات:" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="4" Text="{Binding TotalDebit, StringFormat=N3, Mode=OneWay}" Height="36" IsReadOnly="True" FontWeight="Bold" Foreground="#c0392b" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0" Padding="6,4"/>
                        <TextBox Grid.Column="5" Text="{Binding TotalCredit, StringFormat=N3, Mode=OneWay}" Height="36" IsReadOnly="True" FontWeight="Bold" Foreground="#27ae60" TextAlignment="Center" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Margin="3,0" Padding="6,4"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    
        <!-- Snackbar Notification -->
        <Border x:Name="SnackbarBorder" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#1E293B" CornerRadius="12" Padding="20,12" Margin="0,0,0,30" Visibility="Collapsed" Panel.ZIndex="105">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SnackbarIcon" Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText" Text="رسالة" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
