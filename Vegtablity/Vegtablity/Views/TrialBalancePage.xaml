<UserControl x:Class="Views.TrialBalancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        <helpers:BooleanInverterConverter x:Key="BoolToInvertedConverter"/>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:TrialBalanceViewModel/>
    </UserControl.DataContext>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12" Background="#f8f9fa" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#dcdde1" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📊 ميزان المراجعة" FontSize="20" FontWeight="Bold" Foreground="#2c3e50" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="📄 PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ModernButtonStyle}" Background="#e74c3c" Width="90" Margin="5,0"/>
                    <Button Content="csv" Command="{Binding ExportCsvCommand}" Style="{StaticResource ModernButtonStyle}" Background="#27ae60" Width="90" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" Padding="15" Background="White" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#eee" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                    <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <DatePicker SelectedDate="{Binding StartDate}" Width="120"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                    <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <DatePicker SelectedDate="{Binding EndDate}" Width="120"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                    <TextBlock Text="المستوى:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding AvailableLevels}" 
                              SelectedValue="{Binding SelectedLevel}" 
                              SelectedValuePath="Value" DisplayMemberPath="Key" Width="160"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                    <CheckBox Content="عرض الحركات" IsChecked="{Binding IsDetailedReport}" VerticalAlignment="Center"/>
                </StackPanel>
                
                <Button Content="🔍 عرض التقرير" Command="{Binding SearchCommand}" Style="{StaticResource ModernButtonStyle}" Width="120" Height="32" Margin="0,0,20,5"/>
                

            </WrapPanel>
        </Border>

        <!-- DataGrid -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" BorderBrush="#eee" BorderThickness="1">
            <DataGrid ItemsSource="{Binding FilteredItems}" AutoGenerateColumns="False" IsReadOnly="True" 
                      GridLinesVisibility="Horizontal" RowHeight="35" HorizontalGridLinesBrush="#f1f2f6">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="كود الحساب" Binding="{Binding AccountCode}" Width="100"/>
                    <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountName}" Width="*"/>
                    
                    <!-- Opening Balance (Net) -->
                    <DataGridTextColumn Header="رصيد أول" Binding="{Binding OpeningBalance, StringFormat=N2}" Width="110">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#fcfaf8"/>
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <!-- Period Movements -->
                    <DataGridTextColumn Header="مدين الحركة" Binding="{Binding PeriodDebit, StringFormat=N2}" Width="110" 
                                        Visibility="{Binding Data.IsDetailedReport, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisConverter}}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="دائن الحركة" Binding="{Binding PeriodCredit, StringFormat=N2}" Width="110"
                                        Visibility="{Binding Data.IsDetailedReport, Source={StaticResource Proxy}, Converter={StaticResource BoolToVisConverter}}">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>

                    <!-- Ending Balance (Net) -->
                    <DataGridTextColumn Header="رصيد آخر" Binding="{Binding EndingBalance, StringFormat=N2}" Width="110">
                        <DataGridTextColumn.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Background" Value="#f1f9f5"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="TextBlock.TextAlignment" Value="Right"/>
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.HighlightBrushKey}}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.HighlightTextBrushKey}}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.CellStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer Totals -->
        <Border Grid.Row="3" Padding="10" Background="#2c3e50" CornerRadius="0,0,10,10">
            <UniformGrid Columns="5">
                <TextBlock Text="الإجماليات:" Foreground="White" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="أول:" Foreground="#bdc3c7" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ReportData.TotalOpeningBalance, StringFormat=N2}" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsDetailedReport, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="حركة مدين:" Foreground="#bdc3c7" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ReportData.TotalPeriodDebit, StringFormat=N2}" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Visibility="{Binding IsDetailedReport, Converter={StaticResource BoolToVisConverter}}">
                    <TextBlock Text="حركة دائن:" Foreground="#bdc3c7" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ReportData.TotalPeriodCredit, StringFormat=N2}" Foreground="White" FontWeight="Bold"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="ختامي:" Foreground="#bdc3c7" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding ReportData.TotalEndingBalance, StringFormat=N2}" Foreground="#55efc4" FontWeight="Bold"/>
                </StackPanel>
            </UniformGrid>
        </Border>
    </Grid>
</UserControl>
