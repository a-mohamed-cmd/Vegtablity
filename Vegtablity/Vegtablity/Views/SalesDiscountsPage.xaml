<UserControl x:Class="Views.SalesDiscountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:SalesDiscountsViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <!-- Modern Card Style -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Color="#20000000" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeaderTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E293B"/>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Background="#F8FAFC" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ════════════ HEADER BAR ════════════ -->
        <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="10" Width="44" Height="44" Margin="0,0,12,0">
                        <TextBlock Text="🏷️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="خصومات وباقات المبيعات" Style="{StaticResource HeaderTitleStyle}"/>
                        <TextBlock Text="تعريف باقات وخصومات المنتجات (أنواع 1 و 2) وتفعيلها بتطبيق POS" FontSize="13" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Column="2" Text="{Binding StatusMessage}" Foreground="#10B981" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- ════════════ MAIN CONTENT ════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT PANEL: Discounts List & Form -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Discounts List Card -->
                <Border Grid.Row="0" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                            <TextBlock Text="قائمة الخصومات والباقات" FontWeight="Bold" FontSize="16" Foreground="#1E293B"/>
                        </StackPanel>

                        <!-- Discounts List -->
                        <ListBox Grid.Row="1" ItemsSource="{Binding Discounts}" SelectedItem="{Binding SelectedDiscount}"
                                 BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0"/>
                                    <Setter Property="Margin" Value="0,0,0,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="bd" Background="#F1F5F9" CornerRadius="8" Padding="12" BorderThickness="1" BorderBrush="#E2E8F0">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#EEF2FF"/>
                                                        <Setter TargetName="bd" Property="BorderBrush" Value="#6366F1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DiscountName}" FontWeight="Bold" FontSize="14" Foreground="#1E293B"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding DiscountTypeFormatted}" FontSize="12" Foreground="#64748B"/>
                                                <TextBlock Text=" • " FontSize="12" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding DiscountValueFormatted}" FontSize="12" FontWeight="Bold" Foreground="#6366F1"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#E0E7FF" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ProductCount, StringFormat='{}{0} أصناف'}" FontSize="11" FontWeight="Bold" Foreground="#4338CA"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Discount Form Card -->
                <Border Grid.Row="1" Style="{StaticResource ModernCard}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="بيانات الخصم / الباقة" FontWeight="Bold" FontSize="15" Foreground="#1E293B" Margin="0,0,0,12"/>

                        <!-- Name -->
                        <TextBlock Text="اسم الخصم / الباقة:" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditDiscountName, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="14" Margin="0,0,0,10"/>

                        <!-- Type & Value -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="نوع الخصم:" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <ComboBox SelectedIndex="{Binding EditDiscountTypeIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6" Margin="0">
                                    <ComboBoxItem Content="نسبة مئوية (%)"/>
                                    <ComboBoxItem Content="خصم مقطوع (مبلغ)"/>
                                    <ComboBoxItem Content="باقة كميات"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="قيمة الخصم:" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditDiscountValue, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="14"/>
                            </StackPanel>
                        </Grid>

                        <!-- Min Qty & Active -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="أقل كمية للتفعيل:" FontSize="12" Foreground="#475569" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditMinQuantity, UpdateSourceTrigger=PropertyChanged}" Padding="8" FontSize="14"/>
                            </StackPanel>

                            <CheckBox Grid.Column="2" Content="مفعّل حالياً" IsChecked="{Binding EditIsActive}" VerticalAlignment="Bottom" Margin="0,0,0,10" FontWeight="Bold"/>
                        </Grid>

                        <!-- Action Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Command="{Binding SaveCommand}" Content="حفظ 💾" Background="#6366F1" Foreground="White" FontWeight="Bold" Padding="10,8" BorderThickness="0"/>
                            <Button Grid.Column="2" Command="{Binding NewCommand}" Content="جديد ➕" Background="#E2E8F0" Foreground="#1E293B" FontWeight="Bold" Padding="10,8" BorderThickness="0"/>
                            <Button Grid.Column="4" Command="{Binding DeleteCommand}" Content="حذف 🗑️" Background="#FEE2E2" Foreground="#DC2626" FontWeight="Bold" Padding="10,8" BorderThickness="0"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- RIGHT PANEL: Products Selection DataGrid -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Title & Count -->
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="الأصناف المشمولة بالخصم (أنواع 1 و 2)" FontWeight="Bold" FontSize="16" Foreground="#1E293B"/>
                            <TextBlock Text="حدد الأصناف والمنتجات المصنعة والعادية التي يطبق عليها هذا الخصم" FontSize="12" Foreground="#64748B"/>
                        </StackPanel>

                        <Button Grid.Column="1" Command="{Binding ToggleSelectAllCommand}" Content="تحديد / إلغاء الكل 🔘" Background="#E0E7FF" Foreground="#4338CA" FontWeight="Bold" Padding="12,6" BorderThickness="0"/>
                    </Grid>

                    <!-- Search Bar -->
                    <TextBox Grid.Row="1" Text="{Binding SearchProductText, UpdateSourceTrigger=PropertyChanged}"
                             Padding="8" FontSize="14" Margin="0,0,0,12"/>

                    <!-- Products DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredProducts}" AutoGenerateColumns="False"
                              CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                              Background="Transparent" RowHeaderWidth="0" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridCheckBoxColumn Header="تحديد" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                            <DataGridTextColumn Header="اسم الصنف / المنتج" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="120"/>
                            <DataGridTextColumn Header="نوع الصنف" Binding="{Binding ProductTypeFormatted}" Width="100"/>
                            <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat='{}{0:N3}'}" Width="100"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
