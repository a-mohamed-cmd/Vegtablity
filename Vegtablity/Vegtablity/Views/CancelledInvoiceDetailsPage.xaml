<UserControl x:Class="Views.CancelledInvoiceDetailsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Vegtablity.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="820" d:DesignWidth="1200"
             FlowDirection="RightToLeft"
             Background="#F8FAFC">

    <UserControl.DataContext>
        <viewmodels:CancelledInvoiceDetailsViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="DataGrid">
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#334155"/>
                        <Setter Property="Padding" Value="12,10"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1.5"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══ 1. TOOLBAR (رجوع + طباعة + PDF فقط) ═══ -->
        <Border Grid.Row="0" Background="White" Padding="24,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FEE2E2" CornerRadius="10" Padding="10" Margin="0,0,12,0">
                        <TextBlock Text="🚫" FontSize="22"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="تفاصيل فاتورة ملغاة #" FontSize="20" FontWeight="Black" Foreground="#7F1D1D"/>
                            <TextBlock Text="{Binding Snapshot.OriginalInvID}" FontSize="20" FontWeight="Black" Foreground="#DC2626"/>
                            <Border Margin="12,0,0,0" Padding="10,4" CornerRadius="12" Background="#DC2626" VerticalAlignment="Center">
                                <TextBlock Text="CANCELLED — للعرض والطباعة فقط" Foreground="White" FontSize="11.5" FontWeight="Bold"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding Snapshot.InvTypeLabel}" FontSize="12.5" Foreground="#64748B" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- فقط أزرار العرض والطباعة والرجوع — لا يوجد حفظ / تعديل / ترحيل -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnGoBack" Content="← رجوع" Click="BtnGoBack_Click"
                            Style="{DynamicResource ModernButtonStyle}" Background="#64748B" Margin="0,0,10,0"
                            ToolTip="العودة إلى لوحة الفواتير"/>

                    <Button Content="🖨 طـبـاعـة" Command="{Binding PrintCommand}"
                            Visibility="{Binding CanPrintSalesPaper, Converter={StaticResource BoolToVis}}"
                            Style="{DynamicResource ModernButtonStyle}" Background="#6366F1" Margin="0,0,10,0"
                            ToolTip="طباعة نسخة من الفاتورة الملغاة"/>

                    <Button Content="📄 تصدير PDF" Command="{Binding ExportPdfCommand}"
                            Visibility="{Binding CanPrint, Converter={StaticResource BoolToVis}}"
                            Style="{DynamicResource ModernButtonStyle}" Background="#9333EA"
                            ToolTip="تصدير نسخة PDF من الفاتورة الملغاة"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 2. AUDIT BANNER (بيانات الأرشيف والإلغاء) ═══ -->
        <Border Grid.Row="1" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="0,0,0,1" Padding="24,10">
            <WrapPanel VerticalAlignment="Center">
                <TextBlock Text="🗂️ رقم الأرشيف: " FontWeight="Bold" Foreground="#991B1B" FontSize="13"/>
                <TextBlock Text="{Binding Snapshot.ArchiveID}" FontWeight="Black" Foreground="#7F1D1D" FontSize="13" Margin="0,0,22,0"/>

                <TextBlock Text="🕒 تاريخ الإلغاء: " FontWeight="Bold" Foreground="#991B1B" FontSize="13"/>
                <TextBlock Text="{Binding Snapshot.CancelledAt, StringFormat=yyyy/MM/dd HH:mm}" FontWeight="SemiBold" Foreground="#7F1D1D" FontSize="13" Margin="0,0,22,0"/>

                <TextBlock Text="👤 تم الحذف بواسطة: " FontWeight="Bold" Foreground="#991B1B" FontSize="13"/>
                <TextBlock Text="{Binding Snapshot.CancelledByUserName}" FontWeight="SemiBold" Foreground="#7F1D1D" FontSize="13" Margin="0,0,22,0"/>

                <TextBlock Text="✍️ منشئ الفاتورة الأصلي: " FontWeight="Bold" Foreground="#991B1B" FontSize="13"/>
                <TextBlock Text="{Binding Snapshot.OriginalUserName}" FontWeight="SemiBold" Foreground="#7F1D1D" FontSize="13"/>
            </WrapPanel>
        </Border>

        <!-- ═══ 3. MAIN SCROLLABLE READ-ONLY CONTENT ═══ -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="24,18">
            <StackPanel>
                <!-- Header & Totals Card -->
                <Border Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="14"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="تاريخ الفاتورة الأصلي" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Snapshot.InvDate, StringFormat=yyyy/MM/dd, Mode=OneWay}" IsReadOnly="True"
                                     Style="{DynamicResource ModernTextBoxStyle}" Background="#F8FAFC" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="اسم العميل / المورد" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Snapshot.PartnerName, Mode=OneWay}" IsReadOnly="True"
                                     Style="{DynamicResource ModernTextBoxStyle}" Background="#F8FAFC" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="المستودع" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Snapshot.WarehouseName, Mode=OneWay}" IsReadOnly="True"
                                     Style="{DynamicResource ModernTextBoxStyle}" Background="#F8FAFC" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="6">
                            <TextBlock Text="رقم المرجع / طريقة الدفع" Foreground="#64748B" FontSize="12" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding Snapshot.PaymentAccountName, Mode=OneWay}" IsReadOnly="True"
                                     Style="{DynamicResource ModernTextBoxStyle}" Background="#F8FAFC" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Row 2 Totals -->
                        <Border Grid.Row="2" Grid.Column="0" Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="الإجمالي قبل الخصم" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Snapshot.TotalAmount, StringFormat={}{0:N3}}" FontSize="17" FontWeight="Bold" Foreground="#0F172A"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="2" Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="الخصم / الصافي" FontSize="11.5" Foreground="#64748B"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Snapshot.Discount, StringFormat={}{0:N3}}" FontSize="14" Foreground="#D97706" FontWeight="SemiBold" Margin="0,0,8,0"/>
                                    <TextBlock Text="|" Foreground="#CBD5E1" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Snapshot.NetAmount, StringFormat={}{0:N3}}" FontSize="17" FontWeight="Black" Foreground="#1E293B"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="4" Background="#F0FDF4" CornerRadius="8" Padding="12,10" BorderBrush="#BBF7D0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="المدفوع / المتبقي" FontSize="11.5" Foreground="#15803D"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Snapshot.PaidAmount, StringFormat={}{0:N3}}" FontSize="16" FontWeight="Bold" Foreground="#059669" Margin="0,0,8,0"/>
                                    <TextBlock Text="/" Foreground="#94A3B8" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding Snapshot.Remainder, StringFormat={}{0:N3}}" FontSize="16" FontWeight="Bold" Foreground="#DC2626"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Grid.Column="6" Background="#F8FAFC" CornerRadius="8" Padding="12,10" BorderBrush="#E2E8F0" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ملاحظات" FontSize="11.5" Foreground="#64748B"/>
                                <TextBlock Text="{Binding Snapshot.Notes}" FontSize="12.5" Foreground="#334155" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Invoice Details Grid (Read Only) -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="📦 أصناف الفاتورة المؤرشفة" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>
                        <DataGrid ItemsSource="{Binding Snapshot.Details}"
                                  AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" CanUserDeleteRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#F1F5F9" BorderThickness="1" BorderBrush="#E2E8F0"
                                  RowHeight="40" MaxHeight="340">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="130"/>
                                <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="*"/>
                                <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="100"/>
                                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat={}{0:N3}}" Width="100"/>
                                <DataGridTextColumn Header="السعر" Binding="{Binding UnitPrice, StringFormat={}{0:N3}}" Width="110"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, StringFormat={}{0:N3}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Delivery / TempOrderInfo Section -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding HasTempOrderInfo, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🚚 بيانات التوصيل (TempOrderInfo)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <TextBlock Text="الاسم: " FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Snapshot.TempOrderInfo.CustomerName}" FontWeight="Bold" Margin="0,0,20,0"/>
                            <TextBlock Text="الهاتف: " FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Snapshot.TempOrderInfo.Phone}" FontWeight="Bold" Margin="0,0,20,0"/>
                            <TextBlock Text="العنوان: " FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Snapshot.TempOrderInfo.Address}" FontWeight="SemiBold" Margin="0,0,20,0"/>
                            <TextBlock Text="وقت التوصيل: " FontWeight="SemiBold" Foreground="#64748B"/>
                            <TextBlock Text="{Binding Snapshot.TempOrderInfo.DeliveryTime}" FontWeight="SemiBold"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Payment Splits Section -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding HasPaymentSplits, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="💳 تقسيمات طرق الدفع (Payment Splits)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Snapshot.PaymentSplits}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" RowHeight="36" BorderBrush="#E2E8F0" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="كود الحساب" Binding="{Binding AccountCode}" Width="120"/>
                                <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding AccountName}" Width="*"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N3}}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Payment Links Section -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding HasPaymentLinks, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🔗 روابط الدفع الإلكتروني المرتبطة" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Snapshot.PaymentLinks}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" RowHeight="36" BorderBrush="#E2E8F0" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الرابط" Binding="{Binding LinkID}" Width="90"/>
                                <DataGridTextColumn Header="البوابة" Binding="{Binding ProviderNameAr}" Width="180"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding LinkStatus}" Width="120"/>
                                <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat={}{0:N3}}" Width="120"/>
                                <DataGridTextColumn Header="ملاحظات" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- Talabat Orders Section -->
                <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,16" BorderBrush="#E2E8F0" BorderThickness="1"
                        Visibility="{Binding HasTalabatOrders, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="🛵 طلبات منصة Talabat المرتبطة" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                        <DataGrid ItemsSource="{Binding Snapshot.TalabatOrders}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" HeadersVisibility="Column" RowHeight="36" BorderBrush="#E2E8F0" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="رقم الطلب" Binding="{Binding OrderCode}" Width="130"/>
                                <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="*"/>
                                <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentType}" Width="100"/>
                                <DataGridTextColumn Header="الحالة" Binding="{Binding OrderStatus}" Width="110"/>
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat={}{0:N3}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
