<UserControl x:Class="Views.InventoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             xmlns:vv="clr-namespace:Vegtablity.Views"
             Loaded="Page_Loaded"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:InventoryViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Fade-in animation -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="20" To="0" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Edit Flyout slide-in animation -->
        <Storyboard x:Key="SlideInRight">
            <DoubleAnimation Storyboard.TargetName="EditPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="500" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Title bar -->
            <RowDefinition Height="Auto"/>   <!-- Filter & Actions -->
            <RowDefinition Height="*"/>      <!-- Products list -->
            <RowDefinition Height="Auto"/>   <!-- Pagination Bar -->
            <RowDefinition Height="Auto"/>   <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- ═══ 1. TITLE BAR ═══ -->
        <Border Grid.Row="0" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1" Padding="24,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8FAFC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FEF3C7" CornerRadius="12" Padding="12" Margin="0,0,14,0">
                        <TextBlock Text="📦" FontSize="28" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إدارة الأصناف" FontSize="26" FontWeight="Black" Foreground="#0F172A"/>
                        <TextBlock Text="إضافة وتعديل ومراقبة المنتجات في المخزون" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="NewProductBtn_Click" Margin="0,0,10,0" Cursor="Hand" ToolTip="إضافة صنف جديد">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="10" Padding="16,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#10B981" Offset="0"/>
                                            <GradientStop Color="#059669" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect><DropShadowEffect Color="#059669" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/></Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" Foreground="White" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="إضافة صنف جديد" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                                        <Setter TargetName="bg" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#059669" BlurRadius="18" Opacity="0.5" ShadowDepth="4"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 2. OTHERS / SEARCH BAR ═══ -->
        <Border Grid.Row="1" Background="White" Margin="24,24,24,0" CornerRadius="16" Padding="16"
                BorderBrush="#E2E8F0" BorderThickness="1">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.03" Color="#000"/></Border.Effect>
            <Grid x:Name="FiltersGrid" Opacity="0">
                <Grid.RenderTransform>
                    <TranslateTransform Y="20"/>
                </Grid.RenderTransform>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search -->
                <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" Foreground="#94A3B8" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" FontSize="14" Foreground="#334155"
                                 VerticalAlignment="Center" ToolTip="ابحث بالاسم، الكود أو التصنيف..."/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ 3. PRODUCTS LIST ═══ -->
        <Border Grid.Row="2" Background="White" Margin="24,16,24,24" CornerRadius="16"
                BorderBrush="#E2E8F0" BorderThickness="1" ClipToBounds="True">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.03" Color="#000"/></Border.Effect>
            <DataGrid x:Name="DgProducts" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      Background="Transparent" BorderThickness="0"
                      RowHeaderWidth="0" GridLinesVisibility="None"
                      HeadersVisibility="Column" LoadingRow="DgProducts_LoadingRow"
                      SelectionUnit="FullRow" SelectionMode="Single">

                <!-- ⭐ Fix: override system selection colors to preserve column text colors -->
                <DataGrid.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#DBEAFE"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#EFF6FF"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                </DataGrid.Resources>

                <!-- Header Style -->
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F8FAFC"/>
                        <Setter Property="Foreground" Value="#475569"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="FontSize" Value="13"/>
                        <Setter Property="Padding" Value="16,14"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E2E8F0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                    </Style>
                </DataGrid.ColumnHeaderStyle>

                <!-- Row Style with Hover Animation -->
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Setter Property="BorderBrush" Value="#F1F5F9"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="Padding" Value="5,0"/>
                        <Setter Property="MinHeight" Value="54"/>
                        <Setter Property="Foreground" Value="#0F172A"/>
                        <Style.Triggers>
                            <!-- Hover Animation -->
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetProperty="(DataGridRow.Background).(SolidColorBrush.Color)"
                                            To="#EFF6FF" Duration="0:0:0.15"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <ColorAnimation
                                            Storyboard.TargetProperty="(DataGridRow.Background).(SolidColorBrush.Color)"
                                            To="#FFFFFF" Duration="0:0:0.2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <!-- Selected: only color background, no foreground override -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#DBEAFE"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <!-- Cell Style -->
                <DataGrid.CellStyle>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Padding" Value="16,0"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                    </Style>
                </DataGrid.CellStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="كود" Binding="{Binding Barcode}" Width="110" Foreground="#64748B"/>
                    <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Foreground" Value="#0F172A"/>
                                <Setter Property="FontSize" Value="14"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="English Name" Binding="{Binding ProductNameEn}" Width="*"/>
                    <DataGridTextColumn Header="التصنيف" Binding="{Binding CatName}" Width="150" Foreground="#475569"/>
                    <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="100"/>
                    
                    <DataGridTextColumn Header="سعر الشراء" Binding="{Binding PurchasePrice, StringFormat=N2}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Foreground" Value="#10B981"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTextColumn Header="سعر البيع" Binding="{Binding SalePrice, StringFormat=N2}" Width="90">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Black"/>
                                <Setter Property="Foreground" Value="#2563EB"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- الإجراءات (Actions) -->
                    <DataGridTemplateColumn Header="" Width="130" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="8,0" VerticalAlignment="Center">
                                    <Button Content="🏷️" Click="ProductCardBtn_Click" Margin="0,0,6,0" Width="42" Height="34"
                                            Style="{DynamicResource ModernButtonStyle}" Background="#F8FAFC"
                                            Foreground="#334155" BorderThickness="1" BorderBrush="#E2E8F0"
                                            FontSize="18"
                                            ToolTip="تحليلات بطاقة الصنف"/>
                                    <Button Content="✏️" Click="EditBtn_Click" Width="42" Height="34"
                                            Style="{DynamicResource ModernButtonStyle}" Background="#EFF6FF"
                                            Foreground="#2563EB" BorderThickness="1" BorderBrush="#BFDBFE"
                                            FontSize="18"
                                            ToolTip="تعديل بيانات الصنف"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ═══ 4. PAGINATION BAR ═══ -->
        <Border Grid.Row="3" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="24,0,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Prev button -->
                <Button Grid.Column="0"
                        Command="{Binding PrevPageCommand}"
                        IsEnabled="{Binding CanGoPrev}"
                        Style="{DynamicResource ModernButtonStyle}"
                        Background="#E2E8F0" Foreground="#334155"
                        FontSize="14" FontWeight="Bold"
                        Padding="18,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="→ السابق" Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Page info label (center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageLabel}"
                               FontSize="14" FontWeight="SemiBold" Foreground="#475569"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Next button -->
                <Button Grid.Column="2"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Style="{DynamicResource ModernButtonStyle}"
                        Background="#3B82F6" Foreground="White"
                        FontSize="14" FontWeight="Bold"
                        Padding="18,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="التالي ←" Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#2563EB"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ 5. STATUS BAR ═══ -->
        <Border Grid.Row="4" Background="White" Padding="24,12" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
        </Border>

        <!-- ═══ 6. ADD / EDIT FLYOUT OVERLAY ═══ -->
        <Grid x:Name="OverlayGrid" Grid.RowSpan="5" Panel.ZIndex="50" Visibility="Collapsed">
            <!-- Semi-transparent overlay -->
            <Rectangle Fill="#660F172A" MouseDown="Overlay_MouseDown"/>

            <!-- Edit Panel slides in from left (RTL = visually right side) -->
            <Border x:Name="EditPanel"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Width="450" Background="White"
                    BorderBrush="#E0E6ED" BorderThickness="0,0,1,0">
                <Border.RenderTransform><TranslateTransform X="500"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.15" Color="#000"/></Border.Effect>

                <Grid Margin="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Header -->
                        <RowDefinition Height="*"/>    <!-- Scrollable content -->
                        <RowDefinition Height="Auto"/> <!-- Footer actions -->
                    </Grid.RowDefinitions>

                    <!-- Flyout Header -->
                    <Border Grid.Row="0" Background="#F8FAFC" Padding="24,20" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Content="✕" Click="ClosePopup_Click"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#94A3B8" FontSize="20" FontWeight="Bold" Cursor="Hand" Padding="4"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="تفاصيل الصنف" FontSize="20" FontWeight="Black" Foreground="#0F172A"/>
                                <TextBlock Text="الرجاء التأكد من صحة البيانات" FontSize="13" Foreground="#64748B" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Flyout Content -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24">
                        <StackPanel>
                            <!-- Category & Unit Row -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="التصنيف *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding Categories}" SelectedValue="{Binding EditCategoryID}" 
                                              SelectedValuePath="CatID" DisplayMemberPath="CatName" 
                                              Style="{DynamicResource ModernComboBoxStyle}" Padding="10,8"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="الوحدة *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <ComboBox ItemsSource="{Binding Units}" SelectedValue="{Binding EditUnitID}" 
                                              SelectedValuePath="UnitID" DisplayMemberPath="UnitName" 
                                              Style="{DynamicResource ModernComboBoxStyle}" Padding="10,8"/>
                                </StackPanel>
                            </Grid>

                            <!-- Name -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="اسم الصنف (عربي) *" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding EditProductName, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBoxStyle}" Padding="12,10"
                                         FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ProductNameError}" Foreground="#EF4444" FontSize="12" Margin="0,4,0,0"
                                           Visibility="{Binding ProductNameError, Converter={StaticResource StringToVisConverter}}"/>
                            </StackPanel>

                            <!-- English Name -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="English Name" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding EditProductNameEn, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{DynamicResource ModernTextBoxStyle}" Padding="12,10"
                                         FontSize="14" FlowDirection="LeftToRight" TextAlignment="Left"/>
                            </StackPanel>

                            <!-- Barcode -->
                            <StackPanel Margin="0,0,0,24">
                                <TextBlock Text="رقم الباركود" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="🔳" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBox Grid.Column="1" Text="{Binding EditBarcode, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="Transparent" BorderThickness="0" FontSize="14" FontWeight="Bold"
                                                 VerticalAlignment="Center" FlowDirection="LeftToRight" TextAlignment="Left"/>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Rectangle Fill="#E2E8F0" Height="1" Margin="-24,0,-24,24"/>

                            <!-- Prices Row -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="سعر الشراء" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding EditPurchasePrice, UpdateSourceTrigger=LostFocus}" 
                                             Style="{DynamicResource ModernTextBoxStyle}" Padding="12,10"
                                             FontSize="16" FontWeight="Bold" Foreground="#10B981" TextAlignment="Center"
                                             PreviewTextInput="DecimalBox_PreviewTextInput"
                                             PreviewKeyDown="DecimalBox_PreviewKeyDown"
                                             DataObject.Pasting="DecimalBox_Pasting"/>
                                    <TextBlock Text="{Binding PurchasePriceError}" Foreground="#EF4444" FontSize="12" Margin="0,4,0,0"
                                               Visibility="{Binding PurchasePriceError, Converter={StaticResource StringToVisConverter}}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="سعر البيع" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                    <TextBox Text="{Binding EditSalePrice, UpdateSourceTrigger=LostFocus}" 
                                             Style="{DynamicResource ModernTextBoxStyle}" Padding="12,10"
                                             FontSize="16" FontWeight="Black" Foreground="#2563EB" TextAlignment="Center"
                                             PreviewTextInput="DecimalBox_PreviewTextInput"
                                             PreviewKeyDown="DecimalBox_PreviewKeyDown"
                                             DataObject.Pasting="DecimalBox_Pasting"/>
                                    <TextBlock Text="{Binding SalePriceError}" Foreground="#EF4444" FontSize="12" Margin="0,4,0,0"
                                               Visibility="{Binding SalePriceError, Converter={StaticResource StringToVisConverter}}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Alert Qty -->
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="حد التنبيه (الكمية)" Foreground="#475569" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                <TextBox Text="{Binding EditAlertQty, UpdateSourceTrigger=LostFocus}" 
                                         Style="{DynamicResource ModernTextBoxStyle}" Padding="12,10"
                                         FontSize="14" FontWeight="Bold" TextAlignment="Center" Width="150" HorizontalAlignment="Right"
                                         PreviewTextInput="DecimalBox_PreviewTextInput"
                                         PreviewKeyDown="DecimalBox_PreviewKeyDown"
                                         DataObject.Pasting="DecimalBox_Pasting"/>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Flyout Footer -->
                    <Border Grid.Row="2" Background="#F8FAFC" Padding="24,20" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button Content="حفظ البيانات" Command="{Binding SaveProductCommand}" Click="ClosePopup_Click"
                                        Style="{DynamicResource ModernButtonStyle}" Background="#3B82F6" 
                                        Foreground="White" FontWeight="Bold" FontSize="14" Padding="24,12" Margin="0,0,10,0">
                                    <Button.Effect><DropShadowEffect Color="#3B82F6" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/></Button.Effect>
                                </Button>
                                <Button Content="تفـريـغ" Command="{Binding NewProductCommand}"
                                        Style="{DynamicResource ModernButtonStyle}" Background="#E2E8F0" 
                                        Foreground="#475569" FontWeight="Bold" FontSize="14" Padding="16,12"/>
                            </StackPanel>
                            
                            <Button Grid.Column="1" Content="تعطيل الصنف" Command="{Binding DeleteProductCommand}" Click="ClosePopup_Click"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#FEE2E2" 
                                    Foreground="#EF4444" FontWeight="Bold" FontSize="14" Padding="16,12"
                                    Visibility="{Binding IsEditingProduct, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ 7. PRODUCT CARD OVERLAY ═══ -->
        <Grid x:Name="ProductCardOverlay" Grid.RowSpan="5" Panel.ZIndex="100" Visibility="Collapsed">
            <Rectangle Fill="#800F172A"/> <!-- Dark Overlay -->
            <Border x:Name="ProductCardContainer" Background="Transparent" Margin="40"/>
        </Grid>

    </Grid>
</UserControl>
