<UserControl x:Class="Views.HREmployeesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:controls="clr-namespace:Vegtablity.Controls"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:HREmployeesViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F8FAFC" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header Banner -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="👥" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="شؤون الموظفين والملفات المخصصة" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="إدارة بيانات الموظفين، الحقول المخصصة العمودية (EAV)، ومتابعة الوثائق" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnToggleSidePanel" Content="◀ طي القائمة" Click="ToggleSidePanel_Click"
                            Style="{StaticResource ModernButtonStyle}" Background="#F1F5F9" Foreground="#334155"
                            Height="38" Padding="12,0" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="➕ موظف جديد" Command="{Binding NewEmployeeCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#4F46E5" Foreground="White"
                            Height="38" Padding="14,0" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="💾 حفظ الموظف" Command="{Binding SaveEmployeeCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White"
                            Height="38" Padding="14,0" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="🖨️ نموذج مباشرة عمل" Command="{Binding PrintCommencementCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#0EA5E9" Foreground="White"
                            Height="38" Padding="12,0" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="🗑️ حذف" Command="{Binding DeleteEmployeeCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#EF4444" Foreground="White"
                            Height="38" Padding="12,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Employees Directory with Animated Collapse/Expand -->
            <Border x:Name="SidePanelBorder" Grid.Column="0" Width="340" Background="White" CornerRadius="12" Padding="14" Margin="0,0,15,0" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Search Box -->
                    <TextBox Grid.Row="0" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                             Height="38" Padding="10,0" FontSize="13" VerticalContentAlignment="Center"
                             Style="{DynamicResource ModernTextBoxStyle}"
                             helpers:WatermarkHelper.Watermark="🔍 ابحث بالاسم أو الكود..."
                             Margin="0,0,0,10"/>

                    <!-- Department & Status Filter -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding DepartmentsList}"
                                  SelectedItem="{Binding SelectedDepartment}"
                                  Height="32" FontSize="12" Margin="0,0,4,0"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding StatusList}"
                                  SelectedItem="{Binding SelectedStatusFilter}"
                                  Height="32" FontSize="12" Margin="4,0,0,0"/>
                    </Grid>

                    <!-- Employees List -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding FullName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding JobTitle, StringFormat='{}الوظيفة: {0}'}" FontSize="11.5" Foreground="#64748B" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Department, StringFormat='{}القسم: {0}'}" FontSize="11" Foreground="#94A3B8"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Border Background="#E0E7FF" CornerRadius="6" Padding="6,2" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding EmployeeCode}" FontSize="11" FontWeight="Bold" Foreground="#3730A3"/>
                                            </Border>
                                            <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Right" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Pagination Footer -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="4,8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="◀ السابق" Command="{Binding PreviousPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155"
                                    FontSize="11" FontWeight="SemiBold" Height="28" Padding="8,0" Cursor="Hand"/>
                            <TextBlock Grid.Column="1" Text="{Binding PageInfo}"
                                       FontSize="11" FontWeight="Bold" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="التالي ▶" Command="{Binding NextPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155"
                                    FontSize="11" FontWeight="SemiBold" Height="28" Padding="8,0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Employee Profile Details & Custom Fields Tabs -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <TabControl BorderThickness="0" Background="Transparent">
                    <!-- Tab 1: Basic Information -->
                    <TabItem Header="👤 البيانات الأساسية والتعاقدية" FontSize="13" FontWeight="Bold" Padding="12,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                            <StackPanel DataContext="{Binding EditEmployee}">
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="150"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,15,0">
                                        <TextBlock Text="اسم الموظف الكامل *" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="كود / رقم الموظف *" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding EmployeeCode, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="الرقم الوطني / القومي" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding NationalID, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="الرقم المدني" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding CivilID, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="رقم جواز السفر" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding PassportNumber, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="المسمى الوظيفي" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding JobTitle, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="القسم / الإدارة" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding Department, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="الجنسية" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding Nationality, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="تاريخ التعيين / الالتحاق *" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <controls:DateBoxControl SelectedDate="{Binding HireDate, Mode=TwoWay}" Height="38" FontSize="13"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                        <TextBlock Text="نوع العقد" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding ContractType, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="حالة الموظف" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <ComboBox SelectedValue="{Binding Status, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Content" Height="38" FontSize="13" VerticalContentAlignment="Center">
                                            <ComboBoxItem Content="Active"/>
                                            <ComboBoxItem Content="OnLeave"/>
                                            <ComboBoxItem Content="Resigned"/>
                                            <ComboBoxItem Content="Terminated"/>
                                        </ComboBox>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Margin="0,0,0,15">
                                    <TextBlock Text="ملاحظات وبيانات إضافية" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="65" TextWrapping="Wrap" AcceptsReturn="True" FontSize="13" Padding="8"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 2: Salary & Financial Details -->
                    <TabItem Header="💵 الراتب والبدلات والحساب البنكي" FontSize="13" FontWeight="Bold" Padding="12,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                            <StackPanel DataContext="{Binding EditEmployee}">
                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="الراتب الأساسي *" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding BasicSalary, UpdateSourceTrigger=LostFocus}"
                                                 Height="38" FontSize="14" FontWeight="Bold" Foreground="#1E293B"
                                                 VerticalContentAlignment="Center" Padding="8,0"
                                                 Style="{DynamicResource ModernTextBoxStyle}"
                                                 helpers:WatermarkHelper.Watermark="0.00"
                                                 GotFocus="DecimalBox_GotFocus"
                                                 LostFocus="DecimalBox_LostFocus"
                                                 PreviewTextInput="DecimalBox_PreviewTextInput"
                                                 PreviewKeyDown="DecimalBox_PreviewKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="بدل السكن" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding HousingAllowance, UpdateSourceTrigger=LostFocus}"
                                                 Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="8,0"
                                                 Style="{DynamicResource ModernTextBoxStyle}"
                                                 helpers:WatermarkHelper.Watermark="0.00"
                                                 GotFocus="DecimalBox_GotFocus"
                                                 LostFocus="DecimalBox_LostFocus"
                                                 PreviewTextInput="DecimalBox_PreviewTextInput"
                                                 PreviewKeyDown="DecimalBox_PreviewKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="بدل الانتقال / المواصلات" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding TransportAllowance, UpdateSourceTrigger=LostFocus}"
                                                 Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="8,0"
                                                 Style="{DynamicResource ModernTextBoxStyle}"
                                                 helpers:WatermarkHelper.Watermark="0.00"
                                                 GotFocus="DecimalBox_GotFocus"
                                                 LostFocus="DecimalBox_LostFocus"
                                                 PreviewTextInput="DecimalBox_PreviewTextInput"
                                                 PreviewKeyDown="DecimalBox_PreviewKeyDown"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="بدلات أخرى" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding OtherAllowances, UpdateSourceTrigger=LostFocus}"
                                                 Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="8,0"
                                                 Style="{DynamicResource ModernTextBoxStyle}"
                                                 helpers:WatermarkHelper.Watermark="0.00"
                                                 GotFocus="DecimalBox_GotFocus"
                                                 LostFocus="DecimalBox_LostFocus"
                                                 PreviewTextInput="DecimalBox_PreviewTextInput"
                                                 PreviewKeyDown="DecimalBox_PreviewKeyDown"/>
                                    </StackPanel>
                                </Grid>

                                <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,15">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="إجمالي الراتب الشامل المستحق:" FontSize="14" FontWeight="Bold" Foreground="#065F46" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalSalary, StringFormat={}{0:N3} د.أ}" FontSize="18" FontWeight="ExtraBold" Foreground="#047857" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Grid Margin="0,0,0,15">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock Text="اسم البنك المحول إليه" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding BankName, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"
                                                 Style="{DynamicResource ModernTextBoxStyle}"
                                                 helpers:WatermarkHelper.Watermark="مثال: البنك العربي"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="رقم الحساب الدولي (IBAN)" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                                        <TextBox Text="{Binding IBAN, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="38" FontSize="13" VerticalContentAlignment="Center" Padding="8,0"
                                                 Style="{DynamicResource ModernTextBoxStyle}"
                                                 helpers:WatermarkHelper.Watermark="مثال: JO00AAAA0000000000000000000000"
                                                 LostFocus="IBANBox_LostFocus"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- Tab 3: Dynamic Custom Fields & Document Alerts -->
                    <TabItem Header="🧩 الحقول المخصصة والتنبيهات (EAV)" FontSize="13" FontWeight="Bold" Padding="12,6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,15,0,0">
                            <StackPanel>
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,15">
                                    <TextBlock Text="💡 يتم حفظ هذه الحقول عمودياً في جدول [HR].[EmployeeCustomValues] ويمكن للمستخدم إضافة وتعديل أي خصائص إضافية مع تفعيل التنبيهات المسبقة في شاشة إعدادات الموارد."
                                               FontSize="12" Foreground="#1E40AF" TextWrapping="Wrap"/>
                                </Border>
                                
                                <controls:DynamicFieldEditorControl DataContext="{Binding EditEmployee}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <!-- Modern Floating Snackbar Notification -->
        <Border x:Name="SnackbarBorder" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                Background="#0F172A" CornerRadius="12" Padding="20,12" Margin="0,0,0,30" 
                Visibility="Collapsed" Panel.ZIndex="500" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SnackbarIcon" Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText" Text="تمت العملية بنجاح" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
