<UserControl x:Class="Views.RecipePage" x:Name="root"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
       xmlns:local="clr-namespace:Vegtablity.Views"
       xmlns:vm="clr-namespace:Vegtablity.ViewModels"
       xmlns:controls="clr-namespace:Vegtablity.Controls"
       xmlns:helpers="clr-namespace:Vegtablity.Helpers"
       mc:Ignorable="d" 
       d:DesignHeight="700" d:DesignWidth="1150"
       FlowDirection="RightToLeft" Background="#F8FAFC"
       FontFamily="Cairo">

    <UserControl.DataContext>
        <vm:RecipeViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVis"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="15" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="12" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ☰ Hamburger toggle -->
                <Button x:Name="BtnToggleSidebar" Grid.Column="0"
                        Content="☰" FontSize="20" Width="40" Height="40"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#334155" Cursor="Hand"
                        VerticalAlignment="Center" Margin="0,0,10,0"
                        ToolTip="إظهار / إخفاء قائمة الوصفات"
                        Click="BtnToggleSidebar_Click"/>

                <StackPanel Grid.Column="1" Orientation="Vertical">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📜 " FontSize="22" VerticalAlignment="Center"/>
                        <TextBlock Text="إدارة وصفات ومكونات المنتجات (Recipes)" FontSize="20" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="تحديد مكونات المنتجات المصنعة والوسيطة وحساب التكلفة الدقيقة تلقائياً للمخزون" Foreground="#64748B" FontSize="13" Margin="30,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="جديد ✨" Command="{Binding NewRecipeCommand}" Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="تصدير PDF 📄" Click="BtnExportPdf_Click" Style="{StaticResource ModernButtonStyle}" Background="#DC2626" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="0,0,8,0" Cursor="Hand" ToolTip="تصدير تفاصيل الوصفة إلى ملف PDF"/>
                    <Button Content="تصدير Excel 📊" Click="BtnExportExcel_Click" Style="{StaticResource ModernButtonStyle}" Background="#16A34A" Foreground="White" FontWeight="Bold" Padding="15,8" Margin="0,0,8,0" Cursor="Hand" ToolTip="تصدير تفاصيل الوصفة إلى ملف Excel"/>
                    <Button Content="حذف الوصفة 🗑️" Command="{Binding DeleteRecipeCommand}" Style="{StaticResource ModernButtonStyle}" Background="#EF4444" Foreground="White" FontWeight="Bold" Padding="15,8" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content (2 Columns: Left = Recipe List, Right = Recipe Editor) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto" MinWidth="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar: Existing Recipes List with Collapsible Filter -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="White" CornerRadius="10" Padding="12" Margin="0,0,15,0" ClipToBounds="True" MaxWidth="350" MinWidth="0">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header (Title, Count & Filter Toggle) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜 الوصفات المسجلة" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                            <Border Background="#E0E7FF" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding FilteredRecipes.Count}" FontSize="12" FontWeight="Bold" Foreground="#3730A3"/>
                            </Border>
                        </StackPanel>

                        <!-- Filter Toggle Button -->
                        <Button x:Name="BtnToggleFilter" Grid.Column="1"
                                Content="🔍 تصفية ▼"
                                Style="{StaticResource ModernButtonStyle}"
                                FontSize="12" FontWeight="SemiBold"
                                Background="#F1F5F9" Foreground="#475569"
                                BorderThickness="0"
                                Padding="8,4" Cursor="Hand"
                                Click="BtnToggleFilter_Click"
                                ToolTip="إظهار / إخفاء أدوات التصفية والبحث"/>
                    </Grid>

                    <!-- Collapsible Filter Card -->
                    <Border x:Name="FilterCardBorder" Grid.Row="1"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Search by Product Name -->
                            <TextBlock Text="بحث باسم الصنف:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtFilterName"
                                     Text="{Binding RecipeSearchName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" Padding="8,0" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     helpers:WatermarkHelper.Watermark="أدخل اسم الصنف..."
                                     Margin="0,0,0,6"/>

                            <!-- Search by Barcode -->
                            <TextBlock Text="بحث بالباركود:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtFilterBarcode"
                                     Text="{Binding RecipeSearchBarcode, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" Padding="8,0" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     helpers:WatermarkHelper.Watermark="أدخل الباركود..."
                                     Margin="0,0,0,8"/>

                            <!-- Clear Filter Button -->
                            <Button Content="تفريغ التصفية 🔄"
                                    Command="{Binding ClearRecipeFilterCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Height="28" FontSize="11" FontWeight="SemiBold"
                                    Background="#E2E8F0" Foreground="#334155"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- Recipes ListBox -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredRecipes}" SelectedItem="{Binding SelectedRecipe}"
                             BorderThickness="0" Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="10" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding ProductName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding IngredientsCount, StringFormat=المكونات: {0}}" FontSize="11" Foreground="#64748B"/>
                                                <TextBlock Text="{Binding Barcode, StringFormat=' | كود: {0}'}" FontSize="11" Foreground="#94A3B8"
                                                           Visibility="{Binding Barcode, Converter={StaticResource StringToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
                                            <TextBlock Text="{Binding TotalCost, StringFormat={}{0:N2}}" FontWeight="Bold" Foreground="#16A34A" FontSize="13"/>
                                            <TextBlock Text="{Binding DataContext.CurrencySymbol, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat=' {0}'}" FontWeight="Bold" Foreground="#16A34A" FontSize="13"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Pagination Footer (10 records per page) -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="4,8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Previous Button -->
                            <Button Grid.Column="0" Content="◀ السابق"
                                    Command="{Binding PreviousPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="#E2E8F0" Foreground="#334155"
                                    FontSize="11" FontWeight="SemiBold"
                                    Height="28" Padding="8,0" Cursor="Hand"/>
                            <!-- Page Info -->
                            <TextBlock Grid.Column="1" Text="{Binding PageInfo}"
                                       FontSize="11" FontWeight="Bold" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Next Button -->
                            <Button Grid.Column="2" Content="التالي ▶"
                                    Command="{Binding NextPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="#E2E8F0" Foreground="#334155"
                                    FontSize="11" FontWeight="SemiBold"
                                    Height="28" Padding="8,0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Editor: Recipe Header & Custom Ingredients Rows Control -->
            <Border Grid.Column="1" Background="White" CornerRadius="10" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Product Selection, Warehouse, Notes Header + Add Row Button -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*"/>
                            <ColumnDefinition Width="1.1*"/>
                            <ColumnDefinition Width="1.5*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 0: Manufactured Product -->
                        <StackPanel Grid.Column="0" Margin="0,0,15,0">
                            <TextBlock Text="المنتج المراد تحديد وصفته *" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                            <controls:SearchableDropdown
                                x:Name="ProductTargetDropdown"
                                ItemsSource="{Binding FilteredManufacturedProducts}"
                                DisplayMemberPath="ProductName"
                                Watermark="ابحث بالاسم أو الباركود..."
                                Height="38"
                                SearchChanged="ProductTargetDropdown_SearchChanged"
                                ItemSelected="ProductTargetDropdown_ItemSelected"/>
                        </StackPanel>

                        <!-- Col 1: Warehouse -->
                        <StackPanel Grid.Column="1" Margin="0,0,15,0">
                            <TextBlock Text="المستودع *" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Warehouses}"
                                      SelectedValuePath="WarehouseID"
                                      DisplayMemberPath="WarehouseName"
                                      SelectedValue="{Binding SelectedWarehouseID, UpdateSourceTrigger=PropertyChanged}"
                                      Height="38" FontSize="14" VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Col 2: Notes -->
                        <StackPanel Grid.Column="2" Margin="0,0,15,0">
                            <TextBlock Text="ملاحظات التحضير والوصفة" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" Height="38" FontSize="14" VerticalContentAlignment="Center" Padding="8,0"/>
                        </StackPanel>

                        <!-- Col 3: Add Row Button -->
                        <Button Grid.Column="3" VerticalAlignment="Bottom"
                                Content="➕ إضافة صف جديد"
                                Command="{Binding AddIngredientCommand}"
                                Click="AddRowButton_Click"
                                Style="{StaticResource ModernButtonStyle}"
                                Background="#16A34A" Foreground="White" FontWeight="Bold"
                                Height="38" Padding="16,0" Cursor="Hand"/>
                    </Grid>

                    <!-- Table Column Headers -->
                    <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8,8,0,0" Padding="8,10" BorderBrush="#E2E8F0" BorderThickness="1,1,1,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <!-- 0: Barcode -->
                                <ColumnDefinition Width="140"/>
                                <!-- 1: Product SearchableDropdown (Expanding) -->
                                <ColumnDefinition Width="*"/>
                                <!-- 2: Unit Name -->
                                <ColumnDefinition Width="90"/>
                                <!-- 3: Quantity -->
                                <ColumnDefinition Width="100"/>
                                <!-- 4: Unit Cost -->
                                <ColumnDefinition Width="110"/>
                                <!-- 5: Total Cost -->
                                <ColumnDefinition Width="120"/>
                                <!-- 6: Delete Action -->
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="كود الصنف / الباركود" FontWeight="Bold" Foreground="#334155" Margin="5,0"/>
                            <TextBlock Grid.Column="1" Text="المادة الخام / المكون" FontWeight="Bold" Foreground="#334155" Margin="5,0"/>
                            <TextBlock Grid.Column="2" Text="الوحدة" FontWeight="Bold" Foreground="#334155" TextAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="الكمية" FontWeight="Bold" Foreground="#334155" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="سعر تكلفة الوحدة" FontWeight="Bold" Foreground="#0284C7" TextAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="إجمالي التكلفة" FontWeight="Bold" Foreground="#16A34A" TextAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="حذف" FontWeight="Bold" Foreground="#EF4444" TextAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Ingredients Rows ItemsControl -->
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" MinHeight="250">
                            <ItemsControl x:Name="DetailsItemsControl" ItemsSource="{Binding CurrentRecipeDetails}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:RecipeItemRowControl
                                            ProductsList="{Binding DataContext.RawMaterialProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            RequestAddNewRow="RecipeItemRow_RequestAddNewRow"
                                            RequestDeleteRow="RecipeItemRow_RequestDeleteRow"
                                            AmountChanged="RecipeItemRow_AmountChanged"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Total & Save Footer -->
                    <Grid Grid.Row="3" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="التكلفة الإجمالية للوصفة: " FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                            <TextBlock Text="{Binding TotalRecipeCost, StringFormat={}{0:N2}}" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/>
                            <TextBlock Text="{Binding CurrencySymbol, StringFormat=' {0}'}" FontSize="18" FontWeight="Bold" Foreground="#16A34A"/>
                        </StackPanel>

                        <Button Grid.Column="1" Content="حفظ الوصفة وتحديث المخزون 💾" Command="{Binding SaveRecipeCommand}" Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Foreground="White" FontSize="15" FontWeight="Bold" Padding="25,10" Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Snackbar Notification -->
        <Border x:Name="SnackbarBorder"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#1E293B" CornerRadius="12"
                Padding="20,12" Margin="0,0,0,30"
                Visibility="Collapsed" Panel.ZIndex="105"
                MinWidth="250">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText"
                           Text="تم حفظ الوصفة بنجاح"
                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
