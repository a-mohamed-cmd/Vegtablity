<Window x:Class="Views.UpdateAvailableDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="تحديث جديد متوفر للنظام" 
        Height="420" Width="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        FlowDirection="RightToLeft">

    <Border Background="#1E293B" CornerRadius="16" BorderBrush="#38BDF8" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#0284C7" Opacity="0.4"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#0EA5E9" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0">
                    <TextBlock Text="🚀" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="تحديث جديد متوفر للنظام" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtVersionInfo" Text="الإصدار الحالي: 2.3.0  ←  الإصدار الجديد: 2.4.0" FontSize="13" Foreground="#94A3B8" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Subtitle -->
            <TextBlock Grid.Row="1" Text="ملاحظات وتفاصيل التحديث الجديد:" FontSize="13" FontWeight="SemiBold" Foreground="#38BDF8" Margin="0,16,0,8"/>

            <!-- Release notes -->
            <Border Grid.Row="2" Background="#0F172A" CornerRadius="10" Padding="12" BorderBrush="#334155" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtReleaseNotes" Text="• تحسينات شاملة في الأداء..." FontSize="13" Foreground="#E2E8F0" TextWrapping="Wrap" LineHeight="20"/>
                </ScrollViewer>
            </Border>

            <!-- Progress Bar Section -->
            <StackPanel x:Name="PnlProgress" Grid.Row="3" Margin="0,14,0,0" Visibility="Collapsed">
                <Grid Margin="0,0,0,4">
                    <TextBlock Text="جاري تنزيل التحديث والتثبيت..." FontSize="12" Foreground="#94A3B8"/>
                    <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="12" FontWeight="Bold" Foreground="#38BDF8" HorizontalAlignment="Left"/>
                </Grid>
                <ProgressBar x:Name="PrgDownload" Height="10" Background="#334155" Foreground="#0EA5E9" BorderThickness="0">
                    <ProgressBar.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="5"/>
                        </Style>
                    </ProgressBar.Resources>
                </ProgressBar>
            </StackPanel>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,18,0,0">
                <Button x:Name="BtnUpdateNow" Content="تحديث الآن ⚡" Width="140" Height="40" Background="#0284C7" Foreground="White" FontWeight="Bold" FontSize="14" Cursor="Hand" Click="BtnUpdateNow_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="BtnLater" Content="لاحقاً" Width="100" Height="40" Margin="12,0,0,0" Background="#334155" Foreground="#CBD5E1" FontWeight="SemiBold" FontSize="13" Cursor="Hand" Click="BtnLater_Click">
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
