<UserControl x:Class="Views.QuotePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Vegtablity"
      xmlns:viewmodels="clr-namespace:Vegtablity.ViewModels"
      xmlns:helpers="clr-namespace:Vegtablity.Helpers"
      xmlns:controls="clr-namespace:Vegtablity.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1050"
      FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <viewmodels:QuoteViewModel />
    </UserControl.DataContext>

    <!-- Resources -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:IdToVisibilityConverter x:Key="IdToVisibilityConverter"/>

        <!-- Hover Scale Animation for Cards -->
        <Style x:Key="AnimatedCardStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.005" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.005" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Initial Load Entrance Animations -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeaderCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.05"/>
                    <ThicknessAnimation Storyboard.TargetName="HeaderCard" Storyboard.TargetProperty="Margin" From="20,40,20,-10" To="20,20,20,10" Duration="0:0:0.4" BeginTime="0:0:0.05">
                        <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>

                    <DoubleAnimation Storyboard.TargetName="DetailsCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.15"/>
                    <ThicknessAnimation Storyboard.TargetName="DetailsCard" Storyboard.TargetProperty="Margin" From="20,30,20,0" To="20,10,20,20" Duration="0:0:0.4" BeginTime="0:0:0.15">
                        <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Background="#F5F7FA" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Title Bar -->
                    <RowDefinition Height="Auto"/>
                    <!-- Header Controls -->
                    <RowDefinition Height="*"/>
                    <!-- DataGrid for Details -->
                </Grid.RowDefinitions>

                <!-- 1. Title/ToolBar -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1" Padding="20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="عروض الأسعار" FontSize="26" FontWeight="SemiBold" Foreground="#1E293B"/>
                            
                            <!-- Activeness Badge -->
                            <Border Margin="15,0,0,0" Padding="10,5" CornerRadius="12" Background="#DCFCE7" VerticalAlignment="Center"
                                    Visibility="{Binding CurrentQuote.IsActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="✔ عرض فعال" Foreground="#166534" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📜 سجل العروض" Command="{Binding LoadHistoryCommand}" Click="HistoryButton_Click"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#6366F1" Margin="0,0,10,0"/>

                            <Button Content="➕ عرض جديد" Command="{Binding NewCommand}"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#3B82F6" Margin="0,0,10,0"
                                    Visibility="{Binding CurrentPermissions.CanAdd, Converter={StaticResource BoolToVis}}"/>

                            <Button Content="💾 حـفـظ واعتماد" Command="{Binding SaveCommand}"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#10B981" Margin="0,0,10,0"
                                    Visibility="{Binding CurrentPermissions.CanEdit, Converter={StaticResource BoolToVis}}"/>

                            <!-- Export Buttons (CanPrint) -->
                            <Button Content="📊 تصدير CSV" Command="{Binding ExportCsvCommand}"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#D97706" Margin="0,0,6,0"
                                    Visibility="{Binding CurrentPermissions.CanPrint, Converter={StaticResource BoolToVis}}"/>

                            <Button Content="📄 تصدير PDF" Command="{Binding ExportPdfCommand}"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#DC2626" Margin="0,0,10,0"
                                    Visibility="{Binding CurrentPermissions.CanPrint, Converter={StaticResource BoolToVis}}"/>

                            <!-- Excel Import Buttons (CanAdd) -->
                            <Button Content="📥" Command="{Binding DownloadTemplateCommand}"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#64748B" Margin="0,0,6,0"
                                    Visibility="{Binding CurrentPermissions.CanAdd, Converter={StaticResource BoolToVis}}"
                                    ToolTip="تحميل قالب Excel فارغ للملء واستيراده لاحقاً"/>

                            <Button Content="📂" Command="{Binding ImportFromExcelCommand}"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#7C3AED"
                                    Visibility="{Binding CurrentPermissions.CanAdd, Converter={StaticResource BoolToVis}}"
                                    ToolTip="استيراد ملف Excel يحتوي على أصناف عرض السعر"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Header Fields -->
                <Border x:Name="HeaderCard" Opacity="0" Style="{StaticResource AnimatedCardStyle}" Grid.Row="1" Background="White" Margin="20,20,20,10" CornerRadius="10" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Date -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="تاريخ العرض *" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtQuoteDate" Text="{Binding QuoteDateText, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     GotFocus="TextBox_GotFocus"
                                     LostFocus="QuoteDate_LostFocus" PreviewKeyDown="Date_PreviewKeyDown"
                                     helpers:WatermarkHelper.Watermark="يوم/شهر/سنة"/>
                        </StackPanel>

                        <!-- Customer -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="العميل / المورد الموجه له السعر *" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <controls:SearchableDropdown
                                  x:Name="PartnerDropdown"
                                  ItemsSource="{Binding FilteredPartners}"
                                  DisplayMemberPath="SearchText"
                                  Watermark="ابحث باسم العميل أو المورد..."
                                  Height="40"
                                  SearchChanged="PartnerDropdown_SearchChanged"
                                  ItemSelected="PartnerDropdown_ItemSelected"
                                  ConfirmedAndMoveNext="PartnerDropdown_MoveNext"/>
                        </StackPanel>

                        <!-- Expiry Date -->
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="صالح حتى (تاريخ انتهاء)" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox x:Name="TxtExpiryDate" Text="{Binding ExpiryDateText, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     GotFocus="TextBox_GotFocus"
                                     LostFocus="ExpiryDate_LostFocus" PreviewKeyDown="Date_PreviewKeyDown"
                                     helpers:WatermarkHelper.Watermark="يوم/شهر/سنة"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="6" VerticalAlignment="Center">
                             <CheckBox Content="تفعيل عرض السعر" IsChecked="{Binding CurrentQuote.IsActive}" FontWeight="Bold" Foreground="#0F172A" Margin="0,20,0,0"/>
                        </StackPanel>

                        <!-- Notes -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7">
                            <TextBlock Text="ملاحظات" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding CurrentQuote.Notes, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource ModernTextBoxStyle}" Height="40" MaxLength="250"/>
                        </StackPanel>

                    </Grid>
                </Border>

                <!-- 3. Invoice Details Grid -->
                <Border x:Name="DetailsCard" Opacity="0" Grid.Row="2" Background="White" Margin="20,10,20,20" CornerRadius="10" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="الأصناف المدرجة والأسعار" FontSize="18" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding DetailsTotalCount, StringFormat='(إجمالي الأصناف: {0})'}" FontSize="14" Foreground="#94A3B8" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            
                            <Button Content="➕ إضافة صنف" Command="{Binding AddItemCommand}"
                                    Style="{DynamicResource ModernButtonStyle}"
                                    Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#4F46E5" 
                                    Margin="20,0,0,0" Padding="15,5"/>
                        </StackPanel>
                        <!-- The DataGrid -->
                        <DataGrid x:Name="dgQuoteDetails" Grid.Row="1" ItemsSource="{Binding CurrentQuote.Details}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" SelectionMode="Single"
                                  MinHeight="300" RowHeight="35">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EEF2FF"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#C7D2FE"/>
                                            <Setter Property="BorderThickness" Value="0,1"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFF"/>
                                        </Trigger>
                                        <!-- Unmatched (imported from Excel but not found in DB) -->
                                        <DataTrigger Binding="{Binding IsUnmatched}" Value="True">
                                            <Setter Property="Background" Value="#FEE2E2"/>
                                            <Setter Property="Foreground" Value="#991B1B"/>
                                            <Setter Property="ToolTip" Value="⚠️ هذا الصنف غير معروف — يرجى حذفه أو تصحيح الكود"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.CellStyle>
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="Transparent"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="Transparent"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.CellStyle>
                            <DataGrid.Columns>
                                
                                <!-- Product Code - Editable to search by barcode on Enter -->
                                <DataGridTemplateColumn Header="كود الصنف" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                                                     KeyDown="BarcodeCell_KeyDown"
                                                     BorderThickness="0" Background="Transparent"
                                                     Foreground="#64748B" VerticalContentAlignment="Center"
                                                     Padding="5,0"
                                                     ToolTip="اكتب الكود ثم اضغط Enter للبحث عن الصنف"/>                                            
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Product Selection -->
                                <DataGridTemplateColumn Header="اختيار الصنف" Width="3*" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding ProductID, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="ProductID" DisplayMemberPath="SearchText"
                                                      TextSearch.TextPath="SearchText"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="False"
                                                      StaysOpenOnEdit="True"
                                                      KeyUp="ProductComboBox_KeyUp"
                                                      PreviewKeyDown="ProductComboBox_PreviewKeyDown"
                                                      DropDownOpened="ProductComboBox_DropDownOpened"
                                                      DropDownClosed="ProductComboBox_DropDownClosed"
                                                      LostFocus="ProductComboBox_LostFocus"
                                                      BorderThickness="0" Background="Transparent" Padding="5,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Fallback Product Name (Read-Only) -->
                                <DataGridTextColumn Header="اسم الصنف (تأكيدي)" Binding="{Binding ProductName}" Width="2*" IsReadOnly="True" Foreground="#334155"/>

                                <!-- Unit Name -->
                                <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName, Mode=OneWay}" Width="1*" IsReadOnly="True" Foreground="#64748B"/>

                                <!-- Quoted Price -->
                                <DataGridTemplateColumn Header="سعر العرض المخصص" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding QuotedPrice, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}" 
                                                     PreviewKeyDown="Price_PreviewKeyDown"
                                                     GotFocus="TextBox_GotFocus"
                                                     BorderThickness="0" Background="#EEF2FF" Foreground="#4F46E5" TextAlignment="Center" FontWeight="Bold"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Delete Row Command -->
                                <DataGridTemplateColumn Header="حذف" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent" BorderThickness="0" 
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    ToolTip="حذف السطر">
                                                <TextBlock Text="🗑️" Foreground="#EF4444" FontSize="16"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Quotation Details Pagination (Bottom Bar) -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,1,1,1" CornerRadius="0,0,12,12" Padding="15,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="→ الصفحة السابقة" Command="{Binding PrevDetailsPageCommand}" IsEnabled="{Binding CanGoPrevDetails}"
                                        Style="{StaticResource ModernButtonStyle}" Background="#94A3B8" Padding="15,5"/>
                                <TextBlock Grid.Column="1" Text="{Binding DetailsPageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
                                <Button Grid.Column="2" Content="الصفحة التالية ←" Command="{Binding NextDetailsPageCommand}" IsEnabled="{Binding CanGoNextDetails}"
                                        Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Padding="15,5"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Snackbar Notification -->
        <Border x:Name="SnackbarBorder"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#1E293B" CornerRadius="12"
                Padding="20,12" Margin="0,0,0,30"
                Visibility="Collapsed" Panel.ZIndex="99"
                MinWidth="250">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText"
                           Text="تم حفظ العرض بنجاح"
                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- History Modal Overlay -->
        <Grid x:Name="HistoryModal" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="White" CornerRadius="12" Margin="80" Padding="25" MaxWidth="900" 
                    VerticalAlignment="Center" HorizontalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Opacity="0.4" Color="Black"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <!-- Header -->
                        <RowDefinition Height="Auto"/>
                        <!-- Search Bar -->
                        <RowDefinition Height="*"/>
                        <!-- Grid -->
                        <RowDefinition Height="Auto"/>
                        <!-- Footer/Pagination -->
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock Text="سجل عروض الأسعار" FontSize="22" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Left" Click="CloseHistoryButton_Click" Background="Transparent" BorderThickness="0" Padding="5">
                            <TextBlock Text="✕" FontSize="20" Foreground="#64748B"/>
                        </Button>
                    </Grid>

                    <!-- Search Bar in History -->
                    <Border Grid.Row="1" Background="#F8FAFC" CornerRadius="8" Padding="15,10" Margin="0,0,0,15" BorderBrush="#E2E8F0" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="🔍" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <TextBox Grid.Column="1" Text="{Binding HistorySearch, UpdateSourceTrigger=PropertyChanged}" 
                                     Style="{DynamicResource ModernTextBoxStyle}" BorderThickness="0" Background="Transparent"
                                     helpers:WatermarkHelper.Watermark="ابحث برقم العرض، اسم العميل، أو الملاحظات..." />
                        </Grid>
                    </Border>

                    <DataGrid x:Name="dgHistory" Grid.Row="2" ItemsSource="{Binding QuotesHistory}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" IsReadOnly="True" RowHeight="40"
                              SelectionMode="Single" BorderThickness="1" BorderBrush="#E2E8F0"
                              Background="White" helpers:DataGridHelper.AutoScroll="True">
                        <DataGrid.Triggers>
                            <!-- Potential for paged animations if using a behavior, but let's stick to styling for now -->
                        </DataGrid.Triggers>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم العرض" Binding="{Binding QuoteID}" Width="80"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding PartnerName}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding QuoteDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                            <DataGridTextColumn Header="صلاحية السعر" Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}" Width="110"/>
                            <DataGridTemplateColumn Header="الحالة" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="6,2" CornerRadius="10" Background="{Binding IsActiveColor}" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding IsActiveText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="إجراء" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="تعديل ✎" Command="{Binding DataContext.EditQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Style="{DynamicResource ModernButtonStyle}" Background="#EEF2FF" Foreground="#4F46E5" Padding="8,2" Click="EditFromHistory_Click"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Modern Pagination Controls -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E1E7EF" BorderThickness="0,1,0,0" Padding="15,10" CornerRadius="0,0,12,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="→ الصفحة السابقة" Command="{Binding PrevHistoryPageCommand}" IsEnabled="{Binding CanGoPrevHistory}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#94A3B8" Padding="15,5"/>
                            <TextBlock Grid.Column="1" Text="{Binding HistoryPageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
                            <Button Grid.Column="2" Content="الصفحة التالية ←" Command="{Binding NextHistoryPageCommand}" IsEnabled="{Binding CanGoNextHistory}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Padding="15,5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
