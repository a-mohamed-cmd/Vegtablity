<UserControl x:Class="Views.ProfitLossPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers">

    <UserControl.Resources>
        <helpers:AccountingAmountConverter x:Key="AccountConverter"/>
        
        <ControlTemplate x:Key="ReportSectionHeader">
            <Border Background="#f8f9fa" Padding="10,5" CornerRadius="5" Margin="0,15,0,5">
                <ContentPresenter/>
            </Border>
        </ControlTemplate>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:ProfitLossViewModel/>
    </UserControl.DataContext>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="MainGrid" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8"/>
                    <DoubleAnimation Storyboard.TargetName="MainGrid" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.5"/>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid x:Name="MainGrid" Margin="15">
        <Grid.RenderTransform>
            <TranslateTransform Y="20"/>
        </Grid.RenderTransform>
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12" Background="#f8f9fa" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#dcdde1" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📉 قائمة الأرباح والخسائر" FontSize="20" FontWeight="Bold" Foreground="#2c3e50" VerticalAlignment="Center"/>
                
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="📄 PDF" Command="{Binding ExportPdfCommand}" Style="{StaticResource ModernButtonStyle}" Background="#e74c3c" Width="90" Margin="5,0"/>
                    <Button Content="csv" Command="{Binding ExportCsvCommand}" Style="{StaticResource ModernButtonStyle}" Background="#27ae60" Width="90" Margin="5,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters -->
        <Border Grid.Row="1" Padding="15" Background="White" CornerRadius="10" Margin="0,0,0,10" BorderBrush="#eee" BorderThickness="1">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                    <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="StartDate_LostFocus" PreviewKeyDown="Date_PreviewKeyDown"
                             GotFocus="Date_GotFocus"
                             Width="110"
                             ToolTip="أدخل التاريخ: dd/MM/yyyy أو ddMMyyyy"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                    <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBox Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="EndDate_LostFocus" PreviewKeyDown="Date_PreviewKeyDown"
                             GotFocus="Date_GotFocus"
                             Width="110"
                             ToolTip="أدخل التاريخ: dd/MM/yyyy أو ddMMyyyy"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                    <TextBlock Text="المستوى:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <ComboBox ItemsSource="{Binding AvailableLevels}" 
                              SelectedValue="{Binding SelectedLevel}" 
                              SelectedValuePath="Value" DisplayMemberPath="Key" Width="160"/>
                </StackPanel>
                
                <Button Content="🔍 عرض التقرير" Command="{Binding SearchCommand}" Style="{StaticResource ModernButtonStyle}" Width="120" Height="32" Margin="0,0,20,5"/>
            </WrapPanel>
        </Border>

        <!-- Report Content -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="5">
                
                <!-- Revenues Section -->
                <ContentControl Template="{StaticResource ReportSectionHeader}">
                    <TextBlock Text="الإيرادات" FontWeight="Bold" Foreground="#2980b9" FontSize="16"/>
                </ContentControl>
                <DataGrid ItemsSource="{Binding RevenueItems}" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الكود" Binding="{Binding AccountCode}" Width="100"/>
                        <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountName}" Width="*"/>
                        <DataGridTemplateColumn Header="المبلغ" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Balance, Converter={StaticResource AccountConverter}}" TextAlignment="Right" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border BorderBrush="#eee" BorderThickness="0,1,0,0" Margin="0,5">
                    <Grid Margin="10">
                        <TextBlock Text="إجمالي الإيرادات" FontWeight="Bold" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding TotalRevenues, Converter={StaticResource AccountConverter}}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#27ae60"/>
                    </Grid>
                </Border>

                <!-- Expenses Section -->
                <ContentControl Template="{StaticResource ReportSectionHeader}">
                    <TextBlock Text="المصروفات" FontWeight="Bold" Foreground="#c0392b" FontSize="16"/>
                </ContentControl>
                <DataGrid ItemsSource="{Binding ExpenseItems}" AutoGenerateColumns="False" IsReadOnly="True" 
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" Background="Transparent">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الكود" Binding="{Binding AccountCode}" Width="100"/>
                        <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountName}" Width="*"/>
                        <DataGridTemplateColumn Header="المبلغ" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Balance, Converter={StaticResource AccountConverter}}" TextAlignment="Right" Margin="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <Border BorderBrush="#eee" BorderThickness="0,1,0,0" Margin="0,5">
                    <Grid Margin="10">
                        <TextBlock Text="إجمالي المصروفات" FontWeight="Bold" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource AccountConverter}}" FontWeight="Bold" HorizontalAlignment="Right" Foreground="#e74c3c"/>
                    </Grid>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Net Profit Footer -->
        <Border Grid.Row="3" Padding="15" Background="#2c3e50" CornerRadius="0,0,10,10">
            <Grid>
                <TextBlock Text="{Binding NetProfitLabel}" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Left"/>
                <TextBlock Text="{Binding NetProfit, Converter={StaticResource AccountConverter}}" Foreground="#55efc4" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
