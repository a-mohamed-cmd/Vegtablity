<Window x:Class="Views.UnknownProductsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="أصناف غير موجودة في قاعدة البيانات" Height="450" Width="600"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        FlowDirection="RightToLeft" Background="#F8FAFC">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚠️ تم العثور على أصناف جديدة" FontSize="20" FontWeight="Bold" Foreground="#B91C1C" Margin="0,0,0,10"/>
        
        <TextBlock Grid.Row="1" Text="الأصناف التالية غير موجودة في قاعدة البيانات. هل تريد إضافتها الآن لتتمكن من استيرادها؟ إذا قمت بحذفها، ستتم إزالتها من الفاتورة المستوردة." 
                   TextWrapping="Wrap" FontSize="14" Foreground="#475569" Margin="0,0,0,15"/>

        <DataGrid x:Name="dgUnknowns" Grid.Row="2" AutoGenerateColumns="False" IsReadOnly="True"
                  Background="White" BorderBrush="#E2E8F0" HeadersVisibility="Column"
                  RowHeight="35" Margin="0,0,0,20">
            <DataGrid.Columns>
                <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="1.5*"/>
                <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="3*"/>
                <DataGridTextColumn Header="الكمية" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="1*"/>
                <DataGridTextColumn Header="السعر المرفوع" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="1.5*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" x:Name="BtnReject" Content="❌ حذف الأصناف والمتابعة" 
                    Background="#FEE2E2" Foreground="#B91C1C" BorderThickness="0" 
                    Padding="15,10" Margin="0,0,10,0" FontWeight="SemiBold" Cursor="Hand" Click="BtnReject_Click"/>

            <Button Grid.Column="2" x:Name="BtnApprove" Content="✅ إضافة الأصناف والمتابعة" 
                    Background="#10B981" Foreground="White" BorderThickness="0" 
                    Padding="15,10" FontWeight="SemiBold" Cursor="Hand" Click="BtnApprove_Click"/>
        </Grid>
    </Grid>
</Window>
