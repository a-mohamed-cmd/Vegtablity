<UserControl x:Class="Views.HRAlertsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             xmlns:controls="clr-namespace:Vegtablity.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:HRAlertsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <Style x:Key="FilterTabBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="tabBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="tabBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8FAFC" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF2FF" CornerRadius="10" Padding="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="🔔" FontSize="24" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="مركز متابعة وتنبيهات انتهاء الوثائق والتجديدات" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="متابعة دورية ذكية لتواريخ انتهاء الإقامات، الجوازات، الرخص، العقود، والتأمين الصحي وتنبيه الموظفين" FontSize="12" Foreground="#64748B" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="1" Content="🔄 فحص وتحديث التنبيهات" Command="{Binding RefreshCommand}"
                        Style="{StaticResource ModernButtonStyle}" Background="#4F46E5" Foreground="White"
                        Height="38" Padding="16,0" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Stat Cards Summary Grid (Interactive Filter Cards) -->
        <Grid Grid.Row="1" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Expired Card -->
            <Border Grid.Column="0" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="0,0,10,0" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="Expired"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🔴 وثائق منتهية الصلاحية" FontSize="13.5" FontWeight="Bold" Foreground="#991B1B"/>
                        <TextBlock Text="تحتاج إلى تجديد فوري - اضغط للفلترة" FontSize="11" Foreground="#B91C1C" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ExpiredCount, StringFormat={}{0} وثيقة}" FontSize="20" FontWeight="Black" Foreground="#DC2626" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Expiring Soon Card -->
            <Border Grid.Column="1" Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="5,0,5,0" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="ExpiringSoon"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="🟠 تنتهي قريباً (خلال المهلة)" FontSize="13.5" FontWeight="Bold" Foreground="#92400E"/>
                        <TextBlock Text="خلال مهلة التنبيه المحددة - اضغط للفلترة" FontSize="11" Foreground="#B45309" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding ExpiringSoonCount, StringFormat={}{0} وثيقة}" FontSize="20" FontWeight="Black" Foreground="#D97706" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Total Alerts Card -->
            <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1.5" CornerRadius="10" Padding="16" Margin="10,0,0,0" Cursor="Hand">
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding SetFilterCommand}" CommandParameter="All"/>
                </Border.InputBindings>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="📋 إجمالي التنبيهات النشطة" FontSize="13.5" FontWeight="Bold" Foreground="#1E40AF"/>
                        <TextBlock Text="عرض كافة التنبيهات - اضغط للفلترة" FontSize="11" Foreground="#2563EB" Margin="0,3,0,0"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding TotalAlertsCount, StringFormat={}{0} إجمالي}" FontSize="20" FontWeight="Black" Foreground="#2563EB" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Main Content Area: Search, Filters & Alert Rows -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Search and Filter Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Input Box -->
                    <Border Grid.Column="0" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="38" Margin="0,0,12,0">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#94A3B8"/>
                            <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                                     BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13"
                                     helpers:WatermarkHelper.Watermark="ابحث باسم الموظف، كود الموظف، القسم، أو نوع الوثيقة..."/>

                        </Grid>
                    </Border>

                    <!-- Filter Tabs & Count -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- All Tab -->
                        <Button Content="الكل" Command="{Binding SetFilterCommand}" CommandParameter="All" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterTabBtnStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilter}" Value="All">
                                            <Setter Property="Background" Value="#4F46E5"/>
                                            <Setter Property="BorderBrush" Value="#4338CA"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Expired Tab -->
                        <Button Content="🔴 منتهية" Command="{Binding SetFilterCommand}" CommandParameter="Expired" Margin="0,0,6,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterTabBtnStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilter}" Value="Expired">
                                            <Setter Property="Background" Value="#DC2626"/>
                                            <Setter Property="BorderBrush" Value="#B91C1C"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- Expiring Soon Tab -->
                        <Button Content="🟠 تنتهي قريباً" Command="{Binding SetFilterCommand}" CommandParameter="ExpiringSoon" Margin="0,0,12,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource FilterTabBtnStyle}">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                    <Setter Property="BorderBrush" Value="#E2E8F0"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedFilter}" Value="ExpiringSoon">
                                            <Setter Property="Background" Value="#D97706"/>
                                            <Setter Property="BorderBrush" Value="#B45309"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>


                        <!-- Results Badge -->
                        <Border Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="34" VerticalAlignment="Center">
                            <TextBlock Text="{Binding FilteredCount, StringFormat={}{0} نتيجة}" FontSize="12" FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- List Header Row -->
                <Border Grid.Row="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="85"/>
                            <ColumnDefinition Width="1.3*" MinWidth="130"/>
                            <ColumnDefinition Width="1.3*" MinWidth="140"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="165"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 0: Accent Spacer -->
                        <Border Grid.Column="0" Width="4" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="الكود" FontWeight="Bold" FontSize="12" Foreground="#475569"/>
                        <TextBlock Grid.Column="2" Text="اسم الموظف / القسم" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="6,0"/>
                        <TextBlock Grid.Column="3" Text="نوع الوثيقة / الحقل" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="6,0"/>
                        <TextBlock Grid.Column="4" Text="تاريخ الانتهاء" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="6,0"/>
                        <TextBlock Grid.Column="5" Text="الحالة والمهلة" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="6,0"/>
                        <TextBlock Grid.Column="6" Text="الإجراءات السريعة" FontWeight="Bold" FontSize="12" Foreground="#475569" TextAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Alerts ListBox with DocumentAlertRowControl -->
                <Grid Grid.Row="2">
                    <ListBox ItemsSource="{Binding Alerts}"
                             BorderBrush="#E2E8F0" BorderThickness="1" Background="#FAFAFA"
                             HorizontalContentAlignment="Stretch" Padding="6,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:DocumentAlertRowControl/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,3"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="0" Margin="0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EEF2FF"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Empty State Placeholder (when no alerts) -->
                    <Border Background="#FAFAFA" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1"
                            Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FilteredCount}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="🛡️" FontSize="44" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="لا توجد وثائق منتهية أو قاربت على الانتهاء مطابقة للفحص الحالي" FontSize="14" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center"/>
                            <TextBlock Text="كافة وثائق الموظفين سارية ومحدثة، أو لا توجد نتائج مطابقة لشروط البحث" FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
