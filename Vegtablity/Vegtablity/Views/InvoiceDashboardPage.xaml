<UserControl x:Class="Views.InvoiceDashboardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:viewmodels="clr-namespace:Vegtablity.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="780" d:DesignWidth="1200"
      FlowDirection="RightToLeft"
      Loaded="Page_Loaded">

    <UserControl.DataContext>
        <viewmodels:InvoiceDashboardViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Fade-in animation -->
        <Storyboard x:Key="FadeIn">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.45"/>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                             From="20" To="0" Duration="0:0:0.45">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Payment Flyout slide-in animation -->
        <Storyboard x:Key="SlideInRight">
            <DoubleAnimation Storyboard.TargetName="PaymentPanel"
                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                             From="400" To="0" Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Stats Panel Expand Storyboard -->
        <Storyboard x:Key="ExpandStats">
            <DoubleAnimation Storyboard.TargetName="StatsPanel"
                             Storyboard.TargetProperty="Height"
                             To="180" Duration="0:0:0.35">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="StatsPanel"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.3"/>
        </Storyboard>

        <!-- Stats Panel Collapse Storyboard -->
        <Storyboard x:Key="CollapseStats" Completed="CollapseStats_Completed">
            <DoubleAnimation Storyboard.TargetName="StatsPanel"
                             Storyboard.TargetProperty="Opacity"
                             To="0" Duration="0:0:0.2"/>
            <DoubleAnimation Storyboard.TargetName="StatsPanel"
                             Storyboard.TargetProperty="Height"
                             To="0" Duration="0:0:0.3" BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseIn"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid Background="#F0F4F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- Title bar -->
            <RowDefinition Height="Auto"/>   <!-- Stats Cards -->
            <RowDefinition Height="Auto"/>   <!-- Filter bar -->
            <RowDefinition Height="*"/>      <!-- Invoice list -->
            <RowDefinition Height="Auto"/>   <!-- Pagination bar -->
            <RowDefinition Height="Auto"/>   <!-- Snackbar -->
        </Grid.RowDefinitions>

        <!-- ═══ 1. TITLE BAR ═══ -->
        <Border Grid.Row="0" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1" Padding="24,18">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#FFFFFF" Offset="0"/>
                    <GradientStop Color="#F8FAFC" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#DBEAFE" CornerRadius="12" Padding="12" Margin="0,0,14,0">
                        <TextBlock Text="🧾" FontSize="28" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="لوحة الفواتير" FontSize="26" FontWeight="Black" Foreground="#0F172A"/>
                        <TextBlock Text="إدارة شاملة للمبيعات والمشتريات" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Click="NewSalesInvoice_Click" Margin="0,0,10,0" Cursor="Hand" ToolTip="إنشاء فاتورة مبيعات جديدة">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="10" Padding="16,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#6366F1" Offset="0"/>
                                            <GradientStop Color="#4F46E5" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect><DropShadowEffect Color="#4F46E5" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/></Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" Foreground="White" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="فاتورة مبيعات" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                                        <Setter TargetName="bg" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#4F46E5" BlurRadius="18" Opacity="0.5" ShadowDepth="4"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    
                    <Button Click="NewPurchaseInvoice_Click" Margin="0,0,12,0" Cursor="Hand" ToolTip="إنشاء فاتورة مشتريات جديدة">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="10" Padding="16,10">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#0EA5E9" Offset="0"/>
                                            <GradientStop Color="#0284C7" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.Effect><DropShadowEffect Color="#0284C7" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/></Border.Effect>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="➕" Foreground="White" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="فاتورة مشتريات" Foreground="White" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                                        <Setter TargetName="bg" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="#0284C7" BlurRadius="18" Opacity="0.5" ShadowDepth="4"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Command="{Binding RefreshCommand}" Cursor="Hand" ToolTip="تحديث البيانات" Margin="0,0,12,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="10" Padding="12,10" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="icon" Text="🔄" Foreground="#64748B" FontSize="14" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform><RotateTransform Angle="0"/></TextBlock.RenderTransform>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#E2E8F0"/>
                                        <Setter TargetName="icon" Property="Foreground" Value="#334155"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Stats Toggle Button -->
                    <Button x:Name="ToggleStatsBtn" Click="ToggleStatsBtn_Click" Cursor="Hand" ToolTip="إظهار / إخفاء ملخص الإحصائيات">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" CornerRadius="10" Padding="14,10" Background="White" BorderBrush="#E2E8F0" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="📊" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock x:Name="StatsBtnLabel" Text="إظهار الإحصائيات" Foreground="#334155" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#F8FAFC"/>
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#3B82F6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ 2. STATS CARDS (Collapsible) ═══ -->
        <Border x:Name="StatsPanel" Grid.Row="1" Height="0" Opacity="0" Visibility="Collapsed" ClipToBounds="True" Padding="24,20,24,10">
            <Grid x:Name="CardsGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Card: Sales Amount -->
                <Border Grid.Column="0" CornerRadius="16" Padding="20,18" Cursor="Hand">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#6366F1" Offset="0"/>
                            <GradientStop Color="#4338CA" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect><DropShadowEffect Color="#4338CA" Opacity="0.4" BlurRadius="20" ShadowDepth="6" Direction="270"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="📈" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إجمالي المبيعات" Foreground="#E0E7FF" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalSalesAmount}" Foreground="White" FontSize="28" FontWeight="Black" Margin="0,4,0,6"/>
                        <TextBlock Text="{Binding TotalSalesCount, StringFormat='{}{0} فاتورة مرحّلة'}" Foreground="#C7D2FE" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Card: Purchase Amount -->
                <Border Grid.Column="2" CornerRadius="16" Padding="20,18" Cursor="Hand">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#0EA5E9" Offset="0"/>
                            <GradientStop Color="#0369A1" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect><DropShadowEffect Color="#0369A1" Opacity="0.4" BlurRadius="20" ShadowDepth="6" Direction="270"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🛒" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="إجمالي المشتريات" Foreground="#BAE6FD" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalPurchaseAmount}" Foreground="White" FontSize="28" FontWeight="Black" Margin="0,4,0,6"/>
                        <TextBlock Text="{Binding TotalPurchaseCount, StringFormat='{}{0} فاتورة مرحّلة'}" Foreground="#BAE6FD" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Card: Sales Remainder -->
                <Border Grid.Column="4" CornerRadius="16" Padding="20,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#10B981" Offset="0"/>
                            <GradientStop Color="#047857" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect><DropShadowEffect Color="#047857" Opacity="0.4" BlurRadius="20" ShadowDepth="6" Direction="270"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="💰" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ذمم العملاء" Foreground="#D1FAE5" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalSalesRemainder}" Foreground="White" FontSize="28" FontWeight="Black" Margin="0,4,0,6"/>
                        <TextBlock Text="إجمالي المتبقي من مبيعات" Foreground="#A7F3D0" FontSize="13"/>
                    </StackPanel>
                </Border>

                <!-- Card: Purchase Remainder -->
                <Border Grid.Column="6" CornerRadius="16" Padding="20,18">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F59E0B" Offset="0"/>
                            <GradientStop Color="#B45309" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Effect><DropShadowEffect Color="#B45309" Opacity="0.4" BlurRadius="20" ShadowDepth="6" Direction="270"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🏦" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="ذمم الموردين" Foreground="#FEF3C7" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TotalPurchaseRemainder}" Foreground="White" FontSize="28" FontWeight="Black" Margin="0,4,0,6"/>
                        <TextBlock Text="إجمالي المتبقي من مشتريات" Foreground="#FDE68A" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═══ 3. FILTER BAR ═══ -->
        <Border Grid.Row="2" Background="White" CornerRadius="12" Margin="24,20,24,12" Padding="16,12">
            <Border.Effect><DropShadowEffect Color="#000" Opacity="0.03" BlurRadius="10" ShadowDepth="2"/></Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Type filter pills -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0,0,16,0">
                    <Button Content="الكل" Tag="All" Click="FilterType_Click" x:Name="BtnAll"
                            Style="{DynamicResource ModernButtonStyle}" Background="#3B82F6" Margin="0,0,8,0" FontSize="13" Padding="16,8"/>
                    <Button Content="📈 مبيعات" Tag="Sales" Click="FilterType_Click" x:Name="BtnSales"
                            Style="{DynamicResource ModernButtonStyle}" Background="#94A3B8" Margin="0,0,8,0" FontSize="13" Padding="16,8"/>
                    <Button Content="🛒 مشتريات" Tag="Purchase" Click="FilterType_Click" x:Name="BtnPurchase"
                            Style="{DynamicResource ModernButtonStyle}" Background="#94A3B8" FontSize="13" Padding="16,8"/>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Grid.Column="1" Fill="#E2E8F0" Width="1" Margin="0,4"/>

                <!-- Status filter pills -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="✔ مرحّلة" Tag="Posted" Click="FilterStatus_Click"
                            Style="{DynamicResource ModernButtonStyle}" Background="#94A3B8" Margin="0,0,8,0" FontSize="13" Padding="16,8"/>
                    <Button Content="✎ مسودة" Tag="Draft" Click="FilterStatus_Click"
                            Style="{DynamicResource ModernButtonStyle}" Background="#94A3B8" FontSize="13" Padding="16,8"/>
                </StackPanel>

                <!-- Search box -->
                <Border Grid.Column="3" Background="#F8FAFC" CornerRadius="8" BorderBrush="#E2E8F0" BorderThickness="1"
                        Margin="24,0,0,0" Padding="12,8" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍 " VerticalAlignment="Center" Foreground="#94A3B8" FontSize="14"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                 FontSize="14" Foreground="#334155" Width="260"
                                 ToolTip="بحث برقم الفاتورة أو اسم الشريك"/>
                    </StackPanel>
                </Border>

                <!-- Loading indicator -->
                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="16,0,0,0"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center">
                    <TextBlock Text="⏳" FontSize="14" Foreground="#3B82F6" Margin="0,0,6,0">
                        <TextBlock.RenderTransformOrigin>0.5,0.5</TextBlock.RenderTransformOrigin>
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="LoadingSpinner"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="LoadingSpinner" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="جاري التحميل..." Foreground="#64748B" FontSize="13" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>


        <!-- ═══ 4. INVOICE LIST ═══ -->
        <Grid Grid.Row="3" Margin="24,4,24,12">
            <Border Background="White" CornerRadius="16" BorderBrush="#E2E8F0" BorderThickness="1">
                <Border.Effect><DropShadowEffect Color="#0F172A" Opacity="0.04" BlurRadius="20" ShadowDepth="4"/></Border.Effect>
                <DataGrid x:Name="dgInvoices"
                          ItemsSource="{Binding Invoices}"
                          SelectedItem="{Binding SelectedInvoice, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#F1F5F9"
                          HeadersVisibility="Column"
                          RowHeight="52"
                          BorderThickness="0"
                          Background="Transparent"
                          AlternatingRowBackground="#FCFDFE"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          LoadingRow="DgInvoices_LoadingRow">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#F8FAFC"/>
                            <Setter Property="Foreground" Value="#64748B"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                            <Setter Property="FontSize" Value="13"/>
                            <Setter Property="Padding" Value="16,14"/>
                            <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            <Setter Property="BorderThickness" Value="0,0,0,2"/>
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Cursor" Value="Hand"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F1F5F9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- Invoice No -->
                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvID}" Width="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="Black"/>
                                    <Setter Property="Foreground" Value="#3B82F6"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Type Badge -->
                        <DataGridTemplateColumn Header="النوع" Width="120">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding InvType}" Value="Sales">
                                                        <Setter Property="Background" Value="#EEF2FF"/>
                                                        <Setter Property="BorderBrush" Value="#C7D2FE"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding InvType}" Value="Purchase">
                                                        <Setter Property="Background" Value="#FFF7ED"/>
                                                        <Setter Property="BorderBrush" Value="#FED7AA"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding InvTypeLabel}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding InvType}" Value="Sales">
                                                            <Setter Property="Foreground" Value="#4F46E5"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding InvType}" Value="Purchase">
                                                            <Setter Property="Foreground" Value="#EA580C"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Status Badge -->
                        <DataGridTemplateColumn Header="الحالة" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="6" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPosted}" Value="True">
                                                        <Setter Property="Background" Value="#F0FDF4"/>
                                                        <Setter Property="BorderBrush" Value="#BBF7D0"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsPosted}" Value="False">
                                                        <Setter Property="Background" Value="#FEFCE8"/>
                                                        <Setter Property="BorderBrush" Value="#FEF08A"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock FontSize="12" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsPosted}" Value="True">
                                                            <Setter Property="Text" Value="✔ مرحّلة"/>
                                                            <Setter Property="Foreground" Value="#15803D"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsPosted}" Value="False">
                                                            <Setter Property="Text" Value="✎ مسودة"/>
                                                            <Setter Property="Foreground" Value="#A16207"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Date -->
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding InvDate, StringFormat=yyyy/MM/dd}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="Foreground" Value="#475569"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Partner -->
                        <DataGridTextColumn Header="اسم الشريك" Binding="{Binding PartnerName}" Width="*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Net Amount -->
                        <DataGridTextColumn Header="الصافي" Binding="{Binding NetAmount, StringFormat={}{0:N3}}" Width="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="FontWeight" Value="Black"/>
                                    <Setter Property="Foreground" Value="#0F172A"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Paid -->
                        <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat={}{0:N3}}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="Foreground" Value="#10B981"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Remainder -->
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding Remainder, StringFormat={}{0:N3}}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                    <Setter Property="Padding" Value="16,0"/>
                                    <Setter Property="Foreground" Value="#EF4444"/>
                                    <Setter Property="FontWeight" Value="Bold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <!-- Actions -->
                        <DataGridTemplateColumn Header="إجراءات" Width="160">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="16,0,0,0">
                                        <!-- Open invoice button -->
                                        <Button Content="🔍 فتح" Tag="{Binding}"
                                                Click="OpenInvoiceBtn_Click"
                                                Style="{DynamicResource ModernButtonStyle}"
                                                Background="#E2E8F0" Foreground="#334155" FontSize="12" FontWeight="Bold"
                                                Padding="12,6" Margin="0,0,8,0"/>
                                        <!-- Add payment button (only for posted with remainder) -->
                                        <Button Content="💰 سداد" Tag="{Binding}"
                                                Click="AddPaymentBtn_Click"
                                                Style="{DynamicResource ModernButtonStyle}"
                                                Background="#10B981" FontSize="12" FontWeight="Bold"
                                                Padding="12,6">
                                            <Button.Visibility>
                                                <Binding Path="CanAddPayment" Converter="{StaticResource BoolToVis}"/>
                                            </Button.Visibility>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- ═══ PAGINATION BAR ═══ -->
        <Border Grid.Row="4" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                Padding="24,12" Margin="24,0,24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Prev button -->
                <Button Grid.Column="0"
                        Command="{Binding PrevPageCommand}"
                        IsEnabled="{Binding CanGoPrev}"
                        Style="{DynamicResource ModernButtonStyle}"
                        Background="#E2E8F0" Foreground="#334155"
                        FontSize="14" FontWeight="Bold"
                        Padding="18,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" Background="{TemplateBinding Background}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <TextBlock Text="→ السابق" Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="#CBD5E1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Page info label (center) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageLabel}"
                               FontSize="14" FontWeight="SemiBold" Foreground="#475569"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Next button -->
                <Button Grid.Column="2"
                        Command="{Binding NextPageCommand}"
                        IsEnabled="{Binding CanGoNext}"
                        Style="{DynamicResource ModernButtonStyle}"
                        Background="#3B82F6" Foreground="White"
                        FontSize="14" FontWeight="Bold"
                        Padding="18,8" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bg" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#3B82F6" Offset="0"/>
                                        <GradientStop Color="#2563EB" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.Effect>
                                    <DropShadowEffect Color="#2563EB" BlurRadius="10" Opacity="0.25" ShadowDepth="2"/>
                                </Border.Effect>
                                <TextBlock Text="التالي ←" Foreground="White"
                                           FontSize="{TemplateBinding FontSize}"
                                           FontWeight="{TemplateBinding FontWeight}"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.9"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ SNACKBAR ═══ -->
        <Border x:Name="SnackbarBorder" Grid.Row="5"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#0F172A" CornerRadius="8"
                Padding="24,14" Margin="0,0,0,24"
                Visibility="Collapsed" Panel.ZIndex="99" MinWidth="300">
            <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.4" Color="#000000"/></Border.Effect>
            <TextBlock x:Name="SnackbarText" Foreground="White" FontSize="14" FontWeight="SemiBold" TextAlignment="Center"/>
        </Border>

        <!-- ═══ PAYMENT FLYOUT OVERLAY ═══ -->
        <Grid Grid.RowSpan="6" Panel.ZIndex="50"
              Visibility="{Binding IsPaymentPanelOpen, Converter={StaticResource BoolToVis}}">
            <!-- Semi-transparent overlay -->
            <Rectangle Fill="#660F172A" MouseDown="Overlay_MouseDown"/>

            <!-- Payment Panel slides in from left (RTL = from left visually = right side) -->
            <Border x:Name="PaymentPanel"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    Width="400" Background="White"
                    BorderBrush="#E0E6ED" BorderThickness="0,0,1,0">
                <Border.RenderTransform><TranslateTransform X="400"/></Border.RenderTransform>
                <Border.Effect><DropShadowEffect BlurRadius="40" ShadowDepth="0" Opacity="0.15" Color="#000"/></Border.Effect>

                <Grid Margin="32,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <DockPanel Grid.Row="0" Margin="0,0,0,32">
                        <Button DockPanel.Dock="Left" Content="✕" Click="ClosePaymentPanel_Click"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#94A3B8" FontSize="20" FontWeight="Bold" Cursor="Hand" Padding="4"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="إضافة سداد جديد" FontSize="22" FontWeight="Black" Foreground="#0F172A"/>
                            <TextBlock Text="تسجيل دفعة نقدية أو بنكية" FontSize="13" Foreground="#64748B" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- Invoice Info Card -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,24">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedInvoice.PartnerName}"
                                       FontSize="18" FontWeight="Black" Foreground="#0F172A"/>
                            <TextBlock FontSize="14" Foreground="#64748B" Margin="0,6,0,0">
                                <TextBlock.Text>
                                    <MultiBinding StringFormat="فاتورة #{0} — {1}">
                                        <Binding Path="SelectedInvoice.InvID"/>
                                        <Binding Path="SelectedInvoice.InvTypeLabel"/>
                                    </MultiBinding>
                                </TextBlock.Text>
                            </TextBlock>
                            <Rectangle Fill="#E2E8F0" Height="1" Margin="0,16"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/><ColumnDefinition/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="الصافي الأساسي" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedInvoice.NetAmount, StringFormat={}{0:N3}}"
                                               Foreground="#1E293B" FontWeight="Black" FontSize="16" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="المبلغ المتبقي" Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedInvoice.Remainder, StringFormat={}{0:N3}}"
                                               Foreground="#EF4444" FontWeight="Black" FontSize="16" Margin="0,4,0,0"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Payment Amount -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,20">
                        <TextBlock Text="مبلغ السداد المطلوب *" Foreground="#475569" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N3}}"
                                 Style="{DynamicResource ModernTextBoxStyle}"
                                 FontSize="22" FontWeight="Black" TextAlignment="Center"
                                 Foreground="#10B981" Padding="12"
                                 PreviewTextInput="PaymentAmount_PreviewTextInput"
                                 PreviewKeyDown="PaymentAmount_PreviewKeyDown"
                                 DataObject.Pasting="PaymentAmount_Pasting"/>
                    </StackPanel>

                    <!-- Payment Method -->
                    <StackPanel Grid.Row="3" Margin="0,0,0,24">
                        <TextBlock Text="طريقة وحساب الدفع *" Foreground="#475569" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding CashAccounts}"
                                  SelectedValue="{Binding PaymentAccountID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="AccountID"
                                  DisplayMemberPath="AccountName"
                                  Style="{DynamicResource ModernComboBoxStyle}"
                                  ToolTip="اختر حساب الصندوق/البنك"
                                  Padding="12"/>
                    </StackPanel>

                    <!-- Journal entry preview -->
                    <Border Grid.Row="4" Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="📋 ملخص القيد المحاسبي الآلي:" Foreground="#166534" FontSize="13" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock FontSize="13" Foreground="#15803D" TextWrapping="Wrap" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedInvoice.InvType}" Value="Sales">
                                                <Setter Property="Text" Value="من حـ/ طريقة الدفع  ←  إلى حـ/ العميل"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SelectedInvoice.InvType}" Value="Purchase">
                                                <Setter Property="Text" Value="من حـ/ المورد  ←  إلى حـ/ طريقة الدفع"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Confirm button only -->
                    <StackPanel Grid.Row="6">
                        <Button Content="تأكيد وتسجيل السداد"
                                Command="{Binding ConfirmPaymentCommand}"
                                Style="{DynamicResource ModernButtonStyle}"
                                Background="#10B981" FontSize="16" FontWeight="Black"
                                Padding="0,16" HorizontalAlignment="Stretch">
                            <Button.Effect><DropShadowEffect Color="#10B981" BlurRadius="12" Opacity="0.3" ShadowDepth="3"/></Button.Effect>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
