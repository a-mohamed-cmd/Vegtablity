<UserControl x:Class="Views.IntegrationSettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels.Integrations"
             xmlns:controls="clr-namespace:Vegtablity.Controls"
             mc:Ignorable="d"
             d:DesignHeight="880" d:DesignWidth="1220"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:IntegrationSettingsViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F8FAFC" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🔗" FontSize="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="إعدادات الربط وبوابات الدفع الإلكتروني ومنصات التوصيل" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                        <TextBlock Text="إدارة مفاتيح API، اختبار الاتصال الإلزامي قبل الحفظ، خيارات طباعة QR المتعددة، وصلاحيات إرجاع المبالغ" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🔄 تحديث البوابات" Command="{Binding RefreshProvidersCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#F1F5F9" Foreground="#334155"
                            Height="38" Padding="14,0" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand"/>

                    <Button Content="🔌 1. اختبار الاتصال الفوري" Command="{Binding TestConnectionCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Foreground="White"
                            Height="38" Padding="16,0" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"
                            ToolTip="يجب نجاح اختبار الاتصال أولاً لتفعيل زر حفظ الإعدادات"/>

                    <Button Content="💾 2. حفظ الإعدادات وتفعيل البوابة" Command="{Binding SaveProviderConfigCommand}"
                            IsEnabled="{Binding CanSaveConfig}"
                            Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White"
                            Height="38" Padding="18,0" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"
                            ToolTip="يتفعل فقط بعد نجاح اختبار الاتصال الفعلي مع البوابة"/>

                    <Button Content="🔌❌ فصل الاتصال" Command="{Binding DisconnectProviderCommand}"
                            IsEnabled="{Binding CanDisconnectProvider}"
                            Style="{StaticResource ModernButtonStyle}" Background="#DC2626" Foreground="White"
                            Height="38" Padding="14,0" FontSize="12.5" FontWeight="Bold" Cursor="Hand"
                            ToolTip="فصل الاتصال بالبوابة وإيقاف تفعيلها حالياً"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Dynamic Connection Status & Step-by-Step Guidance Banner -->
        <Border Grid.Row="1" Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1.5" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#1E40AF" CornerRadius="8" Padding="12,6" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding ConnectionStatusBadge}" Foreground="White" FontWeight="Bold" FontSize="12.5"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GuidanceMessageAr}" FontSize="12.5" FontWeight="SemiBold" Foreground="#1E3A8A" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding LinkedEntitySummary}" FontSize="11.5" Foreground="#475569" Margin="0,3,0,0"/>
                </StackPanel>
                <Border Grid.Column="2" Background="#FEF3C7" BorderBrush="#F59E0B" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Text="⚠️ شرط الحفظ: نجاح اختبار الاتصال أولاً" FontSize="11.5" FontWeight="Bold" Foreground="#92400E"/>
                </Border>
            </Grid>
        </Border>

        <!-- 3. Main Content Area: Sidebar List of Enabled Gateways + Configuration Panels -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar: Enabled Providers -->
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="12">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="البوابات المفعلة للشركة" FontSize="14" FontWeight="Bold" Foreground="#1E293B" Margin="4,4,4,10"/>
                    <ListBox ItemsSource="{Binding EnabledProviders}"
                             SelectedItem="{Binding SelectedProvider, Mode=TwoWay}"
                             BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ProviderNameAr}" FontSize="13.5" FontWeight="Bold" Foreground="#0F172A"/>
                                        <TextBlock Text="{Binding ProviderCode}" FontSize="11" Foreground="#64748B" Margin="0,2,0,4"/>
                                        <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#2563EB"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Right Panel: Detailed Configuration + 7 Add-ons -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Visibility="{Binding HasSelectedProvider, Converter={StaticResource BoolToVis}}">
                <StackPanel>

                    <!-- Card A: API Credentials & Environment Mode -->
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12">
                        <Border.Effect>
                            <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="{Binding SelectedProvider.ProviderNameAr}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                                    <TextBlock Text="بيانات ومفاتيح الربط البرمجي (API Keys &amp; Endpoints)" FontSize="12" Foreground="#64748B"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <Button Content="🟡 بيئة تجريبية (Sandbox)" Command="{Binding SetSandboxModeCommand}"
                                            Style="{StaticResource ModernButtonStyle}" Background="#FEF3C7" Foreground="#92400E"
                                            Height="32" Padding="12,0" FontSize="12" FontWeight="Bold" Margin="0,0,6,0" Cursor="Hand"/>
                                    <Button Content="🟢 بيئة فعلية (Live)" Command="{Binding SetLiveModeCommand}"
                                            Style="{StaticResource ModernButtonStyle}" Background="#DCFCE7" Foreground="#166534"
                                            Height="32" Padding="12,0" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="2" Margin="0,4,0,0">
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="وضع البيئة الحالي (Environment Mode):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedProvider.EnvironmentMode, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="True" Height="34" Padding="8,4" Background="#F1F5F9"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="عنوان الخادم الأساسي (API Base URL):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedProvider.BaseUrl, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" FlowDirection="LeftToRight"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="معرف التاجر / السلسلة (Merchant ID / Chain Code):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedProvider.MerchantID, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" FlowDirection="LeftToRight"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="المفتاح العام / اسم المستخدم (Public Key / Client Username):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedProvider.PublicKey, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" FlowDirection="LeftToRight"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="المفتاح السري / التوكن (Secret Key / Bearer Token / Client Secret):" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedProvider.SecretKeyEncrypted, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" FlowDirection="LeftToRight"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,0,10">
                                    <TextBlock Text="مفتاح الـ Webhook / معرف الفرع (Webhook Secret / Vendor ID):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedProvider.WebhookSecret, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" FlowDirection="LeftToRight"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,10">
                                    <TextBlock Text="رابط الإشعارات والعودة (Callback / Webhook URL):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding SelectedProvider.CallbackUrl, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" FlowDirection="LeftToRight"/>
                                </StackPanel>
                                <UniformGrid Columns="3">
                                    <StackPanel Margin="0,0,6,10">
                                        <TextBlock Text="العملة:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedProvider.DefaultCurrency, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,6,10">
                                        <TextBlock Text="نسبة العمولة (%):" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedProvider.CommissionPercent, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="رسوم ثابتة:" FontSize="12" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding SelectedProvider.FixedFee, UpdateSourceTrigger=PropertyChanged}" Height="34" Padding="8,4" FlowDirection="LeftToRight"/>
                                    </StackPanel>
                                </UniformGrid>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Card B.1: Customize Journal Entries (Debit & Credit Sides) -->
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12"
                            Visibility="{Binding IsPaymentGatewaySelected, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="📘 تخصيص وترحيل القيود المحاسبية للبوابة (Customize Journal Entry - الجانب المدين والجانب الدائن)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="يمكنك اعتماد الحسابات المولدة تلقائياً للبوابة أو تخصيص حسابات الجانب المدين والجانب الدائن وحساب مصروف العمولة من شجرة الحسابات:" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                            <UniformGrid Columns="3">
                                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="🟢 الجانب المدين عند التحصيل (Debit Account):" FontSize="12" FontWeight="Bold" Foreground="#1E40AF" Margin="0,0,0,4"/>
                                        <TextBlock Text="حساب إيداع البوابة / البنك (يُولّد تلقائياً للبوابة)" FontSize="10.5" Foreground="#475569" Margin="0,0,0,6"/>
                                        <controls:SearchableDropdown x:Name="DdDebitAccount"
                                                                     ItemsSource="{Binding AvailableAccounts}"
                                                                     DisplayMemberPath="DisplayText"
                                                                     SelectedItem="{Binding SelectedDebitAccount, Mode=TwoWay}"
                                                                     Watermark="ابحث برقم أو اسم حساب المدين..."
                                                                     Height="36"
                                                                     SearchChanged="AccountDropdown_SearchChanged"
                                                                     ItemSelected="AccountDropdown_ItemSelected"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#F0FDF4" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,8,0">
                                    <StackPanel>
                                        <TextBlock Text="🔵 الجانب الدائن عند التحصيل (Credit Account):" FontSize="12" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,4"/>
                                        <TextBlock Text="حساب العميل في الفاتورة تلقائياً أو حساب مبيعات مخصص" FontSize="10.5" Foreground="#475569" Margin="0,0,0,6"/>
                                        <controls:SearchableDropdown x:Name="DdCreditAccount"
                                                                     ItemsSource="{Binding AvailableAccounts}"
                                                                     DisplayMemberPath="DisplayText"
                                                                     SelectedItem="{Binding SelectedCreditAccount, Mode=TwoWay}"
                                                                     Watermark="ابحث برقم أو اسم حساب الدائن..."
                                                                     Height="36"
                                                                     SearchChanged="AccountDropdown_SearchChanged"
                                                                     ItemSelected="AccountDropdown_ItemSelected"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="#FFFBEB" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="8" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="🟠 حساب مصروف عمولة البوابة (الفرعي):" FontSize="12" FontWeight="Bold" Foreground="#92400E" Margin="0,0,0,4"/>
                                        <TextBlock Text="تحت رئيسي: مصروف عمولات بوابات الدفع الإلكتروني" FontSize="10.5" Foreground="#475569" Margin="0,0,0,6"/>
                                        <controls:SearchableDropdown x:Name="DdCommissionAccount"
                                                                     ItemsSource="{Binding AvailableAccounts}"
                                                                     DisplayMemberPath="DisplayText"
                                                                     SelectedItem="{Binding SelectedCommissionAccount, Mode=TwoWay}"
                                                                     Watermark="ابحث برقم أو اسم حساب العمولة..."
                                                                     Height="36"
                                                                     SearchChanged="AccountDropdown_SearchChanged"
                                                                     ItemSelected="AccountDropdown_ItemSelected"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Card B: Multi-Select QR Printing Options (Add-on #1) -->
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12"
                            Visibility="{Binding IsPaymentGatewaySelected, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🖨️ خيارات تحديد طباعة رمز QR والباركود (يمكن اختيار أي منها أو جميعها معاً)" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,4"/>
                            <TextBlock Text="حدد مقاسات ونماذج الفواتير التي ترغب في طباعة رمز QR لرابط الدفع عليها تلقائياً:" FontSize="12" Foreground="#64748B" Margin="0,0,0,12"/>

                            <UniformGrid Columns="3">
                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                    <CheckBox IsChecked="{Binding SelectedProvider.PrintQrOnPos80mm, Mode=TwoWay}" VerticalContentAlignment="Center">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="طباعة QR على إيصال 80mm" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="طابعات الكاشير الحرارية القياسية (80mm)" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,8,0">
                                    <CheckBox IsChecked="{Binding SelectedProvider.PrintQrOnPos58mm, Mode=TwoWay}" VerticalContentAlignment="Center">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="طباعة QR على إيصال 58mm" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="طابعات الكاشير المحمولة والمصغرة (58mm)" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>

                                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="8" Padding="12">
                                    <CheckBox IsChecked="{Binding SelectedProvider.PrintQrOnWpfInvoice, Mode=TwoWay}" VerticalContentAlignment="Center">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="طباعة QR على فاتورة المبيعات (WPF)" FontWeight="Bold" Foreground="#1E293B"/>
                                            <TextBlock Text="فواتير المبيعات المكتبية A4 / A5 في النظام" FontSize="11" Foreground="#64748B"/>
                                        </StackPanel>
                                    </CheckBox>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Card C: Gateway Refunds & Advanced Add-ons (#2 to #7) -->
                    <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,0,12"
                            Visibility="{Binding IsPaymentGatewaySelected, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="↩️ صلاحيات إرجاع المبالغ (Refunds) والمميزات الذكية للبوابة" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,12"/>

                            <!-- Master Refund Permission Toggle -->
                            <Border Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1.5" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding SelectedProvider.EnableGatewayRefunds, Mode=TwoWay}" VerticalContentAlignment="Center">
                                        <StackPanel Margin="6,0,0,0">
                                            <TextBlock Text="تفعيل صلاحية إرجاع المبالغ (Refund API) وإظهار زر (↩️ إرجاع المبلغ) في شاشة الروابط" FontSize="13.5" FontWeight="Bold" Foreground="#991B1B"/>
                                            <TextBlock Text="عند تعطيل هذا الخيار يختفي زر إرجاع المبلغ تماماً من صفحة طلبات وفواتير بوابات الدفع، وعند تفعيله يظهر الزر للعمليات المسددة." FontSize="11.5" Foreground="#7F1D1D"/>
                                        </StackPanel>
                                    </CheckBox>

                                    <UniformGrid Columns="2" Margin="24,10,0,0" Visibility="{Binding SelectedProvider.EnableGatewayRefunds, Converter={StaticResource BoolToVis}}">
                                        <CheckBox IsChecked="{Binding SelectedProvider.AllowPartialRefunds, Mode=TwoWay}" Content="السماح بالاسترداد الجزئي (Partial Refund) على نفس الفاتورة" Margin="0,4"/>
                                        <CheckBox IsChecked="{Binding SelectedProvider.AutoPostRefundJournalEntry, Mode=TwoWay}" Content="ترحيل قيد محاسبي عكسي وتحديث رصيد الفاتورة آلياً عند الاسترداد" Margin="0,4"/>
                                        <CheckBox IsChecked="{Binding SelectedProvider.RefundChargeOnCustomer, Mode=TwoWay}" Content="تحميل رسوم الاسترداد على العميل (RefundChargeOnCustomer)" Margin="0,4"/>
                                        <CheckBox IsChecked="{Binding SelectedProvider.ServiceChargeOnCustomer, Mode=TwoWay}" Content="تحميل رسوم الخدمة على العميل (ServiceChargeOnCustomer)" Margin="0,4"/>
                                    </UniformGrid>

                                    <!-- Customize Refund Journal Entry Debit & Credit Accounts -->
                                    <Border Background="White" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="12" Margin="24,10,0,0"
                                            Visibility="{Binding SelectedProvider.AutoPostRefundJournalEntry, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="⚙️ تخصيص طرفي قيد الاسترداد العكسي (الجانب المدين والجانب الدائن عند إرجاع المبلغ):" FontSize="12.5" FontWeight="Bold" Foreground="#991B1B" Margin="0,0,0,8"/>
                                            <UniformGrid Columns="2">
                                                <StackPanel Margin="0,0,10,0">
                                                    <TextBlock Text="الجانب المدين لقيد الاسترداد (Refund Debit Account):" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                                    <controls:SearchableDropdown x:Name="DdRefundDebitAccount"
                                                                                 ItemsSource="{Binding AvailableAccounts}"
                                                                                 DisplayMemberPath="DisplayText"
                                                                                 SelectedItem="{Binding SelectedRefundDebitAccount, Mode=TwoWay}"
                                                                                 Watermark="ابحث برقم أو اسم حساب المدين..."
                                                                                 Height="36"
                                                                                 SearchChanged="AccountDropdown_SearchChanged"
                                                                                 ItemSelected="AccountDropdown_ItemSelected"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="الجانب الدائن لقيد الاسترداد (Refund Credit Account):" FontSize="11.5" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                                                    <controls:SearchableDropdown x:Name="DdRefundCreditAccount"
                                                                                 ItemsSource="{Binding AvailableAccounts}"
                                                                                 DisplayMemberPath="DisplayText"
                                                                                 SelectedItem="{Binding SelectedRefundCreditAccount, Mode=TwoWay}"
                                                                                 Watermark="ابحث برقم أو اسم حساب الدائن..."
                                                                                 Height="36"
                                                                                 SearchChanged="AccountDropdown_SearchChanged"
                                                                                 ItemSelected="AccountDropdown_ItemSelected"/>
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- Other Smart Add-ons -->
                            <UniformGrid Columns="2">
                                <CheckBox IsChecked="{Binding SelectedProvider.AutoSendLinkOnInvoiceSave, Mode=TwoWay}" Content="إظهار نافذة إرسال رابط الدفع تلقائياً عند حفظ فاتورة آجلة / غير مسددة" Margin="0,6"/>
                                <CheckBox IsChecked="{Binding SelectedProvider.AutoSendWhatsApp, Mode=TwoWay}" Content="إرسال رابط الدفع عبر واتساب (WhatsApp) تلقائياً للعميل" Margin="0,6"/>
                                <CheckBox IsChecked="{Binding SelectedProvider.AutoSendSms, Mode=TwoWay}" Content="إرسال رابط الدفع عبر رسالة نصية (SMS) من البوابة" Margin="0,6"/>
                                <CheckBox IsChecked="{Binding SelectedProvider.EnableConsolidatedLinks, Mode=TwoWay}" Content="تفعيل الروابط المجمعة (دمج عدة فواتير للعميل في رابط دفع واحد)" Margin="0,6"/>
                                <CheckBox IsChecked="{Binding SelectedProvider.DeductCommissionOnShiftClose, Mode=TwoWay}" Content="تجميع وترحيل عمولة البوابة في قيد موحد عند إغلاق الوردية" Margin="0,6" Visibility="Collapsed"/>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6">
                                    <TextBlock Text="مدة صلاحية الرابط (ساعات):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBox Text="{Binding SelectedProvider.LinkExpiryHours, UpdateSourceTrigger=PropertyChanged}" Width="70" Height="28" Padding="4,2" FlowDirection="LeftToRight"/>
                                </StackPanel>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!-- Card D: Talabat Delivery Platform Specific Info -->
                    <Border Background="White" CornerRadius="12" Padding="18"
                            Visibility="{Binding IsDeliveryPlatformSelected, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="🛵 إعدادات عميل المبيعات ومنصة التوصيل (Talabat Integration)" FontSize="15" FontWeight="Bold" Foreground="#EA580C" Margin="0,0,0,8"/>
                            <TextBlock Text="• عند نجاح اختبار الاتصال وحفظ الإعدادات، يقوم النظام تلقائياً بإضافة (Talabat) كعميل مبيعات في جدول الشركاء [Sales].[Partners] وربطه بحساب عميل فرعي في شجرة الحسابات." FontSize="12.5" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBlock Text="• تظهر صفحة (🛵 طلبات Talabat) تلقائياً أسفل قسم المبيعات في برنامج سطح المكتب (WPF)، كما يظهر خيار تفعيل شاشة طلبات Talabat في إعدادات تطبيق الكاشير (Flutter POS)." FontSize="12.5" Foreground="#334155"/>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>

