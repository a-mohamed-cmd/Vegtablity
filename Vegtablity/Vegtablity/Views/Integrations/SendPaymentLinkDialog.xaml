<Window x:Class="Views.Integrations.SendPaymentLinkDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="إصدار وإرسال رابط الدفع الإلكتروني"
        Width="560"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F8FAFC"
        FlowDirection="RightToLeft"
        FontFamily="Cairo, Segoe UI, Tahoma">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Header Banner -->
        <Border Grid.Row="0" Background="#0F172A" CornerRadius="12" Padding="18,14" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock x:Name="TxtDialogTitle" Text="🔗 إصدار وإرسال رابط دفع إلكتروني للعميل"
                               FontSize="17" FontWeight="Bold" Foreground="White"/>
                    <TextBlock x:Name="TxtDialogSubtitle"
                               Text="سيتم إنشاء رابط دفع آمن عبر البوابة المفعلة وإرساله للعميل أو طباعة رمز QR"
                               FontSize="12" Foreground="#94A3B8" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="10,6" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtInvoiceBadge" Text="فاتورة #0" Foreground="#38BDF8" FontWeight="Bold" FontSize="13"/>
                </Border>
            </Grid>
        </Border>

        <!-- 2. Input Form Card -->
        <Border Grid.Row="1" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,12">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="بوابة الدفع الإلكتروني" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbGateways" DisplayMemberPath="ProviderNameAr" SelectedValuePath="ProviderID"
                                  Padding="10,7" FontSize="13" FontWeight="SemiBold"
                                  SelectionChanged="CmbGateways_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="المبلغ المطلوب تحصيله" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtAmount" Padding="10,7" FontSize="15" FontWeight="Bold"
                                 Foreground="#0284C7" TextAlignment="Center" FlowDirection="LeftToRight"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="اسم العميل" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCustomerName" Padding="10,7" FontSize="13"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="رقم هاتف العميل (لواتساب و SMS)" FontSize="12" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtCustomerPhone" Padding="10,7" FontSize="13" FontWeight="Bold"
                                 FlowDirection="LeftToRight" TextAlignment="Left"/>
                    </StackPanel>
                </Grid>

                <!-- Options -->
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,4,0,0">
                    <StackPanel>
                        <TextBlock Text="خيارات الإرسال والطباعة الفورية:" FontSize="12" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,6"/>
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="ChkSendWhatsApp" Content="📲 إرسال عبر واتساب فوراً" IsChecked="True"
                                      FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,16,6"/>
                            <CheckBox x:Name="ChkPrint80mm" Content="🖨 طباعة QR (80mm)"
                                      FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,16,6"/>
                            <CheckBox x:Name="ChkPrint58mm" Content="🖨 طباعة QR (58mm)"
                                      FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,16,6"/>
                            <CheckBox x:Name="ChkPrintWpf" Content="🖨 طباعة QR (A4)"
                                      FontWeight="SemiBold" Foreground="#0F172A" Margin="0,0,0,6"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- 3. Status Message -->
        <Border x:Name="StatusBanner" Grid.Row="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1"
                CornerRadius="8" Padding="12,8" Margin="0,0,0,12" Visibility="Collapsed">
            <TextBlock x:Name="TxtStatusMessage" Text="" FontSize="12" FontWeight="SemiBold" Foreground="#1E40AF" TextWrapping="Wrap"/>
        </Border>

        <!-- 4. Generated Link & QR Preview Card (Visible once link is created) -->
        <Border x:Name="ResultCard" Grid.Row="3" Background="#F0FDF4" BorderBrush="#86EFAC" BorderThickness="1"
                CornerRadius="12" Padding="14" Margin="0,0,0,14" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="✅ تم توليد رابط الدفع الإلكتروني بنجاح:" FontSize="13" FontWeight="Bold" Foreground="#166534" Margin="0,0,0,6"/>
                    <TextBox x:Name="TxtGeneratedUrl" IsReadOnly="True" Padding="8,6" FontSize="11"
                             FlowDirection="LeftToRight" Background="White" Foreground="#0F172A" Margin="0,0,0,8"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="📋 نسخ الرابط" Click="BtnCopyUrl_Click"
                                Background="#0284C7" Foreground="White" BorderThickness="0"
                                Padding="12,5" Margin="0,0,8,4" Cursor="Hand" FontWeight="SemiBold"/>
                        <Button Content="📲 إرسال عبر واتساب" Click="BtnSendWhatsAppNow_Click"
                                Background="#16A34A" Foreground="White" BorderThickness="0"
                                Padding="12,5" Margin="0,0,8,4" Cursor="Hand" FontWeight="SemiBold"/>
                        <Button Content="🖨 طباعة QR" Click="BtnPrintQrNow_Click"
                                Background="#4F46E5" Foreground="White" BorderThickness="0"
                                Padding="12,5" Margin="0,0,0,4" Cursor="Hand" FontWeight="SemiBold"/>
                    </WrapPanel>
                </StackPanel>

                <Border Grid.Column="2" Background="White" BorderBrush="#BBF7D0" BorderThickness="1" CornerRadius="8" Padding="6">
                    <Image x:Name="ImgQrPreview" Width="115" Height="115" Stretch="Uniform"/>
                </Border>
            </Grid>
        </Border>

        <!-- 5. Action Buttons -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="BtnCreateAndSend" Grid.Column="1" Content="🔗 إنشاء وإرسال رابط الدفع الآن"
                    Click="BtnCreateAndSend_Click"
                    Background="#059669" Foreground="White" BorderThickness="0"
                    Padding="20,10" Margin="0,0,10,0" FontSize="14" FontWeight="Bold" Cursor="Hand"/>

            <Button x:Name="BtnClose" Grid.Column="2" Content="إغلاق"
                    Click="BtnClose_Click"
                    Background="#E2E8F0" Foreground="#334155" BorderThickness="0"
                    Padding="18,10" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>

