<UserControl x:Class="Views.PurchaseInvoicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Vegtablity"
      xmlns:viewmodels="clr-namespace:Vegtablity.ViewModels"
      xmlns:controls="clr-namespace:Vegtablity.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1050"
      FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <viewmodels:PurchaseInvoiceViewModel />
    </UserControl.DataContext>

    <!-- Boolean to Visibility Converter for IsPosted badging -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid>

        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Background="#F5F7FA" Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
            <!-- Title Bar -->
            <RowDefinition Height="Auto"/>
            <!-- Header Controls -->
            <RowDefinition Height="*"/>
            <!-- DataGrid for Details -->
            <RowDefinition Height="Auto"/>
            <!-- Footer Controls (Totals, Commands) -->
        </Grid.RowDefinitions>

        <!-- 1. Title/ToolBar -->
        <Border Grid.Row="0" Background="White" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1" Padding="20,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="فاتورة المشتريات" FontSize="26" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <!-- Status Badge -->
                    <Border Margin="15,0,0,0" Padding="10,5" CornerRadius="12" Background="#DCFCE7" VerticalAlignment="Center"
                            Visibility="{Binding IsInvoicePosted, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✔ فاتورة مُرحلة" Foreground="#166534" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                    <Border x:Name="DraftBadge" Margin="15,0,0,0" Padding="10,5" CornerRadius="12" Background="#FEF3C7" VerticalAlignment="Center"
                            Visibility="{Binding IsEditAllowed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="✎ مسودة" Foreground="#92400E" FontWeight="SemiBold" FontSize="13"/>
                    </Border>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- زر الرجوع -->
                    <Button x:Name="BtnGoBack" Content="← رجوع"
                            Click="BtnGoBack_Click"
                            Style="{DynamicResource ModernButtonStyle}"
                            Background="#64748B" Margin="0,0,10,0"
                            ToolTip="العودة للصفحة السابقة"/>

                    <!-- Excel Buttons -->
                    <Button Content="📥 استيراد Excel" Command="{Binding ImportExcelCommand}"
                            Style="{DynamicResource ModernButtonStyle}" Background="#059669" Margin="0,0,6,0"
                            Visibility="{Binding IsEditAllowed, Converter={StaticResource BoolToVis}}"
                            ToolTip="استيراد أصناف الفاتورة من ملف Excel"/>
                    <Button Content="📋 تنزيل القالب" Command="{Binding DownloadTemplateCommand}"
                            Style="{DynamicResource ModernButtonStyle}" Background="#0891B2" Margin="0,0,10,0"
                            ToolTip="تنزيل قالب Excel للتعبئة"/>

                    <Button Content="📄 تصدير PDF" Command="{Binding ExportPdfCommand}"
                            Style="{DynamicResource ModernButtonStyle}" Background="#9333EA" Margin="0,0,10,0"
                            ToolTip="تصدير الفاتورة إلى ملف PDF"/>

                    <Button Content="➕ فاتورة جديدة" Command="{Binding NewCommand}" Click="NewInvoiceButton_Click"
                            Style="{DynamicResource ModernButtonStyle}" Background="#3B82F6" Margin="0,0,10,0"
                            IsEnabled="{Binding CurrentPermissions.CanAdd}"/>

                    <Button Content="💾 حـفـظ" Command="{Binding SaveCommand}" 
                            Style="{DynamicResource ModernButtonStyle}" Background="#10B981" Margin="0,0,10,0"
                            Visibility="{Binding IsEditAllowed, Converter={StaticResource BoolToVis}}"/>

                    <!-- Unpost Button -->
                    <Button Content="↩️ إلغاء الترحيل" Command="{Binding UnpostInvoiceCommand}" 
                            Style="{DynamicResource ModernButtonStyle}" Background="#EF4444" Margin="0,0,10,0"
                            Visibility="{Binding IsInvoicePosted, Converter={StaticResource BoolToVis}}"
                            ToolTip="إلغاء الترحيل وفتح الفاتورة للتعديل"/>

                    <Button Content="🚀 ترحيل الفاتورة" Command="{Binding PostCommand}" 
                            Style="{DynamicResource ModernButtonStyle}" Background="#F59E0B"
                            Visibility="{Binding IsEditAllowed, Converter={StaticResource BoolToVis}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Header Fields -->
        <Border Grid.Row="1" Background="White" Margin="20,20,20,10" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Row 1 -->
                <!-- Date -->
                <StackPanel Grid.Row="0" Grid.Column="0">
                    <TextBlock Text="تاريخ الفاتورة *" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox x:Name="TxtInvDate"
                             Text="{Binding InvDateText, UpdateSourceTrigger=PropertyChanged}"
                             LostFocus="InvDate_LostFocus" PreviewKeyDown="Date_PreviewKeyDown"
                             GotFocus="TextBox_GotFocus"
                             IsEnabled="{Binding IsEditAllowed}"
                             Style="{DynamicResource ModernTextBoxStyle}"
                             ToolTip="أدخل التاريخ: dd/MM/yyyy أو ddMMyyyy"/>
                </StackPanel>

                <!-- Partner Search (عملاء + موردون) -->
                <StackPanel Grid.Row="0" Grid.Column="2">
                    <TextBlock Text="المورد / العميل *" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <controls:SearchableDropdown
                        x:Name="PartnerDropdown"
                        ItemsSource="{Binding FilteredPartners}"
                        DisplayMemberPath="SearchText"
                        Watermark="ابحث باسم المورد أو العميل..."
                        Height="40"
                        IsEnabled="{Binding IsEditAllowed}"
                        SearchChanged="PartnerDropdown_SearchChanged"
                        ItemSelected="PartnerDropdown_ItemSelected"
                        ConfirmedAndMoveNext="PartnerDropdown_MoveNext"/>
                </StackPanel>

                <!-- Warehouse -->
                <StackPanel Grid.Row="0" Grid.Column="4">
                    <TextBlock Text="المستودع *" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <ComboBox ItemsSource="{Binding Warehouses}" 
                              SelectedValue="{Binding CurrentInvoice.WarehouseID, UpdateSourceTrigger=PropertyChanged}" 
                              SelectedValuePath="WarehouseID" DisplayMemberPath="WarehouseName"
                              IsEnabled="{Binding IsEditAllowed}"/>
                </StackPanel>

                <!-- Inv ID (Readonly) -->
                <StackPanel Grid.Row="0" Grid.Column="6">
                    <TextBlock Text="رقم الفاتورة" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding CurrentInvoice.InvID, Mode=OneWay}" 
                             IsReadOnly="True" Background="#F1F5F9" Foreground="#0F172A"
                             Style="{DynamicResource ModernTextBoxStyle}" FontWeight="Bold"/>
                </StackPanel>

                <!-- Row 2 -->
                <StackPanel Grid.Row="2" Grid.Column="0">
                    <TextBlock Text="رقم فاتورة المورد" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding CurrentInvoice.ReferenceNo, UpdateSourceTrigger=PropertyChanged}" 
                             IsEnabled="{Binding IsEditAllowed}"
                             Style="{DynamicResource ModernTextBoxStyle}"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="5">
                    <TextBlock Text="ملاحظات" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding CurrentInvoice.Notes, UpdateSourceTrigger=PropertyChanged}" 
                             IsEnabled="{Binding IsEditAllowed}"
                             Style="{DynamicResource ModernTextBoxStyle}" Height="40" MaxLength="250"/>
                </StackPanel>

            </Grid>
        </Border>

        <!-- 3. Invoice Details Grid -->
        <Border Grid.Row="2" Background="White" Margin="20,10,20,10" CornerRadius="10" Padding="15">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="تفاصيل الأصناف" FontSize="18" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                    <Button Content="➕ إضافة صنف" Command="{Binding AddItemCommand}" Click="AddItemButton_Click"
                            Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#4F46E5" 
                            Margin="20,0,0,0" Padding="15,5">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                <Setter Property="IsEnabled" Value="False"/>
                                <Style.Triggers>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEditAllowed}" Value="True"/>
                                            <Condition Binding="{Binding CurrentPermissions.CanEdit}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </MultiDataTrigger>
                                    <MultiDataTrigger>
                                        <MultiDataTrigger.Conditions>
                                            <Condition Binding="{Binding IsEditAllowed}" Value="True"/>
                                            <Condition Binding="{Binding CurrentInvoice.InvID}" Value="0"/>
                                            <Condition Binding="{Binding CurrentPermissions.CanAdd}" Value="True"/>
                                        </MultiDataTrigger.Conditions>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </MultiDataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Invoice Details Pagination -->
                    <StackPanel Orientation="Horizontal" Margin="40,0,0,0" VerticalAlignment="Center">
                        <Button Content="▶" Command="{Binding PrevDetailsPageCommand}" IsEnabled="{Binding CanGoPrevDetails}"
                                Style="{StaticResource ModernButtonStyle}" Background="#F1F5F9" Foreground="#475569" Width="30" Padding="0"/>
                        <TextBlock Text="{Binding DetailsPageLabel}" Margin="15,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>
                        <Button Content="◀" Command="{Binding NextDetailsPageCommand}" IsEnabled="{Binding CanGoNextDetails}"
                                Style="{StaticResource ModernButtonStyle}" Background="#F1F5F9" Foreground="#475569" Width="30" Padding="0"/>
                    </StackPanel>
                </StackPanel>

                <!-- The DataGrid -->
                <DataGrid x:Name="dgInvoiceDetails" Grid.Row="1" ItemsSource="{Binding CurrentInvoice.Details}" AutoGenerateColumns="False" 
                          CanUserAddRows="False" SelectionMode="Single"
                          IsReadOnly="{Binding IsDataGridReadOnly}"
                          MinHeight="300" RowHeight="35"
                          PreviewKeyDown="dgInvoiceDetails_ArrowNav_PreviewKeyDown">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsUnknown}" Value="True">
                                    <Setter Property="Background" Value="#FEE2E2"/>
                                    <Setter Property="Foreground" Value="#B91C1C"/>
                                    <Setter Property="ToolTip" Value="هذا الصنف غير موجود في قاعدة البيانات ولم يتم إضافته بعد."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        
                        <!-- Product Code (Barcode) -->
                        <DataGridTemplateColumn Header="كود الصنف" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" 
                                             PreviewKeyDown="Barcode_PreviewKeyDown"
                                             GotFocus="TextBox_GotFocus"
                                             IsEnabled="{Binding DataContext.IsEditAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             BorderThickness="0" Background="Transparent" Padding="5,0" VerticalContentAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Product Selection -->
                        <DataGridTemplateColumn Header="اسم الصنف / الباركود" Width="3*" IsReadOnly="False">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              SelectedValue="{Binding ProductID, UpdateSourceTrigger=Explicit}"
                                              SelectedValuePath="ProductID" DisplayMemberPath="SearchText"
                                              TextSearch.TextPath="SearchText"
                                              IsEditable="True"
                                              IsTextSearchEnabled="False"
                                              StaysOpenOnEdit="True"
                                              KeyUp="ProductComboBox_KeyUp"
                                              PreviewKeyDown="ProductComboBox_PreviewKeyDown"
                                              DropDownOpened="ProductComboBox_DropDownOpened"
                                              DropDownClosed="ProductComboBox_DropDownClosed"
                                              LostFocus="ProductComboBox_LostFocus"
                                              SelectionChanged="ProductComboBox_SelectionChanged"
                                              IsEnabled="{Binding DataContext.IsEditAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                              BorderThickness="0" Background="Transparent"
                                              Padding="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Quantity -->
                        <DataGridTemplateColumn Header="الكمية" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N3}}" 
                                             PreviewKeyDown="Quantity_PreviewKeyDown"
                                             GotFocus="TextBox_GotFocus"
                                             IsEnabled="{Binding DataContext.IsEditAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             BorderThickness="0" Background="Transparent" TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Unit Price -->
                        <DataGridTemplateColumn Header="السعر" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N3}}" 
                                             PreviewKeyDown="Price_PreviewKeyDown"
                                             GotFocus="TextBox_GotFocus"
                                             IsEnabled="{Binding DataContext.IsEditAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                             BorderThickness="0" Background="Transparent" TextAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Total Price (Readonly calculation inside ViewModel) -->
                        <DataGridTemplateColumn Header="الإجمالي" Width="1*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBox Text="{Binding TotalPrice, Mode=OneWay, StringFormat={}{0:N3}}" 
                                             IsReadOnly="True" FontWeight="Bold" Background="Transparent" BorderThickness="0"
                                             TextAlignment="Center" PreviewKeyDown="Total_PreviewKeyDown"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <!-- Delete Row Command -->
                        <DataGridTemplateColumn Header="حذف" Width="60">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Background="Transparent" BorderThickness="0" 
                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                            CommandParameter="{Binding}"
                                            IsEnabled="{Binding DataContext.IsEditAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            ToolTip="حذف السطر">
                                        <TextBlock Text="🗑️" Foreground="#EF4444" FontSize="16"/>
                                    </Button>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- Invoice Details Pagination (Bottom Bar) -->
                <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,1,1,1" CornerRadius="0,0,12,12" Padding="15,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="→ الصفحة السابقة" Command="{Binding PrevDetailsPageCommand}" IsEnabled="{Binding CanGoPrevDetails}"
                                Style="{StaticResource ModernButtonStyle}" Background="#94A3B8" Padding="15,5"/>
                        <TextBlock Grid.Column="1" Text="{Binding DetailsPageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
                        <Button Grid.Column="2" Content="الصفحة التالية ←" Command="{Binding NextDetailsPageCommand}" IsEnabled="{Binding CanGoNextDetails}"
                                Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Padding="15,5"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 4. Footer & Totals -->
        <Border Grid.Row="3" Background="White" Margin="20,10,20,20" CornerRadius="10" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/> <!-- Used for optional summary/words -->
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    
                    <!-- Subtotal -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="الإجمالي قبل الخصم:" Foreground="#64748B" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentInvoice.TotalAmount, StringFormat={}{0:N3}}" Foreground="#0F172A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"/>
                    </Grid>
                    
                    <!-- Discount -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="الخصـم:" Foreground="#64748B" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,120,0"/>
                        <TextBox Text="{Binding CurrentInvoice.Discount, UpdateSourceTrigger=LostFocus}" 
                                 Width="100" HorizontalAlignment="Left" TextAlignment="Center"
                                 IsEnabled="{Binding IsEditAllowed}"
                                 Style="{DynamicResource ModernTextBoxStyle}" FontWeight="Bold"
                                 PreviewTextInput="DecimalBox_PreviewTextInput"
                                 PreviewKeyDown="DecimalBox_PreviewKeyDown"
                                 DataObject.Pasting="DecimalBox_Pasting"/>
                    </Grid>

                    <Rectangle Fill="#E2E8F0" Height="1" Margin="0,5,0,10"/>

                    <!-- Net Amount -->
                    <Grid Margin="0,0,0,10">
                        <TextBlock Text="الصافي (الإجمالي الكلي):" Foreground="#0F172A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <Border Background="#F1F5F9" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left" MinWidth="130">
                            <TextBlock Text="{Binding CurrentInvoice.NetAmount, StringFormat={}{0:N3}}" Foreground="#2563EB" FontSize="20" FontWeight="Black" TextAlignment="Center"/>
                        </Border>
                    </Grid>

                    <!-- Payment Tracker -->
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,5" HorizontalAlignment="Stretch">
                        <TextBlock Text="المبلغ المدفوع:" Foreground="#64748B" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Width="140" TextAlignment="Right" Margin="0,0,10,0"/>
                        <TextBox Text="{Binding CurrentInvoice.PaidAmount, UpdateSourceTrigger=LostFocus}" 
                                 Width="100" TextAlignment="Center"
                                 IsEnabled="{Binding IsEditAllowed}"
                                 Style="{DynamicResource ModernTextBoxStyle}" FontWeight="Bold" Foreground="#10B981"
                                 PreviewTextInput="DecimalBox_PreviewTextInput"
                                 PreviewKeyDown="DecimalBox_PreviewKeyDown"
                                 DataObject.Pasting="DecimalBox_Pasting"/>
                    </StackPanel>

                    <!-- Payment Method -->
                    <StackPanel Orientation="Horizontal" Margin="0,5,0,10" HorizontalAlignment="Stretch">
                        <TextBlock Text="طريقة الدفع:" Foreground="#64748B" FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Width="140" TextAlignment="Right" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding CashAccounts}"
                                  SelectedValue="{Binding CurrentInvoice.PaymentAccountID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  SelectedValuePath="AccountID"
                                  DisplayMemberPath="AccountName"
                                  Width="190"
                                  IsEnabled="{Binding IsPaymentAccountEnabled}"
                                  Style="{DynamicResource ModernComboBoxStyle}"
                                  ToolTip="اختر حساب الصندوق/البنك لتسجيل قيد السداد"/>
                    </StackPanel>

                    <!-- Remainder -->
                    <Grid Margin="0,0,0,0">
                        <TextBlock Text="المتبقي (آجل):" Foreground="#EF4444" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding CurrentInvoice.Remainder, StringFormat={}{0:N3}}" Foreground="#EF4444" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"/>
                    </Grid>

                </StackPanel>
            </Grid>
        </Border>

        </Grid>
        </ScrollViewer>

        <!-- Snackbar Notification -->
        <Border x:Name="SnackbarBorder"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#1E293B" CornerRadius="12"
                Padding="20,12" Margin="0,0,0,30"
                Visibility="Collapsed" Panel.ZIndex="99"
                MinWidth="250">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText"
                           Text="تم حفظ الفاتورة بنجاح"
                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

    </Grid>
</UserControl>
