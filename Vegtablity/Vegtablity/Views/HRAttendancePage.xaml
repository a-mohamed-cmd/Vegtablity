<UserControl x:Class="Views.HRAttendancePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:controls="clr-namespace:Vegtablity.Controls"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:HRAttendanceViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F8FAFC" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Date Filter Bar -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⏰" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="تسجيل الحضور والانصراف وساعات الإضافي والخصم" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="متابعة الحضور اليومي، احتساب ساعات الإضافي ودقائق التأخير تمهيداً لمسير الرواتب" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Date Picker -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="تاريخ اليوم:" FontWeight="Bold" FontSize="13" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <controls:DateBoxControl SelectedDate="{Binding AttendanceDate, Mode=TwoWay}" Height="36" Width="140" FontSize="13"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚡ تعيين الكل حاضر" Command="{Binding FillAllPresentCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#0EA5E9" Foreground="White"
                            Height="38" Padding="12,0" FontSize="13" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="💾 حفظ سجل الحضور" Command="{Binding SaveAttendanceCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White"
                            Height="38" Padding="14,0" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Attendance List Table using AttendanceRowControl -->
        <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="16">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Modern Table Headers -->
                <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0" 
                        CornerRadius="8,8,0,0" Padding="12,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="1.2*" MinWidth="130"/>
                            <ColumnDefinition Width="115"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="75"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="1.1*" MinWidth="110"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الكود" FontWeight="Bold" FontSize="12" Foreground="#475569"/>
                        <TextBlock Grid.Column="1" Text="اسم الموظف / القسم" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="6,0"/>
                        <TextBlock Grid.Column="2" Text="حالة الحضور" FontWeight="Bold" FontSize="12" Foreground="#475569" TextAlignment="Center"/>
                        <TextBlock Grid.Column="3" Text="ساعات عمل" FontWeight="Bold" FontSize="12" Foreground="#475569" TextAlignment="Center"/>
                        <TextBlock Grid.Column="4" Text="إضافي (ساعة)" FontWeight="Bold" FontSize="12" Foreground="#0284C7" TextAlignment="Center"/>
                        <TextBlock Grid.Column="5" Text="إضافي (يوم)" FontWeight="Bold" FontSize="12" Foreground="#4F46E5" TextAlignment="Center"/>
                        <TextBlock Grid.Column="6" Text="تأخير (دقيقة)" FontWeight="Bold" FontSize="12" Foreground="#D97706" TextAlignment="Center"/>
                        <TextBlock Grid.Column="7" Text="خصم غياب (يوم)" FontWeight="Bold" FontSize="12" Foreground="#DC2626" TextAlignment="Center"/>
                        <TextBlock Grid.Column="8" Text="ملاحظات" FontWeight="Bold" FontSize="12" Foreground="#475569" Margin="6,0"/>
                        <TextBlock Grid.Column="9" Text="إجراء سريع" FontWeight="Bold" FontSize="12" Foreground="#475569" TextAlignment="Center" Margin="4,0,0,0"/>
                    </Grid>
                </Border>

                <!-- Custom ListBox using AttendanceRowControl -->
                <ListBox Grid.Row="1" ItemsSource="{Binding AttendanceRecords}"
                         BorderBrush="#E2E8F0" BorderThickness="1" Background="#FAFAFA"
                         HorizontalContentAlignment="Stretch" Padding="6,6"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <controls:AttendanceRowControl/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,0,0,3"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="0" Margin="0">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Border>

        <!-- Modern Floating Snackbar Notification (Always at bottom of entire page) -->
        <Border x:Name="SnackbarBorder" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                Background="#0F172A" CornerRadius="12" Padding="20,12" Margin="0,0,0,30" 
                Visibility="Collapsed" Panel.ZIndex="500" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SnackbarIcon" Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText" Text="تمت العملية بنجاح" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
