<UserControl x:Class="Views.DbUpdaterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Vegtablity.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             FlowDirection="RightToLeft">

    <Grid Background="#F5F7FA">
        <Border Background="White" CornerRadius="12" Padding="30" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center" Width="600">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="15" ShadowDepth="3"/>
            </Border.Effect>
            <StackPanel>
                
                <!-- Icon & Title -->
                <TextBlock Text="🛠️ أداة تحديث قاعدة البيانات" FontSize="24" FontWeight="Bold" Foreground="#1E293B" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="تقوم هذه الأداة بتنفيذ ملفات (سكربتات) التحديث بصيغة .sql مباشرة لتجنب الدخول إلى سيرفر قاعدة البيانات يدوياً." 
                           TextWrapping="Wrap" FontSize="14" Foreground="#64748B" TextAlignment="Center" Margin="0,0,0,30"/>
                
                <!-- File Selection Box -->
                <TextBlock Text="اختر ملف التحديث (.sql)" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,0,5"/>
                <Grid Margin="0,0,0,25">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <TextBox x:Name="txtFilePath" IsReadOnly="True" Height="40" VerticalContentAlignment="Center" Padding="10,0"
                             Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#334155" FontSize="14"
                             BorderThickness="1,1,0,1"/>
                    
                    <Button Grid.Column="1" Content="استعراض..." Click="BtnBrowse_Click" Height="40" Padding="15,0"
                            Background="#E2E8F0" Foreground="#1E293B" FontSize="14" FontWeight="SemiBold" Cursor="Hand" BorderThickness="0,1,1,1" BorderBrush="#CBD5E1"/>
                </Grid>

                <!-- Status Feedback -->
                <Border x:Name="brdStatus" CornerRadius="6" Padding="15" Visibility="Collapsed" Margin="0,0,0,25">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock x:Name="txtStatusIcon" Text="✅" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtStatusMsg" Text="تم التحديث بنجاح" FontSize="15" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
                
                <!-- Warning Text -->
                <TextBlock Text="⚠️ نأمل التأكد من موثوقية ملف SQL قبل تشغيله لتفادي أي ضرر بالبيانات." 
                           Foreground="#EF4444" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                <!-- Action Button -->
                <Button x:Name="btnExecute" Content="تنفيذ التحديث الآن 🚀" Click="BtnExecute_Click" Height="45" Width="200"
                        Background="#4F46E5" Foreground="White" FontSize="16" FontWeight="Bold" Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#4338CA"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Background" Value="#A5B4FC"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

            </StackPanel>
        </Border>
    </Grid>
</UserControl>
