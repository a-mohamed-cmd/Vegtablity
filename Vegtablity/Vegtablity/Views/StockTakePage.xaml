<UserControl x:Class="Views.StockTakePage" x:Name="root"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
       xmlns:local="clr-namespace:Vegtablity.Views"
       xmlns:vm="clr-namespace:Vegtablity.ViewModels"
       xmlns:controls="clr-namespace:Vegtablity.Controls"
       xmlns:helpers="clr-namespace:Vegtablity.Helpers"
       mc:Ignorable="d" 
       d:DesignHeight="700" d:DesignWidth="1100"
       FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}"
       FontFamily="Cairo">

    <UserControl.DataContext>
        <vm:StockTakeViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVis"/>
        <Style x:Key="CenterDataGridCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- ☰ Hamburger Toggle Button for History Sidebar -->
                <Button x:Name="btnToggleHistory" Grid.Column="0"
                        Content="☰" FontSize="20" Width="40" Height="40"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#334155" Cursor="Hand"
                        VerticalAlignment="Center" Margin="0,0,10,0"
                        ToolTip="إظهار / إخفاء سجل الجرد"
                        Click="btnToggleHistory_Click"/>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="📋 " FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text="إدارة الجرد الآلي" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="إنشاء ومراجعة واعتماد تسويات الجرد للمخزون وحساب الفروقات آلياً" Foreground="#64748B" FontSize="13" Margin="28,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="تحديث 🔄" Command="{Binding RefreshCommand}" Style="{StaticResource ModernButtonStyle}" Background="#64748B" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" Height="36" Padding="15,0" Cursor="Hand"/>
                    <Button Content="➕ إضافة مسودة جرد" Command="{Binding AddNewCommand}" Click="BtnAddNew_Click" Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Foreground="White" FontWeight="Bold" Height="36" Padding="15,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- History Sidebar with Collapsible Filter & Pagination -->
            <Border x:Name="HistoryCardBorder" Grid.Column="0" Width="350" MaxWidth="350" MinWidth="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,15,0" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Sidebar Header (Title, Count & Filter Toggle) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜 سجل الجرد" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                            <Border Background="#E0E7FF" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding FilteredStockTakeHistory.Count}" FontSize="12" FontWeight="Bold" Foreground="#3730A3"/>
                            </Border>
                        </StackPanel>

                        <!-- Filter Toggle Button -->
                        <Button x:Name="btnToggleFilter" Grid.Column="1"
                                Content="🔍 تصفية ▼"
                                Style="{StaticResource ModernButtonStyle}"
                                FontSize="12" FontWeight="SemiBold"
                                Background="#F1F5F9" Foreground="#475569"
                                BorderThickness="0"
                                Padding="8,4" Cursor="Hand"
                                Click="btnToggleFilter_Click"
                                ToolTip="إظهار / إخفاء أدوات تصفية السجل"/>
                    </Grid>

                    <!-- Collapsible Filter Card -->
                    <Border x:Name="FilterCardBorder" Grid.Row="1"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Search by Text (ID, Warehouse, User, Notes, Date) -->
                            <TextBlock Text="بحث في السجل:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" Padding="8,0" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     helpers:WatermarkHelper.Watermark="رقم المستند، المستودع، المستخدم..."
                                     Margin="0,0,0,6"/>

                            <!-- Status Filter ComboBox -->
                            <TextBlock Text="حالة المستند:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <ComboBox SelectedIndex="{Binding HistoryStatusFilter, UpdateSourceTrigger=PropertyChanged}"
                                      Height="32" FontSize="12" Margin="0,0,0,8" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="الكل (جميع الحالات)"/>
                                <ComboBoxItem Content="📝 مسودة فقط (قيد المراجعة)"/>
                                <ComboBoxItem Content="✔ معتمد فقط"/>
                            </ComboBox>

                            <!-- Clear Filter Button -->
                            <Button Content="تفريغ التصفية 🔄"
                                    Command="{Binding ClearHistoryFilterCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Height="28" FontSize="11" FontWeight="SemiBold"
                                    Background="#E2E8F0" Foreground="#334155"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch" Cursor="Hand"/>
                        </StackPanel>
                    </Border>
                    
                    <!-- History ListView -->
                    <ListView x:Name="HistoryListView" Grid.Row="2" ItemsSource="{Binding FilteredStockTakeHistory}" SelectedItem="{Binding SelectedStockTake}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,8" Margin="0,2" Background="#F8FAFC" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StockTakeID, StringFormat='#{0}'}" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding StockTakeDate, StringFormat='dd/MM/yyyy HH:mm'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding WarehouseName}" FontSize="11" Foreground="#475569" FontWeight="SemiBold" Margin="0,2,0,0"/>
                                            <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"
                                                       Visibility="{Binding Notes, Converter={StaticResource StringToVis}}"/>
                                        </StackPanel>
                                        
                                        <!-- Status Badge -->
                                        <Border Grid.Column="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Top">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#FEF9C3"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                            <Setter Property="Background" Value="#DCFCE7"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="11" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#854D0E"/>
                                                        <Setter Property="Text" Value="مسودة"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                <Setter Property="Foreground" Value="#166534"/>
                                                                <Setter Property="Text" Value="✔ معتمد"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>

                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding UserName}" Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Text=" • فرق مالي: " Foreground="#94A3B8" FontSize="11"/>
                                            <TextBlock Text="{Binding TotalDifferenceValue, StringFormat='{}{0:N3}'}" FontWeight="Bold" Foreground="#E11D48" FontSize="11"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Pagination Footer (10 records per page) -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="4,8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Previous Button -->
                            <Button Grid.Column="0" Content="◀ السابق"
                                    Command="{Binding PreviousPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="#E2E8F0" Foreground="#334155"
                                    FontSize="11" FontWeight="SemiBold"
                                    Height="28" Padding="8,0" Cursor="Hand"/>
                            <!-- Page Info -->
                            <TextBlock Grid.Column="1" Text="{Binding PageInfo}"
                                       FontSize="11" FontWeight="Bold" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Next Button -->
                            <Button Grid.Column="2" Content="التالي ▶"
                                    Command="{Binding NextPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="#E2E8F0" Foreground="#334155"
                                    FontSize="11" FontWeight="SemiBold"
                                    Height="28" Padding="8,0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Details / Edit Form -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>

                <Grid>
                    <!-- Form for Adding / Editing Stock Take -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="إنشاء مسودة جرد جديدة" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15"/>

                        <!-- Warehouse & Notes -->
                        <Grid Grid.Row="1" Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="1.5*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="المستودع (الجرد الفعلي) *" Foreground="#64748B" Margin="0,0,0,5" FontWeight="Bold"/>
                                <ComboBox x:Name="WarehouseComboBox"
                                          ItemsSource="{Binding Warehouses}"
                                          SelectedValue="{Binding CurrentStockTake.WarehouseID, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="WarehouseID"
                                          DisplayMemberPath="WarehouseName"
                                          IsEnabled="{Binding IsWarehouseEnabled}"
                                          Height="40" VerticalContentAlignment="Center" FontSize="14"
                                          SelectionChanged="WarehouseComboBox_SelectionChanged"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ملاحظات الجرد:" Foreground="#64748B" Margin="0,0,0,5" FontWeight="Bold"/>
                                <TextBox Text="{Binding CurrentStockTake.Notes, UpdateSourceTrigger=PropertyChanged}" Height="40" VerticalContentAlignment="Center" Style="{DynamicResource ModernTextBoxStyle}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Add Rows & ItemsControl -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Toolbar -->
                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="قائمة الأصناف المجردة:" FontWeight="Bold" FontSize="15" Foreground="#334155" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📥 قالب الجرد" Command="{Binding DownloadTemplateCommand}" Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White" FontWeight="Bold" Height="34" Margin="0,0,6,0" Padding="12,0" Cursor="Hand"/>
                                    <Button Content="📂 استيراد الإكسيل" Command="{Binding ImportExcelCommand}" Style="{StaticResource ModernButtonStyle}" Background="#8B5CF6" Foreground="White" FontWeight="Bold" Height="34" Margin="0,0,6,0" Padding="12,0" Cursor="Hand"/>
                                    <Button Content="➕ إضافة صنف" Click="BtnAddItem_Click" Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Foreground="White" FontWeight="Bold" Height="34" Padding="15,0" Cursor="Hand"/>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Table Column Headers -->
                            <Border Grid.Row="1" Background="#F1F5F9" CornerRadius="8,8,0,0" Padding="8,10" BorderBrush="#E2E8F0" BorderThickness="1,1,1,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- 0: Product Code / Barcode -->
                                        <ColumnDefinition Width="100"/>
                                        <!-- 1: Product SearchableDropdown (Expanding) -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- 2: Refresh System Stock Button -->
                                        <ColumnDefinition Width="32"/>
                                        <!-- 3: System Quantity -->
                                        <ColumnDefinition Width="85"/>
                                        <!-- 4: Actual Quantity -->
                                        <ColumnDefinition Width="85"/>
                                        <!-- 5: Difference Quantity -->
                                        <ColumnDefinition Width="80"/>
                                        <!-- 6: Cost Price -->
                                        <ColumnDefinition Width="85"/>
                                        <!-- 7: Difference Value -->
                                        <ColumnDefinition Width="95"/>
                                        <!-- 8: Delete Action -->
                                        <ColumnDefinition Width="36"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="كود الصنف" FontWeight="Bold" Foreground="#334155" Margin="5,0"/>
                                    <TextBlock Grid.Column="1" Text="اسم الصنف / المنتج" FontWeight="Bold" Foreground="#334155" Margin="5,0"/>
                                    <TextBlock Grid.Column="2" Text="🔄" FontWeight="Bold" Foreground="#64748B" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="الكمية الدفترية" FontWeight="Bold" Foreground="#2563EB" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="الكمية الفعلية" FontWeight="Bold" Foreground="#334155" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="فرق الكمية" FontWeight="Bold" Foreground="#334155" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="تكلفة الوحدة" FontWeight="Bold" Foreground="#334155" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="قيمة الفرق" FontWeight="Bold" Foreground="#E11D48" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="8" Text="حذف" FontWeight="Bold" Foreground="#EF4444" TextAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- ItemsControl with StockTakeItemRowControl -->
                            <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" MinHeight="230">
                                    <ItemsControl x:Name="DetailsItemsControl" ItemsSource="{Binding CurrentStockTake.Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:StockTakeItemRowControl
                                                    ProductsList="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    WarehouseID="{Binding DataContext.CurrentStockTake.WarehouseID, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    RequestAddNewRow="StockTakeItemRow_RequestAddNewRow"
                                                    RequestDeleteRow="StockTakeItemRow_RequestDeleteRow"
                                                    AmountChanged="StockTakeItemRow_AmountChanged"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Footer Actions -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="إجمالي الفروقات المالية:" Foreground="#64748B" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentStockTake.TotalDifferenceValue, StringFormat='{}{0:N3}'}" FontSize="18" FontWeight="Bold" Foreground="#E11D48" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="إلغاء" Command="{Binding RefreshCommand}" Style="{StaticResource ModernButtonStyle}" Background="#95A5A6" Width="100" Margin="0,0,10,0"/>
                            <Button Content="حفظ كمسودة" Command="{Binding SaveCommand}" Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Width="150"/>
                        </StackPanel>
                    </Grid>

                    <!-- View Selected Stock Take (Read-Only Detail Card) -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- Placeholder -->
                        <TextBlock Text="الرجاء اختيار مستند جرد من القائمة أو إنشاء مسودة جديدة." 
                                   Foreground="#94A3B8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStockTake}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <!-- Selected Document Content -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStockTake}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedStockTake.StockTakeDate, StringFormat='مستند جرد بتاريخ: dd/MM/yyyy HH:mm'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🏭 " FontSize="13"/>
                                                <TextBlock Text="المستودع: " FontSize="13" Foreground="#3B82F6" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedStockTake.WarehouseName}" FontSize="13" Foreground="#1D4ED8" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F0FDF4" CornerRadius="4" Padding="8,3" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤 " FontSize="13"/>
                                                <TextBlock Text="بواسطة: " FontSize="13" Foreground="#16A34A" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedStockTake.UserName}" FontSize="13" Foreground="#15803D" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedStockTake.Notes}" Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding SelectedStockTake.Notes, Converter={StaticResource StringToVis}}"/>
                                </StackPanel>

                                <!-- Status Tag -->
                                <Border Grid.Column="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Top">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#FEF9C3"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedStockTake.Status}" Value="Approved">
                                                    <Setter Property="Background" Value="#DCFCE7"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontWeight="Bold" FontSize="13">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#854D0E"/>
                                                <Setter Property="Text" Value="مسودة (قيد المراجعة)"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedStockTake.Status}" Value="Approved">
                                                        <Setter Property="Foreground" Value="#166534"/>
                                                        <Setter Property="Text" Value="✔ معتمد نهائياً"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </Grid>

                            <!-- Read-only Details DataGrid -->
                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedStockTake.Details}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="32" FontWeight="Bold">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="كود الصنف" Binding="{Binding ProductCode}" Width="100"/>
                                    <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="الكمية الدفترية" Binding="{Binding SystemQuantity, StringFormat='N2'}" Width="110" ElementStyle="{StaticResource CenterDataGridCellStyle}"/>
                                    <DataGridTextColumn Header="الكمية الفعلية" Binding="{Binding ActualQuantity, StringFormat='N2'}" Width="110" ElementStyle="{StaticResource CenterDataGridCellStyle}"/>
                                    <DataGridTextColumn Header="الفرق" Binding="{Binding DifferenceQuantity, StringFormat='N2'}" Width="90" ElementStyle="{StaticResource CenterDataGridCellStyle}"/>
                                    <DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding CostPrice, StringFormat='N3'}" Width="100" ElementStyle="{StaticResource CenterDataGridCellStyle}"/>
                                    <DataGridTextColumn Header="قيمة الفرق" Binding="{Binding DifferenceValue, StringFormat='N3'}" Width="120" ElementStyle="{StaticResource CenterDataGridCellStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Footer for Selected Document -->
                            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="6" Padding="15" Margin="0,15,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="إجمالي الفروقات المالية:" FontSize="15" Foreground="#64748B" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedStockTake.TotalDifferenceValue, StringFormat='{}{0:N3}'}" FontSize="20" FontWeight="Bold" Foreground="#E11D48" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="🖨️ طباعة المستند" Command="{Binding PrintCommand}" Style="{StaticResource ModernButtonStyle}" Background="#27AE60" Height="36" Padding="15,0" Margin="0,0,10,0"/>
                                        <Button Content="✔ اعتماد تسوية الجرد النهائية" Command="{Binding ApproveCommand}" Height="36" Padding="15,0" Margin="0,0,10,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                    <Setter Property="Background" Value="#E74C3C"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStockTake.Status}" Value="Approved">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="✏️ تعديل المسودة" Command="{Binding EditCommand}" Height="36" Padding="15,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                    <Setter Property="Background" Value="#3498DB"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStockTake.Status}" Value="Approved">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Snackbar for notifications -->
        <Border x:Name="Snackbar" Grid.RowSpan="2"
                Background="#1E293B" CornerRadius="8" Padding="20,12"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                Visibility="Collapsed" Panel.ZIndex="9999"
                MinWidth="250" MaxWidth="600">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
            <TextBlock x:Name="SnackbarText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </Border>

    </Grid>
</UserControl>
