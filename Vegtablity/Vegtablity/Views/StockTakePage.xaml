<UserControl x:Class="Views.StockTakePage" x:Name="root"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Vegtablity.Views"
      xmlns:vm="clr-namespace:Vegtablity.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}"
      FontFamily="Cairo">

    <UserControl.DataContext>
        <vm:StockTakeViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <CollectionViewSource x:Key="ProductsList" Source="{Binding AvailableProducts}"/>
        <Style x:Key="CenterDataGridCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="إدارة الجرد الآلي" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="إنشاء ومراجعة واعتماد تسويات الجرد للمخزون" Foreground="#64748B" FontSize="14" Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource ModernButtonStyle}" Background="#95a5a6" Margin="0,0,5,0" Width="100" Height="35"/>
                    <Button Content="إضافة مسودة جرد" Command="{Binding AddNewCommand}" Click="BtnAddNew_Click" Style="{StaticResource ModernButtonStyle}" Background="#3498db" Width="150" Height="35"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- History List -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Toggle Button -->
                <Button x:Name="btnToggleHistory" Grid.Row="0" Content="≡" FontSize="24" FontWeight="Bold" Background="Transparent" BorderThickness="0" Click="btnToggleHistory_Click" HorizontalAlignment="Right" Margin="0,0,0,5" Cursor="Hand" Foreground="#334155" ToolTip="تصغير / تكبير"/>
                
                <Border x:Name="HistoryCard" Grid.Row="1" Width="350" Background="White" CornerRadius="8" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Text="سجل الجرد" FontWeight="Bold" FontSize="16" Foreground="#334155" Margin="0,0,0,15"/>
                        
                        <ListView x:Name="HistoryListView" Grid.Row="1" ItemsSource="{Binding StockTakeHistory}" SelectedItem="{Binding SelectedStockTake}" BorderThickness="0" Background="Transparent">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <TextBlock Text="{Binding StockTakeDate, StringFormat='dd/MM/yyyy HH:mm'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            
                                            <!-- Status Badge -->
                                            <Border Grid.Column="1" CornerRadius="4" Padding="6,2">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F1F5F9"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                <Setter Property="Background" Value="#DCFCE7"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                <Setter Property="Background" Value="#FEF9C3"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#64748B"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Approved">
                                                                    <Setter Property="Foreground" Value="#166534"/>
                                                                    <Setter Property="Text" Value="معتمد"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Pending">
                                                                    <Setter Property="Foreground" Value="#854D0E"/>
                                                                    <Setter Property="Text" Value="مسودة"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="{Binding WarehouseName}" Foreground="#64748B" FontSize="12" Margin="0,0,10,0"/>
                                                <TextBlock Text="{Binding UserName}" Foreground="#94A3B8" FontSize="12"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Grid>
                </Border>
            </Grid>

            <!-- Details / Edit Form -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>

                <Grid>
                    <!-- Form for Adding New Stock Take -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Text="إنشاء مسودة جرد جديدة" FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20"/>

                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="المستودع (الجرد الفعلي) *" Foreground="#64748B" Margin="0,0,0,5" FontWeight="Bold"/>
                                <ComboBox x:Name="WarehouseComboBox"
                                          ItemsSource="{Binding Warehouses}"
                                          SelectedValue="{Binding CurrentStockTake.WarehouseID, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="WarehouseID"
                                          DisplayMemberPath="WarehouseName"
                                          IsEnabled="{Binding IsWarehouseEnabled}"
                                          Height="40" Margin="0,0,0,10"
                                          SelectionChanged="WarehouseComboBox_SelectionChanged"/>
                            </StackPanel>
                            
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="ملاحظات الجرد:" Foreground="#64748B" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CurrentStockTake.Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="40" Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,0,10"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="2">
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="قائمة الأصناف المجردة:" FontWeight="Bold" Foreground="#334155" VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="📥 قالب الجرد" Command="{Binding DownloadTemplateCommand}" Style="{StaticResource ModernButtonStyle}" Background="#10B981" Width="100" Height="30" Margin="0,0,5,0" Padding="5,0"/>
                                    <Button Content="📂 استيراد الإكسيل" Command="{Binding ImportExcelCommand}" Style="{StaticResource ModernButtonStyle}" Background="#8B5CF6" Width="130" Height="30" Margin="0,0,5,0" Padding="5,0"/>
                                    <Button Content="+ إضافة صنف" Click="BtnAddItem_Click" Style="{StaticResource ModernButtonStyle}" Background="#3b82f6" Width="100" Height="30"/>
                                </StackPanel>
                            </Grid>
                            
                            <DataGrid x:Name="dgDetails" ItemsSource="{Binding CurrentStockTake.Details}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" Height="300" RowHeight="30" FontWeight="Bold" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="كود الصنف" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProductCode}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ProductCode, UpdateSourceTrigger=Explicit}" PreviewKeyDown="Barcode_PreviewKeyDown" Loaded="TextBox_Loaded" TextAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTemplateColumn Header="المنتج" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" Margin="5,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Source={StaticResource ProductsList}}"
                                                          SelectedValue="{Binding ProductID, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="ProductID"
                                                          DisplayMemberPath="ProductName"
                                                          PreviewKeyDown="ProductComboBox_PreviewKeyDown"
                                                          DropDownClosed="ProductComboBox_DropDownClosed"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <!-- Button to fetch system qty manually if needed -->
                                    <DataGridTemplateColumn Width="120">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="تحديث كمية النظام" Command="{Binding DataContext.FetchSystemQuantityCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ModernButtonStyle}" Background="#94A3B8" Width="100"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="الكمية الدفترية" Binding="{Binding SystemQuantity, StringFormat='N2'}" IsReadOnly="True" Width="110"/>
                                    
                                    <DataGridTemplateColumn Header="الكمية الفعلية" Width="110">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ActualQuantity}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ActualQuantity, UpdateSourceTrigger=Explicit}" PreviewKeyDown="Quantity_PreviewKeyDown" Loaded="TextBox_Loaded" TextAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Header="الفرق" Binding="{Binding DifferenceQuantity, StringFormat='N2'}" IsReadOnly="True" Width="80">
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource CenterDataGridCellStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding DifferenceQuantity}" Value="0">
                                                        <Setter Property="Foreground" Value="#10B981"/> <!-- Green if zero -->
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    
                                    <DataGridTextColumn Header="قيمة الفرق" Binding="{Binding DifferenceValue, StringFormat='N3'}" IsReadOnly="True" Width="100" ElementStyle="{StaticResource CenterDataGridCellStyle}"/>
                                    
                                    <DataGridTemplateColumn Header="حذف" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderThickness="0" 
                                                        Click="BtnDeleteRow_Click"
                                                        Focusable="False"
                                                        Tag="{Binding}"
                                                        ToolTip="حذف السطر" Cursor="Hand">
                                                    <TextBlock Text="🗑️" Foreground="#EF4444" FontSize="16"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="إجمالي الفروقات المالية:" Foreground="#64748B" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentStockTake.TotalDifferenceValue, StringFormat='N3'}" FontSize="18" FontWeight="Bold" Foreground="#E11D48" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Content="إلغاء" Command="{Binding RefreshCommand}" Style="{StaticResource ModernButtonStyle}" Background="#95a5a6" Width="100" Margin="0,0,10,0"/>
                            <Button Content="حفظ كمسودة" Command="{Binding SaveCommand}" Style="{StaticResource ModernButtonStyle}" Background="#3498db" Width="150"/>
                        </StackPanel>
                    </Grid>

                    <!-- View Selected Stock Take -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <!-- Placeholder -->
                        <TextBlock Text="الرجاء اختيار مستند جرد من القائمة أو إنشاء مسودة جديدة." 
                                   Foreground="#94A3B8" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStockTake}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        
                        <!-- Content -->
                        <Grid>
                            <Grid.Style>
                                <Style TargetType="Grid">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedStockTake}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Grid.Style>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel>
                                    <TextBlock Text="{Binding SelectedStockTake.StockTakeDate, StringFormat='مستند جرد بتاريخ: dd/MM/yyyy'}" FontSize="18" FontWeight="Bold" Foreground="#0F172A"/>
                                    <!-- اسم المستودع -->
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Background="#EFF6FF" CornerRadius="4" Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🏭 " FontSize="13"/>
                                                <TextBlock Text="المستودع: " FontSize="13" Foreground="#3B82F6" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedStockTake.WarehouseName}" FontSize="13" Foreground="#1D4ED8" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="#F0FDF4" CornerRadius="4" Padding="8,3" Margin="8,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="👤 " FontSize="13"/>
                                                <TextBlock Text="بواسطة: " FontSize="13" Foreground="#16A34A" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedStockTake.UserName}" FontSize="13" Foreground="#15803D" FontWeight="Bold"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding SelectedStockTake.Notes}" Foreground="#64748B" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                            </Grid>

                            <DataGrid Grid.Row="1" ItemsSource="{Binding SelectedStockTake.Details}" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="30" FontWeight="Bold">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="كود الصنف" Binding="{Binding ProductCode}" Width="100"/>
                                    <DataGridTextColumn Header="المنتج" Binding="{Binding ProductName}" Width="*"/>
                                    <DataGridTextColumn Header="الكمية الدفترية" Binding="{Binding SystemQuantity, StringFormat='N2'}" Width="110"/>
                                    <DataGridTextColumn Header="الكمية الفعلية" Binding="{Binding ActualQuantity, StringFormat='N2'}" Width="110"/>
                                    <DataGridTextColumn Header="الفرق" Binding="{Binding DifferenceQuantity, StringFormat='N2'}" Width="80"/>
                                    <DataGridTextColumn Header="قيمة العجز/الفائض" Binding="{Binding DifferenceValue, StringFormat='N3'}" Width="120"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="2" Background="#F8FAFC" CornerRadius="6" Padding="15" Margin="0,20,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- إجمالي الفروقات — على اليمين (Column 0 في RTL) -->
                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="إجمالي الفروقات المالية:" FontSize="16" Foreground="#64748B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding SelectedStockTake.TotalDifferenceValue, StringFormat='N3'}" FontSize="24" FontWeight="Bold" Foreground="#0F172A" VerticalAlignment="Center"/>
                                    </StackPanel>

                                    <!-- الأزرار — على اليسار (Column 1 في RTL) -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <Button Content="طباعة" Command="{Binding PrintCommand}" Style="{StaticResource ModernButtonStyle}" Background="#27ae60" Width="100" Margin="0,0,10,0"/>
                                        <Button Content="اعتماد تسوية الجرد النهائية" Command="{Binding ApproveCommand}" Width="220" Margin="0,0,10,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                    <Setter Property="Background" Value="#e74c3c"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStockTake.Status}" Value="Approved">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="تعديل المسودة" Command="{Binding EditCommand}" Width="150">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                                    <Setter Property="Background" Value="#3498db"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedStockTake.Status}" Value="Approved">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Snackbar for notifications — يظهر في أسفل الصفحة فوق كل المحتوى -->
        <Border x:Name="Snackbar" Grid.RowSpan="2"
                Background="#1E293B" CornerRadius="8" Padding="20,12"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"
                Visibility="Collapsed" Panel.ZIndex="9999"
                MinWidth="250" MaxWidth="600">
            <Border.Effect>
                <DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="4" Opacity="0.4"/>
            </Border.Effect>
            <TextBlock x:Name="SnackbarText" Foreground="White" FontSize="14" FontWeight="SemiBold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        </Border>

    </Grid>
</UserControl>
