<UserControl x:Class="Views.ReportsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:vm="clr-namespace:Vegtablity.ViewModels"
      xmlns:helpers="clr-namespace:Vegtablity.Helpers"
      xmlns:controls="clr-namespace:Vegtablity.Controls"
      mc:Ignorable="d" 
      d:DesignHeight="820" d:DesignWidth="1320"
      FlowDirection="RightToLeft"
      FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo"
      Background="#F1F5F9">

    <UserControl.DataContext>
        <vm:ReportsViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Modern Card Style -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#0F172A" Direction="270" ShadowDepth="2" BlurRadius="10" Opacity="0.04"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary Action Button -->
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#2563EB"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick Preset Pill Button -->
        <Style x:Key="PresetBtn" TargetType="Button">
            <Setter Property="Background" Value="#F8FAFC"/>
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="PillBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="PillBd" Property="BorderBrush" Value="#93C5FD"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Sidebar Navigation ListBoxItem Style -->
        <Style x:Key="NavListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Indicator" Grid.Column="0" Width="3" CornerRadius="2" Background="Transparent" Margin="0,2,8,2"/>
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#BFDBFE"/>
                                <Setter TargetName="Indicator" Property="Background" Value="#2563EB"/>
                                <Setter Property="Foreground" Value="#1D4ED8"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <!-- Collapsible Sidebar Column (Auto width animated via SidebarBorder.MaxWidth) -->
            <ColumnDefinition Width="Auto"/>
            <!-- Main Report Workspace -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ======================================================= -->
        <!-- 1. COLLAPSIBLE SIDEBAR (القائمة الجانبية - التقارير الشاملة) -->
        <!-- ======================================================= -->
        <Border x:Name="SidebarBorder"
                Grid.Column="0"
                Width="255"
                MaxWidth="255"
                Margin="0,0,12,0"
                ClipToBounds="True"
                Style="{StaticResource CardBorder}"
                Padding="10,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header + Collapse Button -->
                <Grid Grid.Row="0" Margin="4,0,4,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#EFF6FF" CornerRadius="8" Width="32" Height="32" Margin="0,0,8,0">
                            <TextBlock Text="📊" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="التقارير الشاملة" FontSize="15" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="16 تقرير تحليلي متكامل" FontSize="10.5" Foreground="#64748B"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Click="BtnToggleSidebar_Click"
                            ToolTip="طي القائمة الجانبية"
                            Background="#F1F5F9"
                            Foreground="#475569"
                            BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            Width="30" Height="30"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="BtnBd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
                                    <TextBlock Text="❯" FontSize="12" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="BtnBd" Property="Background" Value="#E2E8F0"/>
                                        <Setter Property="Foreground" Value="#0F172A"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Separator Grid.Row="1" Background="#F1F5F9" Margin="0,0,0,8"/>

                <!-- Report Navigation ListBox (Indices 0..14 preserved 100%) -->
                <ListBox Grid.Row="2"
                         x:Name="ReportListBox"
                         BorderThickness="0"
                         Background="Transparent"
                         SelectedIndex="{Binding SelectedReportTab, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource NavListItem}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <!-- 0 -->
                    <ListBoxItem Content="📦 أرباح الأصناف والمنتجات"/>
                    <!-- 1 -->
                    <ListBoxItem Content="🧾 أرباح الفواتير التفصيلي"/>
                    <!-- 2 -->
                    <ListBoxItem Content="📅 المبيعات اليومية / الشهرية"/>
                    <!-- 3 -->
                    <ListBoxItem Content="🏆 مبيعات العملاء - أقوى شركاء"/>
                    <!-- 4 -->
                    <ListBoxItem Content="⏳ أعمار الديون - فواتير متأخرة"/>
                    <!-- 5 -->
                    <ListBoxItem Content="🏢 جرد وتقييم المخزون"/>
                    <!-- 6 -->
                    <ListBoxItem Content="🕸️ الأصناف الراكدة"/>
                    <!-- 7 -->
                    <ListBoxItem Content="🔄 حركة صنف في مستودع"/>
                    <!-- 8 -->
                    <ListBoxItem Content="💸 تحليل المصروفات"/>
                    <!-- 9 -->
                    <ListBoxItem Content="📜 عروض الأسعار"/>
                    <!-- 10 -->
                    <ListBoxItem Content="📊 ملخص ربحية العملاء"/>
                    <!-- 11 -->
                    <ListBoxItem Content="📑 تفاصيل أرباح فواتير العميل"/>
                    <!-- 12 -->
                    <ListBoxItem Content="🛒 ربحية أصناف العميل"/>
                    <!-- 13 -->
                    <ListBoxItem Content="🗑️ تقرير الهالك والتوالف"/>
                    <!-- 14 -->
                    <ListBoxItem Content="🏬 مبيعات الفروع والمخازن"/>
                    <!-- 15 (NEW) -->
                    <ListBoxItem Content="📥 تقرير فواتير المشتريات"/>
                </ListBox>
            </Grid>
        </Border>

        <!-- ======================================================= -->
        <!-- 2. MAIN REPORT WORKSPACE (الفلاتر + شريط الإجماليات + جدول UserControl) -->
        <!-- ======================================================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <!-- Row 0: Top Filter & Actions Card -->
                <RowDefinition Height="Auto"/>
                <!-- Row 1: Top Summary Bar (شريط الإجماليات أعلى كل تقرير) -->
                <RowDefinition Height="Auto"/>
                <!-- Row 2: Custom UserControl Report Table -->
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ─────────────────────────────────────────────────────── -->
            <!-- ROW 0: TOP FILTER BAR & QUICK PRESETS & EXPORT ACTIONS  -->
            <!-- ─────────────────────────────────────────────────────── -->
            <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,10" Padding="14,10">
                <StackPanel>
                    <!-- Top Line: Expand Sidebar Button + Active Report Title + Quick Date Presets + Export Buttons -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Expand / Toggle Sidebar Button -->
                        <Button x:Name="BtnExpandSidebar"
                                Grid.Column="0"
                                Click="BtnToggleSidebar_Click"
                                ToolTip="إظهار / طي القائمة الجانبية للتقارير"
                                Style="{StaticResource PresetBtn}"
                                Padding="10,6"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtToggleIcon" Text="☰" FontSize="13" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtToggleLabel" Text="طي القائمة" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Active Report Title & Subtitle -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentReportTitle}" FontSize="16" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text="{Binding CurrentReportSubtitle}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <!-- Quick Date Range Presets -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0">
                            <TextBlock Text="فترة سريعة:" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,6,0"/>
                            <Button Content="اليوم" Command="{Binding SetTodayRangeCommand}" Style="{StaticResource PresetBtn}"/>
                            <Button Content="هذا الأسبوع" Command="{Binding SetWeekRangeCommand}" Style="{StaticResource PresetBtn}"/>
                            <Button Content="هذا الشهر" Command="{Binding SetMonthRangeCommand}" Style="{StaticResource PresetBtn}"/>
                            <Button Content="هذا العام" Command="{Binding SetYearRangeCommand}" Style="{StaticResource PresetBtn}"/>
                        </StackPanel>

                        <!-- Export Actions -->
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📄 تصدير PDF" Style="{StaticResource PrimaryBtn}" Background="#E11D48" Margin="0,0,6,0" Click="BtnExportPdf_Click"/>
                            <Button Content="📊 تصدير Excel" Style="{StaticResource PrimaryBtn}" Background="#10B981" Click="BtnExportCsv_Click"/>
                        </StackPanel>
                    </Grid>

                    <Separator Background="#F1F5F9" Margin="0,0,0,10"/>

                    <!-- Bottom Line: Date Range Inputs + Contextual SearchableDropdowns + In-Report Search + Update Button -->
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Start Date -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,12,2" VerticalAlignment="Center">
                            <TextBlock Text="من:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                            <TextBox x:Name="txtStartDate"
                                     Text="{Binding SelectedStartDateText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="105" Height="34" Padding="8,0"
                                     FontSize="12.5" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     PreviewTextInput="DateTextBox_PreviewTextInput"
                                     TextChanged="StartDateTextBox_TextChanged"
                                     LostFocus="StartDateTextBox_LostFocus">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="7"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <!-- End Date -->
                        <StackPanel Orientation="Horizontal" Margin="0,2,12,2" VerticalAlignment="Center">
                            <TextBlock Text="إلى:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" FontSize="12" Foreground="#475569"/>
                            <TextBox x:Name="txtEndDate"
                                     Text="{Binding SelectedEndDateText, UpdateSourceTrigger=PropertyChanged}"
                                     Width="105" Height="34" Padding="8,0"
                                     FontSize="12.5" FontWeight="SemiBold"
                                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                     PreviewTextInput="DateTextBox_PreviewTextInput"
                                     TextChanged="EndDateTextBox_TextChanged"
                                     LostFocus="EndDateTextBox_LostFocus">
                                <TextBox.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="7"/>
                                    </Style>
                                </TextBox.Resources>
                            </TextBox>
                        </StackPanel>

                        <!-- Contextual Warehouse / Branch SearchableDropdown (Tabs 5, 7, 13, 14) -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2,12,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowWarehouseFilter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="الفرع / المخزن:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold" FontSize="12" Foreground="#1E40AF"/>
                            <controls:SearchableDropdown x:Name="WarehouseFilterDropdown"
                                                         Width="205" Height="34"
                                                         ItemsSource="{Binding Warehouses}"
                                                         DisplayMemberPath="WarehouseName"
                                                         Watermark="ابحث عن الفرع أو المخزن..."
                                                         SearchChanged="WarehouseDropdown_SearchChanged"
                                                         ItemSelected="WarehouseDropdown_ItemSelected"/>
                        </StackPanel>

                        <!-- Contextual Partner / Customer / Supplier SearchableDropdown (Tabs 4, 10, 11, 12, 15) -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2,12,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowPartnerFilter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding PartnerFilterLabel}" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold" FontSize="12" Foreground="#1E40AF"/>
                            <controls:SearchableDropdown x:Name="PartnerFilterDropdown"
                                                         Width="225" Height="34"
                                                         ItemsSource="{Binding Partners}"
                                                         DisplayMemberPath="PartnerName"
                                                         Watermark="{Binding PartnerFilterWatermark}"
                                                         SearchChanged="PartnerDropdown_SearchChanged"
                                                         ItemSelected="PartnerDropdown_ItemSelected"/>
                        </StackPanel>

                        <!-- Contextual Product SearchableDropdown (Tab 7) -->
                        <StackPanel Orientation="Horizontal"
                                    Margin="0,2,12,2"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding ShowProductFilter, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="الصنف:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold" FontSize="12" Foreground="#1E40AF"/>
                            <controls:SearchableDropdown x:Name="ProductFilterDropdown"
                                                         Width="220" Height="34"
                                                         ItemsSource="{Binding Products}"
                                                         DisplayMemberPath="ProductName"
                                                         Watermark="ابحث عن الصنف..."
                                                         SearchChanged="ProductDropdown_SearchChanged"
                                                         ItemSelected="ProductDropdown_ItemSelected"/>
                        </StackPanel>

                        <!-- Refresh / Load Report Button -->
                        <Button Content="🔄 تحديث التقرير"
                                Command="{Binding LoadReportCommand}"
                                Style="{StaticResource PrimaryBtn}"
                                Height="34"
                                Margin="0,2,14,2"/>

                        <!-- Instant In-Report Filter Box -->
                        <Border Background="#F8FAFC"
                                BorderBrush="#CBD5E1"
                                BorderThickness="1"
                                CornerRadius="8"
                                Height="34"
                                Padding="8,0"
                                Margin="0,2,0,2">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🔍" FontSize="12" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Grid Width="210">
                                    <TextBox x:Name="TxtQuickSearch"
                                             Text="{Binding ReportQuickSearch, UpdateSourceTrigger=PropertyChanged}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="12"
                                             FontWeight="SemiBold"
                                             Foreground="#0F172A"
                                             VerticalContentAlignment="Center"/>
                                    <TextBlock Text="بحث فوري داخل نتائج التقرير..."
                                               FontSize="11.5"
                                               Foreground="#94A3B8"
                                               VerticalAlignment="Center"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtQuickSearch}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                                <Button Content="✕"
                                        Command="{Binding ClearQuickSearchCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="#64748B"
                                        FontWeight="Bold"
                                        Cursor="Hand"
                                        Padding="4,0"
                                        ToolTip="مسح البحث"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- ─────────────────────────────────────────────────────── -->
            <!-- ROW 1: TOP SUMMARY BAR ABOVE EVERY REPORT (شريط الإجمالي) -->
            <!-- ─────────────────────────────────────────────────────── -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding SummaryMetrics}"
                          Margin="0,0,0,10">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{Binding BgColor}"
                                BorderBrush="{Binding BorderColor}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="14,10"
                                Margin="4,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Metric Icon Badge -->
                                <Border Grid.Column="0"
                                        Background="White"
                                        BorderBrush="{Binding BorderColor}"
                                        BorderThickness="1"
                                        CornerRadius="9"
                                        Width="40" Height="40"
                                        Margin="0,0,12,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="18"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <!-- Metric Title, Total Value & Subtext -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="11.5"
                                               FontWeight="Bold"
                                               Foreground="#475569"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding ValueText}"
                                               FontSize="18"
                                               FontWeight="ExtraBold"
                                               Foreground="{Binding AccentColor}"
                                               Margin="0,1,0,1"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SubText}"
                                               FontSize="10.5"
                                               FontWeight="SemiBold"
                                               Foreground="#64748B"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ─────────────────────────────────────────────────────── -->
            <!-- ROW 2: CUSTOM USERCONTROL REPORT TABLE + PAGINATION BAR -->
            <!-- ─────────────────────────────────────────────────────── -->
            <Border Grid.Row="2" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <!-- Table Header Bar -->
                        <RowDefinition Height="Auto"/>
                        <!-- Virtualized ReportRowControl Rows -->
                        <RowDefinition Height="*"/>
                        <!-- Pagination Footer Bar -->
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- 1. Dynamic Proportional Table Header Bar -->
                    <Border Grid.Row="0"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,0,0,2"
                            Padding="10,10">
                        <Grid x:Name="ReportHeadersGrid" VerticalAlignment="Center"/>
                    </Border>

                    <!-- 2. Custom UserControl Rows (ReportRowControl) -->
                    <ScrollViewer x:Name="ReportScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding CurrentReportRows}"
                                          VirtualizingPanel.IsVirtualizing="True"
                                          VirtualizingPanel.VirtualizationMode="Recycling"
                                          ScrollViewer.CanContentScroll="True">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:ReportRowControl />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Empty State when no records match -->
                            <StackPanel VerticalAlignment="Center"
                                        HorizontalAlignment="Center"
                                        Margin="0,60">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasReportRows}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="40" Width="68" Height="68" HorizontalAlignment="Center" Margin="0,0,0,12">
                                    <TextBlock Text="📭" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="لا توجد بيانات مطابقة لعرضها في هذا التقرير"
                                           FontSize="15" FontWeight="Bold" Foreground="#334155" HorizontalAlignment="Center"/>
                                <TextBlock Text="جرّب تغيير الفترة الزمنية أو الفلاتر المحددة ثم اضغط على (تحديث التقرير)"
                                           FontSize="12" Foreground="#64748B" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- 3. Pagination Footer Bar -->
                    <Border Grid.Row="2"
                            Background="#F8FAFC"
                            BorderBrush="#E2E8F0"
                            BorderThickness="0,1,0,0"
                            Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="▶ الصفحة السابقة"
                                    Command="{Binding PrevReportPageCommand}"
                                    IsEnabled="{Binding CanGoPrevReport}"
                                    Style="{StaticResource PrimaryBtn}"
                                    Padding="12,5"
                                    FontSize="12"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ReportPageLabel}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="#334155"
                                       FontSize="12.5"
                                       FontWeight="Bold"/>

                            <Button Grid.Column="2"
                                    Content="الصفحة التالية ◀"
                                    Command="{Binding NextReportPageCommand}"
                                    IsEnabled="{Binding CanGoNextReport}"
                                    Style="{StaticResource PrimaryBtn}"
                                    Padding="12,5"
                                    FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
