<UserControl x:Class="Views.ReportsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Vegtablity"
             xmlns:viewmodels="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1200"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <viewmodels:ReportsViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:ProfitColorConverter x:Key="ProfitColorConverter"/>

        <!-- Fade in animation for contents -->
        <Storyboard x:Key="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEaseInOut}"/>
            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.4" EasingFunction="{StaticResource SmoothEaseInOut}"/>
        </Storyboard>
        
        <Style TargetType="TabItem" x:Key="SideTabItemStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Border" Padding="15,12" Background="Transparent" CornerRadius="8" Margin="0,2,0,2">
                            <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Left" ContentSource="Header" Margin="5,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#EEF2FF"/>
                                <Setter Property="Foreground" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsSelected" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Border" Property="Background" Value="#EEF2FF"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F5F7FA">
        <Grid.ColumnDefinitions>
            <!-- Sidebar for Report Selection -->
            <ColumnDefinition Width="280"/>
            <!-- Report Content -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E2E8F0" BorderThickness="0,0,1,0" Padding="15">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock Text="التقارير الشاملة" FontSize="22" FontWeight="Bold" Foreground="#1E293B" Margin="10,10,0,20"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TabControl x:Name="TabControl" TabStripPlacement="Left" Background="Transparent" BorderThickness="0" 
                                SelectedIndex="{Binding SelectedReportTab, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                        
                        <TabControl.Resources>
                            <!-- Hide default content area background -->
                            <Style TargetType="{x:Type TabPanel}">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                            </Style>
                        </TabControl.Resources>

                        <!-- Sales Tab Group -->
                        <TabItem Header="📊 أرباح الأصناف" Style="{StaticResource SideTabItemStyle}"/>
                        <TabItem Header="🧾 أرباح الفواتير" Style="{StaticResource SideTabItemStyle}"/>
                        <TabItem Header="📅 المبيعات اليومية/الشهرية" Style="{StaticResource SideTabItemStyle}"/>
                        
                        <!-- Partners Tab Group -->
                        <TabItem Header="👤 مبيعات العملاء (أقوى شركاء)" Style="{StaticResource SideTabItemStyle}"/>
                        <TabItem Header="⏳ أعمار الديون (فواتير متأخرة)" Style="{StaticResource SideTabItemStyle}"/>
                        
                        <!-- Inventory Tab Group -->
                        <TabItem Header="📦 جرد وتقييم المخزون" Style="{StaticResource SideTabItemStyle}"/>
                        <TabItem Header="💤 الأصناف الراكدة" Style="{StaticResource SideTabItemStyle}"/>
                        <TabItem Header="🔄 حركة صنف في مستودع" Style="{StaticResource SideTabItemStyle}"/>
                        
                        <!-- Finance & Quota Tab Group -->
                        <TabItem Header="💸 تحليل المصروفات" Style="{StaticResource SideTabItemStyle}"/>
                        <TabItem Header="📝 عروض الأسعار" Style="{StaticResource SideTabItemStyle}"/>

                        <!-- Customer Profitability Tab Group -->
                        <TabItem Header="👥 ملخص ربحية العملاء" Style="{StaticResource SideTabItemStyle}"/>
                        <TabItem Header="📄 تفاصيل أرباح فواتير العميل" Style="{StaticResource SideTabItemStyle}"/>
                        <TabItem Header="🍎 ربحية أصناف العميل" Style="{StaticResource SideTabItemStyle}"/>

                    </TabControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1" Margin="20" x:Name="ContentGrid" Loaded="ContentGrid_Loaded">
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Global Summary & Filters -->
                <RowDefinition Height="*"/>    <!-- DataGrid Container -->
            </Grid.RowDefinitions>

            <!-- Filters Header -->
            <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20" Margin="0,0,0,20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Dates & Refresh -->
                        <RowDefinition Height="10"/>   <!-- Spacer -->
                        <RowDefinition Height="Auto"/> <!-- Customer Filter -->
                        <RowDefinition Height="15"/>   <!-- Spacer -->
                        <RowDefinition Height="Auto"/> <!-- Pagination -->
                    </Grid.RowDefinitions>
                    
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Row 0: Date Filters & Main Actions -->
                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,20,0">
                        <TextBlock Text="من تاريخ" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding SelectedStartDateText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="140"
                                 LostFocus="StartDate_LostFocus" PreviewKeyDown="Date_PreviewKeyDown"
                                 GotFocus="Date_GotFocus"
                                 Style="{DynamicResource ModernTextBoxStyle}"
                                 helpers:WatermarkHelper.Watermark="يوم/شهر/سنة"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,20,0">
                        <TextBlock Text="إلى تاريخ" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <TextBox Text="{Binding SelectedEndDateText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="140"
                                 LostFocus="EndDate_LostFocus" PreviewKeyDown="Date_PreviewKeyDown"
                                 GotFocus="Date_GotFocus"
                                 Style="{DynamicResource ModernTextBoxStyle}"
                                 helpers:WatermarkHelper.Watermark="يوم/شهر/سنة"/>
                    </StackPanel>

                    <Button Grid.Row="0" Grid.Column="2" HorizontalAlignment="Left" Content="تحديث البيانات 🔄" Command="{Binding LoadReportCommand}"
                            Style="{DynamicResource ModernButtonStyle}" Background="#3B82F6" VerticalAlignment="Bottom" Height="36"/>

                    <StackPanel Grid.Row="0" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="تصدير PDF 📄" Style="{DynamicResource ModernButtonStyle}" Background="#EF4444" Margin="0,0,10,0" Height="36" Click="ExportPdf_Click"/>
                        <Button Content="تصدير CSV 📊" Style="{DynamicResource ModernButtonStyle}" Background="#10B981" Height="36" Click="ExportExcel_Click"/>
                    </StackPanel>

                    <!-- Row 2: Customer Filter (Moved here) -->
                    <StackPanel Grid.Row="2" Grid.ColumnSpan="4">
                        <TextBlock Text="تصفية حسب العميل" Foreground="#64748B" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
                        <ComboBox ItemsSource="{Binding Partners}" SelectedValue="{Binding SelectedPartnerID}" 
                                  SelectedValuePath="PartnerID" DisplayMemberPath="PartnerName" Width="300"
                                  HorizontalAlignment="Left"
                                  Style="{DynamicResource ModernComboBoxStyle}" IsEditable="True"/>
                    </StackPanel>
                    
                    <!-- Row 4: Pagination Controls -->
                    <Border Grid.Row="4" Grid.ColumnSpan="4" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="→ الصفحة السابقة" Command="{Binding PrevReportPageCommand}" IsEnabled="{Binding CanGoPrevReport}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#94A3B8" Padding="15,5"/>
                            <TextBlock Grid.Column="1" Text="{Binding ReportPageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
                            <Button Grid.Column="2" Content="الصفحة التالية ←" Command="{Binding NextReportPageCommand}" IsEnabled="{Binding CanGoNextReport}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Padding="15,5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Dynamic Datagrid Content container. We bind Visibilities based on SelectedReportTab -->
            <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>

                <Grid x:Name="ReportGridContainer">
                    <!-- ============================================== -->
                    <!-- REPORT 0: أرباح الأصناف -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding ProductProfits}" AutoGenerateColumns="False" IsReadOnly="True" 
                              RowHeight="40" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=0}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="1*"/>
                            <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="الوحدة" Binding="{Binding UnitName}" Width="1*"/>
                            <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding TotalQtySold, StringFormat={}{0:N2}}" Width="1*"/>
                            <DataGridTextColumn Header="الإيرادات" Binding="{Binding TotalRevenue, StringFormat={}{0:N2}}" Width="1*"/>
                            <DataGridTextColumn Header="التكلفة" Binding="{Binding TotalCost, StringFormat={}{0:N2}}" Width="1*"/>
                            <DataGridTextColumn Header="صافي الربح" Binding="{Binding NetProfit, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding NetProfit, Converter={StaticResource ProfitColorConverter}}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="هامش الربح %" Binding="{Binding ProfitMarginPercent, StringFormat={}{0:N2}%}" Width="1*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ============================================== -->
                    <!-- REPORT 1: أرباح الفواتير -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding InvoiceProfits}" AutoGenerateColumns="False" IsReadOnly="True" 
                              RowHeight="40" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=1}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="م. الفاتورة" Binding="{Binding InvID}" Width="0.8*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding InvDate, StringFormat=dd/MM/yyyy}" Width="1.2*"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="2*"/>
                            <DataGridTextColumn Header="إجمالي الفاتورة" Binding="{Binding GrossTotal, StringFormat={}{0:N2}}" Width="1.2*"/>
                            <DataGridTextColumn Header="الخصم" Binding="{Binding Discount, StringFormat={}{0:N2}}" Width="1*"/>
                            <DataGridTextColumn Header="الصافي المطلوب" Binding="{Binding NetAmount, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="تكلفة المخزون" Binding="{Binding TotalCost, StringFormat={}{0:N2}}" Width="1.5*"/>
                            <DataGridTextColumn Header="ربح الفاتورة" Binding="{Binding NetProfit, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding NetProfit, Converter={StaticResource ProfitColorConverter}}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ============================================== -->
                    <!-- REPORT 2: المبيعات التجميعية اليومية/الشهرية -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding SalesSummary}" AutoGenerateColumns="False" IsReadOnly="True" 
                              RowHeight="40" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=2}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الفترة (يوم/شهر)" Binding="{Binding PeriodString}" Width="1.5*"/>
                            <DataGridTextColumn Header="عدد الفواتير" Binding="{Binding InvoiceCount}" Width="1*"/>
                            <DataGridTextColumn Header="إجمالي البيع" Binding="{Binding TotalGrossAmount, StringFormat={}{0:N2}}" Width="1.5*"/>
                            <DataGridTextColumn Header="إجمالي الخصم" Binding="{Binding TotalDiscount, StringFormat={}{0:N2}}" Width="1.5*"/>
                            <DataGridTextColumn Header="صافي المبيعات" Binding="{Binding TotalNetAmount, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold" Foreground="#3B82F6"/>
                            <DataGridTextColumn Header="المدفوع" Binding="{Binding TotalPaid, StringFormat={}{0:N2}}" Width="1.5*" Foreground="#10B981"/>
                            <DataGridTextColumn Header="الآجل (الديون)" Binding="{Binding TotalCredit, StringFormat={}{0:N2}}" Width="1.5*" Foreground="#EF4444"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ============================================== -->
                    <!-- REPORT 3: العملاء (Top Customers) -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding TopCustomers}" AutoGenerateColumns="False" IsReadOnly="True" 
                              RowHeight="40" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=3}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="م. العميل" Binding="{Binding PartnerID}" Width="1*"/>
                            <DataGridTextColumn Header="اسم العميل" Binding="{Binding PartnerName}" Width="2.5*"/>
                            <DataGridTextColumn Header="رقم التواصل" Binding="{Binding Phone}" Width="1.5*"/>
                            <DataGridTextColumn Header="الفواتير" Binding="{Binding TotalInvoices}" Width="1*"/>
                            <DataGridTextColumn Header="إجمالي المشتريات" Binding="{Binding TotalPurchases, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold" Foreground="#3B82F6"/>
                            <DataGridTextColumn Header="المدفوعات" Binding="{Binding TotalPaid, StringFormat={}{0:N2}}" Width="1.5*"/>
                            <DataGridTextColumn Header="الرصيد المتبقي (عليه)" Binding="{Binding TotalCreditBalance, StringFormat={}{0:N2}}" Width="1.5*" Foreground="#EF4444"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ============================================== -->
                    <!-- REPORT 4: أعمار الديون (Unpaid Invoices) -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding UnpaidInvoices}" AutoGenerateColumns="False" IsReadOnly="True" 
                              RowHeight="40" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=4}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الفاتورة" Binding="{Binding InvID}" Width="1*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding InvDate, StringFormat=dd/MM/yyyy}" Width="1.5*"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="2*"/>
                            <DataGridTextColumn Header="قيمة الفاتورة" Binding="{Binding InvoiceTotal, StringFormat={}{0:N2}}" Width="1.5*"/>
                            <DataGridTextColumn Header="المتبقي (الدين)" Binding="{Binding UnpaidBalance, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold" Foreground="#EF4444"/>
                            <DataGridTextColumn Header="تجاوزت الأيام" Binding="{Binding DaysOverdue}" Width="1.2*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="فئة التمرحل" Binding="{Binding AgingBucket}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ============================================== -->
                    <!-- REPORT 5: جرد وتقييم المخزون -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=5}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="تصفية بالمستودع:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedWarehouseID}" 
                                      SelectedValuePath="WarehouseID" DisplayMemberPath="WarehouseName" Width="200"
                                      Style="{DynamicResource ModernComboBoxStyle}"/>
                            <Button Content="بحث" Command="{Binding LoadReportCommand}" Style="{DynamicResource ModernButtonStyle}" Background="#3B82F6" Margin="10,0,0,0"/>

                            <!-- Total Valuation Display -->
                            <TextBlock Text="إجمالي تقييم المخزون:" FontWeight="Bold" FontSize="16" Foreground="#1E293B" Margin="50,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalInventoryValue, StringFormat={}{0:N2}}" FontWeight="Black" FontSize="20" Foreground="#10B981" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <DataGrid Grid.Row="1" ItemsSource="{Binding InventoryValuation}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  RowHeight="40" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="المستودع" Binding="{Binding WarehouseName}" Width="1.5*"/>
                                <DataGridTextColumn Header="كود الصنف" Binding="{Binding Barcode}" Width="1.5*"/>
                                <DataGridTextColumn Header="اسم الصنف" Binding="{Binding ProductName}" Width="2.5*"/>
                                <DataGridTextColumn Header="الرصيد الفعلي" Binding="{Binding CurrentStock, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold" Foreground="#3B82F6"/>
                                <DataGridTextColumn Header="متوسط سعر التكلفة" Binding="{Binding UnitCost, StringFormat={}{0:N2}}" Width="1.5*"/>
                                <DataGridTextColumn Header="إجمالي القيمة التقديرية" Binding="{Binding TotalCostValue, StringFormat={}{0:N2}}" Width="2*" FontWeight="Bold" Foreground="#10B981"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- REPORT 6: الأصناف الراكدة -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding SlowMovingStock}" AutoGenerateColumns="False" IsReadOnly="True" 
                              RowHeight="40" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=6}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الباركود" Binding="{Binding Barcode}" Width="1*"/>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="التصنيف" Binding="{Binding CatName}" Width="1.5*"/>
                            <DataGridTextColumn Header="رصيد حالي" Binding="{Binding CurrentTotalStock, StringFormat={}{0:N2}}" Width="1*"/>
                            <DataGridTextColumn Header="تاريخ آخر بيع" Binding="{Binding LastSoldDate, StringFormat=dd/MM/yyyy}" Width="1.5*"/>
                            <DataGridTextColumn Header="أيام الركود" Binding="{Binding DaysSinceLastSale}" Width="1.2*" FontWeight="Bold" Foreground="#EF4444"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ============================================== -->
                    <!-- REPORT 7: حركة صنف -->
                    <!-- ============================================== -->
                    <Grid Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=7}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="الصنف:" Foreground="#64748B" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding Products}" SelectedValue="{Binding SelectedProductID}" 
                                      SelectedValuePath="ProductID" DisplayMemberPath="ProductName" Width="250"
                                      Style="{DynamicResource ModernComboBoxStyle}" IsEditable="True"/>
                            
                            <TextBlock Text="المستودع:" Foreground="#64748B" VerticalAlignment="Center" Margin="20,0,10,0"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding SelectedWarehouseID}" 
                                      SelectedValuePath="WarehouseID" DisplayMemberPath="WarehouseName" Width="150"
                                      Style="{DynamicResource ModernComboBoxStyle}"/>
                            <Button Content="يحث الحركة" Command="{Binding LoadReportCommand}" Style="{DynamicResource ModernButtonStyle}" Background="#3B82F6" Margin="10,0,0,0"/>
                        </StackPanel>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding StockMovement}" AutoGenerateColumns="False" IsReadOnly="True" 
                                  RowHeight="40" Background="Transparent" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="التاريخ" Binding="{Binding TransactionDate, StringFormat=dd/MM/yyyy HH:mm}" Width="1.5*"/>
                                <DataGridTextColumn Header="نوع الحركة والبيان" Binding="{Binding TransactionType}" Width="2*"/>
                                <DataGridTextColumn Header="المستودع" Binding="{Binding WarehouseName}" Width="1.5*"/>
                                <DataGridTextColumn Header="وارد (+)" Binding="{Binding QtyIn, StringFormat={}{0:N2}}" Width="1*" FontWeight="Bold" Foreground="#10B981"/>
                                <DataGridTextColumn Header="منصرف (-)" Binding="{Binding QtyOut, StringFormat={}{0:N2}}" Width="1*" FontWeight="Bold" Foreground="#EF4444"/>
                                <DataGridTextColumn Header="سعر الوحدة" Binding="{Binding UnitPrice, StringFormat={}{0:N2}}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- ============================================== -->
                    <!-- REPORT 8: تحليل المصروفات -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding ExpenseAnalysis}" AutoGenerateColumns="False" IsReadOnly="True" 
                              RowHeight="40" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=8}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الحساب" Binding="{Binding AccountCode}" Width="1*"/>
                            <DataGridTextColumn Header="اسم بند المصروف" Binding="{Binding AccountName}" Width="3*"/>
                            <DataGridTextColumn Header="إجمالي المنصرف" Binding="{Binding TotalExpense, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold" Foreground="#EF4444"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ============================================== -->
                    <!-- REPORT 9: عروض الأسعار -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding QuotationStatus}" AutoGenerateColumns="False" IsReadOnly="True" 
                              RowHeight="40" Background="Transparent" BorderThickness="0"
                              Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=9}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم العرض" Binding="{Binding QuoteID}" Width="1*"/>
                            <DataGridTextColumn Header="تاريخ العرض" Binding="{Binding QuoteDate, StringFormat=dd/MM/yyyy}" Width="1.5*"/>
                            <DataGridTextColumn Header="انتهاء الصلاحية" Binding="{Binding ExpiryDate, StringFormat=dd/MM/yyyy}" Width="1.5*"/>
                            <DataGridTextColumn Header="اسم العميل" Binding="{Binding CustomerName}" Width="2.5*"/>
                            <DataGridTextColumn Header="القيمة الإجمالية" Binding="{Binding QuoteTotalValue, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold"/>
                            <DataGridTextColumn Header="حالة العرض" Binding="{Binding QuoteStatus}" Width="1.5*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ============================================== -->
                    <!-- REPORT 10: ملخص ربحية العملاء -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding CustomerSalesSummary}" AutoGenerateColumns="False" IsReadOnly="True" 
                               RowHeight="40" Background="Transparent" BorderThickness="0"
                               Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=10}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="اسم العميل" Binding="{Binding PartnerName}" Width="2*"/>
                            <DataGridTextColumn Header="عدد الفواتير" Binding="{Binding InvoiceCount}" Width="0.8*"/>
                            <DataGridTextColumn Header="إجمالي المبيعات" Binding="{Binding TotalSales, StringFormat={}{0:N2}}" Width="1.2*"/>
                            <DataGridTextColumn Header="تكلفة المبيعات (COGS)" Binding="{Binding TotalCOGS, StringFormat={}{0:N2}}" Width="1.2*"/>
                            <DataGridTextColumn Header="صافي الربح" Binding="{Binding TotalProfit, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding TotalProfit, Converter={StaticResource ProfitColorConverter}}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ============================================== -->
                    <!-- REPORT 11: تفاصيل أرباح فواتير العميل -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding CustomerInvoicesDetail}" AutoGenerateColumns="False" IsReadOnly="True" 
                               RowHeight="40" Background="Transparent" BorderThickness="0"
                               Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=11}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvID}" Width="1*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding InvDate, StringFormat=dd/MM/yyyy}" Width="1.2*"/>
                            <DataGridTextColumn Header="المرجع" Binding="{Binding ReferenceNo}" Width="1.2*"/>
                            <DataGridTextColumn Header="إجمالي الفاتورة" Binding="{Binding NetAmount, StringFormat={}{0:N2}}" Width="1.2*"/>
                            <DataGridTextColumn Header="التكلفة" Binding="{Binding TotalCOGS, StringFormat={}{0:N2}}" Width="1.2*"/>
                            <DataGridTextColumn Header="الربح" Binding="{Binding Profit, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Profit, Converter={StaticResource ProfitColorConverter}}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- ============================================== -->
                    <!-- REPORT 12: ربحية أصناف العميل -->
                    <!-- ============================================== -->
                    <DataGrid ItemsSource="{Binding CustomerProductSales}" AutoGenerateColumns="False" IsReadOnly="True" 
                               RowHeight="40" Background="Transparent" BorderThickness="0"
                               Visibility="{Binding SelectedReportTab, Converter={StaticResource IntToVisConverter}, ConverterParameter=12}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="العميل" Binding="{Binding PartnerName}" Width="1.5*"/>
                            <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="2*"/>
                            <DataGridTextColumn Header="الكمية المباعة" Binding="{Binding TotalQty, StringFormat={}{0:N2}}" Width="1*"/>
                            <DataGridTextColumn Header="قيمة المبيعات" Binding="{Binding TotalSalesValue, StringFormat={}{0:N2}}" Width="1.2*"/>
                            <DataGridTextColumn Header="قيمة التكلفة" Binding="{Binding TotalCostValue, StringFormat={}{0:N2}}" Width="1.2*"/>
                            <DataGridTextColumn Header="صافي الربح" Binding="{Binding NetProfit, StringFormat={}{0:N2}}" Width="1.5*" FontWeight="Bold">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding NetProfit, Converter={StaticResource ProfitColorConverter}}"/>
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
        
        <!-- Snackbar Notification -->
        <Border x:Name="SnackbarBorder"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Background="#1E293B" CornerRadius="12"
                Padding="20,12" Margin="0,0,0,30"
                Visibility="Collapsed" Panel.ZIndex="99"
                MinWidth="250">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText"
                           Text="تم التصدير بنجاح"
                           Foreground="White" FontSize="14" FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
