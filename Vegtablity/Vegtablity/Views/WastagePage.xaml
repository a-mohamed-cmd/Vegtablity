<UserControl x:Class="Views.WastagePage" x:Name="root"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Vegtablity.Views"
      xmlns:vm="clr-namespace:Vegtablity.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="1000"
      FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}"
      FontFamily="Cairo">

    <UserControl.DataContext>
        <vm:WastageViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <CollectionViewSource x:Key="ProductsList" Source="{Binding AvailableProducts}"/>
        <Style x:Key="CenterDataGridCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="10" Margin="0,0,0,20">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="إدارة التوالف والهوالك" FontSize="16" FontWeight="Bold" Foreground="#1E293B"/>
                    <TextBlock Text="تسجيل واعتماد المواد التالفة وخصمها من المخزون" Foreground="#64748B" FontSize="14" Margin="0,0,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="تحديث" Command="{Binding RefreshCommand}" Style="{StaticResource ModernButtonStyle}" Background="#95a5a6" Margin="0,0,5,0" Width="100" Height="35"/>
                    <Button Content="إضافة هالك جديد" Command="{Binding AddNewCommand}" Style="{StaticResource ModernButtonStyle}" Background="#3498db" Width="150" Height="35"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Split -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- History List -->
            <Grid Grid.Column="0" Margin="0,0,20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Toggle Button -->
                <Button x:Name="btnToggleHistory" Grid.Row="0" Content="≡" FontSize="24" FontWeight="Bold" Background="Transparent" BorderThickness="0" Click="btnToggleHistory_Click" HorizontalAlignment="Right" Margin="0,0,0,5" Cursor="Hand" Foreground="#334155" ToolTip="تصغير / تكبير"/>
                
                <Border x:Name="HistoryCard" Grid.Row="1" Width="350" Background="White" CornerRadius="8" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                    </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Text="سجل التوالف" FontWeight="Bold" FontSize="16" Foreground="#334155" Margin="0,0,0,15"/>
                    
                    <ListView Grid.Row="1" ItemsSource="{Binding WastageHistory}" SelectedItem="{Binding SelectedWastage}" BorderThickness="0" Background="Transparent">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Text="{Binding WastageDate, StringFormat='dd/MM/yyyy HH:mm'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TotalValue, StringFormat='N3'}" FontWeight="Bold" Foreground="#E11D48"/>
                                        
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding UserName}" Foreground="#64748B" FontSize="12"/>
                                            <TextBlock Text=" • " Foreground="#CBD5E1" FontSize="12"/>
                                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="مسودة"/>
                                                        <Setter Property="Foreground" Value="#F59E0B"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPosted}" Value="True">
                                                                <Setter Property="Text" Value="مرحل"/>
                                                                <Setter Property="Foreground" Value="#10B981"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
                </Border>
            </Grid>

            <!-- Details / Edit Form -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>

                <Grid>
                    <!-- Form for Adding New Wastage -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row: Title + Status Badge -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Dynamic Title -->
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,20" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="تعديل سجل الهالك"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewEntry}" Value="True">
                                                <Setter Property="Text" Value="تسجيل هالك جديد"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Status Badge (only for existing records) -->
                            <Border Grid.Column="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Top" Margin="0,0,0,20">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewEntry}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentWastage.IsPosted}" Value="True">
                                                <Setter Property="Background" Value="#D1FAE5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="مسودة"/>
                                            <Setter Property="Foreground" Value="#B45309"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentWastage.IsPosted}" Value="True">
                                                    <Setter Property="Text" Value="✔ مرحّل"/>
                                                    <Setter Property="Foreground" Value="#065F46"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="المستودع (يخصم منه) *" Foreground="#64748B" Margin="0,0,0,5" FontWeight="Bold"/>
                                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding CurrentWastage.WarehouseID, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="WarehouseID" DisplayMemberPath="WarehouseName" Height="40" Margin="0,0,0,10"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ملاحظات:" Foreground="#64748B" Margin="0,0,0,5"/>
                                    <TextBox Text="{Binding CurrentWastage.Notes, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" Height="53" Style="{DynamicResource ModernTextBoxStyle}" Margin="0,0,0,10"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Grid.Row="1" Text="قائمة المنتجات التالفة:" FontWeight="Bold" Foreground="#334155" Margin="0,0,0,10"/>
                            <Button Grid.Row="2" Content="+ إضافة صنف" Click="BtnAddItem_Click" Style="{StaticResource ModernButtonStyle}" Background="#3b82f6" Width="120" Height="30" HorizontalAlignment="Right" Margin="0,0,0,8"/>
                            
                            <DataGrid Grid.Row="4" x:Name="dgDetails" ItemsSource="{Binding CurrentWastage.Details}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" RowHeight="30" FontWeight="Bold" InitializingNewItem="dgDetails_InitializingNewItem" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="كود الصنف" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProductCode}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding ProductCode, UpdateSourceTrigger=Explicit}" PreviewKeyDown="Barcode_PreviewKeyDown" Loaded="TextBox_Loaded" TextAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="المنتج" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ProductName}" VerticalAlignment="Center" Margin="5,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding Source={StaticResource ProductsList}}"
                                                          SelectedValue="{Binding ProductID, UpdateSourceTrigger=PropertyChanged}"
                                                          SelectedValuePath="ProductID"
                                                          DisplayMemberPath="ProductName"
                                                          PreviewKeyDown="ProductComboBox_PreviewKeyDown"
                                                          DropDownClosed="ProductComboBox_DropDownClosed"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTemplateColumn Header="الكمية التالفة" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Quantity}" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="5,0"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding Quantity, UpdateSourceTrigger=Explicit}" PreviewKeyDown="Quantity_PreviewKeyDown" Loaded="TextBox_Loaded" TextAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTextColumn Header="الرصيد المتاح" Binding="{Binding AvailableQuantity, Mode=OneWay}" Width="100" IsReadOnly="True" Foreground="#3b82f6" ElementStyle="{StaticResource CenterDataGridCellStyle}"/>
                                    <DataGridTextColumn Header="تكلفة الوحدة" Binding="{Binding CostPrice, UpdateSourceTrigger=PropertyChanged}" Width="120" IsReadOnly="True" ElementStyle="{StaticResource CenterDataGridCellStyle}"/>
                                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalCost, StringFormat='N3'}" IsReadOnly="True" Width="120" ElementStyle="{StaticResource CenterDataGridCellStyle}"/>
                                    <DataGridTextColumn Header="الرصيد بعد الخصم" Binding="{Binding BalanceAfter, Mode=OneWay}" Width="120" IsReadOnly="True" Foreground="#e74c3c" FontWeight="Bold" ElementStyle="{StaticResource CenterDataGridCellStyle}"/>
                                    
                                    <DataGridTemplateColumn Header="حذف" Width="60">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Background="Transparent" BorderThickness="0" 
                                                        Click="BtnDeleteRow_Click"
                                                        Focusable="False"
                                                        Tag="{Binding}"
                                                        ToolTip="حذف السطر" Cursor="Hand">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding DetailID, FallbackValue=-1}" Value="{x:Null}">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="🗑️" Foreground="#EF4444" FontSize="16"/>
                                                </Button>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <!-- إجمالي التكلفة -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="الإجمالي:" Foreground="#64748B" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentWastage.TotalValue, StringFormat='N3'}" FontSize="18" FontWeight="Bold" Foreground="#E11D48" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Post Button (only for saved drafts) -->
                            <Button Content="✔ اعتماد وخصم من المخزون" Command="{Binding PostCommand}" Margin="0,0,10,0" Width="200">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Background" Value="#e74c3c"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsNewEntry}" Value="False"/>
                                                    <Condition Binding="{Binding CurrentWastage.IsPosted}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Unpost Button: only for posted records + CanDelete permission -->
                            <Button Content="↩ إلغاء الترحيل" Command="{Binding UnpostCommand}" Margin="0,0,10,0" Width="160">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Background" Value="#DC2626"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CurrentWastage.IsPosted}" Value="True"/>
                                                    <Condition Binding="{Binding CanUnpostAllowed}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Print Button: icon only, visible when WastageID > 0 -->
                            <Button Width="40" Height="36" Margin="0,0,6,0" Padding="0">
                                <Button.ToolTip>
                                    <ToolTip Content="🖨️ طباعة مستند الهالك (PDF)" FontSize="13" FontFamily="Cairo"/>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Content" Value="🖨️"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="Background" Value="#8e44ad"/>
                                        <Setter Property="Command" Value="{Binding PrintCommand}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentWastage.WastageID, FallbackValue=0}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Download Template Button: icon only, visible when editing and not posted -->
                            <Button Width="40" Height="36" Margin="0,0,6,0" Padding="0">
                                <Button.ToolTip>
                                    <ToolTip Content="📄 تنزيل قالب Excel لاستيراد الهالك" FontSize="13" FontFamily="Cairo"/>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Content" Value="📄"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="Background" Value="#2980b9"/>
                                        <Setter Property="Command" Value="{Binding DownloadTemplateCommand}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEditing}" Value="True"/>
                                                    <Condition Binding="{Binding CurrentWastage.IsPosted}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Import from Excel: icon only, visible when editing and not posted -->
                            <Button Width="40" Height="36" Margin="0,0,6,0" Padding="0">
                                <Button.ToolTip>
                                    <ToolTip FontSize="13" FontFamily="Cairo">
                                        <StackPanel>
                                            <TextBlock Text="📥 استيراد أصناف من ملف Excel" FontWeight="Bold"/>
                                            <TextBlock Text="• العمود A = كود الصنف أو الباركود" Margin="0,4,0,0"/>
                                            <TextBlock Text="• العمود B = الكمية"/>
                                            <TextBlock Text="نزّل القالب بالزر الأزرق أولاً ▶" Foreground="#27ae60" Margin="0,6,0,0" FontStyle="Italic"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Content" Value="📥"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="Background" Value="#27ae60"/>
                                        <Setter Property="Command" Value="{Binding ImportFromExcelCommand}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEditing}" Value="True"/>
                                                    <Condition Binding="{Binding CurrentWastage.IsPosted}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="إلغاء" Command="{Binding RefreshCommand}" Style="{StaticResource ModernButtonStyle}" Background="#95a5a6" Width="90" Margin="0,0,10,0"/>

                            <!-- Save Button: hidden if posted -->
                            <Button Width="150">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Content" Value="حفظ كمسودة"/>
                                        <Setter Property="Background" Value="#3498db"/>
                                        <Setter Property="Command" Value="{Binding SaveCommand}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentWastage.IsPosted}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Content" Value="تم الاعتماد"/>
                                                <Setter Property="Background" Value="#94a3b8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsNewEntry}" Value="False">
                                                <Setter Property="Content" Value="حفظ التعديلات"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Placeholder when nothing is open -->
                    <TextBlock Text="اختر سجل هالك من القائمة أو أضف واحداً جديداً"
                               Foreground="#94A3B8" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>
            </Border>
        </Grid>
        
        <!-- Snackbar Notification -->
                <Border x:Name="SnackbarBorder" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#1E293B" CornerRadius="12" Padding="20,12" Margin="0,0,0,30" Visibility="Collapsed" Panel.ZIndex="105">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.3" ShadowDepth="4"/>
            </Border.Effect>
            <TextBlock x:Name="SnackbarText" Text="تمت العملية بنجاح" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
