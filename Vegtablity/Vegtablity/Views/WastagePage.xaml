<UserControl x:Class="Views.WastagePage" x:Name="root"
       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
       xmlns:local="clr-namespace:Vegtablity.Views"
       xmlns:vm="clr-namespace:Vegtablity.ViewModels"
       xmlns:controls="clr-namespace:Vegtablity.Controls"
       xmlns:helpers="clr-namespace:Vegtablity.Helpers"
       mc:Ignorable="d" 
       d:DesignHeight="700" d:DesignWidth="1100"
       FlowDirection="RightToLeft" Background="{DynamicResource BackgroundBrush}"
       FontFamily="Cairo">

    <UserControl.DataContext>
        <vm:WastageViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVis"/>
        <Style x:Key="CenterDataGridCellStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ☰ Hamburger Toggle Button for History Sidebar -->
                <Button x:Name="btnToggleHistory" Grid.Column="0"
                        Content="☰" FontSize="20" Width="40" Height="40"
                        Background="Transparent" BorderThickness="0"
                        Foreground="#334155" Cursor="Hand"
                        VerticalAlignment="Center" Margin="0,0,10,0"
                        ToolTip="إظهار / إخفاء سجل التوالف"
                        Click="btnToggleHistory_Click"/>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🗑️ " FontSize="20" VerticalAlignment="Center"/>
                        <TextBlock Text="إدارة التوالف والهوالك" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="تسجيل واعتماد المواد التالفة وخصمها من المخزون وحساب التكلفة بدقة" Foreground="#64748B" FontSize="13" Margin="28,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="تحديث 🔄" Command="{Binding RefreshCommand}" Style="{StaticResource ModernButtonStyle}" Background="#64748B" Foreground="White" FontWeight="Bold" Margin="0,0,8,0" Height="36" Padding="15,0" Cursor="Hand"/>
                    <Button Content="➕ تسجيل هالك جديد" Command="{Binding AddNewCommand}" Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Foreground="White" FontWeight="Bold" Height="36" Padding="15,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Split (Left: History Sidebar, Right: Wastage Editor) -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="Auto" MinWidth="0"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- History Sidebar with Collapsible Filter -->
            <Border x:Name="HistoryCardBorder" Grid.Column="0" Width="350" MaxWidth="350" MinWidth="0" Background="White" CornerRadius="8" Padding="12" Margin="0,0,15,0" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Sidebar Header (Title, Count & Filter Toggle) -->
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📜 سجل التوالف" FontSize="15" FontWeight="Bold" Foreground="#1E293B"/>
                            <Border Background="#E0E7FF" CornerRadius="10" Padding="8,2" Margin="8,0,0,0">
                                <TextBlock Text="{Binding FilteredWastageHistory.Count}" FontSize="12" FontWeight="Bold" Foreground="#3730A3"/>
                            </Border>
                        </StackPanel>

                        <!-- Filter Toggle Button -->
                        <Button x:Name="btnToggleFilter" Grid.Column="1"
                                Content="🔍 تصفية ▼"
                                Style="{StaticResource ModernButtonStyle}"
                                FontSize="12" FontWeight="SemiBold"
                                Background="#F1F5F9" Foreground="#475569"
                                BorderThickness="0"
                                Padding="8,4" Cursor="Hand"
                                Click="btnToggleFilter_Click"
                                ToolTip="إظهار / إخفاء أدوات تصفية السجل"/>
                    </Grid>

                    <!-- Collapsible Filter Card -->
                    <Border x:Name="FilterCardBorder" Grid.Row="1"
                            Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                            CornerRadius="8" Padding="10" Margin="0,0,0,10">
                        <StackPanel>
                            <!-- Search by Text (ID, User, Notes, Date) -->
                            <TextBlock Text="بحث في السجل:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <TextBox x:Name="TxtHistorySearch"
                                     Text="{Binding HistorySearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="34" Padding="8,0" FontSize="12"
                                     VerticalContentAlignment="Center"
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     helpers:WatermarkHelper.Watermark="رقم السند، المستخدم، الملاحظات..."
                                     Margin="0,0,0,6"/>

                            <!-- Status Filter ComboBox -->
                            <TextBlock Text="حالة السند:" FontSize="12" FontWeight="SemiBold" Foreground="#64748B" Margin="0,0,0,3"/>
                            <ComboBox SelectedIndex="{Binding HistoryStatusFilter, UpdateSourceTrigger=PropertyChanged}"
                                      Height="32" FontSize="12" Margin="0,0,0,8" VerticalContentAlignment="Center">
                                <ComboBoxItem Content="الكل (جميع الحالات)"/>
                                <ComboBoxItem Content="📝 مسودة فقط"/>
                                <ComboBoxItem Content="✔ مرحل ومعتمد فقط"/>
                            </ComboBox>

                            <!-- Clear Filter Button -->
                            <Button Content="تفريغ التصفية 🔄"
                                    Command="{Binding ClearHistoryFilterCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Height="28" FontSize="11" FontWeight="SemiBold"
                                    Background="#E2E8F0" Foreground="#334155"
                                    BorderThickness="0"
                                    HorizontalAlignment="Stretch" Cursor="Hand"/>
                        </StackPanel>
                    </Border>

                    <!-- History ListView -->
                    <ListView Grid.Row="2" ItemsSource="{Binding FilteredWastageHistory}" SelectedItem="{Binding SelectedWastage}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="8,8" Margin="0,2" Background="#F8FAFC" CornerRadius="6">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding WastageID, StringFormat='#{0}'}" FontWeight="Bold" Foreground="#0284C7" Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding WastageDate, StringFormat='dd/MM/yyyy HH:mm'}" FontWeight="SemiBold" Foreground="#0F172A"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Notes}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                                                       Visibility="{Binding Notes, Converter={StaticResource StringToVis}}"/>
                                        </StackPanel>
                                        
                                        <TextBlock Grid.Column="1" Text="{Binding TotalValue, StringFormat='{}{0:N3}'}" FontWeight="Bold" Foreground="#E11D48" VerticalAlignment="Center"/>
                                        
                                        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,5,0,0">
                                            <TextBlock Text="{Binding UserName}" Foreground="#64748B" FontSize="11"/>
                                            <TextBlock Text=" • " Foreground="#CBD5E1" FontSize="11"/>
                                            <Border CornerRadius="4" Padding="6,1">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#FEF3C7"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsPosted}" Value="True">
                                                                <Setter Property="Background" Value="#D1FAE5"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock FontSize="11" FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="مسودة"/>
                                                            <Setter Property="Foreground" Value="#B45309"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsPosted}" Value="True">
                                                                    <Setter Property="Text" Value="✔ مرحل"/>
                                                                    <Setter Property="Foreground" Value="#065F46"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Pagination Footer (10 records per page) -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="4,8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Previous Button -->
                            <Button Grid.Column="0" Content="◀ السابق"
                                    Command="{Binding PreviousPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="#E2E8F0" Foreground="#334155"
                                    FontSize="11" FontWeight="SemiBold"
                                    Height="28" Padding="8,0" Cursor="Hand"/>
                            <!-- Page Info -->
                            <TextBlock Grid.Column="1" Text="{Binding PageInfo}"
                                       FontSize="11" FontWeight="Bold" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <!-- Next Button -->
                            <Button Grid.Column="2" Content="التالي ▶"
                                    Command="{Binding NextPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}"
                                    Background="#E2E8F0" Foreground="#334155"
                                    FontSize="11" FontWeight="SemiBold"
                                    Height="28" Padding="8,0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Details / Edit Form -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="20">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="10" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>

                <Grid>
                    <!-- Form for Adding / Editing Wastage -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Header Row: Title + Status Badge -->
                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- Dynamic Title -->
                            <TextBlock FontSize="18" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,15" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="تعديل سجل الهالك"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewEntry}" Value="True">
                                                <Setter Property="Text" Value="تسجيل هالك جديد"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <!-- Status Badge (only for existing records) -->
                            <Border Grid.Column="1" CornerRadius="6" Padding="12,4" VerticalAlignment="Top" Margin="0,0,0,15">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#FEF3C7"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsNewEntry}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CurrentWastage.IsPosted}" Value="True">
                                                <Setter Property="Background" Value="#D1FAE5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="مسودة"/>
                                            <Setter Property="Foreground" Value="#B45309"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrentWastage.IsPosted}" Value="True">
                                                    <Setter Property="Text" Value="✔ مرحّل"/>
                                                    <Setter Property="Foreground" Value="#065F46"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Warehouse & Notes -->
                            <Grid Grid.Row="0" Margin="0,0,0,15">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="15"/>
                                    <ColumnDefinition Width="1.5*"/>
                                </Grid.ColumnDefinitions>
                                
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="المستودع (يخصم منه) *" Foreground="#64748B" Margin="0,0,0,5" FontWeight="Bold"/>
                                    <ComboBox ItemsSource="{Binding Warehouses}" SelectedValue="{Binding CurrentWastage.WarehouseID, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="WarehouseID" DisplayMemberPath="WarehouseName" Height="40" VerticalContentAlignment="Center" FontSize="14"/>
                                </StackPanel>
                                
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="ملاحظات:" Foreground="#64748B" Margin="0,0,0,5" FontWeight="Bold"/>
                                    <TextBox Text="{Binding CurrentWastage.Notes, UpdateSourceTrigger=PropertyChanged}" Height="40" VerticalContentAlignment="Center" Style="{DynamicResource ModernTextBoxStyle}"/>
                                </StackPanel>
                            </Grid>

                            <!-- Add Row Toolbar -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="قائمة المنتجات التالفة:" FontWeight="Bold" FontSize="15" Foreground="#334155" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Content="➕ إضافة صنف" Click="BtnAddItem_Click" Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Foreground="White" FontWeight="Bold" Height="34" Padding="15,0" Cursor="Hand"/>
                            </Grid>
                            
                            <!-- Table Column Headers -->
                            <Border Grid.Row="2" Background="#F1F5F9" CornerRadius="8,8,0,0" Padding="8,10" BorderBrush="#E2E8F0" BorderThickness="1,1,1,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <!-- 0: Product Code / Barcode -->
                                        <ColumnDefinition Width="110"/>
                                        <!-- 1: Product SearchableDropdown (Expanding) -->
                                        <ColumnDefinition Width="*"/>
                                        <!-- 2: Damaged Quantity -->
                                        <ColumnDefinition Width="85"/>
                                        <!-- 3: Available Quantity -->
                                        <ColumnDefinition Width="85"/>
                                        <!-- 4: Unit Cost Price -->
                                        <ColumnDefinition Width="95"/>
                                        <!-- 5: Total Cost -->
                                        <ColumnDefinition Width="105"/>
                                        <!-- 6: Balance After -->
                                        <ColumnDefinition Width="95"/>
                                        <!-- 7: Delete Action -->
                                        <ColumnDefinition Width="40"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="كود الصنف" FontWeight="Bold" Foreground="#334155" Margin="5,0"/>
                                    <TextBlock Grid.Column="1" Text="المنتج / المادة التالفة" FontWeight="Bold" Foreground="#334155" Margin="5,0"/>
                                    <TextBlock Grid.Column="2" Text="الكمية التالفة" FontWeight="Bold" Foreground="#334155" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="الرصيد المتاح" FontWeight="Bold" Foreground="#2563EB" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="تكلفة الوحدة" FontWeight="Bold" Foreground="#334155" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="5" Text="الإجمالي" FontWeight="Bold" Foreground="#E11D48" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="6" Text="بعد الخصم" FontWeight="Bold" Foreground="#DC2626" TextAlignment="Center"/>
                                    <TextBlock Grid.Column="7" Text="حذف" FontWeight="Bold" Foreground="#EF4444" TextAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- ItemsControl with WastageItemRowControl -->
                            <Border Grid.Row="3" BorderBrush="#E2E8F0" BorderThickness="1,0,1,1" CornerRadius="0,0,8,8">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" MinHeight="220">
                                    <ItemsControl x:Name="DetailsItemsControl" ItemsSource="{Binding CurrentWastage.Details}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <controls:WastageItemRowControl
                                                    ProductsList="{Binding DataContext.AvailableProducts, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    WarehouseID="{Binding DataContext.CurrentWastage.WarehouseID, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    IsLocked="{Binding DataContext.CurrentWastage.IsPosted, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    RequestAddNewRow="WastageItemRow_RequestAddNewRow"
                                                    RequestDeleteRow="WastageItemRow_RequestDeleteRow"
                                                    AmountChanged="WastageItemRow_AmountChanged"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </Grid>

                        <!-- Footer Actions -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <!-- إجمالي التكلفة -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                                <TextBlock Text="إجمالي تكلفة الهالك:" Foreground="#64748B" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentWastage.TotalValue, StringFormat='{}{0:N3}'}" FontSize="18" FontWeight="Bold" Foreground="#E11D48" VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- Post Button (only for saved drafts) -->
                            <Button Content="✔ اعتماد وخصم من المخزون" Command="{Binding PostCommand}" Margin="0,0,10,0" Width="200">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Background" Value="#e74c3c"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsNewEntry}" Value="False"/>
                                                    <Condition Binding="{Binding CurrentWastage.IsPosted}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Unpost Button: only for posted records + CanDelete permission -->
                            <Button Content="↩ إلغاء الترحيل" Command="{Binding UnpostCommand}" Margin="0,0,10,0" Width="160">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Background" Value="#DC2626"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding CurrentWastage.IsPosted}" Value="True"/>
                                                    <Condition Binding="{Binding CanUnpostAllowed}" Value="True"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Print Button: icon only, visible when WastageID > 0 -->
                            <Button Width="40" Height="36" Margin="0,0,6,0" Padding="0">
                                <Button.ToolTip>
                                    <ToolTip Content="🖨️ طباعة مستند الهالك (PDF)" FontSize="13" FontFamily="Cairo"/>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Content" Value="🖨️"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="Background" Value="#8e44ad"/>
                                        <Setter Property="Command" Value="{Binding PrintCommand}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentWastage.WastageID, FallbackValue=0}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Download Template Button: icon only, visible when editing and not posted -->
                            <Button Width="40" Height="36" Margin="0,0,6,0" Padding="0">
                                <Button.ToolTip>
                                    <ToolTip Content="📄 تنزيل قالب Excel لاستيراد الهالك" FontSize="13" FontFamily="Cairo"/>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Content" Value="📄"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="Background" Value="#2980b9"/>
                                        <Setter Property="Command" Value="{Binding DownloadTemplateCommand}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEditing}" Value="True"/>
                                                    <Condition Binding="{Binding CurrentWastage.IsPosted}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <!-- Import from Excel: icon only, visible when editing and not posted -->
                            <Button Width="40" Height="36" Margin="0,0,6,0" Padding="0">
                                <Button.ToolTip>
                                    <ToolTip FontSize="13" FontFamily="Cairo">
                                        <StackPanel>
                                            <TextBlock Text="📥 استيراد أصناف من ملف Excel" FontWeight="Bold"/>
                                            <TextBlock Text="• العمود A = كود الصنف أو الباركود" Margin="0,4,0,0"/>
                                            <TextBlock Text="• العمود B = الكمية"/>
                                            <TextBlock Text="نزّل القالب بالزر الأزرق أولاً ▶" Foreground="#27ae60" Margin="0,6,0,0" FontStyle="Italic"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Content" Value="📥"/>
                                        <Setter Property="FontSize" Value="16"/>
                                        <Setter Property="Background" Value="#27ae60"/>
                                        <Setter Property="Command" Value="{Binding ImportFromExcelCommand}"/>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding IsEditing}" Value="True"/>
                                                    <Condition Binding="{Binding CurrentWastage.IsPosted}" Value="False"/>
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="إلغاء" Command="{Binding RefreshCommand}" Style="{StaticResource ModernButtonStyle}" Background="#95a5a6" Width="90" Margin="0,0,10,0"/>

                            <!-- Save Button: hidden if posted -->
                            <Button Width="150">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource ModernButtonStyle}">
                                        <Setter Property="Content" Value="حفظ كمسودة"/>
                                        <Setter Property="Background" Value="#3498db"/>
                                        <Setter Property="Command" Value="{Binding SaveCommand}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CurrentWastage.IsPosted}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Content" Value="تم الاعتماد"/>
                                                <Setter Property="Background" Value="#94a3b8"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsNewEntry}" Value="False">
                                                <Setter Property="Content" Value="حفظ التعديلات"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Placeholder when nothing is open -->
                    <TextBlock Text="اختر سجل هالك من القائمة أو أضف واحداً جديداً"
                               Foreground="#94A3B8" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                </Grid>
            </Border>
        </Grid>
        
        <!-- Snackbar Notification -->
        <Border x:Name="SnackbarBorder" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#1E293B" CornerRadius="12" Padding="20,12" Margin="0,0,0,30" Visibility="Collapsed" Panel.ZIndex="105">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="15" Opacity="0.3" ShadowDepth="4"/>
            </Border.Effect>
            <TextBlock x:Name="SnackbarText" Text="تمت العملية بنجاح" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </Border>
    </Grid>
</UserControl>
