<UserControl x:Class="Views.DailyOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="800" d:DesignWidth="1100" Background="#f4f6f9" FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPastDue}" Value="True">
                    <!-- Light rose/red background for orders whose delivery time has passed -->
                    <Setter Property="Background" Value="#FFF1F2"/>
                    <Setter Property="BorderBrush" Value="#FECDD3"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24" x:Name="MainContainer" Opacity="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="30"/>
        </Grid.RenderTransform>

        <!-- Modern entrance animation -->
        <Grid.Triggers>
            <EventTrigger RoutedEvent="Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="30" To="0" Duration="0:0:0.5">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </Grid.Triggers>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Panel -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="20,16">
            <Border.Effect>
                <DropShadowEffect Color="#000" Opacity="0.03" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="الطلبات اليومية للتوصيل" FontSize="24" FontWeight="Bold" Foreground="#2C3E50"/>
                    <TextBlock Text="متابعة وجدولة طلبات الشحن والتسليم للعملاء" FontSize="13" Foreground="#7F8C8D" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Filter Controls (Date selection & Refresh) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="تاريخ التوصيل" FontSize="11" Foreground="#7F8C8D" Margin="0,0,0,2"/>
                        <!-- Textbox DatePicker based on project standards -->
                        <TextBox x:Name="TxtDeliveryDate" Text="{Binding SelectedDateText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="150" Height="40"
                                 HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                 LostFocus="Date_LostFocus" PreviewKeyDown="Date_PreviewKeyDown" GotFocus="Date_GotFocus"
                                 Style="{DynamicResource ModernTextBoxStyle}"
                                 helpers:WatermarkHelper.Watermark="يوم/شهر/سنة"/>
                    </StackPanel>

                    <Button Command="{Binding RefreshCommand}" Background="#ECF0F1" BorderBrush="#BDC3C7" BorderThickness="1" 
                            Width="80" Height="40" Margin="0,14,0,0" Cursor="Hand" ToolTip="تحديث قائمة الطلبات">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="6"/>
                            </Style>
                        </Button.Resources>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="🔄" FontSize="14" VerticalAlignment="Center" Margin="0,0,4,0"/>
                            <TextBlock Text="تحديث" FontSize="13" Foreground="#2C3E50" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Orders list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Loading indicator -->
                <ProgressBar IsIndeterminate="True" Height="4" Background="Transparent" Foreground="Teal"
                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12"/>

                <TextBlock Text="لا توجد طلبات توصيل مجدولة لهذا اليوم." FontSize="16" Foreground="#7F8C8D" Margin="0,40,0,0"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"
                           Visibility="{Binding Orders.Count, Converter={StaticResource BoolToVis}, ConverterParameter=Inverted}">
                    <!-- Note: Vis converter handles zero items -->
                </TextBlock>

                <!-- Items Container -->
                <ItemsControl ItemsSource="{Binding Orders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- Card Border -->
                            <Border Margin="0,0,0,12" CornerRadius="12" BorderThickness="1" Style="{StaticResource CardBorderStyle}">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                                </Border.Effect>
                                <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}" BorderThickness="0" Background="Transparent">
                                    <Expander.Header>
                                        <!-- Header Grid -->
                                        <Grid Width="960" Margin="10,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="140"/> <!-- Delivery Time -->
                                                <ColumnDefinition Width="140"/> <!-- Phone -->
                                                <ColumnDefinition Width="140"/> <!-- Net Amount -->
                                                <ColumnDefinition Width="120"/> <!-- Payment Status -->
                                                <ColumnDefinition Width="*"/>   <!-- Address -->
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- 1. Delivery Time -->
                                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                <TextBlock Text="🕒" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DeliveryTime}" FontSize="15" FontWeight="Bold" Foreground="#2C3E50" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 2. Phone -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <TextBlock Text="📞" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Phone}" FontSize="14" Foreground="#34495E" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 3. Net Amount -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <TextBlock Text="💰" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding NetAmount, StringFormat='{}{0:N3}'}" FontSize="15" FontWeight="Bold" Foreground="#16A085" VerticalAlignment="Center"/>
                                                <TextBlock Text=" د.ك" FontSize="11" Foreground="#7F8C8D" VerticalAlignment="Center"/>
                                            </StackPanel>

                                            <!-- 4. Payment Status -->
                                            <Border Grid.Column="3" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E8F8F5"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PaymentStatus}" Value="آجل">
                                                                <Setter Property="Background" Value="#FEF9E7"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding PaymentStatus}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="#117A65"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding PaymentStatus}" Value="آجل">
                                                                    <Setter Property="Foreground" Value="#B7950B"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- 5. Address -->
                                            <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                <TextBlock Text="📍" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding Address}" FontSize="14" Foreground="#5D6D7E" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    
                                    <Expander.Content>
                                        <!-- Collapsible Details -->
                                        <Border BorderBrush="#ECF0F1" BorderThickness="0,1,0,0" Padding="16,12" Background="White">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Items List (RTL right-aligned column) -->
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="تفاصيل الطلب والأصناف:" FontSize="14" FontWeight="Bold" Foreground="#34495E" Margin="0,0,0,8"/>
                                                    <ItemsControl ItemsSource="{Binding Details}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border BorderBrush="#F2F4F4" BorderThickness="0,0,0,1" Padding="0,6">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        <!-- Product Name -->
                                                                        <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="13" Foreground="#2C3E50"/>
                                                                        <!-- Quantity -->
                                                                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" FontSize="13" FontWeight="Bold" Foreground="#2980B9" Margin="20,0"/>
                                                                        <!-- Unit Name -->
                                                                        <TextBlock Grid.Column="2" Text="{Binding UnitName}" FontSize="12" Foreground="#7F8C8D" Width="60"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <!-- Left Panel (Details information & View Invoice Button) -->
                                                <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                                                    <TextBlock Text="اسم المستلم الفعلي:" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                                                    <TextBlock Text="{Binding CustomerName}" FontSize="14" FontWeight="Bold" Foreground="#2C3E50" Margin="0,4,0,12"/>

                                                    <TextBlock Text="الملاحظات:" FontSize="12" FontWeight="Bold" Foreground="#7F8C8D"/>
                                                    <TextBlock Text="{Binding Notes}" FontSize="13" Foreground="#7F8C8D" TextWrapping="Wrap" Margin="0,4,0,16"/>

                                                    <Button Content="🔍 عرض تفاصيل الفاتورة كاملة" Click="ViewInvoice_Click" Tag="{Binding InvID}"
                                                            Height="40" Background="#3498DB" Foreground="White" BorderThickness="0" Cursor="Hand">
                                                        <Button.Resources>
                                                            <Style TargetType="Border">
                                                                <Setter Property="CornerRadius" Value="6"/>
                                                            </Style>
                                                        </Button.Resources>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Expander.Content>
                                </Expander>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
