<UserControl x:Class="Views.YearEndClosePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Vegtablity.Views"
             xmlns:converters="clr-namespace:Vegtablity.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1000"
             FlowDirection="RightToLeft"
             Background="#F5F6FA">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:AccountingAmountConverter x:Key="AccountConverter" />
        <converters:StringToVisibilityConverter x:Key="StringToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Text="الإقفال السنوي" FontSize="24" Foreground="#2c3e50" FontWeight="Bold" Margin="0,0,0,8" />
        <Separator Grid.Row="1" Margin="0,0,0,16"/>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="700" HorizontalAlignment="Center">

                <!-- Animation Intro -->
                <StackPanel.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" />
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.5" >
                                    <ThicknessAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </StackPanel.Triggers>

                <!-- Warning Message -->
                <Border Background="#fff3cd" BorderBrush="#ffeeba" BorderThickness="1" Padding="16" Margin="0,0,0,24" CornerRadius="8">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="هام جداً: عملية إقفال السنة المالية" FontWeight="Bold" Foreground="#856404" FontSize="18" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="هذه العملية ستقوم بتصفير جميع أرصدة الإيرادات والمصروفات حتى تاريخ الإقفال المحدد، وسيتم ترحيل صافي الربح أو الخسارة تلقائياً إلى حساب 'أرباح وخسائر مبقاة' في الميزانية العمومية. لا يمكن التراجع عن القيد المحاسبي بعد اعتماده." Foreground="#856404" TextWrapping="Wrap" FontSize="14" LineHeight="22"/>
                    </StackPanel>
                </Border>

                <!-- Form Card -->
                <Border Background="White" Padding="24" CornerRadius="8" BorderBrush="#e1e8ed" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.05" Color="Black"/>
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="إعدادات الإقفال" FontSize="20" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,16"/>

                        <!-- Status Alert (If missing account) -->
                        <TextBlock Text="{Binding StatusMessage}" Foreground="DarkRed" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,16"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisConverter}}"/>

                        <StackPanel Margin="0,0,0,24">
                            <TextBlock Text="تاريخ الإقفال (حتى)" Foreground="#7f8c8d" FontSize="12" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding ClosingDateText, UpdateSourceTrigger=PropertyChanged}"
                                     LostFocus="Date_LostFocus"
                                     GotFocus="Date_GotFocus"
                                     Width="300" HorizontalAlignment="Left" FontSize="16"
                                     Style="{DynamicResource ModernTextBoxStyle}"
                                     ToolTip="أدخل التاريخ: dd/MM/yyyy أو ddMMyyyy"/>
                        </StackPanel>

                        <Separator Margin="0,0,0,24"/>

                        <TextBlock Text="ملخص الإقفال المتوقع:" FontSize="16" Foreground="#7f8c8d" Margin="0,0,0,16"/>

                        <Grid Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBlock Text="{Binding NetProfitLabel}" FontSize="16" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding NetProfitPreview, Converter={StaticResource AccountConverter}}" 
                                       FontSize="24" FontWeight="Bold" VerticalAlignment="Center" 
                                       Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </Grid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ProgressBar IsIndeterminate="True" Width="20" Height="20"
                                         Margin="0,0,16,0" VerticalAlignment="Center"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                            
                            <Button Content="إعـتـمـاد وإقـفـال" 
                                    Command="{Binding CloseYearCommand}"
                                    Style="{StaticResource ModernButtonStyle}" 
                                    Background="#e74c3c"
                                    FontSize="16" Height="48" Width="180"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
