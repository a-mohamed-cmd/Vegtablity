<UserControl x:Class="Views.HRPayrollPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:controls="clr-namespace:Vegtablity.Controls"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:HRPayrollViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F8FAFC" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Generation Toolbar -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="💵" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="مسير الرواتب الشهري" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="احتساب الرواتب الأساسية، البدلات، ساعات الإضافي، خصومات التأخير والغياب، والاعتماد" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- Month & Year Selector -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,15,0">
                    <TextBlock Text="شهر:" FontWeight="Bold" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding MonthsList}" SelectedItem="{Binding SelectedMonth}" Height="36" Width="60" FontSize="13" Margin="0,0,10,0"/>

                    <TextBlock Text="سنة:" FontWeight="Bold" FontSize="12.5" Foreground="#334155" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding YearsList}" SelectedItem="{Binding SelectedYear}" Height="36" Width="80" FontSize="13" Margin="0,0,10,0"/>

                    <Button Content="⚡ توليد مسير الرواتب" Command="{Binding GenerateBatchCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#4F46E5" Foreground="White"
                            Height="36" Padding="12,0" FontSize="12.5" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>

                <!-- Action Button -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="🖨️" Tag="طباعة مسير الرواتب الكامل" ToolTip="طباعة مسير الرواتب الكامل مع الإجماليات"
                            Command="{Binding PrintFullBatchCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#6366F1" Foreground="White"
                            Height="38" Width="44" Padding="0" FontSize="16" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button x:Name="BtnToggleSidePanel" Content="◀ طي المسيرات" Click="ToggleSidePanel_Click"
                            Style="{StaticResource ModernButtonStyle}" Background="#F1F5F9" Foreground="#334155"
                            Height="38" Padding="12,0" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="{Binding ApproveButtonText}" Command="{Binding ApproveBatchCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="{Binding ApproveButtonBackground}" Foreground="White"
                            Height="38" Padding="14,0" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Split Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Payroll Batches List with Animated Collapse/Expand -->
            <Border x:Name="SidePanelBorder" Grid.Column="0" Width="280" Background="White" CornerRadius="12" Padding="14" Margin="0,0,15,0" ClipToBounds="True">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📅 سجل مسيرات الرواتب" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,10"/>

                    <ListBox Grid.Row="1" ItemsSource="{Binding Batches}" SelectedItem="{Binding SelectedBatch}"
                             BorderThickness="0" Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,3">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="{Binding DisplayTitle}" FontWeight="Bold" FontSize="13" Foreground="#0F172A"/>
                                            <TextBlock Text="{Binding TotalNetSalary, StringFormat={}{0:N3}}" FontSize="12.5" FontWeight="Bold" Foreground="#10B981" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="1" Background="#ECFDF5" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Status}" FontSize="10.5" FontWeight="Bold" Foreground="#047857"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Pagination Controls -->
                    <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="4,8" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="◀" Command="{Binding PreviousPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155"
                                    FontSize="11" Height="26" Width="26" Cursor="Hand"/>
                            <TextBlock Grid.Column="1" Text="{Binding PageInfo}"
                                       FontSize="10.5" FontWeight="Bold" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="▶" Command="{Binding NextPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155"
                                    FontSize="11" Height="26" Width="26" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Right: Payroll Details Sheet -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Totals Summary Bar -->
                    <Border Grid.Row="0" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,12" DataContext="{Binding SelectedBatch}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="إجمالي الأساسي:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalBasic, StringFormat={}{0:N3}}" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="إجمالي البدلات:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalAllowances, StringFormat={}{0:N3}}" FontSize="13.5" FontWeight="Bold" Foreground="#1E293B"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="إجمالي الإضافي:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalOvertime, StringFormat={}{0:N3}}" FontSize="13.5" FontWeight="Bold" Foreground="#4F46E5"/>
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="إجمالي الخصومات:" FontSize="11" Foreground="#64748B"/>
                                <TextBlock Text="{Binding TotalDeductions, StringFormat={}{0:N3}}" FontSize="13.5" FontWeight="Bold" Foreground="#EF4444"/>
                            </StackPanel>
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="الصافي الإجمالي:" FontSize="11" Foreground="#047857"/>
                                <TextBlock Text="{Binding TotalNetSalary, StringFormat={}{0:N3}}" FontSize="16" FontWeight="ExtraBold" Foreground="#059669"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Table Headers -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0" 
                            CornerRadius="8,8,0,0" Padding="10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="1.2*" MinWidth="130"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="65"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="95"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الكود" FontWeight="Bold" FontSize="11.5" Foreground="#475569"/>
                            <TextBlock Grid.Column="1" Text="اسم الموظف / القسم" FontWeight="Bold" FontSize="11.5" Foreground="#475569" Margin="6,0"/>
                            <TextBlock Grid.Column="2" Text="الأساسي" FontWeight="Bold" FontSize="11.5" Foreground="#475569" TextAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="البدلات" FontWeight="Bold" FontSize="11.5" Foreground="#15803D" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="إضافي (س)" FontWeight="Bold" FontSize="11.5" Foreground="#0284C7" TextAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="مبلغ إضافي" FontWeight="Bold" FontSize="11.5" Foreground="#0369A1" TextAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="خصم (ي)" FontWeight="Bold" FontSize="11.5" Foreground="#DC2626" TextAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="مبلغ خصم" FontWeight="Bold" FontSize="11.5" Foreground="#B91C1C" TextAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="سلف" FontWeight="Bold" FontSize="11.5" Foreground="#9333EA" TextAlignment="Center"/>
                            <TextBlock Grid.Column="9" Text="صافي الراتب" FontWeight="Bold" FontSize="11.5" Foreground="#047857" TextAlignment="Center"/>
                            <TextBlock Grid.Column="10" Text="حالة الصرف" FontWeight="Bold" FontSize="11.5" Foreground="#475569" TextAlignment="Center"/>
                            <TextBlock Grid.Column="11" Text="إجراء" FontWeight="Bold" FontSize="11.5" Foreground="#475569" TextAlignment="Center" Margin="4,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Interactive Payroll ListBox with PayrollRowControl -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding PayrollDetailsList}"
                             BorderBrush="#E2E8F0" BorderThickness="1" Background="#FAFAFA"
                             HorizontalContentAlignment="Stretch" Padding="6,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:PayrollRowControl IsLocked="{Binding DataContext.IsBatchApproved, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,3"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="0" Margin="0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Modern Floating Snackbar Notification (Always at bottom of entire page) -->
        <Border x:Name="SnackbarBorder" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                Background="#0F172A" CornerRadius="12" Padding="20,12" Margin="0,0,0,30" 
                Visibility="Collapsed" Panel.ZIndex="500" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SnackbarIcon" Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText" Text="تمت العملية بنجاح" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
