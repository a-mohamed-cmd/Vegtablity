<UserControl x:Class="Views.AccountStatementPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers">

    <UserControl.DataContext>
        <vm:AccountStatementViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <!-- Page Fade-in Animation -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header & Filters -->
        <Border Grid.Row="0" Padding="15" Background="#f8f9fa" CornerRadius="10,10,0,0" Margin="0,0,0,15" BorderBrush="#dcdde1" BorderThickness="1">
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,-20,0,5" To="0,0,0,5" Duration="0:0:0.4">
                                <ThicknessAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </ThicknessAnimation.EasingFunction>
                            </ThicknessAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📑 كشف حساب" FontSize="20" FontWeight="Bold" Foreground="#2980b9" VerticalAlignment="Center" Margin="0,0,20,0"/>
                </StackPanel>

                <!-- Filter Controls -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    
                    <StackPanel Margin="10,0">
                        <TextBlock Text="الحساب" FontSize="12" Foreground="#7f8c8d" Margin="0,0,0,2"/>
                        <ComboBox ItemsSource="{Binding FilteredAccounts}" SelectedItem="{Binding SelectedAccount}" Width="220" Height="40"
                                  IsEditable="True" StaysOpenOnEdit="True" IsTextSearchEnabled="False"
                                  TextBoxBase.TextChanged="AccountComboBox_TextChanged"
                                  PreviewKeyDown="AccountComboBox_PreviewKeyDown"
                                  LostFocus="AccountComboBox_LostFocus">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding AccountCode}" Foreground="Gray"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding AccountName}" FontWeight="SemiBold"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Margin="10,0">
                        <TextBlock Text="من تاريخ" FontSize="12" Foreground="#7f8c8d" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding StartDateText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="140" Height="40"
                                 LostFocus="StartDate_LostFocus" PreviewKeyDown="Date_PreviewKeyDown"
                                 GotFocus="Date_GotFocus"
                                 Style="{DynamicResource ModernTextBoxStyle}"
                                 helpers:WatermarkHelper.Watermark="يوم/شهر/سنة"/>
                    </StackPanel>

                    <StackPanel Margin="10,0">
                        <TextBlock Text="إلى تاريخ" FontSize="12" Foreground="#7f8c8d" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding EndDateText, UpdateSourceTrigger=PropertyChanged}" 
                                 Width="140" Height="40"
                                 LostFocus="EndDate_LostFocus" PreviewKeyDown="Date_PreviewKeyDown"
                                 GotFocus="Date_GotFocus"
                                 Style="{DynamicResource ModernTextBoxStyle}"
                                 helpers:WatermarkHelper.Watermark="يوم/شهر/سنة"/>
                    </StackPanel>

                    <Button Content="🔍 عرض" Command="{Binding SearchCommand}" Height="40" Width="80" Margin="10,16,0,0" Background="#2980b9" Foreground="White" BorderThickness="0">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                    <Button Content="📊 CSV" Command="{Binding ExportCsvCommand}" Height="40" Width="80" Margin="5,16,0,0" Background="#27ae60" Foreground="White" BorderThickness="0">
                         <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                    
                    <Button Content="📄 PDF" Command="{Binding ExportPdfCommand}" Height="40" Width="80" Margin="5,16,0,0" Background="#c0392b" Foreground="White" BorderThickness="0">
                         <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>

                </StackPanel>
            </Grid>
        </Border>

        <!-- Report Data -->
        <Border Grid.Row="1" Margin="0,5" CornerRadius="4" BorderBrush="#eee" BorderThickness="1" Background="White">
            <Border.Triggers>
                 <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                             <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            
            <DataGrid ItemsSource="{Binding ReportData.Transactions}" AutoGenerateColumns="False" IsReadOnly="True" 
                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                      BorderThickness="0" RowHeight="32" ColumnHeaderHeight="35"
                      Background="White" AlternationCount="2">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#ecf0f1"/>
                        <Setter Property="FontWeight" Value="SemiBold"/>
                        <Setter Property="Padding" Value="10,0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                    </Style>
                    <Style TargetType="DataGridCell">
                         <Setter Property="Padding" Value="5"/>
                         <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" BorderBrush="Transparent" BorderThickness="0" Background="Transparent" SnapsToDevicePixels="True">
                                        <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="#" Binding="{Binding EntryNo}" Width="60"/>
                    <DataGridTextColumn Header="التاريخ" Binding="{Binding EntryDate, StringFormat=yyyy/MM/dd}" Width="100"/>
                    <DataGridTextColumn Header="نوع السند" Binding="{Binding ReferenceType}" Width="100"/>
                    <DataGridTextColumn Header="البيان" Binding="{Binding Description}" Width="*"/>
                    <DataGridTextColumn Header="مدين" Binding="{Binding DebitAmount, StringFormat=N2}" Width="100" KeyboardNavigation.IsTabStop="False">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#c0392b"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="دائن" Binding="{Binding CreditAmount, StringFormat=N2}" Width="100">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="Foreground" Value="#27ae60"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الرصيد" Binding="{Binding Balance, StringFormat=N2}" Width="120">
                         <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Footer / Totals -->
        <Border Grid.Row="2" Background="#ecf0f1" CornerRadius="0,0,10,10" Padding="15" BorderBrush="#bdc3c7" BorderThickness="1">
             <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                             <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,20,0,0" To="0,0,0,0" Duration="0:0:0.4" BeginTime="0:0:0.3">
                                 <ThicknessAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </ThicknessAnimation.EasingFunction>
                             </ThicknessAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" VerticalAlignment="Center" Foreground="#7f8c8d">
                    <Run Text="الرصيد الافتتاحي: "/>
                    <Run Text="{Binding ReportData.OpeningBalance, StringFormat=N2, TargetNullValue=0.00}" FontWeight="Bold" Foreground="#2c3e50"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="إجمالي المدين: " Foreground="#7f8c8d"/>
                    <TextBlock Text="{Binding ReportData.TotalDebit, StringFormat=N2, TargetNullValue=0.00}" FontWeight="Bold" Foreground="#c0392b"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="إجمالي الدائن: " Foreground="#7f8c8d"/>
                    <TextBlock Text="{Binding ReportData.TotalCredit, StringFormat=N2, TargetNullValue=0.00}" FontWeight="Bold" Foreground="#27ae60"/>
                </StackPanel>

                <Border Grid.Column="3" Width="2" Background="#bdc3c7" Margin="10,2"/>

                <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="20,0">
                    <TextBlock Text="الرصيد الختامي: " FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ReportData.EndingBalance, StringFormat=N2, TargetNullValue=0.00}" FontSize="18" FontWeight="Bold" Foreground="#2980b9" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

    
        <!-- Snackbar Notification -->
        <Border x:Name="SnackbarBorder" Grid.RowSpan="3" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#1E293B" CornerRadius="12" Padding="20,12" Margin="0,0,0,30" Visibility="Collapsed" Panel.ZIndex="105">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SnackbarIcon" Text="⚠️" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText" Text="رسالة" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
