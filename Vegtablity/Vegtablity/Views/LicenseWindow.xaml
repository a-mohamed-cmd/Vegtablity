<Window x:Class="Views.LicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vegtablity.Views"
        xmlns:vm="clr-namespace:Vegtablity.ViewModels"
        mc:Ignorable="d"
        Title="License Check" Height="300" Width="400" WindowStartupLocation="CenterScreen" ResizeMode="NoResize" WindowStyle="None">
    
    <Window.DataContext>
        <vm:LicenseViewModel/>
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="التحقق من الترخيص" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <TextBlock Grid.Row="1" Text="كود الجهاز (Hardware ID):" Margin="0,0,0,5"/>
        <TextBox Grid.Row="2" Text="{Binding HardwareID, Mode=OneWay}" IsReadOnly="True" Margin="0,0,0,10" Padding="5"/>
        
        <Button Grid.Row="2" Content="نسخ" Command="{Binding CopyCommand}" HorizontalAlignment="Right" Width="60" Margin="0,0,0,10"/>

        <TextBlock Grid.Row="3" Text="{Binding StatusMessage}" Foreground="Red" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="تحديث / فحص" Command="{Binding RefreshCommand}" Width="100" Margin="5"/>
            <Button Content="خروج" Command="{Binding ExitCommand}" Width="80" Margin="5"/>
        </StackPanel>
    </Grid>
</Window>
