<UserControl x:Class="Views.ReceiptVoucherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers">

    <UserControl.DataContext>
        <vm:VouchersViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <!-- Page Fade-in -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12" Background="#f8f9fa" CornerRadius="10,10,0,0" Margin="0,0,0,5">
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,-30,0,5" To="0,0,0,5" Duration="0:0:0.4">
                                <ThicknessAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </ThicknessAnimation.EasingFunction>
                            </ThicknessAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📥 سندات القبض" FontSize="18" FontWeight="Bold" Foreground="#27ae60" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" Width="280" BorderBrush="#dcdde1" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding ReceiptSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontSize="13" VerticalAlignment="Center" Padding="5" Background="Transparent"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#eee" BorderThickness="1" Background="White">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <DataGrid ItemsSource="{Binding Receipts}" SelectedItem="{Binding SelectedReceipt}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" Margin="5" RowHeight="36" ColumnHeaderHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNo}" Width="80"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding VoucherDate, StringFormat=\{0:yyyy/MM/dd\}}" Width="100"/>
                        <DataGridTextColumn Header="المستلم منه" Binding="{Binding PartnerName}" Width="130"/>
                        <DataGridTextColumn Header="الحساب" Binding="{Binding AccountName}" Width="130"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="80"/>
                        <DataGridCheckBoxColumn Header="مرحّل" Binding="{Binding IsPosted}" Width="55"/>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                        <DataGridTemplateColumn Width="60" Header="طباعة">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="🖨️" Command="{Binding DataContext.PrintReceiptCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" 
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}" FontSize="14" Cursor="Hand" Padding="5,0"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Edit Panel -->
            <Border Grid.Column="1" CornerRadius="10" Background="#fafafa" Padding="15" BorderBrush="#eee" BorderThickness="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="بيانات سند القبض" FontSize="16" FontWeight="Bold" Foreground="#27ae60" Margin="0,0,0,15"/>

                        <TextBlock Text="التاريخ" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <DatePicker SelectedDate="{Binding EditReceiptDate}" Margin="0,0,0,10"/>

                        <TextBlock Text="المستلم منه" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ComboBox Grid.Column="0" ItemsSource="{Binding Partners}" SelectedValue="{Binding EditReceiptPartnerID}"
                                      SelectedValuePath="PartnerID" DisplayMemberPath="PartnerName"/>
                            <Button Grid.Column="1" Content="➕" Command="{Binding OpenNewPartnerCommand}" CommandParameter="Receipt"
                                    Width="30" Padding="0" Margin="5,0,0,0" ToolTip="إضافة مستلم جديد"
                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                        </Grid>

                        <!-- Quick Add Partner Form -->
                        <Border Background="#f1f2f6" CornerRadius="5" Padding="10" Margin="0,0,0,10"
                                Visibility="{Binding IsAddingNewPartner, Converter={StaticResource BoolToVisConverter}}">
                            <StackPanel>
                                <TextBlock Text="اسم المستلم الجديد *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding NewPartnerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>
                                
                                <TextBlock Text="النوع" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox ItemsSource="{Binding PartnerTypesList}" SelectedItem="{Binding NewPartnerType}" Margin="0,0,0,10"/>
                                
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="إلغاء" Command="{Binding CancelNewPartnerCommand}" Margin="0,0,5,0" Width="60" Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
                                    <Button Content="حفظ" Command="{Binding SaveNewPartnerCommand}" CommandParameter="Receipt" Width="60" Background="#27ae60" Foreground="White" BorderThickness="0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="الحساب" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding Accounts}" SelectedValue="{Binding EditReceiptAccountID}"
                                  SelectedValuePath="AccountID" Margin="0,0,0,10">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding AccountCode}"/>
                                        <Run Text=" - "/>
                                        <Run Text="{Binding AccountName}"/>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <TextBlock Text="المبلغ *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditReceiptAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                        <TextBlock Text="{Binding ReceiptAmountError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                                   Visibility="{Binding ReceiptAmountError, Converter={StaticResource StringToVisConverter}}"/>

                        <TextBlock Text="طريقة الدفع" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedValue="{Binding EditReceiptPaymentMethod}" SelectedValuePath="AccountID" DisplayMemberPath="AccountName" Margin="0,0,0,10"/>

                        <TextBlock Text="الوصف" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding EditReceiptDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15" TextWrapping="Wrap" MinHeight="40"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
                            <Button Content="💾 حفظ" Command="{Binding SaveReceiptCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5"/>
                            <Button Content="🆕 جديد" Command="{Binding NewReceiptCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5" Background="#3498db"/>
                            <Button Content="🗑️ حذف" Command="{Binding DeleteReceiptCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5" Background="#e74c3c"/>
                        </StackPanel>

                        <Border BorderBrush="#eee" BorderThickness="0,1,0,0" Margin="0,10" Padding="0,10,0,0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="📌 ترحيل" Command="{Binding PostReceiptCommand}" Style="{StaticResource ModernButtonStyle}" Width="130" Height="40" Background="#27ae60" FontSize="14" FontWeight="Bold" Margin="5"/>
                                <Button Content="🖨️ طباعة" Command="{Binding PrintReceiptCommand}" Style="{StaticResource ModernButtonStyle}" Width="130" Height="40" Background="#34495e" FontSize="14" FontWeight="Bold" Margin="5"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" CornerRadius="0,0,12,12" Background="#ecf0f1" Padding="12,6" Margin="0,5,0,0">
            <TextBlock Text="{Binding ReceiptStatusMessage}" Foreground="#2c3e50" FontSize="13"/>
        </Border>
    </Grid>
</UserControl>
