<UserControl x:Class="Views.PaymentVoucherPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers">

    <UserControl.DataContext>
        <vm:VouchersViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConverter"/>
    </UserControl.Resources>

    <!-- Page Fade-in -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Padding="12" Background="#f8f9fa" CornerRadius="10,10,0,0" Margin="0,0,0,5">
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,-30,0,5" To="0,0,0,5" Duration="0:0:0.4">
                                <ThicknessAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </ThicknessAnimation.EasingFunction>
                            </ThicknessAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📤 سندات الصرف" FontSize="18" FontWeight="Bold" Foreground="#e74c3c" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" Width="280" BorderBrush="#dcdde1" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding PaymentSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontSize="13" VerticalAlignment="Center" Padding="5" Background="Transparent"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#eee" BorderThickness="1" Background="White">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <DataGrid ItemsSource="{Binding Payments}" SelectedItem="{Binding SelectedPayment}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" Margin="5" RowHeight="36" ColumnHeaderHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="رقم السند" Binding="{Binding VoucherNo}" Width="80"/>
                        <DataGridTextColumn Header="التاريخ" Binding="{Binding VoucherDate, StringFormat=\{0:yyyy/MM/dd\}}" Width="100"/>
                        <DataGridTextColumn Header="الشريك" Binding="{Binding PartnerName}" Width="130"/>
                        <DataGridTextColumn Header="الحساب" Binding="{Binding AccountName}" Width="130"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding Amount, StringFormat=N2}" Width="100"/>
                        <DataGridTextColumn Header="طريقة الدفع" Binding="{Binding PaymentMethod}" Width="80"/>
                        <DataGridCheckBoxColumn Header="مرحّل" Binding="{Binding IsPosted}" Width="55"/>
                        <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Edit Panel -->
            <Border Grid.Column="1" CornerRadius="10" Background="#fafafa" Padding="18" BorderBrush="#eee" BorderThickness="1">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="20,0,0,0" To="0,0,0,0" Duration="0:0:0.5" BeginTime="0:0:0.3">
                                    <ThicknessAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <TextBlock Text="بيانات سند الصرف" FontSize="16" FontWeight="Bold" Foreground="#e74c3c" Margin="0,0,0,15"/>

                    <TextBlock Text="التاريخ" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker SelectedDate="{Binding EditPaymentDate}" Margin="0,0,0,10"/>

                    <TextBlock Text="الشريك" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Partners}" SelectedValue="{Binding EditPaymentPartnerID}"
                              SelectedValuePath="PartnerID" DisplayMemberPath="PartnerName" Margin="0,0,0,10"/>

                    <TextBlock Text="الحساب" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding Accounts}" SelectedValue="{Binding EditPaymentAccountID}"
                              SelectedValuePath="AccountID" Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding AccountCode}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding AccountName}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock Text="المبلغ *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditPaymentAmount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding PaymentAmountError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding PaymentAmountError, Converter={StaticResource StringToVisConverter}}"/>

                    <TextBlock Text="طريقة الدفع" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding PaymentMethods}" SelectedItem="{Binding EditPaymentPaymentMethod}" Margin="0,0,0,10"/>

                    <TextBlock Text="الوصف" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditPaymentDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15" TextWrapping="Wrap" MinHeight="40"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="💾 حفظ" Command="{Binding SavePaymentCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5"/>
                        <Button Content="🆕 جديد" Command="{Binding NewPaymentCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5" Background="#3498db"/>
                        <Button Content="🗑️ حذف" Command="{Binding DeletePaymentCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5" Background="#e74c3c"/>
                    </StackPanel>
                    <Button Content="📌 ترحيل" Command="{Binding PostPaymentCommand}" Style="{StaticResource ModernButtonStyle}" Width="180" Margin="0,8,0,0" Background="#e74c3c" FontSize="14" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" CornerRadius="0,0,12,12" Background="#ecf0f1" Padding="12,6" Margin="0,5,0,0">
            <TextBlock Text="{Binding PaymentStatusMessage}" Foreground="#2c3e50" FontSize="13"/>
        </Border>
    </Grid>
</UserControl>
