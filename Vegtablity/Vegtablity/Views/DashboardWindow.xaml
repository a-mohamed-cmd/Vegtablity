<Window x:Class="Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Vegtablity.Views"
        xmlns:vm="clr-namespace:Vegtablity.ViewModels"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        mc:Ignorable="d"
        Title="Vegtablity - Dashboard" Height="700" Width="1100"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.DataContext>
        <vm:DashboardViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Sidebar Button Style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#dcdde1"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="15,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" CornerRadius="8" Margin="8,2" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#34495e"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="btnBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2ecc71" Offset="0"/>
                                            <GradientStop Color="#27ae60" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Foreground" Value="White"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="15" Background="#f5f6fa">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25" ShadowDepth="0" Opacity="0.25" Color="Black"/>
        </Border.Effect>
        
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ====================== SIDEBAR ====================== -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Width="260" CornerRadius="15,0,0,15">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="#2c3e50" Offset="0"/>
                        <GradientStop Color="#1a252f" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="-260" To="0" Duration="0:0:0.5">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <Border.RenderTransform>
                    <TranslateTransform/>
                </Border.RenderTransform>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- App Logo -->
                    <StackPanel Grid.Row="0" Margin="20,25,20,10" HorizontalAlignment="Center">
                        <TextBlock Text="🥬" FontSize="48" HorizontalAlignment="Center"/>
                        <TextBlock Text="Vegtablity" FontSize="22" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                        <TextBlock Text="نظام إدارة متكامل" FontSize="11" Foreground="#95a5a6" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                    </StackPanel>

                    <!-- Separator -->
                    <Border Grid.Row="1" Height="1" Background="#34495e" Margin="20,5,20,10"/>

                    <!-- Menu Items -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,5">
                        <ItemsControl ItemsSource="{Binding MenuItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <!-- === Main Menu Button === -->
                                        <Button Style="{StaticResource SidebarButtonStyle}"
                                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Button.Triggers>
                                            <Grid Width="210">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontSize="14"/>
                                                <!-- Arrow for expandable parents -->
                                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#95a5a6"
                                                           Visibility="{Binding IsParent, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="▶"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                                    <Setter Property="Text" Value="▼"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </Button>

                                        <!-- === Children Sub-Menu (visible when expanded) === -->
                                        <ItemsControl ItemsSource="{Binding Children}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource SidebarButtonStyle}"
                                                            Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Margin="20,0,0,0">
                                                        <Button.Triggers>
                                                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                                                                        <ThicknessAnimation Storyboard.TargetProperty="Margin" From="20,-10,0,0" To="20,0,0,0" Duration="0:0:0.3">
                                                                            <ThicknessAnimation.EasingFunction>
                                                                                <CubicEase EasingMode="EaseOut"/>
                                                                            </ThicknessAnimation.EasingFunction>
                                                                        </ThicknessAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Button.Triggers>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Icon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontSize="13"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- User Info / Logout -->
                    <Border Grid.Row="3" Margin="10,5,10,15" Padding="10" CornerRadius="10" Background="#34495e">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="38" Height="38" CornerRadius="19" Background="#2ecc71" Margin="0,0,10,0">
                                <TextBlock Text="👤" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentUserName}" Foreground="White" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding CurrentRoleName}" Foreground="#95a5a6" FontSize="11"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="🚪" FontSize="18" VerticalAlignment="Center"
                                    Background="Transparent" BorderThickness="0" Foreground="#e74c3c" Cursor="Hand"
                                    Command="{Binding LogoutCommand}" ToolTip="تسجيل خروج"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- ====================== MAIN CONTENT ====================== -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Top Bar -->
                <Border Grid.Row="0" Padding="25,15" Background="White" CornerRadius="0,15,0,0">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06" Color="Black" Direction="270"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Page Title -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentPageTitle}" FontSize="22" FontWeight="Bold" Foreground="#2c3e50" VerticalAlignment="Center"/>
                        </StackPanel>

                        <!-- Window Controls -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="─" FontSize="14" Width="35" Height="35" Background="Transparent" BorderThickness="0" Foreground="#7f8c8d" Cursor="Hand" Click="MinimizeBtn_Click"/>
                            <Button Content="□" FontSize="14" Width="35" Height="35" Background="Transparent" BorderThickness="0" Foreground="#7f8c8d" Cursor="Hand" Click="MaximizeBtn_Click" Margin="5,0"/>
                            <Button Content="✕" FontSize="14" Width="35" Height="35" Background="Transparent" BorderThickness="0" Foreground="#e74c3c" Cursor="Hand" Click="CloseBtn_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Content Area -->
                <Grid Grid.Row="1" Margin="20">
                    
                    <!-- HOME PAGE: Dashboard Cards (visible only when IsHomePage = True) -->
                    <Border CornerRadius="12" Background="White" Padding="25" 
                            Visibility="{Binding IsHomePage, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.06" Color="Black"/>
                        </Border.Effect>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="1*"/>
                                <RowDefinition Height="1*"/>
                            </Grid.RowDefinitions>

                            <!-- Quick Stats Cards -->
                            <UniformGrid Grid.Row="0" Columns="4" Margin="0,0,0,20">
                                <!-- Sales Card -->
                                <Border Margin="8" CornerRadius="12" Padding="20">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#2ecc71" Offset="0"/>
                                            <GradientStop Color="#27ae60" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="🛒" FontSize="28"/>
                                        <TextBlock Text="المبيعات اليوم" Foreground="White" FontSize="13" Margin="0,8,0,3"/>
                                        <TextBlock Text="{Binding TodaySales, StringFormat={}{0:N3} د.ك}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <!-- Purchases Card -->
                                <Border Margin="8" CornerRadius="12" Padding="20">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#3498db" Offset="0"/>
                                            <GradientStop Color="#2980b9" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="📦" FontSize="28"/>
                                        <TextBlock Text="المشتريات اليوم" Foreground="White" FontSize="13" Margin="0,8,0,3"/>
                                        <TextBlock Text="{Binding TodayPurchases, StringFormat={}{0:N3} د.ك}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <!-- Products Card -->
                                <Border Margin="8" CornerRadius="12" Padding="20">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#e67e22" Offset="0"/>
                                            <GradientStop Color="#d35400" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="🏪" FontSize="28"/>
                                        <TextBlock Text="عدد الأصناف" Foreground="White" FontSize="13" Margin="0,8,0,3"/>
                                        <TextBlock Text="{Binding TotalProducts}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                                <!-- Customers Card -->
                                <Border Margin="8" CornerRadius="12" Padding="20">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#9b59b6" Offset="0"/>
                                            <GradientStop Color="#8e44ad" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <StackPanel>
                                        <TextBlock Text="👥" FontSize="28"/>
                                        <TextBlock Text="العملاء والموردين" Foreground="White" FontSize="13" Margin="0,8,0,3"/>
                                        <TextBlock Text="{Binding TotalCustomers}" Foreground="White" FontSize="22" FontWeight="Bold"/>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <!-- Main Content Grid for Charts and Alerts -->
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Sales Chart -->
                                <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="8" Background="#fafbfc" BorderBrush="#e1e4e8" BorderThickness="1" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="📈 حركة المبيعات (آخر 7 أيام)" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                                        <lvc:CartesianChart Grid.Row="1" Series="{Binding SalesSeries}">
                                            <lvc:CartesianChart.AxisX>
                                                <lvc:Axis Title="التاريخ" Labels="{Binding SalesLabels}" Foreground="#7f8c8d">
                                                    <lvc:Axis.Separator>
                                                        <lvc:Separator Step="1" IsEnabled="False"/>
                                                    </lvc:Axis.Separator>
                                                </lvc:Axis>
                                            </lvc:CartesianChart.AxisX>
                                            <lvc:CartesianChart.AxisY>
                                                <lvc:Axis Title="القيمة" LabelFormatter="{Binding YFormatter}" Foreground="#7f8c8d"/>
                                            </lvc:CartesianChart.AxisY>
                                        </lvc:CartesianChart>
                                    </Grid>
                                </Border>

                                <!-- Low Stock Alerts -->
                                <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="8" Background="#fafbfc" BorderBrush="#e1e4e8" BorderThickness="1" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="⚠️ تنبيهات نقص المخزون" FontSize="16" FontWeight="SemiBold" Foreground="#e74c3c" Margin="0,0,0,15"/>
                                        
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding AlertProducts}" AutoGenerateColumns="False" 
                                                  HeadersVisibility="Column" GridLinesVisibility="None" RowBackground="Transparent"
                                                  BorderThickness="0" Background="Transparent" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#7f8c8d"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="5,0,5,10"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="BorderBrush" Value="#ecf0f1"/>
                                                </Style>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Margin" Value="0,2"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#f1f2f6"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="5,8"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="الصنف" Binding="{Binding ProductName}" Width="*" Foreground="#2c3e50" FontWeight="Medium"/>
                                                <DataGridTemplateColumn Header="الرصيد" Width="Auto">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{Binding StatusColor}" CornerRadius="4" Padding="6,2">
                                                                <TextBlock Text="{Binding CurrentQty}" Foreground="White" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        
                                        <!-- Empty State -->
                                        <TextBlock Grid.Row="1" Text="لا توجد نواقص في المخزون 🎉" Foreground="#2ecc71" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AlertProducts.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Debts Grid -->
                            <Grid Grid.Row="2" Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1*"/>
                                    <ColumnDefinition Width="1*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Customer Debts -->
                                <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="8" Background="#fafbfc" BorderBrush="#e1e4e8" BorderThickness="1" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="👥 مديونيات العملاء" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding CustomerDebts}" AutoGenerateColumns="False" 
                                                  HeadersVisibility="Column" GridLinesVisibility="None" RowBackground="Transparent"
                                                  BorderThickness="0" Background="Transparent" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Resources>
                                                <!-- Add same styles as above DataGrid -->
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#7f8c8d"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="5,0,5,10"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="BorderBrush" Value="#ecf0f1"/>
                                                </Style>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Margin" Value="0,2"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#f1f2f6"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="5,8"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="العميل" Binding="{Binding PartnerName}" Width="*" Foreground="#2c3e50" FontWeight="Medium"/>
                                                <DataGridTextColumn Header="المديونية" Binding="{Binding Balance, StringFormat={}{0:N3} د.ك}" Width="Auto" Foreground="#e74c3c" FontWeight="Bold"/>
                                                <DataGridTemplateColumn Header="إجراء" Width="Auto">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="سداد" Command="{Binding DataContext.PayCustomerDebtCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#2ecc71" Foreground="White" BorderThickness="0" Padding="15,4" Margin="5,0,0,0" Cursor="Hand" FontWeight="Bold"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <!-- Empty State -->
                                        <TextBlock Grid.Row="1" Text="لا توجد مديونيات 🎉" Foreground="#2ecc71" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CustomerDebts.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- Supplier Debts -->
                                <Border Grid.Column="1" Margin="10,0,0,0" CornerRadius="8" Background="#fafbfc" BorderBrush="#e1e4e8" BorderThickness="1" Padding="15">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="🏢 مديونيات الموردين" FontSize="16" FontWeight="SemiBold" Foreground="#2c3e50" Margin="0,0,0,15"/>
                                        
                                        <DataGrid Grid.Row="1" ItemsSource="{Binding SupplierDebts}" AutoGenerateColumns="False" 
                                                  HeadersVisibility="Column" GridLinesVisibility="None" RowBackground="Transparent"
                                                  BorderThickness="0" Background="Transparent" IsReadOnly="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <DataGrid.Resources>
                                                <Style TargetType="DataGridColumnHeader">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Foreground" Value="#7f8c8d"/>
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                    <Setter Property="Padding" Value="5,0,5,10"/>
                                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                    <Setter Property="BorderBrush" Value="#ecf0f1"/>
                                                </Style>
                                                <Style TargetType="DataGridRow">
                                                    <Setter Property="Background" Value="Transparent"/>
                                                    <Setter Property="Margin" Value="0,2"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#f1f2f6"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                                <Style TargetType="DataGridCell">
                                                    <Setter Property="BorderThickness" Value="0"/>
                                                    <Setter Property="Padding" Value="5,8"/>
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                    <Style.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter Property="Background" Value="Transparent"/>
                                                            <Setter Property="Foreground" Value="Black"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </DataGrid.Resources>
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="المورد" Binding="{Binding PartnerName}" Width="*" Foreground="#2c3e50" FontWeight="Medium"/>
                                                <DataGridTextColumn Header="المديونية" Binding="{Binding Balance, StringFormat={}{0:N3} د.ك}" Width="Auto" Foreground="#e74c3c" FontWeight="Bold"/>
                                                <DataGridTemplateColumn Header="إجراء" Width="Auto">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="دفع" Command="{Binding DataContext.PaySupplierDebtCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="#e74c3c" Foreground="White" BorderThickness="0" Padding="15,4" Margin="5,0,0,0" Cursor="Hand" FontWeight="Bold"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <!-- Empty State -->
                                        <TextBlock Grid.Row="1" Text="لا توجد مديونيات 🎉" Foreground="#2ecc71" 
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SupplierDebts.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- EMBEDDED PAGES: Shown when a page is selected (CurrentPage != null) -->
                    <ContentControl Content="{Binding CurrentPage}" />
                    
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
