<UserControl x:Class="Views.ProductCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             mc:Ignorable="d"
             d:DesignHeight="768" d:DesignWidth="1200"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <helpers:DirToArrowConverter x:Key="DirToArrowConverter"/>
        <helpers:DirToColorConverter x:Key="DirToColorConverter"/>
        <helpers:PeriodToColorConverter x:Key="PeriodToColorConverter"/>

        <!-- Filter RadioButton Style -->
        <Style x:Key="FilterRadioStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E8F0"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="#475569"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bg"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EFF6FF"/>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#3B82F6"/>
                                <Setter Property="Foreground" Value="#3B82F6"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#F8FAFC"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Storyboard x:Key="EntryStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainContainer"
                             Storyboard.TargetProperty="Opacity"
                             From="0" To="1" Duration="0:0:0.35"/>
            <ThicknessAnimation Storyboard.TargetName="MainContainer"
                                Storyboard.TargetProperty="Margin"
                                From="0,30,0,-30" To="0" Duration="0:0:0.4">
                <ThicknessAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </ThicknessAnimation.EasingFunction>
            </ThicknessAnimation>
        </Storyboard>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="UserControl.Loaded">
            <BeginStoryboard Storyboard="{StaticResource EntryStoryboard}"/>
        </EventTrigger>
    </UserControl.Triggers>

    <!-- Main Container -->
    <Grid x:Name="MainContainer" Background="#F1F5F9">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Summary Cards -->
            <RowDefinition Height="*"/>     <!-- Chart & DataGrid -->
        </Grid.RowDefinitions>

        <!-- ════ 1. Header ════ -->
        <Border Grid.Row="0" Background="White" Padding="20,14" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EFF6FF" CornerRadius="12" Width="46" Height="46" Margin="0,0,14,0">
                        <TextBlock Text="🏷️" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="بطاقة الصنف — التحليلات الشاملة" FontSize="13" Foreground="#64748B" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding ProductName}" FontSize="22" FontWeight="Bold" Foreground="#0F172A" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Barcode, StringFormat='باركود: {0}'}" FontSize="12" Foreground="#94A3B8" Margin="0,1,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Close Button -->
                <Button Grid.Column="1" x:Name="BtnClose" Content="✕"
                        FontSize="18" FontWeight="Bold"
                        Foreground="#64748B" Background="Transparent" BorderThickness="0"
                        Width="38" Height="38"
                        Style="{DynamicResource ModernButtonStyle}"
                        Click="BtnClose_Click"
                        ToolTip="إغلاق بطاقة الصنف"/>
            </Grid>
        </Border>

        <!-- ════ 2. Summary Cards (2 rows × 4 cols) ════ -->
        <Border Grid.Row="1" Padding="20,14,20,0">
            <UniformGrid Columns="4" Rows="2">

                <!-- Card 1: الرصيد الحالي -->
                <Border Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,14,14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📦" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="الرصيد الحالي" FontSize="13" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary.Balance, StringFormat=N2}" FontSize="26" FontWeight="Black" Foreground="#0F172A"/>
                    </StackPanel>
                </Border>

                <!-- Card 2: متوسط سعر التكلفة -->
                <Border Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,14,14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="💰" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="متوسط سعر التكلفة" FontSize="13" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Summary.AvgCost, StringFormat=N2}" FontSize="26" FontWeight="Black" Foreground="#10B981"/>
                            <TextBlock Text=" KWD" FontSize="13" Foreground="#10B981" Margin="4,8,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 3: آخر سعر شراء -->
                <Border Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,14,14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="💵" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="آخر سعر شراء" FontSize="13" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Summary.LastPurchasePrice, StringFormat=N2}" FontSize="26" FontWeight="Black" Foreground="#F59E0B"/>
                            <TextBlock Text=" KWD" FontSize="13" Foreground="#F59E0B" Margin="4,8,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 4: معدل الربح التقريبي -->
                <Border Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📈" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="معدل الربح التقريبي" FontSize="13" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Summary.ProfitRate, StringFormat=N1}" FontSize="26" FontWeight="Black" Foreground="#8B5CF6"/>
                            <TextBlock Text="%" FontSize="18" Foreground="#8B5CF6" Margin="2,4,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 5: إجمالي الوارد -->
                <Border Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,14,14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📥" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="إجمالي الوارد" FontSize="13" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Summary.TotalInQty, StringFormat=N2}" FontSize="20" FontWeight="Bold" Foreground="#3B82F6"/>
                            <TextBlock Text=" وحدة" FontSize="12" Foreground="#94A3B8" Margin="2,0,16,0" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding Summary.TotalInValue, StringFormat=N2}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text=" KWD" FontSize="12" Foreground="#94A3B8" Margin="2,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 6: إجمالي الصادر -->
                <Border Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,14,14"
                        BorderBrush="#E2E8F0" BorderThickness="1">
                    <Border.Effect><DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.04" Color="#000"/></Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="📤" FontSize="18" Margin="0,0,8,0"/>
                            <TextBlock Text="إجمالي الصادر" FontSize="13" Foreground="#64748B" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Summary.TotalOutQty, StringFormat=N2}" FontSize="20" FontWeight="Bold" Foreground="#EF4444"/>
                            <TextBlock Text=" وحدة" FontSize="12" Foreground="#94A3B8" Margin="2,0,16,0" VerticalAlignment="Bottom"/>
                            <TextBlock Text="{Binding Summary.TotalOutValue, StringFormat=N2}" FontSize="20" FontWeight="Bold" Foreground="#0F172A"/>
                            <TextBlock Text=" KWD" FontSize="12" Foreground="#94A3B8" Margin="2,0,0,0" VerticalAlignment="Bottom"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card 7 + 8: Placeholder (empty for symmetry) -->
                <Border Background="Transparent" Margin="0,0,14,14"/>
                <Border Background="Transparent" Margin="0,0,0,14"/>

            </UniformGrid>
        </Border>

        <!-- ════ 3. Content Area: DataGrid (60%) + Chart (40%) ════ -->
        <Grid Grid.Row="2" Margin="20,0,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6*"/>
                <ColumnDefinition Width="4*"/>
            </Grid.ColumnDefinitions>

            <!-- ▌ حركة الصنف — DataGrid ▌ -->
            <Border Grid.Column="0" Background="White" CornerRadius="16"
                    BorderBrush="#E2E8F0" BorderThickness="1" Margin="0,0,14,0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- Filter Bar -->
                        <RowDefinition Height="*"/>      <!-- DataGrid -->
                        <RowDefinition Height="Auto"/>   <!-- Pagination Bar -->
                    </Grid.RowDefinitions>

                    <!-- Filter Bar -->
                    <Border Grid.Row="0" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="حركة الصنف والفواتير" FontSize="15" FontWeight="Bold"
                                       Foreground="#0F172A" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <RadioButton Content="الكل"
                                         Command="{Binding FilterMovementsCommand}" CommandParameter="ALL"
                                         GroupName="MovFilter" IsChecked="True"
                                         Style="{StaticResource FilterRadioStyle}" Margin="0,0,6,0"/>
                            <RadioButton Content="📥 وارد"
                                         Command="{Binding FilterMovementsCommand}" CommandParameter="IN"
                                         GroupName="MovFilter"
                                         Style="{StaticResource FilterRadioStyle}" Margin="0,0,6,0"/>
                            <RadioButton Content="📤 صادر"
                                         Command="{Binding FilterMovementsCommand}" CommandParameter="OUT"
                                         GroupName="MovFilter"
                                         Style="{StaticResource FilterRadioStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" ItemsSource="{Binding PagedMovements}"
                              AutoGenerateColumns="False" IsReadOnly="True"
                              Background="Transparent" BorderThickness="0"
                              RowHeaderWidth="0" GridLinesVisibility="None"
                              HeadersVisibility="Column" SelectionUnit="FullRow"
                              SelectionMode="Single" RowHeight="44">

                        <DataGrid.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#F1F5F9"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#0F172A"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#F1F5F9"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#0F172A"/>
                        </DataGrid.Resources>

                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="#F8FAFC"/>
                                <Setter Property="Foreground" Value="#64748B"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="Padding" Value="14,10"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#E2E8F0"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>

                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                <Setter Property="BorderBrush" Value="#F1F5F9"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F8FAFC"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>

                        <DataGrid.CellStyle>
                            <Style TargetType="DataGridCell">
                                <Setter Property="Padding" Value="14,0"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                                                <ContentPresenter VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>

                        <DataGrid.Columns>
                            <!-- اتجاه الحركة -->
                            <DataGridTemplateColumn Width="42" Header="">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding MovementDirection, Converter={StaticResource DirToArrowConverter}}"
                                                   Foreground="{Binding MovementDirection, Converter={StaticResource DirToColorConverter}}"
                                                   FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Header="رقم الفاتورة"
                                               Binding="{Binding InvID}"
                                               Width="85"/>

                            <DataGridTextColumn Header="التاريخ"
                                               Binding="{Binding InvDate, StringFormat=dd/MM/yyyy}"
                                               Width="90"/>



                            <DataGridTextColumn Header="العميل / المورد"
                                               Binding="{Binding PartnerName}"
                                               Width="80"/>

                            <DataGridTextColumn Header="الكمية"
                                               Binding="{Binding Quantity, StringFormat=N2}"
                                               Width="80">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="Bold"/>
                                        <Setter Property="Foreground" Value="{Binding MovementDirection, Converter={StaticResource DirToColorConverter}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Header="سعر الوحدة"
                                               Binding="{Binding UnitPrice, StringFormat=N2}"
                                               Width="78"/>

                            <DataGridTextColumn Header="الإجمالي"
                                               Binding="{Binding TotalPrice, StringFormat=N2}"
                                               Width="78"
                                               FontWeight="Bold"/>

                            <!-- زر فتح الفاتورة -->
                            <DataGridTemplateColumn Width="70" Header="عرض">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="👁" ToolTip="فتح الفاتورة الأصلية"
                                                Command="{Binding DataContext.OpenInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Background="Transparent" BorderThickness="0"
                                                Foreground="#3B82F6" FontSize="16"
                                                Cursor="Hand" Style="{DynamicResource ModernButtonStyle}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- شريط تسلسل الصفحات -->
                    <Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                            Background="#FAFBFC" Padding="14,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- إجمالي السجلات -->
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       FontSize="12" Foreground="#94A3B8">
                                <Run Text="إجمالي الحركات: "/>
                                <Run Text="{Binding TotalRecords, Mode=OneWay}"
                                     FontWeight="SemiBold" Foreground="#475569"/>
                            </TextBlock>

                            <!-- أزرار التنقل -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">

                                <Button Content="❮" ToolTip="الصفحة السابقة"
                                        Command="{Binding PrevPageCommand}"
                                        Width="32" Height="32" Margin="0,0,8,0"
                                        Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                        Foreground="#475569" FontSize="13" FontWeight="Bold"
                                        Cursor="Hand" Style="{DynamicResource ModernButtonStyle}"/>

                                <Border Background="#EFF6FF" CornerRadius="8"
                                        Padding="16,5" Margin="0,0,8,0">
                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="#3B82F6"
                                               VerticalAlignment="Center">
                                        <Run Text="الصفحة "/>
                                        <Run Text="{Binding PageInfo, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>

                                <Button Content="❯" ToolTip="الصفحة التالية"
                                        Command="{Binding NextPageCommand}"
                                        Width="32" Height="32"
                                        Background="White" BorderBrush="#E2E8F0" BorderThickness="1"
                                        Foreground="#475569" FontSize="13" FontWeight="Bold"
                                        Cursor="Hand" Style="{DynamicResource ModernButtonStyle}"/>
                            </StackPanel>

                            <!-- حجم الصفحة -->
                            <TextBlock Grid.Column="2"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       FontSize="12" Foreground="#94A3B8"
                                       Text="15 سجل / صفحة"/>
                        </Grid>
                    </Border>

                </Grid>

            </Border>

            <!-- ▌ الرسم البياني ▌ -->
            <Border Grid.Column="1" Background="White" CornerRadius="16"
                    BorderBrush="#E2E8F0" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <!-- عنوان الرسم + أزرار الفلتر -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="الرصيد التراكمي"
                                   FontSize="15" FontWeight="Bold" Foreground="#0F172A"
                                   VerticalAlignment="Center"/>

                        <!-- أزرار فلتر الفترة -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="شهر"
                                    Command="{Binding ChartPeriodCommand}"
                                    CommandParameter="1"
                                    Tag="1"
                                    Style="{DynamicResource ModernButtonStyle}"
                                    Background="{Binding ChartPeriodMonths, Converter={StaticResource PeriodToColorConverter}, ConverterParameter=1}"
                                    Foreground="White" FontSize="11" Padding="10,4"
                                    Margin="0,0,4,0"/>
                            <Button Content="3 أشهر"
                                    Command="{Binding ChartPeriodCommand}"
                                    CommandParameter="3"
                                    Style="{DynamicResource ModernButtonStyle}"
                                    Background="{Binding ChartPeriodMonths, Converter={StaticResource PeriodToColorConverter}, ConverterParameter=3}"
                                    Foreground="White" FontSize="11" Padding="10,4"
                                    Margin="0,0,4,0"/>
                            <Button Content="6 أشهر"
                                    Command="{Binding ChartPeriodCommand}"
                                    CommandParameter="6"
                                    Style="{DynamicResource ModernButtonStyle}"
                                    Background="{Binding ChartPeriodMonths, Converter={StaticResource PeriodToColorConverter}, ConverterParameter=6}"
                                    Foreground="White" FontSize="11" Padding="10,4"
                                    Margin="0,0,4,0"/>
                            <Button Content="سنة"
                                    Command="{Binding ChartPeriodCommand}"
                                    CommandParameter="12"
                                    Style="{DynamicResource ModernButtonStyle}"
                                    Background="{Binding ChartPeriodMonths, Converter={StaticResource PeriodToColorConverter}, ConverterParameter=12}"
                                    Foreground="White" FontSize="11" Padding="10,4"/>
                        </StackPanel>
                    </Grid>

                    <lvc:CartesianChart Grid.Row="1"
                                        Series="{Binding ChartSeries}"
                                        LegendLocation="Bottom">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title=""
                                      Labels="{Binding ChartLabels}"
                                      FontSize="11" Foreground="#64748B"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="الكمية"
                                      LabelFormatter="{Binding YFormatter}"
                                      FontSize="11" Foreground="#64748B" MinValue="0"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>
                </Grid>
            </Border>

        </Grid>
    </Grid>
</UserControl>
