<Window x:Class="Views.UserManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Vegtablity.ViewModels"
        xmlns:helpers="clr-namespace:Vegtablity.Helpers"
        Title="إدارة المستخدمين والصلاحيات" Height="700" Width="950"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent">

    <Window.DataContext>
        <vm:UserManagementViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConverter"/>
    </Window.Resources>

    <Border CornerRadius="15" Background="#f5f6fa">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.25"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border Grid.Row="0" CornerRadius="15,15,0,0" Padding="20,12" MouseDown="TitleBar_MouseDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#2c3e50" Offset="0"/>
                        <GradientStop Color="#34495e" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <TextBlock Text="🔐  إدارة المستخدمين والصلاحيات" Foreground="White" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="✕" HorizontalAlignment="Right" FontSize="16" Background="Transparent" BorderThickness="0" Foreground="#e74c3c" Cursor="Hand" Click="CloseBtn_Click"/>
                </Grid>
            </Border>

            <!-- Tab Control -->
            <TabControl Grid.Row="1" Margin="15" BorderThickness="0" Background="Transparent">

                <!-- ========== TAB 1: Users ========== -->
                <TabItem Header="  👥 المستخدمين  " FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <!-- Users List -->
                        <DataGrid Grid.Column="0" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="1" BorderBrush="#dcdde1" Margin="0,0,15,0"
                                  RowHeight="38" ColumnHeaderHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding UserID}" Width="50"/>
                                <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="*"/>
                                <DataGridTextColumn Header="الاسم الكامل" Binding="{Binding FullName}" Width="*"/>
                                <DataGridTextColumn Header="الدور" Binding="{Binding RoleName}" Width="100"/>
                                <DataGridCheckBoxColumn Header="نشط" Binding="{Binding IsActive}" Width="60"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Edit Panel -->
                        <Border Grid.Column="1" CornerRadius="10" Background="White" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                            </Border.Effect>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="تفاصيل المستخدم" FontSize="16" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,15"/>

                                    <!-- اسم المستخدم -->
                                    <TextBlock Text="اسم المستخدم *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditUserName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding UserNameError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                                               Visibility="{Binding UserNameError, Converter={StaticResource StringToVisConverter}}"/>

                                    <!-- الاسم الكامل -->
                                    <TextBlock Text="الاسم الكامل *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditFullName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding FullNameError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                                               Visibility="{Binding FullNameError, Converter={StaticResource StringToVisConverter}}"/>

                                    <!-- كلمة المرور -->
                                    <TextBlock Text="كلمة المرور *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding EditPassword, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                                    <TextBlock Text="{Binding PasswordError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                                               Visibility="{Binding PasswordError, Converter={StaticResource StringToVisConverter}}"/>

                                    <!-- الدور -->
                                    <TextBlock Text="الدور *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding Roles}" SelectedValue="{Binding EditRoleID}" SelectedValuePath="RoleID" DisplayMemberPath="RoleName" Margin="0,0,0,2" Padding="8"/>
                                    <TextBlock Text="{Binding RoleError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                                               Visibility="{Binding RoleError, Converter={StaticResource StringToVisConverter}}"/>

                                    <CheckBox Content="  نشط (Active)" IsChecked="{Binding EditIsActive}" Margin="0,5,0,15"/>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Content="💾 حفظ" Command="{Binding SaveUserCommand}" Style="{StaticResource ModernButtonStyle}" Width="80" Margin="5"/>
                                        <Button Content="🆕 جديد" Command="{Binding NewUserCommand}" Style="{StaticResource ModernButtonStyle}" Width="80" Margin="5" Background="#3498db"/>
                                        <Button Content="🗑 حذف" Command="{Binding DeleteUserCommand}" Style="{StaticResource ModernButtonStyle}" Width="80" Margin="5" Background="#e74c3c"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========== TAB 2: Roles ========== -->
                <TabItem Header="  🎭 الأدوار  " FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="1" BorderBrush="#dcdde1" Margin="0,0,15,0"
                                  RowHeight="38" ColumnHeaderHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding RoleID}" Width="60"/>
                                <DataGridTextColumn Header="اسم الدور" Binding="{Binding RoleName}" Width="*"/>
                                <DataGridTextColumn Header="الوصف" Binding="{Binding Description}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Column="1" CornerRadius="10" Background="White" Padding="15">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.06"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="تفاصيل الدور" FontSize="16" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,15"/>

                                <!-- اسم الدور -->
                                <TextBlock Text="اسم الدور *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditRoleName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding RoleNameError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                                           Visibility="{Binding RoleNameError, Converter={StaticResource StringToVisConverter}}"/>

                                <!-- الوصف -->
                                <TextBlock Text="الوصف" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditRoleDescription, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15" TextWrapping="Wrap" Height="60" AcceptsReturn="True"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="💾 حفظ" Command="{Binding SaveRoleCommand}" Style="{StaticResource ModernButtonStyle}" Width="80" Margin="5"/>
                                    <Button Content="🆕 جديد" Command="{Binding NewRoleCommand}" Style="{StaticResource ModernButtonStyle}" Width="80" Margin="5" Background="#3498db"/>
                                    <Button Content="🗑 حذف" Command="{Binding DeleteRoleCommand}" Style="{StaticResource ModernButtonStyle}" Width="80" Margin="5" Background="#e74c3c"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ========== TAB 3: Permissions ========== -->
                <TabItem Header="  🛡 الصلاحيات  " FontSize="14" FontWeight="SemiBold">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Role Selector -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                            <TextBlock Text="اختر الدور:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14"/>
                            <ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedPermissionRole}" DisplayMemberPath="RoleName" Width="200" Padding="8" FontSize="14"/>
                        </StackPanel>

                        <!-- Permissions Grid -->
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Permissions}"
                                  AutoGenerateColumns="False" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="All"
                                  BorderThickness="1" BorderBrush="#dcdde1"
                                  RowHeight="38" ColumnHeaderHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="اسم النموذج" Binding="{Binding FormName}" Width="*" IsReadOnly="True"/>
                                <DataGridCheckBoxColumn Header="عرض" Binding="{Binding CanView}" Width="70"/>
                                <DataGridCheckBoxColumn Header="إضافة" Binding="{Binding CanAdd}" Width="70"/>
                                <DataGridCheckBoxColumn Header="تعديل" Binding="{Binding CanEdit}" Width="70"/>
                                <DataGridCheckBoxColumn Header="حذف" Binding="{Binding CanDelete}" Width="70"/>
                                <DataGridCheckBoxColumn Header="طباعة" Binding="{Binding CanPrint}" Width="70"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Save Button -->
                        <Button Grid.Row="2" Content="💾 حفظ الصلاحيات" Command="{Binding SavePermissionsCommand}" Style="{StaticResource ModernButtonStyle}" HorizontalAlignment="Right" Margin="0,15,0,0" Width="160" Height="40"/>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Status Bar -->
            <Border Grid.Row="2" CornerRadius="0,0,15,15" Background="#ecf0f1" Padding="15,8">
                <TextBlock Text="{Binding UserStatusMessage}" Foreground="#2c3e50" FontSize="13"/>
            </Border>
        </Grid>
    </Border>
</Window>
