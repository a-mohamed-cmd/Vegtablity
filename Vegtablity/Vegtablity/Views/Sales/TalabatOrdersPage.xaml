<UserControl x:Class="Views.TalabatOrdersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels.Sales"
             mc:Ignorable="d"
             d:DesignHeight="860" d:DesignWidth="1220"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <UserControl.DataContext>
        <vm:TalabatOrdersViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F8FAFC" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header & Branch Availability Bar -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="18,14" Margin="0,0,0,12">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🛵" FontSize="30" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel>
                        <TextBlock Text="إدارة طلبات ومبيعات منصة طلبات (Talabat POS Integration)" FontSize="18" FontWeight="Bold" Foreground="#EA580C"/>
                        <TextBlock Text="استقبال الطلبات الفورية، القبول والتحويل الآلي لفاتورة مبيعات باسم عميل (Talabat)، إشعار الجاهزية، والطباعة" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <!-- KPIs & Branch Toggle -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="طلبات جديدة واردة" FontSize="10.5" Foreground="#9A3412"/>
                            <TextBlock Text="{Binding NewOrdersCount}" FontSize="15" FontWeight="Bold" Foreground="#C2410C" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="قيد التحضير" FontSize="10.5" Foreground="#1E40AF"/>
                            <TextBlock Text="{Binding PreparingOrdersCount}" FontSize="15" FontWeight="Bold" Foreground="#1D4ED8" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="#DCFCE7" BorderBrush="#86EFAC" BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel>
                            <TextBlock Text="إجمالي مبيعات Talabat" FontSize="10.5" Foreground="#166534"/>
                            <TextBlock Text="{Binding TotalTalabatSales, StringFormat={}{0:N3}}" FontSize="14" FontWeight="Bold" Foreground="#14532D"/>
                        </StackPanel>
                    </Border>

                    <Button Content="{Binding BranchStatusText}" Command="{Binding ToggleBranchAvailabilityCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#0F172A" Foreground="White"
                            Height="38" Padding="14,0" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Search, Prep Time, & Action Bar -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="بحث في الطلبات:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="200" Height="32" Padding="8,4" Margin="0,0,8,0"/>
                    <Button Content="🔄 تحديث الطلبات" Command="{Binding RefreshOrdersCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#2563EB" Foreground="White"
                            Height="32" Padding="14,0" FontSize="12" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="🧪 محاكاة طلب وارد (اختبار)" Command="{Binding SimulateIncomingOrderCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#FFF7ED" Foreground="#C2410C"
                            Height="32" Padding="12,0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="وقت التحضير (دقيقة):" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBox Text="{Binding PrepTimeMinutes, UpdateSourceTrigger=PropertyChanged}" Width="50" Height="32" Padding="6,4" Margin="0,0,10,0"/>

                    <Button Content="✅ قبول الطلب وإصدار الفاتورة" Command="{Binding AcceptOrderCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White"
                            Height="34" Padding="14,0" FontSize="12.5" FontWeight="Bold" Margin="0,0,6,0" Cursor="Hand"/>

                    <Button Content="👨‍🍳 إشعار جاهزية الطلب (Prepared)" Command="{Binding MarkPreparedCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#EA580C" Foreground="White"
                            Height="34" Padding="14,0" FontSize="12.5" FontWeight="Bold" Margin="0,0,6,0" Cursor="Hand"/>

                    <Button Content="🖨️ طباعة الطلب" Command="{Binding PrintOrderTicketCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#F1F5F9" Foreground="#334155"
                            Height="34" Padding="12,0" FontSize="12" FontWeight="SemiBold" Margin="0,0,6,0" Cursor="Hand"/>

                    <Button Content="❌ رفض الطلب" Command="{Binding RejectOrderCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#DC2626" Foreground="White"
                            Height="34" Padding="12,0" FontSize="12" FontWeight="Bold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. Orders DataGrid + Order Details Panel -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="10">
                <DataGrid ItemsSource="{Binding Orders}"
                          SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" RowHeight="38" FontSize="12.5"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E2E8F0"
                          HeadersVisibility="Column" BorderThickness="0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="كود الطلب" Binding="{Binding OrderCode}" Width="110"/>
                        <DataGridTextColumn Header="الرقم المختصر" Binding="{Binding ShortCode}" Width="85"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding CustomerName}" Width="150"/>
                        <DataGridTextColumn Header="نوع الطلب" Binding="{Binding ExpeditionType}" Width="90"/>
                        <DataGridTextColumn Header="الدفع" Binding="{Binding PaymentType}" Width="80"/>
                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat={}{0:N3}}" Width="95"/>
                        <DataGridTextColumn Header="رقم فاتورة المبيعات" Binding="{Binding InvID}" Width="115"/>
                        <DataGridTextColumn Header="حالة الطلب" Binding="{Binding OrderStatusArabic}" Width="*"/>
                        <DataGridTextColumn Header="وقت الورود" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="125"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Selected Order Details Sidebar -->
            <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16"
                    Visibility="{Binding HasSelectedOrder, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="📋 تفاصيل طلب Talabat المحدد" FontSize="15" FontWeight="Bold" Foreground="#0F172A" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding SelectedOrder.OrderCode}" FontSize="18" FontWeight="Bold" Foreground="#EA580C"/>
                    <TextBlock Text="{Binding SelectedOrder.OrderStatusArabic}" FontSize="12.5" FontWeight="SemiBold" Foreground="#2563EB" Margin="0,2,0,10"/>

                    <TextBlock Text="العميل والهاتف:" FontSize="11.5" Foreground="#64748B"/>
                    <TextBlock Text="{Binding SelectedOrder.CustomerName}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding SelectedOrder.CustomerPhone}" FontSize="12.5" Margin="0,0,0,8"/>

                    <TextBlock Text="عنوان التوصيل:" FontSize="11.5" Foreground="#64748B"/>
                    <TextBlock Text="{Binding SelectedOrder.DeliveryAddress}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,8"/>

                    <TextBlock Text="ملاحظات الطلب:" FontSize="11.5" Foreground="#64748B"/>
                    <TextBlock Text="{Binding SelectedOrder.Comments}" FontSize="12.5" TextWrapping="Wrap" Foreground="#B45309" Margin="0,0,0,8"/>

                    <TextBlock Text="الأصناف (Items JSON):" FontSize="11.5" Foreground="#64748B"/>
                    <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="8" Margin="0,4,0,10">
                        <TextBlock Text="{Binding SelectedOrder.ItemsJson}" FontSize="11.5" TextWrapping="Wrap"/>
                    </Border>

                    <TextBlock Text="سبب الرفض (في حال رفض الطلب):" FontSize="11.5" Foreground="#64748B" Margin="0,4,0,4"/>
                    <ComboBox SelectedValue="{Binding RejectionReason, Mode=TwoWay}" SelectedValuePath="Tag" Height="32">
                        <ComboBoxItem Content="الصنف غير متوفر حالياً (ITEM_UNAVAILABLE)" Tag="ITEM_UNAVAILABLE" IsSelected="True"/>
                        <ComboBoxItem Content="الفرع مزدحم جداً (RESTAURANT_TOO_BUSY)" Tag="RESTAURANT_TOO_BUSY"/>
                        <ComboBoxItem Content="خارج نطاق التوصيل (OUT_OF_DELIVERY_AREA)" Tag="OUT_OF_DELIVERY_AREA"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

