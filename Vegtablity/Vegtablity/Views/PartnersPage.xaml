<UserControl x:Class="Views.PartnersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers">

    <UserControl.DataContext>
        <vm:PartnersViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- Fade-in animation for entire page -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <TabControl>
        <TabControl.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.15">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </TabControl.Triggers>

        <!-- ==================== تبويب العملاء ==================== -->
        <TabItem Header="👤 العملاء">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Search -->
                <Border Grid.Row="0" Padding="12" Background="#f8f9fa" CornerRadius="10,10,0,0" Margin="0,0,0,5">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,-30,0,5" To="0,0,0,5" Duration="0:0:0.4">
                                        <ThicknessAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="👤 إدارة العملاء" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" Width="280" BorderBrush="#dcdde1" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontSize="13" VerticalAlignment="Center" Padding="5" Background="Transparent"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Content: DataGrid + Edit Panel + Quotes Overlay -->
                <Grid Grid.Row="1">
                    <!-- Base: DataGrid + Edit Panel side by side -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="340"/>
                        </Grid.ColumnDefinitions>

                        <!-- DataGrid -->
                        <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#eee" BorderThickness="1" Background="White">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <DataGrid ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                      BorderThickness="0" Margin="5" RowHeight="38" ColumnHeaderHeight="40">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding PartnerID}" Width="50"/>
                                    <DataGridTextColumn Header="اسم العميل" Binding="{Binding PartnerName}" Width="*"/>
                                    <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                                    <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="150"/>
                                    <DataGridTextColumn Header="الرصيد" Binding="{Binding CurrentBalance, StringFormat=N2}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <!-- Edit Panel -->
                        <Border Grid.Column="1" CornerRadius="10" Background="#fafafa" Padding="18" BorderBrush="#eee" BorderThickness="1">
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.3">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="20,0,0,0" To="0,0,0,0" Duration="0:0:0.5" BeginTime="0:0:0.3">
                                                <ThicknessAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </ThicknessAnimation.EasingFunction>
                                            </ThicknessAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                            <StackPanel>
                                <TextBlock Text="بيانات العميل" FontSize="16" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,15"/>

                                <TextBlock Text="اسم العميل *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                                <TextBlock Text="{Binding CustomerNameError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                                           Visibility="{Binding CustomerNameError, Converter={StaticResource StringToVisConverter}}"/>

                                <TextBlock Text="الهاتف" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>

                                <TextBlock Text="العنوان" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <TextBox Text="{Binding EditCustomerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15"/>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="💾 حفظ" Command="{Binding SaveCustomerCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5"/>
                                    <Button Content="🆕 جديد" Command="{Binding NewCustomerCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5" Background="#3498db" IsEnabled="{Binding CurrentPermissions.CanAdd}"/>
                                    <Button Content="🚫 تعطيل" Command="{Binding DeleteCustomerCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5" Background="#e74c3c"/>
                                </StackPanel>

                                <!-- Quotes Panel Button -->
                                <Button Content="📋 عروض أسعاره" Command="{Binding ShowQuotesPanelCommand}"
                                        Style="{StaticResource ModernButtonStyle}" Background="#6366F1"
                                        Margin="5,15,5,0" HorizontalAlignment="Stretch"
                                        Visibility="{Binding IsEditingCustomer, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ═══════════════════════════════════════════ -->
                    <!--  Quotes Side Panel Overlay (slides in from right) -->
                    <!-- ═══════════════════════════════════════════ -->
                    <Grid x:Name="QuotesPanelOverlay" HorizontalAlignment="Right" Width="360"
                          Visibility="{Binding IsQuotesPanelOpen, Converter={StaticResource BoolToVis}}">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Opacity" Value="0"/>
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="360"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsQuotesPanelOpen}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="0" To="1" Duration="0:0:0.28">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                                     From="360" To="0" Duration="0:0:0.32">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                     From="1" To="0" Duration="0:0:0.2"/>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                                                     From="0" To="360" Duration="0:0:0.22"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>

                        <Border CornerRadius="14,0,0,14" Background="White"
                                BorderBrush="#E0E7FF" BorderThickness="1,0,0,0">
                            <Border.Effect>
                                <DropShadowEffect Color="#000" Opacity="0.12" BlurRadius="20" ShadowDepth="-4" Direction="180"/>
                            </Border.Effect>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Panel Header -->
                                <Border Grid.Row="0" Background="#4F46E5" CornerRadius="14,0,0,0" Padding="16,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="📋 عروض الأسعار" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                            <TextBlock Text="{Binding QuotePanelCustomerName}" Foreground="#C7D2FE" FontSize="12" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="✕" Command="{Binding CloseQuotesPanelCommand}"
                                                Background="Transparent" BorderThickness="0" Foreground="White"
                                                FontSize="16" FontWeight="Bold" Cursor="Hand"
                                                Width="32" Height="32" Padding="0"
                                                VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Quotes List -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12">
                                    <ItemsControl ItemsSource="{Binding CustomerQuotes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,8" CornerRadius="10" Background="#F8FAFF"
                                                        BorderBrush="#E0E7FF" BorderThickness="1" Padding="12,10">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Background" Value="#EEF2FF"/>
                                                                    <Setter Property="BorderBrush" Value="#A5B4FC"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <!-- Row 1: ID + Status Badge -->
                                                        <Grid Grid.Row="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding QuoteID, StringFormat='عرض رقم: {0}'}"
                                                                       FontWeight="SemiBold" FontSize="13" Foreground="#1E293B"/>
                                                            <!-- Active badge: green if active, gray if not -->
                                                            <Border Grid.Column="1" CornerRadius="8" Padding="8,3"
                                                                    Background="#10B981"
                                                                    Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="فعال" FontSize="10" FontWeight="SemiBold" Foreground="White"/>
                                                            </Border>
                                                        </Grid>

                                                        <!-- Row 2: Dates -->
                                                        <StackPanel Grid.Row="1" Margin="0,5,0,0">
                                                            <TextBlock Text="{Binding QuoteDate, StringFormat='📅 التاريخ: {0:yyyy/MM/dd}'}"
                                                                       FontSize="11" Foreground="#64748B"/>
                                                            <TextBlock Text="{Binding ExpiryDate, StringFormat='⏳ الانتهاء: {0:yyyy/MM/dd}'}"
                                                                       FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0"
                                                                       Visibility="{Binding ExpiryDate, Converter={StaticResource StringToVisConverter}}"/>
                                                        </StackPanel>

                                                        <!-- Row 3: Open button -->
                                                        <Button Grid.Row="2" Content="فتح تفاصيل العرض ←"
                                                                Command="{Binding DataContext.ViewQuoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Margin="0,8,0,0" HorizontalAlignment="Right"
                                                                Background="Transparent" BorderThickness="0"
                                                                Foreground="#4F46E5" FontWeight="SemiBold" FontSize="11"
                                                                Cursor="Hand"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>

                                        <!-- Empty state -->
                                        <ItemsControl.Style>
                                            <Style TargetType="ItemsControl">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding CustomerQuotes.Count}" Value="0">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate>
                                                                    <StackPanel HorizontalAlignment="Center" Margin="0,40">
                                                                        <TextBlock Text="📭" FontSize="36" HorizontalAlignment="Center"/>
                                                                        <TextBlock Text="لا توجد عروض أسعار لهذا العميل" Foreground="#94A3B8"
                                                                                   FontSize="13" HorizontalAlignment="Center" Margin="0,10"/>
                                                                    </StackPanel>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ItemsControl.Style>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" CornerRadius="0,0,12,12" Background="#ecf0f1" Padding="12,6" Margin="0,5,0,0">
                    <TextBlock Text="{Binding CustomerStatusMessage}" Foreground="#2c3e50" FontSize="13"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- ==================== تبويب الموردين ==================== -->
        <TabItem Header="🏭 الموردين">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Search -->
                <Border Grid.Row="0" Padding="12" Background="#f8f9fa" CornerRadius="10,10,0,0" Margin="0,0,0,5">
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,-30,0,5" To="0,0,0,5" Duration="0:0:0.4">
                                        <ThicknessAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseOut"/>
                                        </ThicknessAnimation.EasingFunction>
                                    </ThicknessAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🏭 إدارة الموردين" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" Width="280" BorderBrush="#dcdde1" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox Grid.Column="1" Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontSize="13" VerticalAlignment="Center" Padding="5" Background="Transparent"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- Main Content -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="340"/>
                    </Grid.ColumnDefinitions>

                    <!-- DataGrid -->
                    <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#eee" BorderThickness="1" Background="White">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <DataGrid ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  BorderThickness="0" Margin="5" RowHeight="38" ColumnHeaderHeight="40">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding PartnerID}" Width="50"/>
                                <DataGridTextColumn Header="اسم المورد" Binding="{Binding PartnerName}" Width="*"/>
                                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="العنوان" Binding="{Binding Address}" Width="150"/>
                                <DataGridTextColumn Header="الرصيد" Binding="{Binding CurrentBalance, StringFormat=N2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <!-- Edit Panel -->
                    <Border Grid.Column="1" CornerRadius="10" Background="#fafafa" Padding="18" BorderBrush="#eee" BorderThickness="1">
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.3">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <ThicknessAnimation Storyboard.TargetProperty="Margin" From="20,0,0,0" To="0,0,0,0" Duration="0:0:0.5" BeginTime="0:0:0.3">
                                            <ThicknessAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </ThicknessAnimation.EasingFunction>
                                        </ThicknessAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <StackPanel>
                            <TextBlock Text="بيانات المورد" FontSize="16" FontWeight="Bold" Foreground="#2c3e50" Margin="0,0,0,15"/>

                            <TextBlock Text="اسم المورد *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditSupplierName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SupplierNameError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                                       Visibility="{Binding SupplierNameError, Converter={StaticResource StringToVisConverter}}"/>

                            <TextBlock Text="الهاتف" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditSupplierPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>

                            <TextBlock Text="العنوان" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditSupplierAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="💾 حفظ" Command="{Binding SaveSupplierCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5"/>
                                <Button Content="🆕 جديد" Command="{Binding NewSupplierCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5" Background="#3498db" IsEnabled="{Binding CurrentPermissions.CanAdd}"/>
                                <Button Content="🚫 تعطيل" Command="{Binding DeleteSupplierCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5" Background="#e74c3c"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" CornerRadius="0,0,12,12" Background="#ecf0f1" Padding="12,6" Margin="0,5,0,0">
                    <TextBlock Text="{Binding SupplierStatusMessage}" Foreground="#2c3e50" FontSize="13"/>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
