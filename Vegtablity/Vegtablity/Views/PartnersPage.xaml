<UserControl x:Class="Views.PartnersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             xmlns:controls="clr-namespace:Vegtablity.Controls"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo">

    <UserControl.DataContext>
        <vm:PartnersViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <!-- Fade-in animation for entire page -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <TabControl>
        <TabControl.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                <BeginStoryboard>
                    <Storyboard>
                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" BeginTime="0:0:0.1">
                            <DoubleAnimation.EasingFunction>
                                <CubicEase EasingMode="EaseOut"/>
                            </DoubleAnimation.EasingFunction>
                        </DoubleAnimation>
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger>
        </TabControl.Triggers>

        <!-- ==================== تبويب العملاء ==================== -->
        <TabItem Header="👤 العملاء">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Search and Actions -->
                <Border Grid.Row="0" Padding="14,12" Background="#f8f9fa" CornerRadius="10,10,0,0" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="👤 إدارة العملاء" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Customers.Count, StringFormat='{}{0} عميل'}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="➕ إضافة عميل" Command="{Binding NewCustomerCommand}" Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White" Width="120" Height="36" Margin="0,0,10,0" ToolTip="إضافة عميل جديد للوحة التحكم"/>
                            <Border Background="White" CornerRadius="8" Padding="8,4" Width="280" BorderBrush="#CBD5E1" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding CustomerSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontSize="13" VerticalAlignment="Center" Padding="5" Background="Transparent"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content: Cards Grid + Edit Panel side by side -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cards Grid (Column 0) -->
                    <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SnapsToDevicePixels="True">
                            <ItemsControl ItemsSource="{Binding Customers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:PartnerCardControl Margin="6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Edit Customer Panel (Column 1) -->
                    <Border Grid.Column="1" Width="340" CornerRadius="12" Background="White" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1.5"
                            Visibility="{Binding IsCustomerPanelVisible, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="4"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="340"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCustomerPanelVisible}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" From="340" To="0" Duration="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="👤" FontSize="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="بيانات العميل" FontSize="16.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="✕" HorizontalAlignment="Right" Command="{Binding CloseCustomerPanelCommand}"
                                        Style="{StaticResource ModernButtonStyle}" Background="Transparent" Foreground="#64748B" Width="32" Height="32" BorderThickness="0" Cursor="Hand" ToolTip="إغلاق اللوحة"/>
                            </Grid>
                            
                            <TextBlock Text="اسم العميل *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditCustomerName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding CustomerNameError}" Foreground="#EF4444" FontSize="11" Margin="2,0,0,8" Visibility="{Binding CustomerNameError, Converter={StaticResource StringToVisConverter}}"/>
                            
                            <TextBlock Text="الهاتف" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="العنوان" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditCustomerAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,18"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <Button Content="💾 حفظ" Command="{Binding SaveCustomerCommand}" Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White" Width="90" Height="36" Margin="4"/>
                                <Button Content="🆕 جديد" Command="{Binding NewCustomerCommand}" Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Foreground="White" Width="90" Height="36" Margin="4"/>
                                <Button Content="🚫 تعطيل" Command="{Binding DeleteCustomerCommand}" Style="{StaticResource ModernButtonStyle}" Background="#EF4444" Foreground="White" Width="90" Height="36" Margin="4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" CornerRadius="0,0,10,10" Background="#F1F5F9" Padding="14,8" Margin="0,6,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <TextBlock Text="{Binding CustomerStatusMessage}" Foreground="#334155" FontSize="13" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </TabItem>

        <!-- ==================== تبويب الموردين ==================== -->
        <TabItem Header="🏭 الموردين">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header with Search and Actions -->
                <Border Grid.Row="0" Padding="14,12" Background="#f8f9fa" CornerRadius="10,10,0,0" Margin="0,0,0,8" BorderBrush="#E2E8F0" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="🏭 إدارة الموردين" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                            <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Suppliers.Count, StringFormat='{}{0} مورد'}" FontSize="12" FontWeight="Bold" Foreground="#B45309"/>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="➕ إضافة مورد" Command="{Binding NewSupplierCommand}" Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White" Width="120" Height="36" Margin="0,0,10,0" ToolTip="إضافة مورد جديد للوحة التحكم"/>
                            <Border Background="White" CornerRadius="8" Padding="8,4" Width="280" BorderBrush="#CBD5E1" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding SupplierSearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontSize="13" VerticalAlignment="Center" Padding="5" Background="Transparent"/>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Main Content: Cards Grid + Edit Panel side by side -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Cards Grid (Column 0) -->
                    <Border Grid.Column="0" Margin="0,0,8,0" CornerRadius="10" BorderBrush="#E2E8F0" BorderThickness="1" Background="#F8FAFC" Padding="6">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SnapsToDevicePixels="True">
                            <ItemsControl ItemsSource="{Binding Suppliers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:PartnerCardControl Margin="6"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- Edit Supplier Panel (Column 1) -->
                    <Border Grid.Column="1" Width="340" CornerRadius="12" Background="White" Padding="20" BorderBrush="#E2E8F0" BorderThickness="1.5"
                            Visibility="{Binding IsSupplierPanelVisible, Converter={StaticResource BoolToVis}}">
                        <Border.Effect>
                            <DropShadowEffect Color="#000000" Opacity="0.08" BlurRadius="15" ShadowDepth="4"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="340"/>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSupplierPanelVisible}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X" From="340" To="0" Duration="0:0:0.3">
                                                        <DoubleAnimation.EasingFunction>
                                                            <CubicEase EasingMode="EaseOut"/>
                                                        </DoubleAnimation.EasingFunction>
                                                    </DoubleAnimation>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <Grid Margin="0,0,0,18">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="🏭" FontSize="18" Margin="0,0,6,0"/>
                                    <TextBlock Text="بيانات المورد" FontSize="16.5" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="✕" HorizontalAlignment="Right" Command="{Binding CloseSupplierPanelCommand}"
                                        Style="{StaticResource ModernButtonStyle}" Background="Transparent" Foreground="#64748B" Width="32" Height="32" BorderThickness="0" Cursor="Hand" ToolTip="إغلاق اللوحة"/>
                            </Grid>
                            
                            <TextBlock Text="اسم المورد *" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditSupplierName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                            <TextBlock Text="{Binding SupplierNameError}" Foreground="#EF4444" FontSize="11" Margin="2,0,0,8" Visibility="{Binding SupplierNameError, Converter={StaticResource StringToVisConverter}}"/>
                            
                            <TextBlock Text="الهاتف" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditSupplierPhone, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>
                            
                            <TextBlock Text="العنوان" FontWeight="SemiBold" Foreground="#334155" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding EditSupplierAddress, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,18"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5,0,0">
                                <Button Content="💾 حفظ" Command="{Binding SaveSupplierCommand}" Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White" Width="90" Height="36" Margin="4"/>
                                <Button Content="🆕 جديد" Command="{Binding NewSupplierCommand}" Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Foreground="White" Width="90" Height="36" Margin="4"/>
                                <Button Content="🚫 تعطيل" Command="{Binding DeleteSupplierCommand}" Style="{StaticResource ModernButtonStyle}" Background="#EF4444" Foreground="White" Width="90" Height="36" Margin="4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2" CornerRadius="0,0,10,10" Background="#F1F5F9" Padding="14,8" Margin="0,6,0,0" BorderBrush="#E2E8F0" BorderThickness="1">
                    <TextBlock Text="{Binding SupplierStatusMessage}" Foreground="#334155" FontSize="13" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
