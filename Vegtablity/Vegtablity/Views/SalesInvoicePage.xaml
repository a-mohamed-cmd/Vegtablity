<UserControl x:Class="Views.SalesInvoicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Vegtablity"
      xmlns:viewmodels="clr-namespace:Vegtablity.ViewModels"
      xmlns:helpers="clr-namespace:Vegtablity.Helpers"
      mc:Ignorable="d" 
      d:DesignHeight="750" d:DesignWidth="1050"
      FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <viewmodels:SalesInvoiceViewModel />
    </UserControl.DataContext>

    <!-- Resources -->
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <helpers:BooleanAndConverter x:Key="BooleanAndConverter"/>

        <!-- Hover Scale Animation for Cards -->
        <Style x:Key="AnimatedCardStyle" TargetType="Border">
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.005" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.005" Duration="0:0:0.2">
                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- Initial Load Entrance Animations -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="HeaderCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.05"/>
                    <ThicknessAnimation Storyboard.TargetName="HeaderCard" Storyboard.TargetProperty="Margin" From="20,40,20,-10" To="20,20,20,10" Duration="0:0:0.4" BeginTime="0:0:0.05">
                        <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>

                    <DoubleAnimation Storyboard.TargetName="DetailsCard" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3" BeginTime="0:0:0.15"/>
                    <ThicknessAnimation Storyboard.TargetName="DetailsCard" Storyboard.TargetProperty="Margin" From="20,30,20,0" To="20,10,20,10" Duration="0:0:0.4" BeginTime="0:0:0.15">
                        <ThicknessAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></ThicknessAnimation.EasingFunction>
                    </ThicknessAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Background="#F5F7FA" Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- 1. Title/ToolBar -->
                <Border Grid.Row="0" Background="White" BorderBrush="#E0E6ED" BorderThickness="0,0,0,1" Padding="20,15">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="فاتورة المبيعات" FontSize="26" FontWeight="SemiBold" Foreground="#1E293B"/>
                            <!-- Status Badge -->
                            <Border Margin="15,0,0,0" Padding="10,5" CornerRadius="12" Background="#DCFCE7" VerticalAlignment="Center"
                                    Visibility="{Binding IsInvoicePosted, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="✔ فاتورة مُرحلة" Foreground="#166534" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                            <Border x:Name="DraftBadge" Margin="15,0,0,0" Padding="10,5" CornerRadius="12" Background="#FEF3C7" VerticalAlignment="Center"
                                    Visibility="{Binding IsEditAllowed, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="✎ مسودة" Foreground="#92400E" FontWeight="SemiBold" FontSize="13"/>
                            </Border>
                        </StackPanel>

                        <!-- Action Buttons -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="📜 سجل الفواتير" Command="{Binding LoadHistoryCommand}" Click="HistoryButton_Click"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#6366F1" Margin="0,0,10,0"/>

                            <Button x:Name="BtnGoBack" Content="← رجوع" Click="BtnGoBack_Click"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#64748B" Margin="0,0,10,0"
                                    ToolTip="العودة للحسابات"/>

                            <Button Content="➕ فاتورة جديدة" Command="{Binding NewCommand}" Click="NewInvoiceButton_Click"
                                    Style="{DynamicResource ModernButtonStyle}" Background="#3B82F6" Margin="0,0,10,0"
                                    IsEnabled="{Binding CurrentPermissions.CanAdd}"/>

                            <Button Content="💾 حـفـظ" Command="{Binding SaveCommand}" 
                                    Style="{DynamicResource ModernButtonStyle}" Background="#10B981" Margin="0,0,10,0"/>

                            <Button Content="🖨 طـبـاعـة" Command="{Binding PrintCommand}" 
                                    Style="{DynamicResource ModernButtonStyle}" Background="#6366F1" Margin="0,0,10,0"
                                    IsEnabled="{Binding CurrentPermissions.CanPrint}"/>

                            <Button Content="🚀 ترحيل الفاتورة" Command="{Binding PostCommand}" 
                                    Style="{DynamicResource ModernButtonStyle}" Background="#F59E0B"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Header Fields -->
                <Border x:Name="HeaderCard" Opacity="0" Style="{StaticResource AnimatedCardStyle}" Grid.Row="1" Background="White" Margin="20,20,20,10" CornerRadius="10" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Date -->
                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="تاريخ الفاتورة *" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <DatePicker SelectedDate="{Binding CurrentInvoice.InvDate, UpdateSourceTrigger=PropertyChanged}" 
                                        IsEnabled="{Binding IsEditAllowed}"/>
                        </StackPanel>

                        <!-- Customer -->
                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="العميل *" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding Customers}" 
                                      SelectedValue="{Binding CurrentInvoice.PartnerID, UpdateSourceTrigger=PropertyChanged}" 
                                      SelectedValuePath="PartnerID" DisplayMemberPath="PartnerName"
                                      IsEnabled="{Binding IsEditAllowed}"/>
                        </StackPanel>

                        <!-- Warehouse -->
                        <StackPanel Grid.Row="0" Grid.Column="4">
                            <TextBlock Text="يصرف من مستودع *" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding Warehouses}" 
                                      SelectedValue="{Binding CurrentInvoice.WarehouseID, UpdateSourceTrigger=PropertyChanged}" 
                                      SelectedValuePath="WarehouseID" DisplayMemberPath="WarehouseName"
                                      IsEnabled="{Binding IsEditAllowed}"/>
                        </StackPanel>

                        <!-- Invoice Reference No -->
                        <StackPanel Grid.Row="0" Grid.Column="6">
                            <TextBlock Text="رقم الفاتورة" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding CurrentInvoice.InvID, Mode=OneWay}" 
                                     IsReadOnly="True" Background="#F1F5F9" Foreground="#0F172A"
                                     Style="{DynamicResource ModernTextBoxStyle}" FontWeight="Bold"/>
                        </StackPanel>

                        <!-- Notes -->
                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="7">
                            <TextBlock Text="ملاحظات" Foreground="#64748B" FontSize="13" Margin="0,0,0,5" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding CurrentInvoice.Notes, UpdateSourceTrigger=PropertyChanged}" 
                                     IsEnabled="{Binding IsEditAllowed}"
                                     Style="{DynamicResource ModernTextBoxStyle}" Height="40" MaxLength="250"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 3. Invoice Details Grid -->
                <Border x:Name="DetailsCard" Opacity="0" Grid.Row="2" Background="White" Margin="20,10,20,10" CornerRadius="10" Padding="15">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="تفاصيل الأصناف" FontSize="18" FontWeight="SemiBold" Foreground="#334155" VerticalAlignment="Center"/>
                            <Button Content="➕ إضافة صنف" Command="{Binding AddItemCommand}" Click="AddItemButton_Click"
                                    Background="#EEF2FF" Foreground="#4F46E5" BorderBrush="#4F46E5" 
                                    Style="{DynamicResource ModernButtonStyle}"
                                    Margin="20,0,0,0" Padding="15,5">
                                <Button.IsEnabled>
                                    <MultiBinding Converter="{StaticResource BooleanAndConverter}" UpdateSourceTrigger="PropertyChanged">
                                        <Binding Path="IsEditAllowed"/>
                                        <Binding Path="CurrentPermissions.CanAdd"/>
                                    </MultiBinding>
                                </Button.IsEnabled>
                            </Button>

                            <!-- Invoice Details Pagination (at the top) -->
                            <StackPanel Orientation="Horizontal" Margin="40,0,0,0" VerticalAlignment="Center">
                                <Button Content="▶" Command="{Binding PrevDetailsPageCommand}" IsEnabled="{Binding CanGoPrevDetails}"
                                        Style="{StaticResource ModernButtonStyle}" Background="#F1F5F9" Foreground="#475569" Width="30" Padding="0"/>
                                <TextBlock Text="{Binding DetailsPageLabel}" Margin="15,0" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#64748B"/>
                                <Button Content="◀" Command="{Binding NextDetailsPageCommand}" IsEnabled="{Binding CanGoNextDetails}"
                                        Style="{StaticResource ModernButtonStyle}" Background="#F1F5F9" Foreground="#475569" Width="30" Padding="0"/>
                            </StackPanel>

                            <TextBlock Text="تحذير: لن يكتمل الترحيل إذا تجاوزت الكمية المخزون المتاح."  
                                       Foreground="#EF4444" Margin="20,0,0,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" FontStyle="Italic"/>
                        </StackPanel>

                        <!-- The DataGrid -->
                        <DataGrid x:Name="dgInvoiceDetails" Grid.Row="1" ItemsSource="{Binding CurrentInvoice.Details}" AutoGenerateColumns="False" 
                                  CanUserAddRows="False" SelectionMode="Single"
                                  IsReadOnly="{Binding IsInvoicePosted}"
                                  MinHeight="300" RowHeight="35">
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="White"/>
                                    <Setter Property="Foreground" Value="#1E293B"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#EEF2FF"/>
                                            <Setter Property="Foreground" Value="#1E293B"/>
                                            <Setter Property="BorderBrush" Value="#C7D2FE"/>
                                            <Setter Property="BorderThickness" Value="0,1"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F8FAFF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                            <DataGrid.Columns>
                                <!-- Product Code (Barcode) -->
                                <DataGridTemplateColumn Header="كود الصنف" Width="1.5*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}" 
                                                     PreviewKeyDown="Barcode_PreviewKeyDown"
                                                     GotFocus="TextBox_GotFocus"
                                                     IsEnabled="{Binding DataContext.IsEditAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     BorderThickness="0" Background="Transparent" Padding="5,0" VerticalContentAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Product Selection -->
                                <DataGridTemplateColumn Header="اسم الصنف / الباركود" Width="3*" IsReadOnly="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Products, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValue="{Binding ProductID, UpdateSourceTrigger=PropertyChanged}"
                                                      SelectedValuePath="ProductID" DisplayMemberPath="SearchText"
                                                      TextSearch.TextPath="SearchText"
                                                      IsEditable="True"
                                                      IsTextSearchEnabled="False"
                                                      StaysOpenOnEdit="True"
                                                      KeyUp="ProductComboBox_KeyUp"
                                                      PreviewKeyDown="ProductComboBox_PreviewKeyDown"
                                                      DropDownOpened="ProductComboBox_DropDownOpened"
                                                      DropDownClosed="ProductComboBox_DropDownClosed"
                                                      LostFocus="ProductComboBox_LostFocus"
                                                      IsEnabled="{Binding DataContext.IsEditAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      BorderThickness="0" Background="Transparent"
                                                      Padding="5,0"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Quantity -->
                                <DataGridTemplateColumn Header="الكمية" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}" 
                                                     PreviewKeyDown="Quantity_PreviewKeyDown"
                                                     GotFocus="TextBox_GotFocus"
                                                     IsEnabled="{Binding DataContext.IsEditAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     BorderThickness="0" Background="Transparent" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Unit Price -->
                                <DataGridTemplateColumn Header="السعر" Width="1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat={}{0:N2}}" 
                                                     PreviewKeyDown="Price_PreviewKeyDown"
                                                     GotFocus="TextBox_GotFocus"
                                                     IsEnabled="{Binding DataContext.IsEditAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     BorderThickness="0" Background="Transparent" TextAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- Total Price -->
                                <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalPrice, Mode=OneWay, StringFormat={}{0:N2}}" Width="1*" IsReadOnly="True" Foreground="#0F172A" FontWeight="Bold"/>

                                <!-- Delete -->
                                <DataGridTemplateColumn Header="حذف" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Background="Transparent" BorderThickness="0" 
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}"
                                                    IsEnabled="{Binding DataContext.IsEditAllowed, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    ToolTip="حذف السطر">
                                                <TextBlock Text="🗑️" Foreground="#EF4444" FontSize="16"/>
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Invoice Details Pagination (Bottom Bar) -->
                        <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,1,1,1" CornerRadius="0,0,12,12" Padding="15,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Content="→ الصفحة السابقة" Command="{Binding PrevDetailsPageCommand}" IsEnabled="{Binding CanGoPrevDetails}"
                                        Style="{StaticResource ModernButtonStyle}" Background="#94A3B8" Padding="15,5"/>
                                <TextBlock Grid.Column="1" Text="{Binding DetailsPageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
                                <Button Grid.Column="2" Content="الصفحة التالية ←" Command="{Binding NextDetailsPageCommand}" IsEnabled="{Binding CanGoNextDetails}"
                                        Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Padding="15,5"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!-- 4. Footer & Totals -->
                <Border Grid.Row="3" Background="White" Margin="20,10,20,20" CornerRadius="10" Padding="20">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1.5*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="1" Margin="20,0,0,0">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="الإجمالي قبل الخصم:" Foreground="#64748B" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentInvoice.TotalAmount, StringFormat={}{0:N2}}" Foreground="#0F172A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="الخصـم:" Foreground="#64748B" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,120,0"/>
                                <TextBox Text="{Binding CurrentInvoice.Discount, UpdateSourceTrigger=LostFocus}" Width="100" HorizontalAlignment="Left" TextAlignment="Center"
                                         IsEnabled="{Binding IsEditAllowed}" Style="{DynamicResource ModernTextBoxStyle}" FontWeight="Bold"
                                         PreviewTextInput="DecimalBox_PreviewTextInput" PreviewKeyDown="DecimalBox_PreviewKeyDown" DataObject.Pasting="DecimalBox_Pasting"/>
                            </Grid>
                            <Rectangle Fill="#E2E8F0" Height="1" Margin="0,5,0,10"/>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="مطلوب من العميل (الصافي):" Foreground="#0F172A" FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <Border Background="#F1F5F9" CornerRadius="8" Padding="10,5" HorizontalAlignment="Left" MinWidth="130">
                                    <TextBlock Text="{Binding CurrentInvoice.NetAmount, StringFormat={}{0:N2}}" Foreground="#2563EB" FontSize="20" FontWeight="Black" TextAlignment="Center"/>
                                </Border>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,15,0,5" HorizontalAlignment="Stretch">
                                <TextBlock Text="المبلغ المدفوع:" Foreground="#64748B" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Width="150" TextAlignment="Right" Margin="0,0,10,0"/>
                                <TextBox Text="{Binding CurrentInvoice.PaidAmount, UpdateSourceTrigger=LostFocus}" Width="100" TextAlignment="Center"
                                         IsEnabled="{Binding IsEditAllowed}" Style="{DynamicResource ModernTextBoxStyle}" FontWeight="Bold" Foreground="#10B981"
                                         PreviewTextInput="DecimalBox_PreviewTextInput" PreviewKeyDown="DecimalBox_PreviewKeyDown" DataObject.Pasting="DecimalBox_Pasting"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,5,0,10" HorizontalAlignment="Stretch">
                                <TextBlock Text="طريقة الدفع:" Foreground="#64748B" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Width="150" TextAlignment="Right" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding CashAccounts}" SelectedValue="{Binding CurrentInvoice.PaymentAccountID, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="AccountID" DisplayMemberPath="AccountName" Width="190" IsEnabled="{Binding IsPaymentAccountEnabled}"
                                          Style="{DynamicResource ModernComboBoxStyle}"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,0">
                                <TextBlock Text="المتبقي (آجل):" Foreground="#EF4444" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding CurrentInvoice.Remainder, StringFormat={}{0:N2}}" Foreground="#EF4444" FontSize="16" FontWeight="Bold" HorizontalAlignment="Left"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Snackbar Notification -->
        <Border x:Name="SnackbarBorder" VerticalAlignment="Bottom" HorizontalAlignment="Center" Background="#1E293B" CornerRadius="12" Padding="20,12" Margin="0,0,0,30" Visibility="Collapsed" Panel.ZIndex="105">
            <Border.Effect><DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Color="#000000"/></Border.Effect>
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="✅" FontSize="16" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText" Text="تم الحفظ بنجاح" Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- History Modal Overlay -->
        <Grid x:Name="HistoryModal" Background="#80000000" Visibility="Collapsed" Panel.ZIndex="100">
            <Border Background="White" CornerRadius="10" Margin="100" Padding="20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch" Margin="0,0,0,15">
                        <TextBlock Text="سجل فواتير المبيعات" FontSize="20" FontWeight="SemiBold" Foreground="#1E293B"/>
                        <Button Content="❌ إغلاق" Click="CloseHistoryButton_Click" Background="Transparent" BorderThickness="0" Foreground="#EF4444" HorizontalAlignment="Right" Margin="250,0,0,0"/>
                    </StackPanel>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding InvoicesHistory}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" RowHeight="35">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvID}" Width="100"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding PartnerName}" Width="*"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding InvDate, StringFormat=dd/MM/yyyy}" Width="120"/>
                            <DataGridTextColumn Header="الصافي" Binding="{Binding NetAmount, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTemplateColumn Header="ترحيل؟" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding IsPostedText}" Foreground="{Binding IsPostedColor}" HorizontalAlignment="Center" FontWeight="Bold"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="تعديل" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="تعديل ✎" Click="EditFromHistory_Click"
                                                Style="{DynamicResource ModernButtonStyle}" Background="#E0E7FF" Foreground="#4F46E5" Padding="5,2"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- History Pagination -->
                    <Border Grid.Row="1" VerticalAlignment="Bottom" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="→ الصفحة السابقة" Command="{Binding PrevHistoryPageCommand}" IsEnabled="{Binding CanGoPrevHistory}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#94A3B8" Padding="15,5"/>
                            <TextBlock Grid.Column="1" Text="{Binding HistoryPageLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="#475569"/>
                            <Button Grid.Column="2" Content="الصفحة التالية ←" Command="{Binding NextHistoryPageCommand}" IsEnabled="{Binding CanGoNextHistory}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#3B82F6" Padding="15,5"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</UserControl>
