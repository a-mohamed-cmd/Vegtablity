<UserControl x:Class="Views.HREndOfServicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:controls="clr-namespace:Vegtablity.Controls"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="750" d:DesignWidth="1100"
             FlowDirection="RightToLeft">

    <UserControl.DataContext>
        <vm:HREndOfServiceViewModel/>
    </UserControl.DataContext>

    <Grid Background="#F8FAFC" Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Header & Actions -->
        <Border Grid.Row="0" Background="White" CornerRadius="12" Padding="16,12" Margin="0,0,0,15">
            <Border.Effect>
                <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.6"/>
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="📜" FontSize="26" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <StackPanel>
                        <TextBlock Text="حاسبة مكافأة نهاية الخدمة" FontSize="18" FontWeight="Bold" Foreground="#1E293B"/>
                        <TextBlock Text="حساب مكافأة الخدمة وفق قانون العمل ونسب الاستقالة، تعويض رصيد الإجازات المتبقي، وطباعة المخالصة" FontSize="12" Foreground="#64748B"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="BtnToggleSidePanel" Content="◀ طي الحاسبة" Click="ToggleSidePanel_Click"
                            Style="{StaticResource ModernButtonStyle}" Background="#F1F5F9" Foreground="#334155"
                            Height="38" Padding="12,0" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="➕ تصفية جديدة" Command="{Binding NewSettlementCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#4F46E5" Foreground="White"
                            Height="38" Padding="14,0" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="💾 حفظ واعتماد التصفية" Command="{Binding SaveSettlementCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#10B981" Foreground="White"
                            Height="38" Padding="14,0" FontSize="13" FontWeight="Bold" Margin="0,0,8,0" Cursor="Hand"/>
                    <Button Content="🖨️ طباعة إبراء الذمة" Command="{Binding PrintSettlementCommand}"
                            Style="{StaticResource ModernButtonStyle}" Background="#0EA5E9" Foreground="White"
                            Height="38" Padding="12,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Layout -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: End of Service Live Calculator Card with Collapse Animation -->
            <Border x:Name="SidePanelBorder" Grid.Column="0" Width="460" Margin="0,0,15,0" ClipToBounds="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Border Background="White" CornerRadius="12" Padding="18">
                        <Border.Effect>
                            <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                        </Border.Effect>
                        <StackPanel DataContext="{Binding CurrentSettlement}">
                            <TextBlock Text="🧮 حاسبة المستحقات التفاعلية" FontSize="15" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                            <!-- Employee Selection via SearchableDropdown -->
                            <TextBlock Text="اختر الموظف *:" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,4"/>
                            <controls:SearchableDropdown
                                x:Name="EmployeeDropdown"
                                ItemsSource="{Binding DataContext.FilteredEmployees, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                SelectedItem="{Binding DataContext.SelectedEmployee, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                DisplayMemberPath="DisplayText"
                                Watermark="🔍 ابحث باسم أو كود الموظف..."
                                Height="38" Margin="0,0,0,10"
                                SearchChanged="EmployeeDropdown_SearchChanged"
                                ItemSelected="EmployeeDropdown_ItemSelected"
                                ConfirmedAndMoveNext="EmployeeDropdown_MoveNext"/>

                            <!-- Dates Grid -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="تاريخ التعيين:" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                    <controls:DateBoxControl SelectedDate="{Binding HireDate, Mode=TwoWay}" Height="36" FontSize="12.5"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="تاريخ نهاية الخدمة:" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                    <controls:DateBoxControl SelectedDate="{Binding EndDate, Mode=TwoWay}" Height="36" FontSize="12.5"/>
                                </StackPanel>
                            </Grid>

                            <!-- Departure Reason -->
                            <TextBlock Text="سبب انتهاء الخدمة / ترك العمل:" FontWeight="Bold" FontSize="12.5" Foreground="#334155" Margin="0,0,0,4"/>
                            <ComboBox ItemsSource="{Binding DataContext.DepartureReasonsList, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      SelectedItem="{Binding DepartureReason, UpdateSourceTrigger=PropertyChanged}"
                                      Height="36" FontSize="13" VerticalContentAlignment="Center" Margin="0,0,0,10"/>

                            <!-- Financials Inputs Grid -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="الراتب الأساسي الأخير:" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtBasicSalary" Text="{Binding LastBasicSalary, UpdateSourceTrigger=LostFocus, StringFormat=\{0:G29\}}" 
                                             Height="36" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"
                                             GotFocus="DecimalBox_GotFocus" PreviewTextInput="DecimalBox_PreviewTextInput" 
                                             PreviewKeyDown="DecimalBox_PreviewKeyDown" LostFocus="DecimalBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="البدلات الثابتة:" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtAllowances" Text="{Binding LastAllowances, UpdateSourceTrigger=LostFocus, StringFormat=\{0:G29\}}" 
                                             Height="36" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"
                                             GotFocus="DecimalBox_GotFocus" PreviewTextInput="DecimalBox_PreviewTextInput" 
                                             PreviewKeyDown="DecimalBox_PreviewKeyDown" LostFocus="DecimalBox_LostFocus"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                    <TextBlock Text="رصيد إجازات متبقي (أيام):" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtLeaveBalance" Text="{Binding UnpaidLeaveBalanceDays, UpdateSourceTrigger=LostFocus, StringFormat=\{0:G29\}}" 
                                             Height="36" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"
                                             GotFocus="DecimalBox_GotFocus" PreviewTextInput="DecimalBox_PreviewTextInput" 
                                             PreviewKeyDown="DecimalBox_PreviewKeyDown" LostFocus="DecimalBox_LostFocus"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="يخصم سلف / التزامات:" FontWeight="Bold" FontSize="12" Foreground="#334155" Margin="0,0,0,4"/>
                                    <TextBox x:Name="TxtDeductionsLoans" Text="{Binding DeductionsLoans, UpdateSourceTrigger=LostFocus, StringFormat=\{0:G29\}}" 
                                             Height="36" FontSize="13" Padding="8,0" VerticalContentAlignment="Center"
                                             GotFocus="DecimalBox_GotFocus" PreviewTextInput="DecimalBox_PreviewTextInput" 
                                             PreviewKeyDown="DecimalBox_PreviewKeyDown" LostFocus="DecimalBox_LostFocus"/>
                                </StackPanel>
                            </Grid>

                            <!-- Calculate Action -->
                            <Button Content="🔄 إعادة احتساب النتائج" Command="{Binding DataContext.CalculateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#475569" Foreground="White"
                                    Height="34" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,14" Cursor="Hand"/>

                            <!-- Result Summary Dark Card -->
                            <Border Background="#0F172A" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="مدة الخدمة الفعلية:" FontSize="12" Foreground="#94A3B8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DurationDescription}" FontSize="12.5" FontWeight="Bold" Foreground="#38BDF8"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="مكافأة نهاية الخدمة المحتسبة:" FontSize="12" Foreground="#94A3B8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding IndemnityAmount, StringFormat={}{0:N3}}" FontSize="13" FontWeight="Bold" Foreground="#A7F3D0"/>
                                    </Grid>

                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="تعويض رصيد الإجازات:" FontSize="12" Foreground="#94A3B8"/>
                                        <TextBlock Grid.Column="1" Text="{Binding UnpaidLeaveCompensation, StringFormat={}{0:N3}}" FontSize="13" FontWeight="Bold" Foreground="#FDE68A"/>
                                    </Grid>

                                    <Separator Background="#334155" Margin="0,0,0,10"/>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="الصافي المستحق للصرف:" FontSize="13" FontWeight="Bold" Foreground="#6EE7B7" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding NetSettlementAmount, StringFormat={}{0:N3}}" FontSize="20" FontWeight="Black" Foreground="#4ADE80"/>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Border>

            <!-- Right: Settlements History List with Pagination -->
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="16">
                <Border.Effect>
                    <DropShadowEffect Color="#E2E8F0" BlurRadius="8" ShadowDepth="2" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="📋 سجل تصفيات نهاية الخدمة المعتمدة" FontSize="16" FontWeight="Bold" Foreground="#1E293B" Margin="0,0,0,12"/>

                    <!-- Table Headers -->
                    <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1,1,1,0" 
                            CornerRadius="8,8,0,0" Padding="10,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="1.3*" MinWidth="135"/>
                                <ColumnDefinition Width="1.4*" MinWidth="150"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="85"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="105"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الكود" FontWeight="Bold" FontSize="11.5" Foreground="#475569"/>
                            <TextBlock Grid.Column="1" Text="اسم الموظف / القسم" FontWeight="Bold" FontSize="11.5" Foreground="#475569" Margin="6,0"/>
                            <TextBlock Grid.Column="2" Text="نهاية الخدمة والمدة" FontWeight="Bold" FontSize="11.5" Foreground="#475569" Margin="6,0"/>
                            <TextBlock Grid.Column="3" Text="سبب الترك" FontWeight="Bold" FontSize="11.5" Foreground="#475569" TextAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="مكافأة الخدمة" FontWeight="Bold" FontSize="11.5" Foreground="#1E293B" TextAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="بدل إجازة" FontWeight="Bold" FontSize="11.5" Foreground="#D97706" TextAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="خصومات" FontWeight="Bold" FontSize="11.5" Foreground="#DC2626" TextAlignment="Center"/>
                            <TextBlock Grid.Column="7" Text="صافي المستحق" FontWeight="Bold" FontSize="11.5" Foreground="#059669" TextAlignment="Center"/>
                            <TextBlock Grid.Column="8" Text="إجراء" FontWeight="Bold" FontSize="11.5" Foreground="#475569" TextAlignment="Center" Margin="6,0,0,0"/>
                        </Grid>
                    </Border>

                    <!-- Interactive Settlements ListBox with EndOfServiceRowControl -->
                    <ListBox Grid.Row="2" ItemsSource="{Binding Settlements}" SelectedItem="{Binding SelectedSettlement}"
                             BorderBrush="#E2E8F0" BorderThickness="1" Background="#FAFAFA"
                             HorizontalContentAlignment="Stretch" Padding="6,6"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <controls:EndOfServiceRowControl/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0,0,0,3"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="Transparent" CornerRadius="8" Padding="0" Margin="0">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EFF6FF"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F8FAFC"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <!-- Pagination Footer (10 per page) -->
                    <Border Grid.Row="3" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="8,10" Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="◀ السابق" Command="{Binding PreviousPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155"
                                    FontSize="12" FontWeight="SemiBold" Height="30" Padding="12,0" Cursor="Hand"/>
                            <TextBlock Grid.Column="1" Text="{Binding PageInfo}"
                                       FontSize="12" FontWeight="Bold" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Button Grid.Column="2" Content="التالي ▶" Command="{Binding NextPageCommand}"
                                    Style="{StaticResource ModernButtonStyle}" Background="#E2E8F0" Foreground="#334155"
                                    FontSize="12" FontWeight="SemiBold" Height="30" Padding="12,0" Cursor="Hand"/>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Modern Floating Snackbar Notification (Always at bottom of entire page) -->
        <Border x:Name="SnackbarBorder" Grid.RowSpan="2" VerticalAlignment="Bottom" HorizontalAlignment="Center" 
                Background="#0F172A" CornerRadius="12" Padding="20,12" Margin="0,0,0,30" 
                Visibility="Collapsed" Panel.ZIndex="500" Opacity="0" IsHitTestVisible="False">
            <Border.Effect>
                <DropShadowEffect BlurRadius="25" ShadowDepth="4" Opacity="0.45" Color="#000000"/>
            </Border.Effect>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="SnackbarIcon" Text="✅" FontSize="18" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBlock x:Name="SnackbarText" Text="تمت العملية بنجاح" FontSize="13.5" FontWeight="Bold" Foreground="#F8FAFC" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
