<UserControl x:Class="Views.AccountingPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Vegtablity.ViewModels"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers">

    <UserControl.DataContext>
        <vm:AccountingViewModel/>
    </UserControl.DataContext>

    <UserControl.Resources>
        <helpers:StringToVisibilityConverter x:Key="StringToVisConverter"/>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <!-- Fade-in animation -->
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5">
                        <DoubleAnimation.EasingFunction>
                            <CubicEase EasingMode="EaseOut"/>
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </UserControl.Triggers>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header with Search -->
        <Border Grid.Row="0" Padding="12" Background="#f8f9fa" CornerRadius="10,10,0,0" Margin="0,0,0,5">
            <Border.Triggers>
                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                    <BeginStoryboard>
                        <Storyboard>
                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="0,-30,0,5" To="0,0,0,5" Duration="0:0:0.4">
                                <ThicknessAnimation.EasingFunction>
                                    <CubicEase EasingMode="EaseOut"/>
                                </ThicknessAnimation.EasingFunction>
                            </ThicknessAnimation>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Border.Triggers>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="📊 شجرة الحسابات" FontSize="18" FontWeight="Bold" Foreground="#2c3e50" VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="8,4" HorizontalAlignment="Right" Width="280" BorderBrush="#dcdde1" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" FontSize="13" VerticalAlignment="Center" Padding="5" Background="Transparent"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- DataGrid -->
            <Border Grid.Column="0" Margin="0,0,10,0" CornerRadius="8" BorderBrush="#eee" BorderThickness="1" Background="White">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.2">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          BorderThickness="0" Margin="5" RowHeight="36" ColumnHeaderHeight="40">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="الرمز" Binding="{Binding AccountCode}" Width="80"/>
                        <DataGridTextColumn Header="اسم الحساب" Binding="{Binding AccountName}" Width="*"/>
                        <DataGridTextColumn Header="الحساب الأب" Binding="{Binding ParentAccountName}" Width="140"/>
                        <DataGridTextColumn Header="النوع" Binding="{Binding AccountType}" Width="100"/>
                        <DataGridTextColumn Header="المستوى" Binding="{Binding AccountLevel}" Width="60"/>
                        <DataGridCheckBoxColumn Header="فرعي" Binding="{Binding IsTransactional}" Width="55"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- Edit Panel -->
            <Border Grid.Column="1" CornerRadius="10" Padding="18" BorderBrush="#eee" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#fafafa"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                <Setter Property="Background" Value="#fffaf0"/>
                                <Setter Property="BorderBrush" Value="#f39c12"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.Triggers>
                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.3">
                                    <DoubleAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                                <ThicknessAnimation Storyboard.TargetProperty="Margin" From="20,0,0,0" To="0,0,0,0" Duration="0:0:0.5" BeginTime="0:0:0.3">
                                    <ThicknessAnimation.EasingFunction>
                                        <CubicEase EasingMode="EaseOut"/>
                                    </ThicknessAnimation.EasingFunction>
                                </ThicknessAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
                <StackPanel>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding PanelTitle}" FontSize="16" FontWeight="Bold" Foreground="#2c3e50" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="#34495e" CornerRadius="4" Padding="6,2" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisConverter}}">
                            <TextBlock Text="وضع التعديل" Foreground="White" FontSize="10" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <!-- رمز الحساب -->
                    <TextBlock Text="رمز الحساب *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditAccountCode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding AccountCodeError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding AccountCodeError, Converter={StaticResource StringToVisConverter}}"/>

                    <!-- اسم الحساب -->
                    <TextBlock Text="اسم الحساب *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditAccountName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding AccountNameError}" Foreground="#e74c3c" FontSize="11" Margin="2,0,0,8" TextWrapping="Wrap"
                               Visibility="{Binding AccountNameError, Converter={StaticResource StringToVisConverter}}"/>

                    <!-- الحساب الأب -->
                    <TextBlock Text="الحساب الأب" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding DisplayParentAccounts}" SelectedValue="{Binding EditParentAccountID}" 
                              SelectedValuePath="AccountID" Margin="0,0,0,10">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding AccountCode}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding AccountName}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <!-- نوع الحساب -->
                    <TextBlock Text="نوع الحساب" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding EditAccountType}" 
                              Margin="0,0,0,10"/>

                    <!-- المستوى -->
                    <TextBlock Text="المستوى" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox Text="{Binding EditAccountLevel, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,10"/>

                    <!-- حساب فرعي -->
                    <CheckBox Content="حساب فرعي (يقبل قيود مباشرة)" IsChecked="{Binding EditIsTransactional}" 
                              IsEnabled="{Binding IsTransactionalEnabled}" Margin="0,0,0,15" FontSize="13"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{Binding SaveActionText}" Command="{Binding SaveCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5"/>
                        <Button Content="🆕 جديد" Command="{Binding NewCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5" Background="#3498db"/>
                        <Button Content="🗑️ حذف" Command="{Binding DeleteCommand}" Style="{StaticResource ModernButtonStyle}" Width="85" Margin="5" Background="#e74c3c"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" CornerRadius="0,0,12,12" Background="#ecf0f1" Padding="12,6" Margin="0,5,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="#2c3e50" FontSize="13"/>
        </Border>
    </Grid>
</UserControl>
