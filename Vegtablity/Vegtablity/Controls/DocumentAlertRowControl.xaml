<UserControl x:Class="Controls.DocumentAlertRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="AlertActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="MainRowBorder" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,4" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="4" ShadowDepth="1"/>
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- 0: Accent Strip -->
                <ColumnDefinition Width="Auto"/>
                <!-- 1: Employee Code -->
                <ColumnDefinition Width="85"/>
                <!-- 2: Employee Name & Dept -->
                <ColumnDefinition Width="1.3*" MinWidth="130"/>
                <!-- 3: Document Type / Field -->
                <ColumnDefinition Width="1.3*" MinWidth="140"/>
                <!-- 4: Expiry Date -->
                <ColumnDefinition Width="115"/>
                <!-- 5: Status Badge & Days Remaining -->
                <ColumnDefinition Width="165"/>
                <!-- 6: Quick Actions (WhatsApp & Copy) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 0: Visual Status Strip -->
            <Border x:Name="StatusStrip" Grid.Column="0" Width="4" Height="36" CornerRadius="2" Margin="0,0,10,0" Background="#EF4444" VerticalAlignment="Center"/>

            <!-- 1: Employee Code Badge -->
            <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="👤 " FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding EmployeeCode}" FontWeight="Bold" FontSize="11.5" Foreground="#334155"/>
                </StackPanel>
            </Border>

            <!-- 2: Employee Name & Dept -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                <TextBlock Text="{Binding EmployeeName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="🏢 " FontSize="10" VerticalAlignment="Center" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding Department, TargetNullValue='عام'}" FontSize="11" Foreground="#64748B" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </StackPanel>

            <!-- 3: Document Type Badge -->
            <Border Grid.Column="3" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="📄 " FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding FieldNameAr}" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>

            <!-- 4: Expiry Date -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="6,0">
                <TextBlock Text="تاريخ الانتهاء" FontSize="10" Foreground="#94A3B8" FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ExpiryDate, StringFormat=\{0:yyyy/MM/dd\}}" FontSize="12" FontWeight="Bold" Foreground="#1E293B" Margin="0,1,0,0"/>
            </StackPanel>

            <!-- 5: Status Badge & Days -->
            <Border x:Name="StatusBadge" Grid.Column="5" CornerRadius="6" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="6,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusIconText" Text="⚠️" FontSize="11" VerticalAlignment="Center" Margin="0,0,4,0"/>
                    <TextBlock x:Name="StatusTextLabel" Text="{Binding StatusText}" FontSize="11.5" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- 6: Action Buttons -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <!-- WhatsApp Button -->
                <Button x:Name="BtnWhatsApp" Content="📱 إشعار واتساب" Click="BtnWhatsApp_Click"
                        Style="{StaticResource AlertActionBtnStyle}"
                        Background="#25D366" BorderBrush="#1EBE5D" Foreground="White"
                        ToolTip="إرسال رسالة تذكير فورية للموظف عبر واتساب بتفاصيل تجديد الوثيقة"/>

                <!-- Copy Message Button -->
                <Button x:Name="BtnCopyText" Content="📋 نسخ التنبيه" Click="BtnCopyText_Click" Margin="6,0,0,0"
                        Style="{StaticResource AlertActionBtnStyle}"
                        Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#475569"
                        ToolTip="نسخ نص التذكير الجاهز إلى الحافظة"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
