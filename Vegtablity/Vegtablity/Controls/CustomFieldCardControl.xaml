<UserControl x:Class="Controls.CustomFieldCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo"
             Width="280" Margin="8">

    <UserControl.Resources>
        <!-- Action Button Style -->
        <Style x:Key="CardActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="MainCardBorder" Background="White" BorderBrush="#E2E8F0" BorderThickness="1.5" CornerRadius="14" Padding="16" SnapsToDevicePixels="True" Cursor="Hand">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.04" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Row 0: Header with Type Icon/Tag Badge & Active Status Pill -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Data Type Icon & Tag Badge (Hover shows ToolTip / Tag) -->
                <Border x:Name="TypeBadge" Grid.Column="0" CornerRadius="8" Padding="10,5"
                        Tag="{Binding FieldTypeDisplay}"
                        ToolTip="{Binding FieldTypeTooltip}"
                        BorderThickness="1" SnapsToDevicePixels="True">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="TypeIcon" Text="{Binding FieldTypeIcon}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TypeText" Text="{Binding FieldTypeDisplay}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <!-- Active / Inactive Status Pill -->
                <Border x:Name="StatusBadge" Grid.Column="2" CornerRadius="8" Padding="8,4" BorderThickness="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="{Binding StatusDescription}" FontSize="11" FontWeight="Bold"/>
                </Border>
            </Grid>

            <!-- Row 1: Field Name in Arabic -->
            <TextBlock Grid.Row="1" Text="{Binding FieldNameAr}" FontSize="15" FontWeight="Bold" Foreground="#0F172A" TextWrapping="Wrap" Margin="0,0,0,4"/>

            <!-- Row 2: Field Key Code Pill -->
            <Border Grid.Row="2" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="مفتاح: " FontSize="10" Foreground="#94A3B8"/>
                    <TextBlock Text="{Binding FieldKey}" FontFamily="Consolas, Cairo" FontSize="11" FontWeight="SemiBold" Foreground="#475569"/>
                </StackPanel>
            </Border>

            <!-- Row 3: Alert Notification Info Box -->
            <Border x:Name="AlertBadge" Grid.Row="3" CornerRadius="8" Padding="10,6" Margin="0,0,0,14" BorderThickness="1">
                <TextBlock x:Name="AlertText" Text="{Binding AlertDescription}" FontSize="11.5" FontWeight="SemiBold"/>
            </Border>

            <!-- Row 4: Sort Order & Action Buttons -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Sort Order Badge -->
                <Border Grid.Column="0" Background="#F1F5F9" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SortOrder, StringFormat='الترتيب: \{0\}'}" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                </Border>

                <!-- Actions: Edit & Delete Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource CardActionBtnStyle}"
                            Background="#EEF2FF" BorderBrush="#C7D2FE" Foreground="#4338CA"
                            ToolTip="تعديل بيانات هذا الحقل المخصص"
                            Tag="تعديل الحقل"
                            Margin="0,0,6,0"
                            Click="EditField_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="✏️" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="تعديل" FontSize="11"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource CardActionBtnStyle}"
                            Background="#FEF2F2" BorderBrush="#FECACA" Foreground="#DC2626"
                            ToolTip="حذف هذا الحقل المخصص وكافة قيمه"
                            Tag="حذف الحقل"
                            Click="DeleteField_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🗑️" FontSize="11" Margin="0,0,4,0"/>
                            <TextBlock Text="حذف" FontSize="11"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
