<UserControl x:Class="Controls.QuoteItemRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Vegtablity.Controls"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo">

    <Border Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="4,4" MinHeight="46">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- 0: Barcode -->
                <ColumnDefinition Width="160"/>
                <!-- 1: Product SearchableDropdown (Expanding) -->
                <ColumnDefinition Width="*"/>
                <!-- 2: Unit Name -->
                <ColumnDefinition Width="100"/>
                <!-- 3: Quoted Price -->
                <ColumnDefinition Width="140"/>
                <!-- 4: Delete Action -->
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <!-- 0: Barcode TextBox -->
            <TextBox x:Name="BarcodeBox"
                     Grid.Column="0"
                     Height="38"
                     Margin="3,2"
                     Padding="8,0"
                     Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource ModernTextBoxStyle}"
                     GotFocus="AmountBox_GotFocus"
                     PreviewKeyDown="BarcodeBox_PreviewKeyDown"/>

            <!-- 1: Product SearchableDropdown -->
            <controls:SearchableDropdown x:Name="ProductDropdown"
                                         Grid.Column="1"
                                         Height="38"
                                         Margin="3,2"
                                         DisplayMemberPath="SearchText"
                                         Watermark="اختر أو ابحث عن الصنف..."
                                         SearchChanged="ProductDropdown_SearchChanged"
                                         ItemSelected="ProductDropdown_ItemSelected"
                                         ConfirmedAndMoveNext="ProductDropdown_ConfirmedAndMoveNext"/>

            <!-- 2: Unit TextBox (Read-Only) -->
            <TextBox x:Name="UnitBox"
                     Grid.Column="2"
                     Height="38"
                     Margin="3,2"
                     Padding="6,0"
                     Text="{Binding UnitName, Mode=OneWay}"
                     IsReadOnly="True"
                     Background="#F8FAFC"
                     Foreground="#64748B"
                     TextAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource ModernTextBoxStyle}"/>

            <!-- 3: Quoted Price TextBox -->
            <TextBox x:Name="QuotedPriceBox"
                     Grid.Column="3"
                     Height="38"
                     Margin="3,2"
                     Padding="6,0"
                     Text="{Binding QuotedPrice, UpdateSourceTrigger=LostFocus, StringFormat=\{0:0.###\}}"
                     FontWeight="Bold"
                     Foreground="#2563EB"
                     TextAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource ModernTextBoxStyle}"
                     GotFocus="AmountBox_GotFocus"
                     LostFocus="QuotedPriceBox_LostFocus"
                     PreviewTextInput="AmountBox_PreviewTextInput"
                     PreviewKeyDown="QuotedPriceBox_PreviewKeyDown"/>

            <!-- 4: Delete Button -->
            <Button x:Name="DeleteButton"
                    Grid.Column="4"
                    Content="❌"
                    Width="32"
                    Height="32"
                    Margin="2,2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#EF4444"
                    FontSize="12"
                    Cursor="Hand"
                    ToolTip="حذف هذا السطر"
                    Click="DeleteButton_Click"/>
        </Grid>
    </Border>
</UserControl>
