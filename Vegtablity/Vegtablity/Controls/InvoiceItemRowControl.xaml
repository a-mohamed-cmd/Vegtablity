<UserControl x:Class="Controls.InvoiceItemRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Vegtablity.Controls"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo">

    <UserControl.Resources>
        <helpers:BooleanInverterConverter x:Key="BoolToInvertedConverter"/>
    </UserControl.Resources>

    <Border Background="White" BorderBrush="#F1F5F9" BorderThickness="0,0,0,1" Padding="4,4" MinHeight="46">
        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- 0: Barcode -->
                <ColumnDefinition Width="140"/>
                <!-- 1: Product SearchableDropdown (Expanding) -->
                <ColumnDefinition Width="*"/>
                <!-- 2: Unit Name -->
                <ColumnDefinition Width="90"/>
                <!-- 3: Quantity -->
                <ColumnDefinition Width="100"/>
                <!-- 4: Unit Price -->
                <ColumnDefinition Width="110"/>
                <!-- 5: Total Price -->
                <ColumnDefinition Width="120"/>
                <!-- 6: Delete Action -->
                <ColumnDefinition Width="40"/>
            </Grid.ColumnDefinitions>

            <!-- 0: Barcode TextBox -->
            <TextBox x:Name="BarcodeBox"
                     Grid.Column="0"
                     Height="38"
                     Margin="3,2"
                     Padding="8,0"
                     Text="{Binding Barcode, UpdateSourceTrigger=PropertyChanged}"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource ModernTextBoxStyle}"
                     IsEnabled="{Binding IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToInvertedConverter}}"
                     GotFocus="AmountBox_GotFocus"
                     PreviewKeyDown="BarcodeBox_PreviewKeyDown"/>

            <!-- 1: Product SearchableDropdown -->
            <controls:SearchableDropdown x:Name="ProductDropdown"
                                         Grid.Column="1"
                                         Height="38"
                                         Margin="3,2"
                                         DisplayMemberPath="SearchText"
                                         Watermark="اختر أو ابحث عن الصنف..."
                                         IsEnabled="{Binding IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToInvertedConverter}}"
                                         SearchChanged="ProductDropdown_SearchChanged"
                                         ItemSelected="ProductDropdown_ItemSelected"
                                         ConfirmedAndMoveNext="ProductDropdown_ConfirmedAndMoveNext"/>

            <!-- 2: Unit TextBox (Read-Only) -->
            <TextBox x:Name="UnitBox"
                     Grid.Column="2"
                     Height="38"
                     Margin="3,2"
                     Padding="6,0"
                     Text="{Binding UnitName, Mode=OneWay}"
                     IsReadOnly="True"
                     Background="#F8FAFC"
                     Foreground="#64748B"
                     TextAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource ModernTextBoxStyle}"/>

            <!-- 3: Quantity TextBox -->
            <TextBox x:Name="QuantityBox"
                     Grid.Column="3"
                     Height="38"
                     Margin="3,2"
                     Padding="6,0"
                     Text="{Binding Quantity, UpdateSourceTrigger=LostFocus, StringFormat=\{0:0.###\}}"
                     FontWeight="SemiBold"
                     Foreground="#0F172A"
                     TextAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource ModernTextBoxStyle}"
                     IsEnabled="{Binding IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToInvertedConverter}}"
                     GotFocus="AmountBox_GotFocus"
                     LostFocus="QuantityBox_LostFocus"
                     PreviewTextInput="AmountBox_PreviewTextInput"
                     PreviewKeyDown="QuantityBox_PreviewKeyDown"/>

            <!-- 4: Unit Price TextBox -->
            <TextBox x:Name="UnitPriceBox"
                     Grid.Column="4"
                     Height="38"
                     Margin="3,2"
                     Padding="6,0"
                     Text="{Binding UnitPrice, UpdateSourceTrigger=LostFocus, StringFormat=\{0:0.###\}}"
                     FontWeight="SemiBold"
                     Foreground="#0284C7"
                     TextAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource ModernTextBoxStyle}"
                     IsEnabled="{Binding IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToInvertedConverter}}"
                     GotFocus="AmountBox_GotFocus"
                     LostFocus="UnitPriceBox_LostFocus"
                     PreviewTextInput="AmountBox_PreviewTextInput"
                     PreviewKeyDown="UnitPriceBox_PreviewKeyDown"/>

            <!-- 5: Total Price TextBox (Read-Only) -->
            <TextBox x:Name="TotalPriceBox"
                     Grid.Column="5"
                     Height="38"
                     Margin="3,2"
                     Padding="6,0"
                     Text="{Binding TotalPrice, Mode=OneWay, StringFormat=\{0:N3\}}"
                     FontWeight="Bold"
                     Foreground="#0F172A"
                     Background="#F8FAFC"
                     TextAlignment="Center"
                     HorizontalContentAlignment="Center"
                     VerticalContentAlignment="Center"
                     Style="{DynamicResource ModernTextBoxStyle}"
                     PreviewKeyDown="TotalPriceBox_PreviewKeyDown"/>

            <!-- 6: Delete Button -->
            <Button x:Name="DeleteButton"
                    Grid.Column="6"
                    Content="❌"
                    Width="32"
                    Height="32"
                    Margin="2,2"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    Foreground="#EF4444"
                    FontSize="12"
                    Cursor="Hand"
                    ToolTip="حذف هذا السطر"
                    IsEnabled="{Binding IsLocked, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToInvertedConverter}}"
                    Click="DeleteButton_Click"/>
        </Grid>
    </Border>
</UserControl>
