<UserControl x:Class="Controls.EndOfServiceRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="RowActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="MainRowBorder" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,4" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="4" ShadowDepth="1"/>
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- 0: Employee Code -->
                <ColumnDefinition Width="80"/>
                <!-- 1: Employee Name & Dept -->
                <ColumnDefinition Width="1.3*" MinWidth="135"/>
                <!-- 2: End Date & Duration -->
                <ColumnDefinition Width="1.4*" MinWidth="150"/>
                <!-- 3: Departure Reason Badge -->
                <ColumnDefinition Width="105"/>
                <!-- 4: Indemnity Amount -->
                <ColumnDefinition Width="90"/>
                <!-- 5: Leave Compensation -->
                <ColumnDefinition Width="85"/>
                <!-- 6: Deductions -->
                <ColumnDefinition Width="80"/>
                <!-- 7: Net Settlement Amount -->
                <ColumnDefinition Width="105"/>
                <!-- 8: Print Action Button -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 0: Employee Code Badge -->
            <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding EmployeeCode}" FontWeight="Bold" FontSize="11.5" Foreground="#334155"/>
            </Border>

            <!-- 1: Employee Name & Dept -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                <TextBlock Text="{Binding EmployeeName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Department}" FontSize="11" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 2: End Date & Duration -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="تاريخ النهاية: " FontSize="10.5" Foreground="#64748B"/>
                    <TextBlock Text="{Binding EndDate, StringFormat=\{0:yyyy/MM/dd\}}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                </StackPanel>
                <Border Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" Margin="0,2,0,0">
                    <TextBlock Text="{Binding DurationDescription}" FontSize="10" FontWeight="Bold" Foreground="#0284C7"/>
                </Border>
            </StackPanel>

            <!-- 3: Departure Reason Badge -->
            <Border x:Name="ReasonBadge" Grid.Column="3" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="ReasonText" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
            </Border>

            <!-- 4: Indemnity Amount -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding IndemnityAmount, StringFormat=\{0:N3\}}" FontSize="12.5" FontWeight="Bold" Foreground="#1E293B" TextAlignment="Center"/>
                <TextBlock Text="مكافأة" FontSize="9.5" Foreground="#64748B" TextAlignment="Center"/>
            </StackPanel>

            <!-- 5: Leave Compensation -->
            <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding UnpaidLeaveCompensation, StringFormat=\{0:N3\}}" FontSize="12.5" FontWeight="Bold" Foreground="#D97706" TextAlignment="Center"/>
                <TextBlock Text="بدل إجازة" FontSize="9.5" Foreground="#64748B" TextAlignment="Center"/>
            </StackPanel>

            <!-- 6: Deductions -->
            <StackPanel Grid.Column="6" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="{Binding DeductionsLoans, StringFormat=\{0:N3\}}" FontSize="12" FontWeight="Bold" Foreground="#DC2626" TextAlignment="Center"/>
                <TextBlock Text="خصومات" FontSize="9.5" Foreground="#64748B" TextAlignment="Center"/>
            </StackPanel>

            <!-- 7: Net Settlement Amount -->
            <Border Grid.Column="7" Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="6,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding NetSettlementAmount, StringFormat=\{0:N3\}}" FontSize="13.5" FontWeight="ExtraBold" Foreground="#059669" TextAlignment="Center"/>
            </Border>

            <!-- 8: Print Action Button -->
            <StackPanel Grid.Column="8" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Button Style="{StaticResource RowActionBtnStyle}"
                        Background="#0EA5E9" BorderBrush="#0284C7" Foreground="White"
                        ToolTip="طباعة نموذج تصفية نهاية الخدمة والمخالصة"
                        Tag="طباعة المخالصة"
                        Click="PrintSettlement_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🖨️" FontSize="11" Margin="0,0,4,0"/>
                        <TextBlock Text="المخالصة" FontSize="10.5"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
