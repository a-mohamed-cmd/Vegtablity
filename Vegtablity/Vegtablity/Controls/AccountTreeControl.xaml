<UserControl x:Class="Controls.AccountTreeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:Vegtablity.Models"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             FlowDirection="RightToLeft">

    <UserControl.Resources>
        <helpers:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <!-- Modern Toggle Button for TreeView Expander -->
        <Style x:Key="ExpandCollapseToggleStyle" TargetType="{x:Type ToggleButton}">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Width" Value="24"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border x:Name="ToggleBorder" Width="22" Height="22" Background="#F1F5F9" CornerRadius="4" 
                                BorderBrush="#E2E8F0" BorderThickness="1"
                                VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="ArrowText" Text="◀" FontSize="11" FontWeight="Bold" Foreground="#64748B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="ToggleBorder" Property="BorderBrush" Value="#C7D2FE"/>
                                <Setter TargetName="ArrowText" Property="Text" Value="▼"/>
                                <Setter TargetName="ArrowText" Property="Foreground" Value="#4F46E5"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleBorder" Property="Background" Value="#E2E8F0"/>
                                <Setter TargetName="ArrowText" Property="Foreground" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Modern TreeViewItem Style -->
        <Style x:Key="ModernTreeViewItemStyle" TargetType="{x:Type TreeViewItem}">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
            <Setter Property="Visibility" Value="{Binding IsVisible, Converter={StaticResource BoolToVisConverter}}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="0,2"/>
            <Setter Property="Margin" Value="0,1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TreeViewItem}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Node Header Content -->
                            <Border x:Name="Bd" Grid.Row="0" Background="{TemplateBinding Background}"
                                    BorderBrush="Transparent" BorderThickness="1"
                                    CornerRadius="6" Padding="4,3" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="26"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Expander Toggle -->
                                    <ToggleButton x:Name="Expander" Grid.Column="0"
                                                  Style="{StaticResource ExpandCollapseToggleStyle}"
                                                  IsChecked="{Binding Path=IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                  ClickMode="Press"/>

                                    <!-- Content Presenter -->
                                    <ContentPresenter Grid.Column="1" x:Name="PART_Header"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="Stretch"/>
                                </Grid>
                            </Border>

                            <!-- Child Items Host -->
                            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Margin="24,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- CRITICAL: Hide child items when collapsed -->
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEF2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#C7D2FE"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="#F8FAFC"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#E2E8F0"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.RowDefinitions>
            <!-- 0: Toolbar Bar -->
            <RowDefinition Height="Auto"/>
            <!-- 1: TreeView -->
            <RowDefinition Height="*"/>
            <!-- 2: Footer / Stats -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Tree Toolbar -->
        <Border Grid.Row="0" Background="#F8FAFC" Padding="12,8" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title and Legend -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🌳 شجرة الحسابات الهرمية" FontWeight="Bold" FontSize="13.5" Foreground="#1E293B" Margin="0,0,10,0" VerticalAlignment="Center"/>
                    <Border Background="#EDE9FE" CornerRadius="10" Padding="6,2" Margin="0,0,4,0" ToolTip="الحسابات الرئيسية الكبرى">
                        <TextBlock Text="مستوى 0: رئيسي" FontSize="10.5" FontWeight="Bold" Foreground="#6D28D9"/>
                    </Border>
                    <Border Background="#E0F2FE" CornerRadius="10" Padding="6,2" Margin="0,0,4,0" ToolTip="حسابات تابعة للمستوى 0">
                        <TextBlock Text="مستوى 1: فرعي" FontSize="10.5" FontWeight="Bold" Foreground="#0369A1"/>
                    </Border>
                    <Border Background="#FEF3C7" CornerRadius="10" Padding="6,2" Margin="0,0,4,0" ToolTip="حسابات تابعة للمستوى 1">
                        <TextBlock Text="مستوى 2: فرعي للفرعي" FontSize="10.5" FontWeight="Bold" Foreground="#B45309"/>
                    </Border>
                </StackPanel>

                <!-- Right: Expand / Collapse All Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="➕ توسيع الكل" Command="{Binding ExpandAllTreeCommand}"
                            Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,2" FontSize="11" FontWeight="SemiBold"
                            Background="#475569" Margin="0,0,6,0" ToolTip="فتح وتوسيع كافة فروع شجرة الحسابات"/>
                    <Button Content="➖ طي الكل" Command="{Binding CollapseAllTreeCommand}"
                            Style="{StaticResource ModernButtonStyle}" Height="28" Padding="10,2" FontSize="11" FontWeight="SemiBold"
                            Background="#64748B" ToolTip="طي كافة فروع شجرة الحسابات وإظهار المستوى 0 فقط"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- TreeView Control -->
        <TreeView Grid.Row="1" ItemsSource="{Binding AccountTree}"
                  ItemContainerStyle="{StaticResource ModernTreeViewItemStyle}"
                  BorderThickness="0" Padding="8,8"
                  SelectedItemChanged="TreeView_SelectedItemChanged"
                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                  ScrollViewer.VerticalScrollBarVisibility="Auto">
            
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type models:AccountNode}" ItemsSource="{Binding Children}">
                    <Border Padding="6,4" CornerRadius="6" Background="Transparent">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <!-- 0: Icon -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- 1: Account Code Badge -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- 2: Account Name -->
                                <ColumnDefinition Width="*"/>
                                <!-- 3: Level Badge -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- 4: Type Badge -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- 5: Transactional Badge -->
                                <ColumnDefinition Width="Auto"/>
                                <!-- 6: Quick Add Sub-Account Button -->
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- 0: Node Icon -->
                            <TextBlock Grid.Column="0" Text="{Binding NodeIcon}" FontSize="15" VerticalAlignment="Center" Margin="0,0,6,0"/>

                            <!-- 1: Account Code Badge -->
                            <Border Grid.Column="1" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1"
                                    CornerRadius="6" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AccountCode}" FontWeight="Bold" FontSize="12" Foreground="#334155" FontFamily="Consolas, Segoe UI"/>
                            </Border>

                            <!-- 2: Account Name -->
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="{Binding AccountName}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ChildrenCountText}" FontSize="11" Foreground="#64748B" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 3: Level Badge -->
                            <Border Grid.Column="3" Background="{Binding LevelBadgeBackground}"
                                    CornerRadius="10" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding LevelBadgeText}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding LevelBadgeForeground}"/>
                            </Border>

                            <!-- 4: Type Badge -->
                            <Border Grid.Column="4" Background="{Binding AccountTypeBadgeBackground}"
                                    CornerRadius="10" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding AccountTypeArabicName}" FontSize="10.5" FontWeight="Bold" Foreground="{Binding AccountTypeBadgeForeground}"/>
                            </Border>

                            <!-- 5: Transactional Badge -->
                            <Border Grid.Column="5" CornerRadius="10" Padding="7,2" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#F1F5F9"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransactional}" Value="True">
                                                <Setter Property="Background" Value="#DCFCE7"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10.5" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="تجميعي 📊"/>
                                            <Setter Property="Foreground" Value="#475569"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsTransactional}" Value="True">
                                                    <Setter Property="Text" Value="يقبل قيود ✍️"/>
                                                    <Setter Property="Foreground" Value="#15803D"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>

                            <!-- 6: Quick Add Child Account Button -->
                            <Button Grid.Column="6" Content="➕ فرعي" 
                                    Command="{Binding DataContext.AddChildAccountCommand, RelativeSource={RelativeSource AncestorType=TreeView}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                                    Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1"
                                    Foreground="#4F46E5" FontSize="11" FontWeight="Bold" Cursor="Hand"
                                    Padding="6,2" Margin="4,0,0,0" ToolTip="إضافة حساب فرعي جديد تابع لهذا الحساب"/>
                        </Grid>
                    </Border>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>

        <!-- Footer Bar with Tree Stats -->
        <Border Grid.Row="2" Background="#F1F5F9" Padding="10,6" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="إحصائيات الشجرة:" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" Margin="0,0,8,0"/>
                    <TextBlock Text="إجمالي الحسابات: " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TotalAccountsCount}" FontWeight="Bold" FontSize="11" Foreground="#0F172A" Margin="0,0,12,0"/>
                    
                    <TextBlock Text="الحسابات الرئيسية (مستوى 0): " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding RootAccountsCount}" FontWeight="Bold" FontSize="11" Foreground="#6D28D9" Margin="0,0,12,0"/>

                    <TextBlock Text="الحسابات القابلة للقيد: " FontSize="11" Foreground="#64748B"/>
                    <TextBlock Text="{Binding TransactionalAccountsCount}" FontWeight="Bold" FontSize="11" Foreground="#15803D"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Text="💡 انقر على أي حساب لتعديل بياناته أو إضافة حساب فرعي تحته" 
                           FontSize="11" Foreground="#64748B" FontStyle="Italic" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
