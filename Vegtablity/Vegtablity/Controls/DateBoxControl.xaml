<UserControl x:Class="Controls.DateBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="40" d:DesignWidth="160"
             FlowDirection="RightToLeft"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo"
             SnapsToDevicePixels="True"
             UseLayoutRounding="True"
             ClipToBounds="False">

    <Grid x:Name="RootGrid" SnapsToDevicePixels="True" UseLayoutRounding="True" ClipToBounds="False">
        <TextBox x:Name="DateTextBox"
                 HorizontalAlignment="Stretch"
                 VerticalAlignment="Stretch"
                 HorizontalContentAlignment="Center" 
                 VerticalContentAlignment="Center"
                 Padding="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Padding}"
                 FontSize="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FontSize}"
                 FontWeight="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=FontWeight}"
                 Style="{DynamicResource ModernTextBoxStyle}"
                 IsReadOnly="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=IsReadOnly}"
                 helpers:WatermarkHelper.Watermark="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=Watermark}"
                 SnapsToDevicePixels="True"
                 UseLayoutRounding="True"
                 GotFocus="DateTextBox_GotFocus"
                 LostFocus="DateTextBox_LostFocus"
                 PreviewKeyDown="DateTextBox_PreviewKeyDown"
                 TextChanged="DateTextBox_TextChanged"/>
    </Grid>
</UserControl>
