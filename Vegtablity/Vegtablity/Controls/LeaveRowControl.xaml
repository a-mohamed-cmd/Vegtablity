<UserControl x:Class="Controls.LeaveRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:Vegtablity.Helpers"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <Style x:Key="RowActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="MainRowBorder" Background="White" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,4" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="4" ShadowDepth="1"/>
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- 0: Employee Code -->
                <ColumnDefinition Width="80"/>
                <!-- 1: Employee Name & Dept -->
                <ColumnDefinition Width="1.2*" MinWidth="130"/>
                <!-- 2: Leave Type -->
                <ColumnDefinition Width="110"/>
                <!-- 3: Leave Period & Duration -->
                <ColumnDefinition Width="1.3*" MinWidth="150"/>
                <!-- 4: Return & Resumption Date -->
                <ColumnDefinition Width="1.2*" MinWidth="140"/>
                <!-- 5: Delay Status -->
                <ColumnDefinition Width="85"/>
                <!-- 6: Leave Status Badge -->
                <ColumnDefinition Width="95"/>
                <!-- 7: Quick Actions (Print Buttons) -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 0: Employee Code Badge -->
            <Border Grid.Column="0" Background="#F1F5F9" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="6,3" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding EmployeeCode}" FontWeight="Bold" FontSize="11.5" Foreground="#334155"/>
            </Border>

            <!-- 1: Employee Name & Dept -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
                <TextBlock Text="{Binding EmployeeName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding Department}" FontSize="11" Foreground="#64748B" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>

            <!-- 2: Leave Type Badge -->
            <Border Grid.Column="2" Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="{Binding LeaveTypeName}" FontSize="11.5" FontWeight="Bold" Foreground="#1D4ED8" TextAlignment="Center"/>
            </Border>

            <!-- 3: Leave Period & Duration -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding StartDate, StringFormat=\{0:yyyy/MM/dd\}}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                    <TextBlock Text=" ◀ " FontSize="10" Foreground="#94A3B8" Margin="2,0"/>
                    <TextBlock Text="{Binding EndDate, StringFormat=\{0:yyyy/MM/dd\}}" FontSize="11.5" FontWeight="SemiBold" Foreground="#1E293B"/>
                </StackPanel>
                <Border Background="#F0FDF4" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left" Margin="0,2,0,0">
                    <TextBlock Text="{Binding DaysCount, StringFormat='المدة: \{0\} أيام'}" FontSize="10.5" FontWeight="Bold" Foreground="#16A34A"/>
                </Border>
            </StackPanel>

            <!-- 4: Return & Resumption -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="6,0">
                <TextBlock FontSize="11" Foreground="#475569">
                    <Run Text="العودة المقررة: " FontWeight="Medium"/>
                    <Run Text="{Binding ExpectedReturnDate, StringFormat=\{0:yyyy/MM/dd\}}" FontWeight="Bold" Foreground="#0F172A"/>
                </TextBlock>
                <TextBlock FontSize="11" Margin="0,2,0,0">
                    <Run Text="المباشرة: " Foreground="#64748B"/>
                    <Run Text="{Binding ResumptionDate, TargetNullValue='⏳ قيد الإجازة', StringFormat=\{0:yyyy/MM/dd\}}" FontWeight="Bold" Foreground="#0284C7"/>
                </TextBlock>
            </StackPanel>

            <!-- 5: Delay Status -->
            <Border x:Name="DelayBadge" Grid.Column="5" CornerRadius="6" Padding="6,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="DelayText" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
            </Border>

            <!-- 6: Status Badge -->
            <Border x:Name="StatusBadge" Grid.Column="6" CornerRadius="6" Padding="8,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="StatusText" FontSize="11" FontWeight="Bold" TextAlignment="Center"/>
            </Border>

            <!-- 7: Quick Actions -->
            <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Button Content="📄 طلب" ToolTip="طباعة طلب الإجازة المعتمد"
                        Style="{StaticResource RowActionBtnStyle}"
                        Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#1E293B"
                        Margin="0,0,4,0" Click="PrintLeave_Click"/>

                <Button Content="🏢 مباشرة" ToolTip="طباعة إشعار مباشرة العمل"
                        Style="{StaticResource RowActionBtnStyle}"
                        Background="#F0FDF4" BorderBrush="#BBF7D0" Foreground="#15803D"
                        Click="PrintCommencement_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
