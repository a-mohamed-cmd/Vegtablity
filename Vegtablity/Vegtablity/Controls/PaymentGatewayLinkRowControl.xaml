<UserControl x:Class="Controls.PaymentGatewayLinkRowControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo"
             FlowDirection="RightToLeft"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="LinkRowActionBtnStyle" TargetType="Button">
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="9,2"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border x:Name="MainRowBorder"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="10"
            Padding="12,9"
            Margin="0,0,0,5"
            SnapsToDevicePixels="True"
            MouseEnter="MainRowBorder_MouseEnter"
            MouseLeave="MainRowBorder_MouseLeave">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.03" BlurRadius="5" ShadowDepth="1"/>
        </Border.Effect>

        <Grid VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
                <!-- 0: Accent Status Strip -->
                <ColumnDefinition Width="Auto"/>
                <!-- 1: Link & Invoice Badge -->
                <ColumnDefinition Width="110"/>
                <!-- 2: Gateway & Created Date -->
                <ColumnDefinition Width="150"/>
                <!-- 3: Customer Name & Phone -->
                <ColumnDefinition Width="1.2*" MinWidth="145"/>
                <!-- 4: Financial Amounts (Amount / Fee / Refunded) -->
                <ColumnDefinition Width="165"/>
                <!-- 5: Status Badge & Journal Entry -->
                <ColumnDefinition Width="175"/>
                <!-- 6: Quick Actions -->
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 0: Visual Status Strip -->
            <Border x:Name="StatusStrip" Grid.Column="0" Width="4" Height="42" CornerRadius="2" Margin="0,0,10,0" Background="#F59E0B" VerticalAlignment="Center"/>

            <!-- 1: Link ID & Invoice ID -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
                <Border Background="#EFF6FF" BorderBrush="#BFDBFE" BorderThickness="1" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🧾 فاتورة #" FontSize="10.5" Foreground="#1E40AF" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding InvID}" FontSize="12" FontWeight="Bold" Foreground="#1D4ED8"/>
                    </StackPanel>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="2,3,0,0">
                    <TextBlock Text="🔗 رابط #" FontSize="10.5" Foreground="#64748B"/>
                    <TextBlock Text="{Binding LinkID}" FontSize="11" FontWeight="Bold" Foreground="#475569"/>
                    <Border Background="#FEF3C7" BorderBrush="#FDE68A" BorderThickness="1" CornerRadius="4" Padding="4,0" Margin="6,0,0,0"
                            Visibility="{Binding IsConsolidated, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="مجمّع" FontSize="9.5" FontWeight="Bold" Foreground="#92400E"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- 2: Gateway & Timestamp -->
            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="6,0">
                <TextBlock Text="{Binding ProviderNameAr}" FontWeight="Bold" FontSize="12.5" Foreground="#0F172A" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="🕒 " FontSize="10" Foreground="#94A3B8" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding CreatedAt, StringFormat=\{0:yyyy/MM/dd HH:mm\}}" FontSize="11" Foreground="#64748B" FlowDirection="LeftToRight"/>
                </StackPanel>
            </StackPanel>

            <!-- 3: Customer Name & Phone -->
            <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="6,0">
                <TextBlock Text="{Binding DisplayCustomerName}" FontWeight="Bold" FontSize="13" Foreground="#0F172A" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayCustomerName}"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                    <TextBlock Text="📱 " FontSize="10.5" Foreground="#64748B" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding DisplayCustomerPhone, TargetNullValue='بدون هاتف'}" FontSize="11.5" FontWeight="SemiBold" Foreground="#475569" FlowDirection="LeftToRight"/>
                </StackPanel>
            </StackPanel>

            <!-- 4: Financial Breakdown -->
            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="6,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Amount, StringFormat=\{0:N3\}}" FontSize="14" FontWeight="Black" Foreground="#0F172A"/>
                    <TextBlock Text="{Binding CurrencyCode}" FontSize="11" FontWeight="Bold" Foreground="#475569" Margin="4,0,0,0" VerticalAlignment="Bottom"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                    <TextBlock Text="عمولة: " FontSize="10.5" Foreground="#64748B"/>
                    <TextBlock Text="{Binding GatewayFeeAmount, StringFormat=\{0:N3\}}" FontSize="10.5" FontWeight="Bold" Foreground="#B45309"/>
                    <TextBlock Text=" | مسترد: " FontSize="10.5" Foreground="#64748B"/>
                    <TextBlock x:Name="TxtRefundedAmt" Text="{Binding RefundedAmount, StringFormat=\{0:N3\}}" FontSize="10.5" FontWeight="Bold" Foreground="#DC2626"/>
                </StackPanel>
            </StackPanel>

            <!-- 5: Status Badge & Journal Entry -->
            <StackPanel Grid.Column="5" VerticalAlignment="Center" Margin="6,0">
                <Border x:Name="StatusBadge" CornerRadius="6" Padding="8,3" HorizontalAlignment="Left" BorderThickness="1" Background="#FFFBEB" BorderBrush="#FDE68A">
                    <TextBlock x:Name="StatusTextLabel" Text="{Binding StatusArabic}" FontSize="11.5" FontWeight="Bold" Foreground="#B45309"/>
                </Border>
                <StackPanel Orientation="Horizontal" Margin="2,3,0,0">
                    <TextBlock Text="📘 القيد: " FontSize="10.5" Foreground="#64748B"/>
                    <TextBlock Text="{Binding JournalEntryNo, TargetNullValue='غير مرحّل'}" FontSize="11" FontWeight="Bold" Foreground="#334155"/>
                </StackPanel>
            </StackPanel>

            <!-- 6: Quick Action Buttons -->
            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                <Button Content="🔄 فحص" Click="BtnRefreshStatus_Click"
                        Style="{StaticResource LinkRowActionBtnStyle}"
                        Background="#E0F2FE" BorderBrush="#BAE6FD" Foreground="#0369A1"
                        ToolTip="فحص وتحديث حالة الدفع من البوابة"/>

                <Button Content="💬 واتساب" Click="BtnWhatsApp_Click" Margin="4,0,0,0"
                        Style="{StaticResource LinkRowActionBtnStyle}"
                        Background="#DCFCE7" BorderBrush="#86EFAC" Foreground="#15803D"
                        ToolTip="إرسال رابط الدفع للعميل عبر واتساب"/>

                <Button Content="📋 نسخ" Click="BtnCopyLink_Click" Margin="4,0,0,0"
                        Style="{StaticResource LinkRowActionBtnStyle}"
                        Background="#F8FAFC" BorderBrush="#CBD5E1" Foreground="#334155"
                        ToolTip="نسخ رابط الدفع الإلكتروني إلى الحافظة"/>

                <Button Content="🖨️ 80mm" Click="BtnPrint80_Click" Margin="4,0,0,0"
                        Visibility="Collapsed"
                        Style="{StaticResource LinkRowActionBtnStyle}"
                        Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#334155"
                        ToolTip="طباعة إيصال QR بمقاس 80mm"/>

                <Button Content="🖨️ 58mm" Click="BtnPrint58_Click" Margin="4,0,0,0"
                        Visibility="Collapsed"
                        Style="{StaticResource LinkRowActionBtnStyle}"
                        Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#334155"
                        ToolTip="طباعة إيصال QR بمقاس 58mm"/>

                <Button Content="🖨️ A4" Click="BtnPrintWpf_Click" Margin="4,0,0,0"
                        Style="{StaticResource LinkRowActionBtnStyle}"
                        Background="#F1F5F9" BorderBrush="#CBD5E1" Foreground="#334155"
                        ToolTip="طباعة نموذج فاتورة دفع إلكتروني A4"/>

                <Button x:Name="BtnRefundRow" Content="↩️ إرجاع" Click="BtnRefund_Click" Margin="5,0,0,0"
                        Style="{StaticResource LinkRowActionBtnStyle}"
                        Background="#FEE2E2" BorderBrush="#FCA5A5" Foreground="#991B1B"
                        ToolTip="إرجاع المبلغ الكلي أو الجزئي للعميل عبر البوابة"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>

