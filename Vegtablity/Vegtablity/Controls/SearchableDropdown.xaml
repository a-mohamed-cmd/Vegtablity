<UserControl x:Class="Controls.SearchableDropdown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="pack://application:,,,/Resources/Fonts/#Cairo, Cairo">

    <Grid x:Name="RootGrid">

        <!-- Input TextBox -->
        <TextBox x:Name="SearchBox"
                 VerticalAlignment="Stretch"
                 VerticalContentAlignment="Center"
                 Padding="10,0,52,0"
                 Style="{DynamicResource ModernTextBoxStyle}"
                 TextChanged="SearchBox_TextChanged"
                 PreviewKeyDown="SearchBox_PreviewKeyDown"
                 PreviewMouseLeftButtonDown="SearchBox_PreviewMouseLeftButtonDown"
                 MouseDoubleClick="SearchBox_MouseDoubleClick"
                 GotFocus="SearchBox_GotFocus"
                 LostFocus="SearchBox_LostFocus"/>

        <!-- Action Buttons (Clear & Dropdown Toggle) -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,6,0">

            <!-- Clear Button (X) -->
            <Button x:Name="BtnClear"
                    Width="20" Height="20"
                    Margin="0,0,2,0"
                    Cursor="Hand"
                    Focusable="False"
                    ToolTip="مسح الاختيار (Esc)"
                    Visibility="Collapsed"
                    Click="BtnClear_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="10">
                            <TextBlock Text="✕" FontSize="11" FontWeight="Bold"
                                       Foreground="#94A3B8"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FEE2E2"/>
                                <Setter Property="Foreground" Value="#EF4444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- Dropdown Arrow Button (▼) -->
            <Button x:Name="BtnToggleDrop"
                    Width="20" Height="20"
                    Cursor="Hand"
                    Focusable="False"
                    ToolTip="فتح القائمة"
                    Click="BtnToggleDrop_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="4">
                            <Path x:Name="arrow" Data="M 0 0 L 4 4 L 8 0 Z"
                                  Fill="#64748B"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F1F5F9"/>
                                <Setter TargetName="arrow" Property="Fill" Value="#1E293B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>

        <!-- Dropdown Popup -->
        <Popup x:Name="DropPopup"
               PlacementTarget="{Binding ElementName=SearchBox}"
               Placement="Bottom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Slide"
               Opened="DropPopup_Opened">

            <Border x:Name="PopupBorder"
                    Background="White"
                    BorderBrush="#CBD5E1"
                    BorderThickness="1"
                    CornerRadius="0,0,8,8"
                    MinWidth="{Binding ActualWidth, ElementName=SearchBox}"
                    MaxHeight="280">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.15" Color="#000000"/>
                </Border.Effect>

                <ListBox x:Name="ItemsList"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         MouseLeftButtonUp="ItemsList_MouseLeftButtonUp"
                         PreviewKeyDown="ItemsList_PreviewKeyDown">

                    <!-- Item style -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="12,8"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="Cursor" Value="Hand"/>
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#EFF6FF"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#DBEAFE"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>

                    <!-- Items Panel for Virtualization -->
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel/>
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>

                    <!-- ListBox Template with ScrollViewer -->
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <Border x:Name="listBorder" Background="White" BorderThickness="0">
                                <Grid>
                                    <ScrollViewer x:Name="listScroll" Focusable="False" Padding="{TemplateBinding Padding}">
                                        <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </ScrollViewer>
                                    
                                    <TextBlock x:Name="EmptyMsg" Text="لا توجد نتائج"
                                               Padding="12,8" Foreground="#94A3B8"
                                               FontStyle="Italic" FontSize="13"
                                               Visibility="Collapsed"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Top"
                                               Margin="0,10"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter TargetName="EmptyMsg" Property="Visibility" Value="Visible"/>
                                    <Setter TargetName="listScroll" Property="Visibility" Value="Collapsed"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ListBox.Template>

                </ListBox>
            </Border>
        </Popup>

    </Grid>
</UserControl>
